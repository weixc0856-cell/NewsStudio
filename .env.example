# ---------------------------------------------------------------------------
# NewsStudio 环境变量模板（提交到远程；只写占位符，禁止出现任何真实路径）
#
# 用法：复制为 .env 并填入本机值；.env 已被 .gitignore 忽略，不会进远程。
# 代码在启动时通过 env_file.load_env() 读 .env；系统里已设置的同名变量优先。
# ---------------------------------------------------------------------------

# ---- 本地大模型（llama.cpp + Qwen3-30B-A3B-Instruct-2507） ----------------
LLM_BASE_URL=http://127.0.0.1:8080/v1
# 本地服务不校验密钥，任意非空值即可
LLM_API_KEY=sk-local
LLAMA_PORT=8080
# llama-server 可执行文件；留空则回退到 PATH 中的 llama-server
LLAMA_SERVER_BIN=
# 模型权重 .gguf 完整路径
LLAMA_MODEL_PATH=<path-to-model.gguf>

# ---- CosyVoice 配音微服务（独立 venv，与主项目隔离） --------------------
COSYVOICE_DIR=<path-to-CosyVoice-Runtime>
COSY_PORT=50000
# 零样本音色参考音频；用 SFT 预置音色时可留空
NEWS_TTS_PROMPT_WAV=
NEWS_TTS_PROMPT_TEXT=

# ---- 数据根与产出根 ------------------------------------------------------
# 新闻线媒体产出；留空使用 <repo>/output
NEWS_OUTPUT_ROOT=
# 原片与 [中英字幕].mkv 成片的数据根；<repo>/downloads 可做目录联接指向这里
NEWS_DATA_ROOT=

# ---- 可选的外部工具 ------------------------------------------------------
# 无头浏览器（截帧/片头渲染）；留空自动探测 Chrome/Edge
INTRO_BROWSER=
NEWS_BROWSER=
# ComfyUI / FLUX 工作流 JSON
NEWS_FLUX_WORKFLOW=
# VoxCPM 配音运行时目录（news/tts.py 用）
VOXCPM_RUNTIME=
# Docling 课程资料根目录（scripts/collect_knowledge.py 使用）
DOCLING_ROOT=
