  }, {
    "tStartMs": 1782240,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "With a Digital Twin Composer,\nyou can create"
    } ]
  }, {
    "tStartMs": 1784720,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "a virtual 3D model of any product,\nany plant, any process,"
    } ]
  }, {
    "tStartMs": 1789520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "bring it to life in a photorealistic scene\nthat you built"
    } ]
  }, {
    "tStartMs": 1794640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and in real time."
    } ]
  }, {
    "tStartMs": 1796880,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "The Digital Twin Composer is so powerful\nbecause you can connect the digital twin"
    } ]
  }, {
    "tStartMs": 1801840,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "to the real world and to real time data,"
    } ]
  }, {
    "tStartMs": 1806560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "from engineering data to weather data,"
    } ]
  }, {
    "tStartMs": 1809120,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "even time series data\ncoming from your machines."
    } ]
  }, {
    "tStartMs": 1814160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And when something worked\nwell or something went wrong,"
    } ]
  }, {
    "tStartMs": 1817360,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you can go back in time\nand you find out why."
    } ]
  }, {
    "tStartMs": 1820400,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Or you can jump to the future\nto simulate the science before you built"
    } ]
  }, {
    "tStartMs": 1824560,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "in the real world."
    } ]
  }, {
    "tStartMs": 1826960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And if you want"
    } ]
  }, {
    "tStartMs": 1828400,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to unlock the full benefits\nof the Digital Twin Composer,"
    } ]
  }, {
    "tStartMs": 1832480,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "you connect it to our operations\nsoftware and our hardware stack."
    } ]
  }, {
    "tStartMs": 1838160,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "That when you can make real world changes\nfrom the virtual environment,"
    } ]
  }, {
    "tStartMs": 1843040,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "optimize machine speed,\ntemperature, pressure, or any parameter"
    } ]
  }, {
    "tStartMs": 1847280,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "that determines\nthe quality in the yield of your plant."
    } ]
  }, {
    "tStartMs": 1852160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This is how we combine"
    } ]
  }, {
    "tStartMs": 1854240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the real and the digital worlds."
    } ]
  }, {
    "tStartMs": 1857280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This Digital Twin Composer will be available"
    } ]
  }, {
    "tStartMs": 1859360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "on our Siemens accelerator marketplace"
    } ]
  }, {
    "tStartMs": 1862480,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "in just a few moments."
    } ]
  }, {
    "tStartMs": 1868160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "PepsiCo"
    } ]
  }, {
    "tStartMs": 1870160,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "PepsiCo\nis among the first companies to use it."
    } ]
  }, {
    "tStartMs": 1874640,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "And this brings me to our next guest\nwho is leading the way when it comes"
    } ]
  }, {
    "tStartMs": 1879440,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "to the digitalization of PepsiCo,\nmaking the company"
    } ]
  }, {
    "tStartMs": 1885040,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "smarter, more efficient, more sustainable"
    } ]
  }, {
    "tStartMs": 1888240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "with industrial AI."
    } ]
  }, {
    "tStartMs": 1891200,
    "dDurationMs": 8000,
    "segs": [ {
      "utf8": "Please welcome Athina Kanioura."
    } ]
  }, {
    "tStartMs": 1907760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "It's a great year."
    } ]
  }, {
    "tStartMs": 1909120,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Your year, great year!"
    } ]
  }, {
    "tStartMs": 1910800,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It is, it is. Yeah."
    } ]
  }, {
    "tStartMs": 1913600,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "So tell us about the challenge\nPepsiCo's is navigating through."
    } ]
  }, {
    "tStartMs": 1918960,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And these challenges are very much alike\nto both the whole food"
    } ]
  }, {
    "tStartMs": 1923200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and beverage industry."
    } ]
  }, {
    "tStartMs": 1925280,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Yeah of course."
    } ]
  }, {
    "tStartMs": 1926160,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "And as Roland said I'm very privileged\nto be on stage with Roland and, you know,"
    } ]
  }, {
    "tStartMs": 1931520,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "PepsiCo has been pioneering some of these\ninnovation with you and Nvidia."
    } ]
  }, {
    "tStartMs": 1935920,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "So but from farm to shelf, PepsiCo,\nhas been operating in a very extraordinary"
    } ]
  }, {
    "tStartMs": 1940960,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and very complex environment\nbecause we have operations everywhere."
    } ]
  }, {
    "tStartMs": 1945360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "We serve billions of consumers."
    } ]
  }, {
    "tStartMs": 1947600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "We have billions of touch points per day."
    } ]
  }, {
    "tStartMs": 1949840,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "So consumers expect the products\nto be everywhere every time."
    } ]
  }, {
    "tStartMs": 1955680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "In real time."
    } ]
  }, {
    "tStartMs": 1957040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And we want to be able\nto fulfill the supply."
    } ]
  }, {
    "tStartMs": 1960160,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "So imagine a world where you have demand\nspikes, where you have unusual events."
    } ]
  }, {
    "tStartMs": 1965680,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "When you have tornadoes,\nyou have to be able to fulfill this demand"
    } ]
  }, {
    "tStartMs": 1969440,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "in a very digital way, where the physical\nfootprint cannot be a showstopper."
    } ]
  }, {
    "tStartMs": 1974960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 1975920,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So a ton of a supply chain and delivering."
    } ]
  }, {
    "tStartMs": 1979920,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Let's take a look\nat your existing warehouses."
    } ]
  }, {
    "tStartMs": 1983200,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 1983600,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So I mean, many of you know,\nespecially the ones that come"
    } ]
  }, {
    "tStartMs": 1986800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "from the manufacturing world,\nwe have great warehouses"
    } ]
  }, {
    "tStartMs": 1990160,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "that are fully modernized, but\nwe also have warehouses that are very old."
    } ]
  }, {
    "tStartMs": 1994880,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "So in this specific case,\nthis warehouse is half a century old."
    } ]
  }, {
    "tStartMs": 1999520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And that means in the current state,\nit really cannot serve and deliver"
    } ]
  }, {
    "tStartMs": 2003600,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "the demand."
    } ]
  }, {
    "tStartMs": 2004480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That might change depending on the events."
    } ]
  }, {
    "tStartMs": 2008080,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So what is the answer?"
    } ]
  }, {
    "tStartMs": 2009360,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And the answer cannot."
    } ]
  }, {
    "tStartMs": 2010480,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "These cannot be\nI will just build more capacity."
    } ]
  }, {
    "tStartMs": 2013840,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The answer must be I need to find a way\nto maximize the capacity that I have"
    } ]
  }, {
    "tStartMs": 2018640,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "to drive more operational efficiency\nand therefore increase the throughput."
    } ]
  }, {
    "tStartMs": 2023440,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "So what we wanted to do\nis adopt a digital first design approach,"
    } ]
  }, {
    "tStartMs": 2028800,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "and that means to leverage\nthe digital twins and adopting AI at scale"
    } ]
  }, {
    "tStartMs": 2033840,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "in all the parts of the operations\nwhere we were able to co-design"
    } ]
  }, {
    "tStartMs": 2038400,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "and simulate and optimize the layout\nbefore any physical building begins."
    } ]
  }, {
    "tStartMs": 2044400,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So and to do that,"
    } ]
  }, {
    "tStartMs": 2046000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "you decided to use our Digital Twin\nComposer."
    } ]
  }, {
    "tStartMs": 2049840,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Share your experience. Yes."
    } ]
  }, {
    "tStartMs": 2051520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "First of all, thank you."
    } ]
  }, {
    "tStartMs": 2054160,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Thank you for the partnership."
    } ]
  }, {
    "tStartMs": 2055440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Thank you for the investment."
    } ]
  }, {
    "tStartMs": 2056640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Thank you for taking our feedback\ninto product innovation."
    } ]
  }, {
    "tStartMs": 2060000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And today\nwe just had a press release. Yes."
    } ]
  }, {
    "tStartMs": 2062800,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "We are very excited to help save this\ntechnology in partnership with Nvidia."
    } ]
  }, {
    "tStartMs": 2067600,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And of course, Siemens\nthis is the first of its kind for the industry."
    } ]
  }, {
    "tStartMs": 2071840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "It is how we build AI\nand digital twins"
    } ]
  }, {
    "tStartMs": 2074560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "into our operations\nacross the board globally."
    } ]
  }, {
    "tStartMs": 2078320,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "When we say operations,\nthat is manufacturing, warehousing,"
    } ]
  }, {
    "tStartMs": 2082240,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "distribution centers, mixing centers\nand every part of logistics."
    } ]
  }, {
    "tStartMs": 2087200,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "So the Digital Twin Composer allows us\nto do everything in the virtual world,"
    } ]
  }, {
    "tStartMs": 2092480,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "being able to simulate everything in a way\nwhere we don't have to spend"
    } ]
  }, {
    "tStartMs": 2096800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a single dollar"
    } ]
  }, {
    "tStartMs": 2098000,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "on the physical plant before we know\nthat design is the final design."
    } ]
  }, {
    "tStartMs": 2102640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So therefore we are able to pull now\nmassive amounts of data"
    } ]
  }, {
    "tStartMs": 2106480,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "that we are able to simulate\nin a unified, immersive environment."
    } ]
  }, {
    "tStartMs": 2111440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "That means we can create a beautiful,"
    } ]
  }, {
    "tStartMs": 2114160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "photorealistic way,\nwhich you saw before in the discussion."
    } ]
  }, {
    "tStartMs": 2117760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And with the AI powered simulation."
    } ]
  }, {
    "tStartMs": 2119920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Now we can explore hundreds\nor thousands of potential"
    } ]
  }, {
    "tStartMs": 2123600,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "layouts\nto find the most efficient options."
    } ]
  }, {
    "tStartMs": 2127040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Therefore, with a digital twin,"
    } ]
  }, {
    "tStartMs": 2129120,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "this type of task that would have normally\ntaken months now takes days."
    } ]
  }, {
    "tStartMs": 2134320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Well, and"
    } ]
  }, {
    "tStartMs": 2136560,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "the question would be\nthen what does that do to your customers?"
    } ]
  }, {
    "tStartMs": 2141200,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "Yeah."
    } ]
  }, {
    "tStartMs": 2141680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Well obviously for us, making\nsure we serve our customers"
    } ]
  }, {
    "tStartMs": 2145200,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "in the most efficient way\nwhere we provide the inventory"
    } ]
  }, {
    "tStartMs": 2148640,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and we have the intelligent network\nwhere both the plants, the warehouses"
    } ]
  }, {
    "tStartMs": 2152560,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "and the network is able to anticipate\nthe demand and fine tune operations"
    } ]
  }, {
    "tStartMs": 2155960,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "in real time is a must."
    } ]
  }, {
    "tStartMs": 2158160,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "So therefore, we have had significant\nimpact even in the first three months."
    } ]
  }, {
    "tStartMs": 2162720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So one good\nexample is in the Gatorade plant in the US"
    } ]
  }, {
    "tStartMs": 2166080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "we use the Digital Twin Composer."
    } ]
  }, {
    "tStartMs": 2168240,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "We were able to drive\ntwo very meaningful results."
    } ]
  }, {
    "tStartMs": 2171520,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "One is to increase efficiency 20%\njust in three months."
    } ]
  }, {
    "tStartMs": 2176080,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And obviously if we were to look at\nwe have estimated how this capabilities"
    } ]
  }, {
    "tStartMs": 2179840,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "will benefit the company."
    } ]
  }, {
    "tStartMs": 2181280,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "We estimate the CapEx reduction of 10\nto 15% across all the operations."
    } ]
  }, {
    "tStartMs": 2186480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So for us, this is just the beginning."
    } ]
  }, {
    "tStartMs": 2188720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "We are very hopeful\nabout what this technology can do"
    } ]
  }, {
    "tStartMs": 2191440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "when it comes to serving our customers,\nserving our consumers."
    } ]
  }, {
    "tStartMs": 2194880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And I would really to thank you\nfor the great partnership."
    } ]
  }, {
    "tStartMs": 2197360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Thank you for the partnership."
    } ]
  }, {
    "tStartMs": 2198720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "And, this is just the start."
    } ]
  }, {
    "tStartMs": 2200640,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "We want to see more\nand we will see more. Athina,"
    } ]
  }, {
    "tStartMs": 2203120,
    "dDurationMs": 9840,
    "segs": [ {
      "utf8": "Thank you very much.\nThank you so much. Thank you."
    } ]
  }, {
    "tStartMs": 2212960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You have seen the great impacts\nthat the Digital Twin Composer"
    } ]
  }, {
    "tStartMs": 2215760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "is having on PepsiCo facilities."
    } ]
  }, {
    "tStartMs": 2219120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Using this technology,"
    } ]
  }, {
    "tStartMs": 2221040,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "even in the design phase of new plants\nmatters,"
    } ]
  }, {
    "tStartMs": 2224480,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "especially in the United States,"
    } ]
  }, {
    "tStartMs": 2226000,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "because it accelerates\nthe ramp up of new manufacturing sites"
    } ]
  }, {
    "tStartMs": 2229760,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "and allows our customers to make them more\nproductive and energy efficient."
    } ]
  }, {
    "tStartMs": 2234520,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "KION uses our"
    } ]
  }, {
    "tStartMs": 2235840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "technology to transform warehouses\nentire supply chains too."
    } ]
  }, {
    "tStartMs": 2238800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Let's have a look."
    } ]
  }, {
    "tStartMs": 2240240,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "KION the supply chain\nsolutions company is scaling up physical"
    } ]
  }, {
    "tStartMs": 2244240,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "AI and automation solutions\nto orchestrate customer supply chains"
    } ]
  }, {
    "tStartMs": 2249280,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "inside the four walls\nand up and down the supply chain"
    } ]
  }, {
    "tStartMs": 2253040,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "with AI, digital twins,\na new supply chain solution begins"
    } ]
  }, {
    "tStartMs": 2257440,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "as a digital twin\ncompressing solutioning from years to months."
    } ]
  }, {
    "tStartMs": 2263120,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "You can learn more"
    } ]
  }, {
    "tStartMs": 2264080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "about the Digital Composer at our booth."
    } ]
  }, {
    "tStartMs": 2268000,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Also on this CES show floor when you will"
    } ]
  }, {
    "tStartMs": 2272080,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "meet the team from PAVE 360."
    } ]
  }, {
    "tStartMs": 2277520,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "PAVE 360 automotive is our digital twin"
    } ]
  }, {
    "tStartMs": 2282560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "for autonomous driving system,"
    } ]
  }, {
    "tStartMs": 2285280,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and it's ready to use right off the shelf."
    } ]
  }, {
    "tStartMs": 2289360,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It replicates real vehicle\nhardware in the digital world."
    } ]
  }, {
    "tStartMs": 2293920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Developers can simulate real world\ndriving conditions."
    } ]
  }, {
    "tStartMs": 2298320,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "They can test the autonomous system\nbefore a car even exists,"
    } ]
  }, {
    "tStartMs": 2302320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and this accelerates the development."
    } ]
  }, {
    "tStartMs": 2305360,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "PAVE 360 automotive\nalso replicates how the software"
    } ]
  }, {
    "tStartMs": 2310400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "in the car behaves, and better yet,"
    } ]
  }, {
    "tStartMs": 2313840,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "it integrates the latest automotive\nIP from our partner ARM for advanced"
    } ]
  }, {
    "tStartMs": 2319680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "driver assistance systems, infotainment"
    } ]
  }, {
    "tStartMs": 2322640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and the AI driven cockpit features."
    } ]
  }, {
    "tStartMs": 2326400,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "It's a solution that will scale autonomous\ndriving faster"
    } ]
  }, {
    "tStartMs": 2330080,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "with the power of industrial AI."
    } ]
  }, {
    "tStartMs": 2336880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now imagine\nwhat happens when we apply industrial"
    } ]
  }, {
    "tStartMs": 2339680,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "AI to something more personal,\neven more complex."
    } ]
  }, {
    "tStartMs": 2345280,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Your body, your health."
    } ]
  }, {
    "tStartMs": 2349440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Life sciences."
    } ]
  }, {
    "tStartMs": 2352080,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Bringing new medicines to the market costs\na lot of time and money."
    } ]
  }, {
    "tStartMs": 2357120,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Over the last 50"
    } ]
  }, {
    "tStartMs": 2358160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "years, these costs have risen\ndramatically."
    } ]
  }, {
    "tStartMs": 2361840,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It often takes more than ten years"
    } ]
  }, {
    "tStartMs": 2364960,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "and costs are up to $2 billion."
    } ]
  }, {
    "tStartMs": 2369600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Patients and pharmaceutical companies"
    } ]
  }, {
    "tStartMs": 2371840,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "obviously want to have faster innovations."
    } ]
  }, {
    "tStartMs": 2374560,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "That means tackling\nevery step in the chain"
    } ]
  }, {
    "tStartMs": 2378720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from early research to manufacturing."
    } ]
  }, {
    "tStartMs": 2382000,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "And we bring AI to all these steps."
    } ]
  }, {
    "tStartMs": 2386480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Let's take the example of a new cancer\ndrug."
    } ]
  }, {
    "tStartMs": 2389920,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "In research lab"
    } ]
  }, {
    "tStartMs": 2390960,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "scientists create billions of data points."
    } ]
  }, {
    "tStartMs": 2393360,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Today, this data is scattered\nacross industries and instruments"
    } ]
  }, {
    "tStartMs": 2397040,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "and files and around the world\nthrough our platform, Luma"
    } ]
  }, {
    "tStartMs": 2401520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "scientists use AI to bring this data\ntogether and structure it"
    } ]
  }, {
    "tStartMs": 2406640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "so you can ask questions\nin natural language."
    } ]
  }, {
    "tStartMs": 2411040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Next step, scientists identify"
    } ]
  }, {
    "tStartMs": 2413680,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "the most promising molecular structure\nof the cancer drug"
    } ]
  }, {
    "tStartMs": 2418400,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "with AI powered simulations\nthat can simulate the behavior"
    } ]
  }, {
    "tStartMs": 2423360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of the molecule."
    } ]
  }, {
    "tStartMs": 2424800,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "2.5 million times more efficiently"
    } ]
  }, {
    "tStartMs": 2428400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "than ever before."
    } ]
  }, {
    "tStartMs": 2431360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And this includes\nhow molecules move and flex,"
    } ]
  }, {
    "tStartMs": 2435360,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "how they interact with each other,\nor how stable they are."
    } ]
  }, {
    "tStartMs": 2439200,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Over time."
    } ]
  }, {
    "tStartMs": 2442080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "But then, when you need to go"
    } ]
  }, {
    "tStartMs": 2444240,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "from making a small batch in the lab\nto producing at scale"
    } ]
  }, {
    "tStartMs": 2448800,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "without the slightest deviation\nin the recipe,"
    } ]
  }, {
    "tStartMs": 2453120,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "and with exactly the same result,"
    } ]
  }, {
    "tStartMs": 2456960,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "even for world class production experts,\nthis means a lot of trial and error."
    } ]
  }, {
    "tStartMs": 2461600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "A lot of experiments in a bioreactor,"
    } ]
  }, {
    "tStartMs": 2464720,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and our digital twin of a bioreactor."
    } ]
  }, {
    "tStartMs": 2467440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "You can run these experiments\nin the digital world, first."
    } ]
  }, {
    "tStartMs": 2471200,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "You simulate until you have the\nhighest quality and the highest output."
    } ]
  }, {
    "tStartMs": 2474880,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "And only then\nand only then you start the production."
    } ]
  }, {
    "tStartMs": 2480560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Siemens technology accelerates"
    } ]
  }, {
    "tStartMs": 2482880,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "all steps from discovery to manufacturing."
    } ]
  }, {
    "tStartMs": 2487120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Life saving therapies can"
    } ]
  }, {
    "tStartMs": 2488320,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "make it to the market\nas much as 50% faster,"
    } ]
  }, {
    "tStartMs": 2493200,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "and at every stage, AI speeds things up."
    } ]
  }, {
    "tStartMs": 2499040,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "This requires powerful\nAI infrastructure too."
    } ]
  }, {
    "tStartMs": 2505040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The GPUs used in the AI factories"
    } ]
  }, {
    "tStartMs": 2507360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "I talked about with Jensen,\nbut also the cloud infrastructure"
    } ]
  }, {
    "tStartMs": 2511280,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "we get from partners like Microsoft"
    } ]
  }, {
    "tStartMs": 2515760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "on that."
    } ]
  }, {
    "tStartMs": 2517200,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Let's hear from my friend Satya Nadella."
    } ]
  }, {
    "tStartMs": 2522160,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Thanks so much, Roland."
    } ]
  }, {
    "tStartMs": 2523520,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It's fantastic to join all of you\nat CES."
    } ]
  }, {
    "tStartMs": 2526960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "In the industrial sector"
    } ]
  }, {
    "tStartMs": 2528480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "we have an incredible opportunity\nto bring together"
    } ]
  }, {
    "tStartMs": 2531600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "digital intelligence\nwith physical operations,"
    } ]
  }, {
    "tStartMs": 2534880,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "to reinvent things that are designed,\nbuilt and run in this era of AI."
    } ]
  }, {
    "tStartMs": 2539760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And we're already seeing the industrial\nAI drive"
    } ]
  }, {
    "tStartMs": 2542320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "better outcomes in both productivity\nas well as in safety."
    } ]
  }, {
    "tStartMs": 2545920,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "That's why our partnership with Siemens\nis so important to us at Microsoft."
    } ]
  }, {
    "tStartMs": 2550400,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "By combining your deep domain expertise\nwith our trusted cloud"
    } ]
  }, {
    "tStartMs": 2555280,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "and AI capabilities,"
    } ]
  }, {
    "tStartMs": 2556560,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "we are helping our customers tackle\nsome of today's most pressing challenges,"
    } ]
  }, {
    "tStartMs": 2561120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "from sustainable energy and transportation\nto smart cities and precision medicine."
    } ]
  }, {
    "tStartMs": 2565840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I'm especially excited\nabout the core engineering work"
    } ]
  }, {
    "tStartMs": 2568720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "our teams are driving to build custom\nmodels and agents"
    } ]
  }, {
    "tStartMs": 2572240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that get trained with real world\nindustrial data."
    } ]
  }, {
    "tStartMs": 2575200,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And of course, we're just getting started."
    } ]
  }, {
    "tStartMs": 2577520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "I could not be more optimistic about what\nwe do together and achieve together."
    } ]
  }, {
    "tStartMs": 2581680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Thank you all so very much."
    } ]
  }, {
    "tStartMs": 2583760,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Thank you Satya."
    } ]
  }, {
    "tStartMs": 2587920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So, custom"
    } ]
  }, {
    "tStartMs": 2590080,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "models, agents and of course Copilots."
    } ]
  }, {
    "tStartMs": 2593680,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "Let's talk more about it with Jay Parikh."
    } ]
  }, {
    "tStartMs": 2608240,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Hi"
    } ]
  }, {
    "tStartMs": 2608880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Nice seeing you"
    } ]
  }, {
    "tStartMs": 2611280,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "So Jay, you are leading Microsoft's core\nAI team."
    } ]
  }, {
    "tStartMs": 2615680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "You put all AI experts together"
    } ]
  }, {
    "tStartMs": 2617760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "which tells me again"
    } ]
  }, {
    "tStartMs": 2619200,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "this is a foundational technology\nwith skills across the whole company."
    } ]
  }, {
    "tStartMs": 2623440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So, where are you\nin the step of really making this AI,"
    } ]
  }, {
    "tStartMs": 2627440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "journey creating impact for your customers?"
    } ]
  }, {
    "tStartMs": 2630880,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Yeah. Well, first of all,\nthank you for the partnership."
    } ]
  }, {
    "tStartMs": 2633360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Excited about what we're working on today\nand also going forward."
    } ]
  }, {
    "tStartMs": 2637440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "So as what we're seeing"
    } ]
  }, {
    "tStartMs": 2638480,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "today is really three waves\nwith more waves coming in terms of AI,"
    } ]
  }, {
    "tStartMs": 2643040,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "the first wave was really folks\nusing AI as a chat bot, right?"
    } ]
  }, {
    "tStartMs": 2647840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Ask it simple questions,\nmaybe do code completions."
    } ]
  }, {
    "tStartMs": 2651040,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "The second wave is much more focused\non delegating a specific task to AI,"
    } ]
  }, {
    "tStartMs": 2656720,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "may be giving it a task to do\nand come up with a market strategy,"
    } ]
  }, {
    "tStartMs": 2660800,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "document, or proposal to do these longer\nrunning, kind of more sophisticated tasks."
    } ]
  }, {
    "tStartMs": 2666080,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Now, what we're seeing emerging\nin this third wave is this set of agents"
    } ]
  }, {
    "tStartMs": 2671120,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "working with and orchestrating\na set of different agents"
    } ]
  }, {
    "tStartMs": 2674880,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "to be able to do asynchronous work,\nbut much more complicated work, right?"
    } ]
  }, {
    "tStartMs": 2679680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Longer running tasks."
    } ]
  }, {
    "tStartMs": 2681360,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "And it is this third wave\nthat we're focused on building"
    } ]
  }, {
    "tStartMs": 2685920,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "because you need multiple models."
    } ]
  }, {
    "tStartMs": 2687840,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You need to be able\nto train your own models, right?"
    } ]
  }, {
    "tStartMs": 2689840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You need to be able\nto bring in your enterprise data."
    } ]
  }, {
    "tStartMs": 2692240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You need to be able\nto orchestrate these agents,"
    } ]
  }, {
    "tStartMs": 2694640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "but you also need to do it with security,\nwith observability,"
    } ]
  }, {
    "tStartMs": 2698720,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "with compliance\nwith all of that scale, enterprise ready"
    } ]
  }, {
    "tStartMs": 2704320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "abstractions."
    } ]
  }, {
    "tStartMs": 2705360,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2705840,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And it is this area in this third wave\nthat I'm most excited"
    } ]
  }, {
    "tStartMs": 2709280,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "for us to be working together,\nbecause this third wave is how"
    } ]
  }, {
    "tStartMs": 2713360,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "we bring this technology\nto specific use cases and industries."
    } ]
  }, {
    "tStartMs": 2717680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But Roland, I'm\nreally curious is like this third wave,"
    } ]
  }, {
    "tStartMs": 2720560,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "how does this show up as you lead\nindustrials with AI?"
    } ]
  }, {
    "tStartMs": 2724480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "How is this manifesting\nwith your customers? And,"
    } ]
  }, {
    "tStartMs": 2727600,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I mean, there are many examples."
    } ]
  }, {
    "tStartMs": 2728960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I brought one, it's\njust a very exciting one."
    } ]
  }, {
    "tStartMs": 2732080,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "We talk about Rolls Royce\nthey do turbines for airplanes."
    } ]
  }, {
    "tStartMs": 2737440,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And I mean, obviously"
    } ]
  }, {
    "tStartMs": 2738560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "you want to have these turbines to to work\nhundred percent reliable."
    } ]
  }, {
    "tStartMs": 2742560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And of course fuel efficient."
    } ]
  }, {
    "tStartMs": 2745040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And within these turbines\nthey have alot of design parts coming,"
    } ]
  }, {
    "tStartMs": 2748880,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "these are designed with Siemens\nsoftware and technology from Microsoft."
    } ]
  }, {
    "tStartMs": 2753600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And there's a particular one\nwhich is a hydraulic pump."
    } ]
  }, {
    "tStartMs": 2756400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And that makes this machine turning."
    } ]
  }, {
    "tStartMs": 2759040,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So this pump has now\na digital twin of the pump itself,"
    } ]
  }, {
    "tStartMs": 2764080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "but it also is a digital twin\nof the machines machining it."
    } ]
  }, {
    "tStartMs": 2767600,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And we simulate the whole process."
    } ]
  }, {
    "tStartMs": 2770320,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "In programing it."
    } ]
  }, {
    "tStartMs": 2771440,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And we use your technologies together\nwith ours and simulated"
    } ]
  }, {
    "tStartMs": 2775520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "with amazing outcomes."
    } ]
  }, {
    "tStartMs": 2777360,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "These pumps are much stiffer and lighter."
    } ]
  }, {
    "tStartMs": 2780640,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "But we use Microsoft as well\nhere and AI technologies for."
    } ]
  }, {
    "tStartMs": 2784880,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Yeah.\nAnd excited about the other things"
    } ]
  }, {
    "tStartMs": 2786240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "that we're working on with these joint\nAI copilots."
    } ]
  }, {
    "tStartMs": 2789600,
    "dDurationMs": 160,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2789760,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "We're able to help\nreduce the programing time for can by 80%."
    } ]
  }, {
    "tStartMs": 2794800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Drove drove up\nproductivity in the factory by 30%."
    } ]
  }, {
    "tStartMs": 2798560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And then also excited\nto work with your team"
    } ]
  }, {
    "tStartMs": 2800720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "to bring the GitHub platform\nto all of the developers"
    } ]
  }, {
    "tStartMs": 2803920,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to drive that innovation,\nthat value for your customers faster."
    } ]
  }, {
    "tStartMs": 2808000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Again, all built together on Microsoft's\ncloud and AI."
    } ]
  }, {
    "tStartMs": 2812000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Exactly. And there are many more examples."
    } ]
  }, {
    "tStartMs": 2814640,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "The demand is huge."
    } ]
  }, {
    "tStartMs": 2815920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "And the benefits of"
    } ]
  }, {
    "tStartMs": 2817040,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "not only shortening the development time,\nbut also the production time is amazing."
    } ]
  }, {
    "tStartMs": 2823120,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "We talked about"
    } ]
  }, {
    "tStartMs": 2823760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "technology, but you cannot stop there."
    } ]
  }, {
    "tStartMs": 2826960,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And we know that you're very passionate\nabout also the the other part,"
    } ]
  }, {
    "tStartMs": 2830320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the cultural, the way how you transform\nthe you have seen the people."
    } ]
  }, {
    "tStartMs": 2834160,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "It's hard."
    } ]
  }, {
    "tStartMs": 2834640,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "It's it's hard."
    } ]
  }, {
    "tStartMs": 2835520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "I know\nthat's the let's talk about it. Yeah."
    } ]
  }, {
    "tStartMs": 2838400,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So you know, I spent probably"
    } ]
  }, {
    "tStartMs": 2841040,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "last year\ntalking to about 2 or 300 customers."
    } ]
  }, {
    "tStartMs": 2844320,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And it was fascinating because somewhere\nbetween probably 70 and 80%"
    } ]
  }, {
    "tStartMs": 2848080,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "of my conversations with customers\nstarted or ended or was dominated"
    } ]
  }, {
    "tStartMs": 2853280,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "by this topic of change, about culture,\nabout people, about organizations."
    } ]
  }, {
    "tStartMs": 2858080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And it was such\nan interesting set of conversations."
    } ]
  }, {
    "tStartMs": 2860880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And my kind of three current takeaways\nfrom those conversations"
    } ]
  }, {
    "tStartMs": 2864240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "were, one is like, we're all learning\ntogether, and we're sharing openly"
    } ]
  }, {
    "tStartMs": 2867680,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "about what's happening in organizations,\nsmall startups to,"
    } ]
  }, {
    "tStartMs": 2871920,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "you know, companies that are much, much,\nmuch bigger multinational."
    } ]
  }, {
    "tStartMs": 2876000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So this culture of change is something\nthat we have to share"
    } ]
  }, {
    "tStartMs": 2878720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "openly and work together on."
    } ]
  }, {
    "tStartMs": 2880400,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The second thing that I noticed\nand comes up in conversations is actually"
    } ]
  }, {
    "tStartMs": 2884640,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "many of the employees."
    } ]
  }, {
    "tStartMs": 2885680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Many of the workers are using this\ntechnology in their personal lives, right?"
    } ]
  }, {
    "tStartMs": 2889520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "They're using it."
    } ]
  }, {
    "tStartMs": 2890480,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "They're actually really sophisticated with\nit for family, for personal growth, etc."
    } ]
  }, {
    "tStartMs": 2896320,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "but there are institutional headwinds\nto adopting it,"
    } ]
  }, {
    "tStartMs": 2900320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "using it inside the company,\nwhether it be compliance,"
    } ]
  }, {
    "tStartMs": 2903120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "whether it be risk,\nwhether it be security,"
    } ]
  }, {
    "tStartMs": 2905200,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "whether it be finance,\nwhether it be just misaligned incentives."
    } ]
  }, {
    "tStartMs": 2908800,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 2909520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And then so it is our job\nto try to work and try to unlock"
    } ]
  }, {
    "tStartMs": 2913040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "and this value of this creativity,\nthis collaboration."
    } ]
  }, {
    "tStartMs": 2916400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And then third thing that I always\nencourage folks to do is really"
    } ]
  }, {
    "tStartMs": 2919840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the potential intelligence\nof these models."
    } ]
  }, {
    "tStartMs": 2922880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The capabilities of the platforms\nthat we're building here at Microsoft"
    } ]
  }, {
    "tStartMs": 2926640,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "are so much more capable\nthan what we realized today."
    } ]
  }, {
    "tStartMs": 2930800,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "So my biggest encouragement to myself,\nto my teams,"
    } ]
  }, {
    "tStartMs": 2934960,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "to our partners, is to really raise\nour level of ambition, of what we can do"
    } ]
  }, {
    "tStartMs": 2939680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "with AI to drive the world forward\nand to deliver more impact."
    } ]
  }, {
    "tStartMs": 2943840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And I tell you\nI can say it from my perspective."
    } ]
  }, {
    "tStartMs": 2946400,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "We see a lot of this changes\nalso in working with you,"
    } ]
  }, {
    "tStartMs": 2949280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "working with our customers,\nbut also with you."
    } ]
  }, {
    "tStartMs": 2951120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "You come from a different environment,\nbut we bring that together"
    } ]
  }, {
    "tStartMs": 2953680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to our customers\nand they do appreciate it, I tell you."
    } ]
  }, {
    "tStartMs": 2956160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Thank you very much for doing that."
    } ]
  }, {
    "tStartMs": 2958000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And, this is just the start. Yes.\nThank you."
    } ]
  }, {
    "tStartMs": 2960640,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "Thank you for the partnership. Thank you."
    } ]
  }, {
    "tStartMs": 2967600,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "So more"
    } ]
  }, {
    "tStartMs": 2969040,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "powerful industrial copilots\nand now new Copilots."
    } ]
  }, {
    "tStartMs": 2973920,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Today at CES,\nwe are launching nine additional"
    } ]
  }, {
    "tStartMs": 2978080,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "AI powered Siemens Industrial Copilots."
    } ]
  }, {
    "tStartMs": 2982320,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "They bring intelligence\nalong the entire industrial value"
    } ]
  }, {
    "tStartMs": 2987040,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "chain, transforming\nhow we design, engineer and operate"
    } ]
  }, {
    "tStartMs": 2992320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and well to help everyone"
    } ]
  }, {
    "tStartMs": 2994880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "access this kind of technology\nmore easily."
    } ]
  }, {
    "tStartMs": 2997840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "We are now putting it"
    } ]
  }, {
    "tStartMs": 3000720,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "in the hands of our Shopfloor colleagues."
    } ]
  }, {
    "tStartMs": 3004560,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Or to be more precise,"
    } ]
  }, {
    "tStartMs": 3007520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "on their faces. Together with META."
    } ]
  }, {
    "tStartMs": 3011360,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "We are making Rayban META glasses\nfor industrial AI."
    } ]
  }, {
    "tStartMs": 3015680,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I actually we do not use the tinted ones."
    } ]
  }, {
    "tStartMs": 3019520,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "As you can imagine."
    } ]
  }, {
    "tStartMs": 3020480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Maybe if the sun is shining."
    } ]
  }, {
    "tStartMs": 3022320,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But, there are also, natural ones."
    } ]
  }, {
    "tStartMs": 3025520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And, they tell our colleagues to get\nreal time audio"
    } ]
  }, {
    "tStartMs": 3029440,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "guidance through the glasses, which button\nto press, which parameters to change."
    } ]
  }, {
    "tStartMs": 3034560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Let's take a look at one of our factories."
    } ]
  }, {
    "tStartMs": 3037600,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "where these glasses will turn colleagues\ninto connected experts"
    } ]
  }, {
    "tStartMs": 3041360,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "so they can have more impact\nin the real world."
    } ]
  }, {
    "tStartMs": 3045680,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Handsfree."
    } ]
  }, {
    "tStartMs": 3047440,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hi, I'm"
    } ]
  }, {
    "tStartMs": 3048240,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Sarah,\nI just started working at this factory."
    } ]
  }, {
    "tStartMs": 3052240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Honestly, there's a ton to learn."
    } ]
  }, {
    "tStartMs": 3054640,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It's great having AI from Siemens\nto help me get familiar with everything."
    } ]
  }, {
    "tStartMs": 3058960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Good morning Sarah."
    } ]
  }, {
    "tStartMs": 3060080,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Let's take a quick look at how\nthe last shift went and what's coming up."
    } ]
  }, {
    "tStartMs": 3064560,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Today,"
    } ]
  }, {
    "tStartMs": 3065280,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "you'll be operating the robotic\nassembly line."
    } ]
  }, {
    "tStartMs": 3070320,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "I've noticed an issue"
    } ]
  }, {
    "tStartMs": 3071360,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "with some sensors at cell four\nthat could lead to assembly faults later."
    } ]
  }, {
    "tStartMs": 3075760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "A reset now can prevent that."
    } ]
  }, {
    "tStartMs": 3079280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Should I guide you through the process?"
    } ]
  }, {
    "tStartMs": 3081600,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "What I love about my\nAI is how easy it is to use."
    } ]
  }, {
    "tStartMs": 3085200,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It brings together\nlive machine data, knowledge"
    } ]
  }, {
    "tStartMs": 3088160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "from my colleagues and all of our standard\noperating procedures,"
    } ]
  }, {
    "tStartMs": 3091760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and explains everything\nin a way that makes sense to me"
    } ]
  }, {
    "tStartMs": 3094960,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "at my pace,\nin my language, and now select restart"
    } ]
  }, {
    "tStartMs": 3100800,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "with AI from Siemens."
    } ]
  }, {
    "tStartMs": 3102560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "I can solve problems efficiently, quickly,"
    } ]
  }, {
    "tStartMs": 3106320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "confidently."
    } ]
  }, {
    "tStartMs": 3110880,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The first test show that colleagues"
    } ]
  }, {
    "tStartMs": 3112800,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "are more confident in their work,\nand they're also more productive."
    } ]
  }, {
    "tStartMs": 3117520,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That's impact in the real world."
    } ]
  }, {
    "tStartMs": 3119680,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "By scaling industrial AI."
    } ]
  }, {
    "tStartMs": 3125440,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But we're heading for another"
    } ]
  }, {
    "tStartMs": 3128000,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "huge bottleneck"
    } ]
  }, {
    "tStartMs": 3131040,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "power electric power"
    } ]
  }, {
    "tStartMs": 3134320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "AI factories and data require"
    } ]
  }, {
    "tStartMs": 3136560,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "gigawatts of electric power."
    } ]
  }, {
    "tStartMs": 3140480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Now, what if\nwhat if you had an energy source"
    } ]
  }, {
    "tStartMs": 3144720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "that was clean, safe, affordable,"
    } ]
  }, {
    "tStartMs": 3148240,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and practically limitless?"
    } ]
  }, {
    "tStartMs": 3151840,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "That's the promise of fusion power."
    } ]
  }, {
    "tStartMs": 3156080,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Which brings me to my next guest."
    } ]
  }, {
    "tStartMs": 3159280,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Commonwealth Fusion\nSystems is working on the world's"
    } ]
  }, {
    "tStartMs": 3162400,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "first commercially viable machine\nto make fusion real."
    } ]
  }, {
    "tStartMs": 3167600,
    "dDurationMs": 10640,
    "segs": [ {
      "utf8": "Please welcome Bob Mumgaard."
    } ]
  }, {
    "tStartMs": 3178240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Hello,\nHi, Bob"
    } ]
  }, {
    "tStartMs": 3180560,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "So, for the starters, what is fusion?"
    } ]
  }, {
    "tStartMs": 3185280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That's a good question. So?"
    } ]
  }, {
    "tStartMs": 3186720,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So fusion is the power of the universe."
    } ]
  }, {
    "tStartMs": 3188560,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's the power of the stars."
    } ]
  }, {
    "tStartMs": 3190240,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "And what we want to do"
    } ]
  }, {
    "tStartMs": 3191120,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "is build machines here on Earth\nthat create that power, that harness it."
    } ]
  }, {
    "tStartMs": 3195040,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And that would mean that we would go from\nan energy system that is about natural"
    } ]
  }, {
    "tStartMs": 3198960,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "resource consumption to an energy system\nthat's about technology."
    } ]
  }, {
    "tStartMs": 3203120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Can you build these machines?"
    } ]
  }, {
    "tStartMs": 3204720,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "How fast can you build them?\nHow well do they run?"
    } ]
  }, {
    "tStartMs": 3207200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "And we work on a type of machine"
    } ]
  }, {
    "tStartMs": 3208480,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "called a tokamak, basically a bottle\nthat holds a star inside of it."
    } ]
  }, {
    "tStartMs": 3213440,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So these are massive machines."
    } ]
  }, {
    "tStartMs": 3216400,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "And there are for decades\nresearchers, engineers trying to make it."
    } ]
  }, {
    "tStartMs": 3221760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So tell us why should it work now. Right."
    } ]
  }, {
    "tStartMs": 3224800,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So we're at CES\nwhere many of the technologies we see,"
    } ]
  }, {
    "tStartMs": 3228160,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "you know, were ideas\neven just five years ago."
    } ]
  }, {
    "tStartMs": 3232240,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But the technical stack\nthat has been developed from simulation"
    } ]
  }, {
    "tStartMs": 3235840,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "tools, from the physical understanding,\nhas enabled a lot of these technologies."
    } ]
  }, {
    "tStartMs": 3240400,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And fusion is no different."
    } ]
  }, {
    "tStartMs": 3241920,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "We have very large"
    } ]
  }, {
    "tStartMs": 3243040,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "simulations where we understand\nthe underlying physics of the process."
    } ]
  }, {
    "tStartMs": 3247520,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We can layer that\ninto manufacturing these machines"
    } ]
  }, {
    "tStartMs": 3251200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "that are complex, that perform\nthese very delicate procedures."
    } ]
  }, {
    "tStartMs": 3255600,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "And we can build all that up into a plant\nthat makes makes energy."
    } ]
  }, {
    "tStartMs": 3260000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "And that's that whole stacks\nenabling this entire industry."
    } ]
  }, {
    "tStartMs": 3264720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "So let's go a little bit deeper\ninto these challenges, because I mean,"
    } ]
  }, {
    "tStartMs": 3268000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "putting a complex machine together\nis obviously very complicated,"
    } ]
  }, {
    "tStartMs": 3271600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but you also have to produce it\nat the same time."
    } ]
  }, {
    "tStartMs": 3274160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So you have to design and manufacture\nand that's what you do."
    } ]
  }, {
    "tStartMs": 3277520,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Also with the software from Siemens."
    } ]
  }, {
    "tStartMs": 3279760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "So that that's right."
    } ]
  }, {
    "tStartMs": 3281360,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "This infusion,\nwe're developing an entire new industry."
    } ]
  }, {
    "tStartMs": 3284720,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "You can't just go and buy a fusion plant\nor a fusion part."
    } ]
  }, {
    "tStartMs": 3290000,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We actually have to take it from,"
    } ]
  }, {
    "tStartMs": 3292000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "you know, the first principles of\nhow do these magnets work?"
    } ]
  }, {
    "tStartMs": 3295440,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "How do you manufacture them in a factory\nthat can take new designs really quickly,"
    } ]
  }, {
    "tStartMs": 3299840,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "that can iterate really quickly,\nthey can compare test results,"
    } ]
  }, {
    "tStartMs": 3303600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the simulation tools\nand see where there's a mismatch."
    } ]
  }, {
    "tStartMs": 3306640,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "What we don't understand."
    } ]
  }, {
    "tStartMs": 3308000,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And this produces a huge amount of data."
    } ]
  }, {
    "tStartMs": 3310400,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It produces a huge amount of insight."
    } ]
  }, {
    "tStartMs": 3312800,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now how do you harness that."
    } ]
  }, {
    "tStartMs": 3314240,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And that's where we use Siemens technology\nfrom the design of the actual parts"
    } ]
  }, {
    "tStartMs": 3318560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to how the factory runs,\nto how the plant itself is controlling,"
    } ]
  }, {
    "tStartMs": 3322880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "you know, very large amounts of current\nand cooling to, you know, hold this star"
    } ]
  }, {
    "tStartMs": 3327360,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "inside of it. Right."
    } ]
  }, {
    "tStartMs": 3328480,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Actually, I was walking,\none of your plants where you built Spark,"
    } ]
  }, {
    "tStartMs": 3332960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "which is your first demonstrator,\nwhere you really create more energy"
    } ]
  }, {
    "tStartMs": 3336640,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "than you put in, which is make a viability\ncheck of your technology."
    } ]
  }, {
    "tStartMs": 3341680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And, and it's amazing what you do."
    } ]
  }, {
    "tStartMs": 3343840,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And, imagine that the next one\nis even two times bigger."
    } ]
  }, {
    "tStartMs": 3347280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It's hard to believe."
    } ]
  }, {
    "tStartMs": 3348480,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So tell me a little bit more\nabout how Siemens technology"
    } ]
  }, {
    "tStartMs": 3351600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "played in, in that in designing it."
    } ]
  }, {
    "tStartMs": 3354640,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And of course, in\nsupporting the manufacturing as well."
    } ]
  }, {
    "tStartMs": 3357600,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "Right."
    } ]
  }, {
    "tStartMs": 3357920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So we're building\na plant in Massachusetts."
    } ]
  }, {
    "tStartMs": 3360880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "There is a, machine\nthat will make more power out from fusion."
    } ]
  }, {
    "tStartMs": 3364000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "That takes the heat it up and to do that,\nSiemens was there from the beginning"
    } ]
  }, {
    "tStartMs": 3367520,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of how do we actually do the design work?"
    } ]
  }, {
    "tStartMs": 3370640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "They're there in the factory\nwith the PLCs that automate the factory."
    } ]
  }, {
    "tStartMs": 3373920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And this is the factory that, you know,\nhas engineers standing right"
    } ]
  }, {
    "tStartMs": 3377280,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "next to the equipment that's running,\nthat's being reconfigured all the time."
    } ]
  }, {
    "tStartMs": 3381360,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And then in the actual Spark facility,\nthe the brains that are actually running"
    } ]
  }, {
    "tStartMs": 3386480,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "all the different processes,\nit has to all come together"
    } ]
  }, {
    "tStartMs": 3389120,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to make the right conditions\nof a star inside of it."
    } ]
  }, {
    "tStartMs": 3392240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Those machines are our Siemens machines,\nand they're running,"
    } ]
  }, {
    "tStartMs": 3396400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "software that has been checked out"
    } ]
  }, {
    "tStartMs": 3398480,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and large computer\nsimulations accelerated by Nvidia,"
    } ]
  }, {
    "tStartMs": 3403360,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "computation and DeepMind."
    } ]
  }, {
    "tStartMs": 3404720,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "It's it's a very big, stack\nall the way from idea to a plant."
    } ]
  }, {
    "tStartMs": 3410080,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So now here comes the key question"
    } ]
  }, {
    "tStartMs": 3413920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "when we'll see\nwe will see real world impact."
    } ]
  }, {
    "tStartMs": 3416880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "When will that commercially be viable."
    } ]
  }, {
    "tStartMs": 3419440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So it's a great question."
    } ]
  }, {
    "tStartMs": 3421600,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "A question I always get."
    } ]
  }, {
    "tStartMs": 3422560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And the key part\nis that you can start to see things today."
    } ]
  }, {
    "tStartMs": 3425920,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So we have the plant in Massachusetts\nfactory running."
    } ]
  }, {
    "tStartMs": 3429520,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But the the Spark facility\nis being put together and in fact at CES"
    } ]
  }, {
    "tStartMs": 3433520,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "we have pieces of it\nthat we've brought and"
    } ]
  }, {
    "tStartMs": 3435200,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "there's Siemens booth. Go check them out."
    } ]
  }, {
    "tStartMs": 3437360,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "But we also announced yesterday\nthat we've put the first big magnet"
    } ]
  }, {
    "tStartMs": 3441520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "into place for Spark."
    } ]
  }, {
    "tStartMs": 3442880,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "So you can see it coming together."
    } ]
  }, {
    "tStartMs": 3445600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That's setting up for the next machine,\nwhich is going to be in Virginia."
    } ]
  }, {
    "tStartMs": 3449600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That's we call Arc."
    } ]
  }, {
    "tStartMs": 3450800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That's a commercial machine\nthat will make about 400MW"
    } ]
  }, {
    "tStartMs": 3454160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "of fusion power, electricity\nthat can power a data center."
    } ]
  }, {
    "tStartMs": 3458160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In fact, that Google has agreed to buy\nthe power from Arc."
    } ]
  }, {
    "tStartMs": 3461920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "That is getting started here soon."
    } ]
  }, {
    "tStartMs": 3463440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And so we can see out here\non this technical stack,"
    } ]
  }, {
    "tStartMs": 3466640,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "going from science all the way to energy,\nwe can see a new age of abundance."
    } ]
  }, {
    "tStartMs": 3472240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So, Bob, thank you very much."
    } ]
  }, {
    "tStartMs": 3473440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "We have a lot of customers counting on you"
    } ]
  }, {
    "tStartMs": 3475440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to make that work,\nand we are here to support."
    } ]
  }, {
    "tStartMs": 3477680,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "Thanks for the partnership."
    } ]
  }, {
    "tStartMs": 3479350,
    "dDurationMs": 5210,
    "segs": [ {
      "utf8": "Thank you.\nThank you."
    } ]
  }, {
    "tStartMs": 3484560,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Well, but"
    } ]
  }, {
    "tStartMs": 3485200,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "but even if we have abundant clean energy,\nthere's another huge bottleneck"
    } ]
  }, {
    "tStartMs": 3490880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "grid availability and grid stability."
    } ]
  }, {
    "tStartMs": 3495360,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Today, many electricity grids\nare on the verge of collapse,"
    } ]
  }, {
    "tStartMs": 3499680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and intermittent energy sources"
    } ]
  }, {
    "tStartMs": 3501840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "like solar wind\nare increasing the stress on our grids."
    } ]
  }, {
    "tStartMs": 3505840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We need to predict loads better\nand stabilize the grid,"
    } ]
  }, {
    "tStartMs": 3509200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and that's in real time."
    } ]
  }, {
    "tStartMs": 3511680,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Our industrially\nAI enabled technologies can do this"
    } ]
  }, {
    "tStartMs": 3515920,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "even for huge grids and autonomously."
    } ]
  }, {
    "tStartMs": 3520400,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "We can simulate the impact of adding\n10,000 electric vehicles"
    } ]
  }, {
    "tStartMs": 3523920,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "to the neighborhood."
    } ]
  }, {
    "tStartMs": 3525760,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Buildings all over\nthe city can act together and coordinate"
    } ]
  }, {
    "tStartMs": 3530240,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "energy consumption,\nso they could turn down their air"
    } ]
  }, {
    "tStartMs": 3533360,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "conditioning for just half a minute\nto help stabilizing the grid."
    } ]
  }, {
    "tStartMs": 3538240,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "And already today, we are using\nAI to maximize existing grid capacity"
    } ]
  }, {
    "tStartMs": 3544160,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "by 20% without new infrastructure."
    } ]
  }, {
    "tStartMs": 3549040,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "This is industrial AI creating impact"
    } ]
  }, {
    "tStartMs": 3553440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "in the real world."
    } ]
  }, {
    "tStartMs": 3557600,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "So what does this all mean for you?"
    } ]
  }, {
    "tStartMs": 3562080,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "No matter whether you design, engineer,"
    } ]
  }, {
    "tStartMs": 3565600,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "or operate or all of the the three,\nno matter"
    } ]
  }, {
    "tStartMs": 3569920,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "what you make food, cars,\nmedicine, energy,"
    } ]
  }, {
    "tStartMs": 3574640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "no matter what type of infrastructure"
    } ]
  }, {
    "tStartMs": 3576800,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "you manage, the water supply,"
    } ]
  }, {
    "tStartMs": 3579760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "a transportation system or a grid."
    } ]
  }, {
    "tStartMs": 3583120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "We have the technology,"
    } ]
  }, {
    "tStartMs": 3585360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "domain knowhow and the partners"
    } ]
  }, {
    "tStartMs": 3587920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to help you do what you do,"
    } ]
  }, {
    "tStartMs": 3591040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "but faster, more efficiently\nand more sustainably."
    } ]
  }, {
    "tStartMs": 3594880,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "By scaling industrial\nAI in the real world."
    } ]
  }, {
    "tStartMs": 3602320,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Electricity."
    } ]
  }, {
    "tStartMs": 3604880,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Today, for"
    } ]
  }, {
    "tStartMs": 3606320,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "those of us in this room\nbarely think about it."
    } ]
  }, {
    "tStartMs": 3610400,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Our lights turn on, our coffee machines\nrun, our computers charge."
    } ]
  }, {
    "tStartMs": 3614960,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Electricity is a fact of life."
    } ]
  }, {
    "tStartMs": 3619440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Soon industrial AI"
    } ]
  }, {
    "tStartMs": 3622320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "will become a fact of life."
    } ]
  }, {
    "tStartMs": 3626560,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "We will"
    } ]
  }, {
    "tStartMs": 3627040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "produce only what's needed, exactly"
    } ]
  }, {
    "tStartMs": 3629840,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "what's needed, where it's needed."
    } ]
  }, {
    "tStartMs": 3633360,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Equipment failures and outages\nwill be rare, unpredicted ones."
    } ]
  }, {
    "tStartMs": 3637040,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Even rarer"
    } ]
  }, {
    "tStartMs": 3639120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "medicine tailored to your unique biology"
    } ]
  }, {
    "tStartMs": 3642000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "will just be standard health care."
    } ]
  }, {
    "tStartMs": 3645440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Autonomous vehicles will move with 100%"
    } ]
  }, {
    "tStartMs": 3649040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "reliability and zero emissions,"
    } ]
  }, {
    "tStartMs": 3653040,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "and knowledge\nwill transfer through generations"
    } ]
  }, {
    "tStartMs": 3657600,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "as naturally as current through a wire."
    } ]
  }, {
    "tStartMs": 3662640,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Energy will flow cleanly,\nabundantly"
    } ]
  }, {
    "tStartMs": 3665840,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "to infrastructure\nthat repairs and optimizes itself"
    } ]
  }, {
    "tStartMs": 3670000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and serves a world so defined by AI"
    } ]
  }, {
    "tStartMs": 3673600,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "that we hardly notice it anymore."
    } ]
  }, {
    "tStartMs": 3678880,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "When a breakthrough"
    } ]
  }, {
    "tStartMs": 3679600,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "innovation becomes a real world essential"
    } ]
  }, {
    "tStartMs": 3683680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and a general purpose technology becomes"
    } ]
  }, {
    "tStartMs": 3686320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "the invisible fabric of our lives,"
    } ]
  }, {
    "tStartMs": 3690160,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that's\nwhen we will know that we have scaled"
    } ]
  }, {
    "tStartMs": 3693760,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "AI in the real world\nand realized its potentials."
    } ]
  }, {
    "tStartMs": 3698560,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "And together with our customers,\nwith our partners, with you,"
    } ]
  }, {
    "tStartMs": 3703760,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "transformed the everyday for everyone."
    } ]
  }, {
    "tStartMs": 3706880,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  } ]
}
