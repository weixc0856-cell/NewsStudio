  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 8000,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "Welcome to the CES stage, Roland. Have fun!"
    } ]
  }, {
    "tStartMs": 13680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I want you to think"
    } ]
  }, {
    "tStartMs": 15040,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "back to the time before electricity."
    } ]
  }, {
    "tStartMs": 19600,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "The world moved at the pace of people, but"
    } ]
  }, {
    "tStartMs": 24720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Horses stretched our distances."
    } ]
  }, {
    "tStartMs": 29200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Steam powered our machines"
    } ]
  }, {
    "tStartMs": 33280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and ideas moved only as fast as a letter"
    } ]
  }, {
    "tStartMs": 36960,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "or a human voice."
    } ]
  }, {
    "tStartMs": 41520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Then electricity arrived."
    } ]
  }, {
    "tStartMs": 45680,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "This general purpose technology"
    } ]
  }, {
    "tStartMs": 47280,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "became the foundation of modern life."
    } ]
  }, {
    "tStartMs": 51440,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It turned night into day,"
    } ]
  }, {
    "tStartMs": 53520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "amplified human capabilities,\nboosted productivity"
    } ]
  }, {
    "tStartMs": 57680,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "and powered progress\nthat once felt out of reach."
    } ]
  }, {
    "tStartMs": 63920,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "At Siemens, we brought this world to life."
    } ]
  }, {
    "tStartMs": 68960,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Pioneering telecommunications"
    } ]
  }, {
    "tStartMs": 71760,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and electric grids."
    } ]
  }, {
    "tStartMs": 74800,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Developing the machines that accelerated\nmass production,"
    } ]
  }, {
    "tStartMs": 78960,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "moving people and goods\nvia electric trains."
    } ]
  }, {
    "tStartMs": 83280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Scaling the benefits of electricity"
    } ]
  }, {
    "tStartMs": 86320,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "all around the world."
    } ]
  }, {
    "tStartMs": 89760,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Fast forward"
    } ]
  }, {
    "tStartMs": 91840,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "one and a half centuries later,\nanother general purpose."
    } ]
  }, {
    "tStartMs": 95200,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "technology has arrived,\nand this time it's not about energy."
    } ]
  }, {
    "tStartMs": 100880,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's about intelligence."
    } ]
  }, {
    "tStartMs": 104000,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Artificial Intelligence"
    } ]
  }, {
    "tStartMs": 106080,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "will be as transformative for this century"
    } ]
  }, {
    "tStartMs": 108720,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "as electricity was for the last."
    } ]
  }, {
    "tStartMs": 112960,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It's redefining how we design\nand manufacture products."
    } ]
  }, {
    "tStartMs": 116480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "From the phones in your hands to the cars\nyou drive."
    } ]
  }, {
    "tStartMs": 121040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It's revolutionizing\nhow we build and operate infrastructure"
    } ]
  }, {
    "tStartMs": 124880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "including buildings just like this one."
    } ]
  }, {
    "tStartMs": 128240,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And it's allowing us to make entire"
    } ]
  }, {
    "tStartMs": 130480,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "systems, grids,\ncities, economies more adaptive"
    } ]
  }, {
    "tStartMs": 135360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and more efficient."
    } ]
  }, {
    "tStartMs": 139360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "A century ago,"
    } ]
  }, {
    "tStartMs": 140800,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Siemens helped build the world\nin the light of electricity."
    } ]
  }, {
    "tStartMs": 145840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Now we get to do it again"
    } ]
  }, {
    "tStartMs": 148880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "in the age of intelligence."
    } ]
  }, {
    "tStartMs": 152080,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "We are powering the industrial\nAI revolution."
    } ]
  }, {
    "tStartMs": 157120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It has already begun, and it's picking up"
    } ]
  }, {
    "tStartMs": 159600,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "steam faster than steam ever did."
    } ]
  }, {
    "tStartMs": 162880,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "In fact,\nsteam took 60 years to transform society."
    } ]
  }, {
    "tStartMs": 167920,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Electricity."
    } ]
  }, {
    "tStartMs": 168880,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "30 computers, 15 for AI."
    } ]
  }, {
    "tStartMs": 172160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "We're looking at seven years\nor less before"
    } ]
  }, {
    "tStartMs": 175920,
    "dDurationMs": 7120,
    "segs": [ {
      "utf8": "intelligence is embedded\nin the system we rely on every day."
    } ]
  }, {
    "tStartMs": 183040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And that changes something"
    } ]
  }, {
    "tStartMs": 185360,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "fundamentally, because when an AI"
    } ]
  }, {
    "tStartMs": 189680,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "enters a physical system,"
    } ]
  }, {
    "tStartMs": 192320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "it stops being a feature."
    } ]
  }, {
    "tStartMs": 195120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "It becomes a force."
    } ]
  }, {
    "tStartMs": 196720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "A force with direct real world impact."
    } ]
  }, {
    "tStartMs": 200240,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "A force that transforms\nhow we design and build, how factories"
    } ]
  }, {
    "tStartMs": 205600,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "produce, how infrastructure operates,\nhow the world powers itself."
    } ]
  }, {
    "tStartMs": 211520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Now,"
    } ]
  }, {
    "tStartMs": 213520,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "how do we do it?"
    } ]
  }, {
    "tStartMs": 215120,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "How can we make this happen?"
    } ]
  }, {
    "tStartMs": 217440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "How can we do all of this\nat speed and scale"
    } ]
  }, {
    "tStartMs": 221600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "and at the same time, in a way"
    } ]
  }, {
    "tStartMs": 223840,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "that it's reliable and safe"
    } ]
  }, {
    "tStartMs": 227360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and hallucination is not acceptable."
    } ]
  }, {
    "tStartMs": 230480,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "when AI is deployed\nin the industrial world."
    } ]
  }, {
    "tStartMs": 234880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Today we are making it easy for you\nto scale industrial"
    } ]
  }, {
    "tStartMs": 238720,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "AI in the real world systems\nto create real world impact."
    } ]
  }, {
    "tStartMs": 243920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "We are bringing together\nAI powered technologies,"
    } ]
  }, {
    "tStartMs": 248320,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "industrial domain know how\nand the right partners."
    } ]
  }, {
    "tStartMs": 254160,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And the whole thing is connected"
    } ]
  }, {
    "tStartMs": 256000,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "by data, valuable industrial data"
    } ]
  }, {
    "tStartMs": 260560,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and all in one place."
    } ]
  }, {
    "tStartMs": 262320,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "In our Siemens Xcelerator marketplace."
    } ]
  }, {
    "tStartMs": 266240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So let's have a look at these elements\none by one."
    } ]
  }, {
    "tStartMs": 269680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And let's start\nfirst with the right technologies."
    } ]
  }, {
    "tStartMs": 272880,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "It is about software hardware compute"
    } ]
  }, {
    "tStartMs": 278400,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "highly performant compute with GPUs."
    } ]
  }, {
    "tStartMs": 281920,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "And of course it is about data."
    } ]
  }, {
    "tStartMs": 286320,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Here comes the good news."
    } ]
  }, {
    "tStartMs": 288000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Many companies have already"
    } ]
  }, {
    "tStartMs": 290560,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "some important elements in place,"
    } ]
  }, {
    "tStartMs": 293280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "but this does not make them AI ready yet."
    } ]
  }, {
    "tStartMs": 297120,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Digital twins can simulate\nand software can solve problems,"
    } ]
  }, {
    "tStartMs": 301280,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "but they do not recommend\nwhat to do next in the real world."
    } ]
  }, {
    "tStartMs": 307120,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "Compute is CPU based with AI"
    } ]
  }, {
    "tStartMs": 312800,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "needs\nGPUs to deploy its full power and speed,"
    } ]
  }, {
    "tStartMs": 317600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "and too often data is fragmented,"
    } ]
  }, {
    "tStartMs": 320160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "trapped in silos and unused."
    } ]
  }, {
    "tStartMs": 323360,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "That's why it is so important\nto have an end to end"
    } ]
  }, {
    "tStartMs": 328320,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "AI industrial stack\nto make impact in the real world."
    } ]
  }, {
    "tStartMs": 333520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And at Siemens, we are able to build this"
    } ]
  }, {
    "tStartMs": 337040,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "because we have been working with\nAI for industry for more than 50 years."
    } ]
  }, {
    "tStartMs": 342960,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Today, Siemens has"
    } ]
  }, {
    "tStartMs": 344400,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "more than 1,500 AI experts,\nand all our engineers"
    } ]
  }, {
    "tStartMs": 348240,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "live in both worlds in the digital\nand in the real world."
    } ]
  }, {
    "tStartMs": 353200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And all our colleagues, over\n250,000 of them,"
    } ]
  }, {
    "tStartMs": 357280,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "bring deep domain knowhow in our 30"
    } ]
  }, {
    "tStartMs": 361120,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "industrial verticals."
    } ]
  }, {
    "tStartMs": 364320,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And that's because for decades,\nSiemens has been helping"
    } ]
  }, {
    "tStartMs": 367840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "customers in the United States\nand all over the world"
    } ]
  }, {
    "tStartMs": 371120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to automate manufacturing,\nto run railway networks,"
    } ]
  }, {
    "tStartMs": 375200,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "to design and operate grids, or"
    } ]
  }, {
    "tStartMs": 378000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to operate buildings more efficiently."
    } ]
  }, {
    "tStartMs": 380960,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In fact, today, in one out of three"
    } ]
  }, {
    "tStartMs": 384720,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "manufacturing machines worldwide"
    } ]
  }, {
    "tStartMs": 387920,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "runs a Siemens controller."
    } ]
  }, {
    "tStartMs": 391360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "With our software, you can build"
    } ]
  }, {
    "tStartMs": 393200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "the most comprehensive\ndigital twin of products"
    } ]
  }, {
    "tStartMs": 396240,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and the cost\nof a whole manufacturing site."
    } ]
  }, {
    "tStartMs": 399920,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "And now we are adding AI"
    } ]
  }, {
    "tStartMs": 405520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Decades of experience\nin software, hardware and AI"
    } ]
  }, {
    "tStartMs": 409360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And this experience means"
    } ]
  }, {
    "tStartMs": 412160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "we have the domain know how to identify"
    } ]
  }, {
    "tStartMs": 414880,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "which data matter and how to cluster it."
    } ]
  }, {
    "tStartMs": 419120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Which AI applications make"
    } ]
  }, {
    "tStartMs": 421040,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "sense and which decisions should be left\nto humans."
    } ]
  }, {
    "tStartMs": 426240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And finally."
    } ]
  }, {
    "tStartMs": 428960,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Our partners"
    } ]
  }, {
    "tStartMs": 430640,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "for industrial\nAI to make use of all of this"
    } ]
  }, {
    "tStartMs": 433600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "industrial design,\nmanufacturing and operating data."
    } ]
  }, {
    "tStartMs": 436720,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "You need a huge amount of compute."
    } ]
  }, {
    "tStartMs": 439960,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Gigantic centralized AI factories"
    } ]
  }, {
    "tStartMs": 443760,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "that are run by our partners\nlike AWS or Microsoft,"
    } ]
  }, {
    "tStartMs": 448720,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "but also at the edge,\nvery close to your machines,"
    } ]
  }, {
    "tStartMs": 454320,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "to your infrastructure."
    } ]
  }, {
    "tStartMs": 457280,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "With this massive GPU"
    } ]
  }, {
    "tStartMs": 458800,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "process powered compute"
    } ]
  }, {
    "tStartMs": 462240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "digital twins no longer explore"
    } ]
  }, {
    "tStartMs": 464960,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "just thousands of options,\nbut hundreds of thousands of them."
    } ]
  }, {
    "tStartMs": 469840,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Complex industrial foundation\nmodels can get trained"
    } ]
  }, {
    "tStartMs": 474560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "on unprecedented\namounts of industrial data."
    } ]
  }, {
    "tStartMs": 478000,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And a digital twin\ncan control a whole plant"
    } ]
  }, {
    "tStartMs": 481440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "in real time."
    } ]
  }, {
    "tStartMs": 483920,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "When these things come together,\nthe right technologies,"
    } ]
  }, {
    "tStartMs": 488400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "industry domain knowhow,\nand the right partners."
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "That's when we stop just reporting issues\nand start anticipating them."
    } ]
  }, {
    "tStartMs": 496960,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "That's when humans stop reacting to errors\nbecause machines"
    } ]
  }, {
    "tStartMs": 500720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "have started to act\nand adjust autonomously."
    } ]
  }, {
    "tStartMs": 504240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "That's when companies can turn ideas"
    } ]
  }, {
    "tStartMs": 507440,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "into real world\nimpact with speed, quality and efficiency."
    } ]
  }, {
    "tStartMs": 513920,
    "dDurationMs": 6960,
    "segs": [ {
      "utf8": "It's the industrial AI revolution."
    } ]
  }, {
    "tStartMs": 520880,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Now, I mentioned"
    } ]
  }, {
    "tStartMs": 522480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "partners,\nthe right partners, the best partners."
    } ]
  }, {
    "tStartMs": 525920,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "And including\na very special friend of mine."
    } ]
  }, {
    "tStartMs": 530640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And we hit it off immediately."
    } ]
  }, {
    "tStartMs": 533280,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "He has a visionary engineering mindset."
    } ]
  }, {
    "tStartMs": 536720,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "He thinks through problems\nfrom first principles."
    } ]
  }, {
    "tStartMs": 541120,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "He anticipates the next development\nstep of AI technology."
    } ]
  }, {
    "tStartMs": 546400,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And he has both bold vision"
    } ]
  }, {
    "tStartMs": 549760,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and the ability to make things happen."
    } ]
  }, {
    "tStartMs": 554000,
    "dDurationMs": 3935,
    "segs": [ {
      "utf8": "Please welcome Jensen Huang."
    } ]
  }, {
    "tStartMs": 568384,
    "dDurationMs": 2809,
    "segs": [ {
      "utf8": "Roland!\nHappy new year!"
    } ]
  }, {
    "tStartMs": 571386,
    "dDurationMs": 4808,
    "segs": [ {
      "utf8": "Happy new year! Happy new year!\nPlease"
    } ]
  }, {
    "tStartMs": 580000,
    "dDurationMs": 3855,
    "segs": [ {
      "utf8": "200 years old.\nYou've seen a few of these"
    } ]
  }, {
    "tStartMs": 583855,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Industrial revolutions."
    } ]
  }, {
    "tStartMs": 585280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We are not quite 200 years,\nbut we are heading for 175."
    } ]
  }, {
    "tStartMs": 588640,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Exactly, exactly."
    } ]
  }, {
    "tStartMs": 590240,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And we came a long way\nwith our partnership too, right?"
    } ]
  }, {
    "tStartMs": 593200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I mean, we kicked it off\na couple of years ago."
    } ]
  }, {
    "tStartMs": 596240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I remember that very well."
    } ]
  }, {
    "tStartMs": 597920,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Have the same vision, industrial\nAI operating system"
    } ]
  }, {
    "tStartMs": 600800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "that we want to build, huge opportunities\nfor our customers."
    } ]
  }, {
    "tStartMs": 604320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So what's with you?"
    } ]
  }, {
    "tStartMs": 606240,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Where are we on this journey?"
    } ]
  }, {
    "tStartMs": 607360,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You know? Yeah,\nit's it's an incredible thing."
    } ]
  }, {
    "tStartMs": 609360,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "So we, we did a press conference at Siemens\nheadquarters in Munich."
    } ]
  }, {
    "tStartMs": 615280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "How many? Yeah.\nHow many years ago was that?"
    } ]
  }, {
    "tStartMs": 617440,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "2022."
    } ]
  }, {
    "tStartMs": 618240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "It was only 2022. Okay."
    } ]
  }, {
    "tStartMs": 619760,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Yeah, it was three years ago."
    } ]
  }, {
    "tStartMs": 621440,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And we spoke about this moment in fact."
    } ]
  }, {
    "tStartMs": 624480,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And Siemens is is unquestionably\nat the foundation"
    } ]
  }, {
    "tStartMs": 628400,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "of every industry that we participate\nin, that the world builds on."
    } ]
  }, {
    "tStartMs": 634160,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "And, we had a vision that that, Siemens\nand this was your vision"
    } ]
  }, {
    "tStartMs": 639440,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "to turn Siemens into a software\ndefined company in a lot of ways,"
    } ]
  }, {
    "tStartMs": 643680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "described it in a way\nvery similar to a computer company."
    } ]
  }, {
    "tStartMs": 647040,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And it would\nit would, of course, have the underlying"
    } ]
  }, {
    "tStartMs": 650560,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "infrastructure of computing,\nbut mostly on top,"
    } ]
  }, {
    "tStartMs": 653760,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "your infrastructure software,\nartificial intelligence."
    } ]
  }, {
    "tStartMs": 656880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And it's going to revolutionize\nthe way things are designed,"
    } ]
  }, {
    "tStartMs": 660240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "simulated, planned and operated."
    } ]
  }, {
    "tStartMs": 663680,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "And that was the vision you described."
    } ]
  }, {
    "tStartMs": 665680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And we spoke about three years ago."
    } ]
  }, {
    "tStartMs": 667920,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "And here we are."
    } ]
  }, {
    "tStartMs": 668880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You know, here\nwe are at the beginning of that journey."
    } ]
  }, {
    "tStartMs": 671680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And, all the pieces are now finally coming\ntogether."
    } ]
  }, {
    "tStartMs": 674400,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "It seems to."
    } ]
  }, {
    "tStartMs": 675440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And talking about what you achieved."
    } ]
  }, {
    "tStartMs": 677200,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "I brought an example, you know, that \nHD Hyundai. I mean, they built ships."
    } ]
  }, {
    "tStartMs": 682480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "huge ships, and and shipyards, by the way."
    } ]
  }, {
    "tStartMs": 686080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And they use our technology."
    } ]
  }, {
    "tStartMs": 688160,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 688480,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "You're sitting on Nvidia."
    } ]
  }, {
    "tStartMs": 689600,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "This is a digital twin of an entire ship."
    } ]
  }, {
    "tStartMs": 691760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Every nut and bolt is in\nthere is incredible."
    } ]
  }, {
    "tStartMs": 695280,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "I mean, this is the full CAD of the ship\nvisiting the pavilion."
    } ]
  }, {
    "tStartMs": 699360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Precise digital twin."
    } ]
  }, {
    "tStartMs": 701600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And, and you see also the the\nthe people working on the ships."
    } ]
  }, {
    "tStartMs": 704960,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "You simulate everything."
    } ]
  }, {
    "tStartMs": 705840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "By the way,\nthese ships are they look alike."
    } ]
  }, {
    "tStartMs": 708400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So the body is the same,\nbut each of them is individual."
    } ]
  }, {
    "tStartMs": 712000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So you really have to be very, very clear\nhow you design that you optimize"
    } ]
  }, {
    "tStartMs": 715200,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "in the digital world\nand then you build it, for that."
    } ]
  }, {
    "tStartMs": 719360,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And that's\nwhere our whole stack comes together."
    } ]
  }, {
    "tStartMs": 721680,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Complimentary technology."
    } ]
  }, {
    "tStartMs": 723360,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "And for the photorealistic, representation\nwe use Omniverse."
    } ]
  }, {
    "tStartMs": 727720,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "And this was really quite a perfect. Yeah."
    } ]
  }, {
    "tStartMs": 730080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "This is quite a perfect example\nof the type of work that we do together"
    } ]
  }, {
    "tStartMs": 734000,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "in this realization\nof this digital twin idea"
    } ]
  }, {
    "tStartMs": 738080,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "that you would design,\nevery aspect of engineering."
    } ]
  }, {
    "tStartMs": 741360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It's not just the not just the CAD,\nbut the computing,"
    } ]
  }, {
    "tStartMs": 744960,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "the electronics,\nall of it would be integrated and then and"
    } ]
  }, {
    "tStartMs": 750160,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "built into a digital twin,"
    } ]
  }, {
    "tStartMs": 752320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "it would, of course, run\nall of the software in the digital twin."
    } ]
  }, {
    "tStartMs": 755920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And in the future, I hope that's the ship."
    } ]
  }, {
    "tStartMs": 759280,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The digital twin of a ship\nwill actually put it in the ocean,"
    } ]
  }, {
    "tStartMs": 763680,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "a virtual simulation of the ocean\nand see it completely operate."
    } ]
  }, {
    "tStartMs": 767680,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "Exactly. Yeah."
    } ]
  }, {
    "tStartMs": 768560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And you have only one option\nto get it onto water."
    } ]
  }, {
    "tStartMs": 771360,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "If then you have a problem,\nby the way. So."
    } ]
  }, {
    "tStartMs": 774240,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Well, we talked about bringing\nour partners up to the next level."
    } ]
  }, {
    "tStartMs": 779280,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And, the whole idea is obviously to take\nthese examples and scale them even faster."
    } ]
  }, {
    "tStartMs": 784400,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And of course, to make it AI enabled, I'm"
    } ]
  }, {
    "tStartMs": 787840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "talking about industrially,\nI would really it's the real world."
    } ]
  }, {
    "tStartMs": 791840,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And we picked five areas of collaboration\nwhere we want to intensify."
    } ]
  }, {
    "tStartMs": 795600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And, and that's,\ngood news for our customers too, I guess."
    } ]
  }, {
    "tStartMs": 798960,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Let me start with the first one."
    } ]
  }, {
    "tStartMs": 800080,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Take them off one by one."
    } ]
  }, {
    "tStartMs": 801600,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The first one is AI native chip design."
    } ]
  }, {
    "tStartMs": 805440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So, if it comes to chip design,\nI don't need to tell you something."
    } ]
  }, {
    "tStartMs": 808560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Obviously,\nyou're with each next generation."
    } ]
  }, {
    "tStartMs": 811120,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You're getting closer\nto the physical limits."
    } ]
  }, {
    "tStartMs": 813920,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So tell me what what the challenges are\nand what can we do."
    } ]
  }, {
    "tStartMs": 816720,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Well, let's use let's use,"
    } ]
  }, {
    "tStartMs": 818160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "our latest generation that we just\nannounced yesterday as an example,"
    } ]
  }, {
    "tStartMs": 822000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Vera Rubin, Vera Rubin,\nin order to build the latest generation"
    } ]
  }, {
    "tStartMs": 826000,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "GPU, people think that our GPU is a chip."
    } ]
  }, {
    "tStartMs": 828960,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "It is a chip."
    } ]
  }, {
    "tStartMs": 829920,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "It consists of a chip,\nbut ultimately, in order for these"
    } ]
  }, {
    "tStartMs": 833600,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "GPUs to scale up to process the level of\nAI that's necessary at the frontier,"
    } ]
  }, {
    "tStartMs": 838640,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "these GPUs are essentially one giant rack,\nand this entire rack is,"
    } ]
  }, {
    "tStartMs": 844240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in the case of Vera Rubin, 240kW."
    } ]
  }, {
    "tStartMs": 848640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "It consists of altogether\n220 trillion transistors."
    } ]
  }, {
    "tStartMs": 853040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "We had to design six different\nunique chips"
    } ]
  }, {
    "tStartMs": 856400,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "CPU, GPU, networking,\nmultiple types of networking switches."
    } ]
  }, {
    "tStartMs": 860880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "One is for scale up, one is for scale out,"
    } ]
  }, {
    "tStartMs": 864080,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "and a smart"
    } ]
  }, {
    "tStartMs": 864880,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "net and a data processor for storage\nall for AI memory basically."
    } ]
  }, {
    "tStartMs": 869680,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "All of this stuff came together\nis 220 trillion"
    } ]
  }, {
    "tStartMs": 872960,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "transistors, is two tons and"
    } ]
  }, {
    "tStartMs": 877440,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "150,000 engineering years came together"
    } ]
  }, {
    "tStartMs": 880160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "to build this one system\nthat we announced yesterday."
    } ]
  }, {
    "tStartMs": 883600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And in order to do this perfectly\nat a rhythm"
    } ]
  }, {
    "tStartMs": 886160,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "that our company runs at the level of chip\ndesign,"
    } ]
  }, {
    "tStartMs": 890960,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "system design, system integration,\nthermals, electricals, all of that."
    } ]
  }, {
    "tStartMs": 896000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "In a lot of ways,\nour GPUs, it's a little bit like that"
    } ]
  }, {
    "tStartMs": 899360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "HD Hyundai ship\nand, and what we are hoping for"
    } ]
  }, {
    "tStartMs": 903360,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "and the reason why we're partnering\nso closely together is so that we could"
    } ]
  }, {
    "tStartMs": 908400,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "build that Vera Rubin in the future\nas a digital twin,"
    } ]
  }, {
    "tStartMs": 912560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "the entire system as a digital twin,\nnot just the chips,"
    } ]
  }, {
    "tStartMs": 916000,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but the systems, the chips,\neverything together, cooling thermals"
    } ]
  }, {
    "tStartMs": 919600,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "and run the thermal simulation directly\nthrough it as it is a digital twin."
    } ]
  }, {
    "tStartMs": 924560,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And that's our that's our vision."
    } ]
  }, {
    "tStartMs": 925920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And so we're accelerating the first part\nof our project together."
    } ]
  }, {
    "tStartMs": 929760,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Our partnership is to accelerate\nwith Siemens EDA,"
    } ]
  }, {
    "tStartMs": 934160,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Siemens Simcenter accelerate\neverything we can with GPUs."
    } ]
  }, {
    "tStartMs": 938640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And this way we could scale up\nthe simulations that we do"
    } ]
  }, {
    "tStartMs": 942240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and achieve the virtual digital twin\nthat we hope for."
    } ]
  }, {
    "tStartMs": 945280,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So and, what are we going to do\nis we will use, your CUDA software"
    } ]
  }, {
    "tStartMs": 949520,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "to, we will rewrite our EDA software\nso it can take advantage of GPUs."
    } ]
  }, {
    "tStartMs": 954000,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 954400,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "So working with GPUs\nand designing GPUs."
    } ]
  }, {
    "tStartMs": 957200,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Imagine EDA software"
    } ]
