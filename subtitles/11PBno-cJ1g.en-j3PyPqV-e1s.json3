  }, {
    "tStartMs": 4872330,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "in minutes instead of months."
    } ]
  }, {
    "tStartMs": 4875090,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Gemini Enterprise for\nCustomer Experience"
    } ]
  }, {
    "tStartMs": 4877850,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "is hard at work across many\nindustries and enterprises."
