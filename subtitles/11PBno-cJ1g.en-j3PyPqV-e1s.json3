  }, {
    "tStartMs": 1655490,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "working on that Jira ticket."
    } ]
  }, {
    "tStartMs": 1657410,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "It's going to give me an\noverview of the strategy,"
