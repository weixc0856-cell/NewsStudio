  }, {
    "tStartMs": 1874060,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "in just the first month."
    } ]
  }, {
    "tStartMs": 1877260,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The American Society\nfor Clinical Oncology"
