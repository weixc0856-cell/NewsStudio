{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 24720,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "[MUSIC PLAYING]"
    } ]
  }, {
    "tStartMs": 124747,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "[CHEERING]"
    } ]
  }, {
    "tStartMs": 129580,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "SPEAKER 1: Please\nwelcome to the stage CEO"
    } ]
  }, {
    "tStartMs": 132500,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "of Google Cloud, Thomas Kurian."
    } ]
  }, {
    "tStartMs": 136560,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 154785,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "THOMAS KURIAN: Hello."
    } ]
  }, {
    "tStartMs": 159541,
    "dDurationMs": 4359,
    "segs": [ {
      "utf8": "[CHEERING, APPLAUSE]"
    } ]
  }, {
    "tStartMs": 163900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "THOMAS KURIAN: Welcome\neveryone to Google Cloud Next."
    } ]
  }, {
    "tStartMs": 166900,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Just one year ago, we\nstood on this same stage"
    } ]
  }, {
    "tStartMs": 170740,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "and promised a\nnew future for AI."
    } ]
  }, {
    "tStartMs": 173580,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Today, that future is running\nin production at a scale"
    } ]
  }, {
    "tStartMs": 178460,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that the world has never seen."
    } ]
  }, {
    "tStartMs": 180940,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Over the last year, we\ndidn't just see adoption."
    } ]
  }, {
    "tStartMs": 185060,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "We saw transformation."
    } ]
  }, {
    "tStartMs": 187660,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Nearly 75% of Google\nCloud customers"
    } ]
  }, {
    "tStartMs": 191380,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "now leverage our AI products\nto power their businesses."
    } ]
  }, {
    "tStartMs": 195180,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "We have thousands of agents and\nservices across every industry,"
    } ]
  }, {
    "tStartMs": 200260,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "reaching billions of people\nthrough the global scale"
    } ]
  }, {
    "tStartMs": 203460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of our partner network."
    } ]
  }, {
    "tStartMs": 205460,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "You have moved beyond the pilot."
    } ]
  }, {
    "tStartMs": 208860,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The experimenting\nphase is behind us."
    } ]
  }, {
    "tStartMs": 211660,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And now, the real\nchallenge begins."
    } ]
  }, {
    "tStartMs": 214460,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "How do you move\nAI into production"
    } ]
  }, {
    "tStartMs": 217900,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "across your entire enterprise?"
    } ]
  }, {
    "tStartMs": 220860,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The answer is a unified stack."
    } ]
  }, {
    "tStartMs": 223340,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "You cannot deliver AI by\npiecing together a puzzle piece"
    } ]
  }, {
    "tStartMs": 227940,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "of fragmented silicon\nand disconnected models."
    } ]
  }, {
    "tStartMs": 231380,
    "dDurationMs": 4270,
    "segs": [ {
      "utf8": "To drive real value,\nyou need an architecture"
    } ]
  }, {
    "tStartMs": 235650,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "where chips are\ndesigned for the models,"
    } ]
  }, {
    "tStartMs": 238930,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "models are grounded in your\ndata, agents and applications"
    } ]
  }, {
    "tStartMs": 243650,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "are built with models and\nsecured by the infrastructure."
    } ]
  }, {
    "tStartMs": 249130,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Google uses this\nexact same OpenStack"
    } ]
  }, {
    "tStartMs": 253050,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "to reimagine how we\nserve users using our AI"
    } ]
  }, {
    "tStartMs": 257050,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "tools across Search,\nYouTube, Chrome, and Android."
    } ]
  }, {
    "tStartMs": 263290,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "To take you inside that journey,\nlet's hear from Sundar Pichai."
    } ]
  }, {
    "tStartMs": 268290,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 272210,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "SUNDAR PICHAI: Thanks,\nThomas, and hello, everyone."
    } ]
  }, {
    "tStartMs": 274730,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "We are so glad you are here."
    } ]
  }, {
    "tStartMs": 277010,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The pace of\ntechnological change has"
    } ]
  }, {
    "tStartMs": 279690,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "been faster than I've ever seen,\nand I've been around technology"
    } ]
  }, {
    "tStartMs": 283450,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "for a while."
    } ]
  }, {
    "tStartMs": 284890,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "In fact, this Sunday, I'm\ncelebrating my Googleversary--"
    } ]
  }, {
    "tStartMs": 289170,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "22 years, and I'm\nstill feeling lucky."
    } ]
  }, {
    "tStartMs": 292080,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And I hope that luck extends to\nall of you in Vegas this week."
    } ]
  }, {
    "tStartMs": 296280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "I was drawn to Google\nall those years"
    } ]
  }, {
    "tStartMs": 297880,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "ago because of its\nambitious mission."
    } ]
  }, {
    "tStartMs": 300960,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "From the web to mobile to\nAI, every platform shift"
    } ]
  }, {
    "tStartMs": 305520,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "has given us new opportunities\nto advance our mission"
    } ]
  }, {
    "tStartMs": 309000,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "and to help our customers\nand partners achieve yours."
    } ]
  }, {
    "tStartMs": 313840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "As we move into\nthe agentic era, we"
    } ]
  }, {
    "tStartMs": 316040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "are taking this\nto the next level."
    } ]
  }, {
    "tStartMs": 318480,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "We are making big investments\nnow and for the future."
    } ]
  }, {
    "tStartMs": 322560,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "In 2022, we were investing\n$31 billion in CapEx."
    } ]
  }, {
    "tStartMs": 327280,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "This year, we plan to invest\nbetween $175 to $185 billion"
    } ]
  }, {
    "tStartMs": 333080,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "in total CapEx, a nearly 6x\nincrease in just four years."
    } ]
  }, {
    "tStartMs": 338360,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And for 2026, just over half\nof our machine learning compute"
    } ]
  }, {
    "tStartMs": 341960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "is expected to go towards\nthe cloud business,"
    } ]
  }, {
    "tStartMs": 344920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "so it will greatly\nbenefit all of you."
    } ]
  }, {
    "tStartMs": 347880,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "These investments are how we\ncontinue to stay at the frontier"
    } ]
  }, {
    "tStartMs": 351870,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "and ensure you're at the\ncutting edge as well."
    } ]
  }, {
    "tStartMs": 355510,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "A big focus for\nus is to always be"
    } ]
  }, {
    "tStartMs": 357710,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "customer 0 for our\nown technologies,"
    } ]
  }, {
    "tStartMs": 360250,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "so we can be a better\npartner to all of you."
    } ]
  }, {
    "tStartMs": 363150,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Let me share a few\nexamples of how we"
    } ]
  }, {
    "tStartMs": 365470,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "are rewiring our work with AI."
    } ]
  }, {
    "tStartMs": 368870,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "First, coding-- we've been using\nAI to generate code internally"
    } ]
  }, {
    "tStartMs": 372830,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "at Google for a while."
    } ]
  }, {
    "tStartMs": 374830,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Today, nearly 75% of\nall new code at Google"
    } ]
  }, {
    "tStartMs": 378150,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "is AI-generated and\napproved by engineers,"
    } ]
  }, {
    "tStartMs": 381510,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "up from 50% last fall."
    } ]
  }, {
    "tStartMs": 383910,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "We are now shifting to\ntruly agentic workflows."
    } ]
  }, {
    "tStartMs": 387830,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Our engineers are orchestrating\nfully autonomous digital task"
    } ]
  }, {
    "tStartMs": 391750,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "forces, firing off agents, and\naccomplishing incredible things."
    } ]
  }, {
    "tStartMs": 397590,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "As one example of how\nwe are using agents,"
    } ]
  }, {
    "tStartMs": 400630,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "we recently executed a\nparticularly complex code"
    } ]
  }, {
    "tStartMs": 403430,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "migration."
    } ]
  }, {
    "tStartMs": 405350,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Anyone familiar knows\nthese migrations"
    } ]
  }, {
    "tStartMs": 407230,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "can take a while to get done."
    } ]
  }, {
    "tStartMs": 410020,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "We created a system of agents\ntaking on three different types"
    } ]
  }, {
    "tStartMs": 413300,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "of roles--"
    } ]
  }, {
    "tStartMs": 414460,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "planners, orchestrators,\nand coders."
    } ]
  }, {
    "tStartMs": 418220,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Working together with engineers,\nwe completed the migration 6x"
    } ]
  }, {
    "tStartMs": 421860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "faster than we could\nhave a year ago."
    } ]
  }, {
    "tStartMs": 424980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And now we are\napplying that approach"
    } ]
  }, {
    "tStartMs": 426700,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "across our entire\ndevelopment cycle,"
    } ]
  }, {
    "tStartMs": 429340,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "from experimentation\nto testing to evals."
    } ]
  }, {
    "tStartMs": 433140,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It's not just developers\nwho are infusing AI"
    } ]
  }, {
    "tStartMs": 435620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "into their workflows."
    } ]
  }, {
    "tStartMs": 437660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Our marketing teams\nare fundamentally"
    } ]
  }, {
    "tStartMs": 439700,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "rethinking the creative\nprocess from concept to launch."
    } ]
  }, {
    "tStartMs": 443340,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Historically,\nadapting a campaign"
    } ]
  }, {
    "tStartMs": 445100,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "for every audience, channel,\nand country took weeks."
    } ]
  }, {
    "tStartMs": 448500,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "For the recent launch\nof Gemini and Chrome,"
    } ]
  }, {
    "tStartMs": 451180,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "teams used our models to rapidly\ngenerate thousands of variations"
    } ]
  }, {
    "tStartMs": 455260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "of our creative assets."
    } ]
  }, {
    "tStartMs": 457300,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "This enabled personalization\nat a massive scale."
    } ]
  }, {
    "tStartMs": 461180,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "It also led to 70% faster\nturnaround and a 20% increase"
    } ]
  }, {
    "tStartMs": 465300,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in conversion."
    } ]
  }, {
    "tStartMs": 467020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We are not only getting\nto market faster."
    } ]
  }, {
    "tStartMs": 469420,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "We are also doing it\nmore effectively with AI."
    } ]
  }, {
    "tStartMs": 472820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Our security teams are also\nseeing significant gains"
    } ]
  }, {
    "tStartMs": 475820,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "with AI."
    } ]
  }, {
    "tStartMs": 477100,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Each month, our teams receive\nunstructured threat reports"
    } ]
  }, {
    "tStartMs": 480700,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "at a scale that would take\nthousands of hours to review--"
    } ]
  }, {
    "tStartMs": 484500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "a nearly impossible task."
    } ]
  }, {
    "tStartMs": 487100,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Today, our Security Operations\nCenter agents automatically"
    } ]
  }, {
    "tStartMs": 491220,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "triage tens of thousands of\nunstructured threat reports"
    } ]
  }, {
    "tStartMs": 494140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "each month."
    } ]
  }, {
    "tStartMs": 495940,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "By accelerating the extraction\nof critical intelligence"
    } ]
  }, {
    "tStartMs": 498660,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and filtering out\nthe noise, it's"
    } ]
  }, {
    "tStartMs": 500860,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "reduced threat mitigation\ntime by over 90%"
    } ]
  }, {
    "tStartMs": 504980,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "We are more on the front\nfoot than ever before."
    } ]
  }, {
    "tStartMs": 508540,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Those are just a few examples\nof what we are trying at Google."
    } ]
  }, {
    "tStartMs": 511980,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "We are moving in a bold\nand responsible way."
    } ]
  }, {
    "tStartMs": 515260,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "There's a lot of\nchange happening."
    } ]
  }, {
    "tStartMs": 517220,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "And it can feel like we are in\nthe messy part of the innovation"
    } ]
  }, {
    "tStartMs": 520020,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "cycle."
    } ]
  }, {
    "tStartMs": 520980,
    "dDurationMs": 2319,
    "segs": [ {
      "utf8": "But we are starting to see\nthe foundational building"
    } ]
  }, {
    "tStartMs": 523299,
    "dDurationMs": 2511,
    "segs": [ {
      "utf8": "blocks coming\ntogether, unlocking"
    } ]
  }, {
    "tStartMs": 525810,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "a new wave of innovation."
    } ]
  }, {
    "tStartMs": 528050,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "One thing that is super clear--"
    } ]
  }, {
    "tStartMs": 530410,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "we are firmly in the\nagentic Gemini era."
    } ]
  }, {
    "tStartMs": 533730,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Last fall, we introduced Gemini\nEnterprise as a front door"
    } ]
  }, {
    "tStartMs": 537290,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to agentic AI in the workplace."
    } ]
  }, {
    "tStartMs": 540410,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "What we have seen in just\na few months since launch"
    } ]
  }, {
    "tStartMs": 543050,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "is how every employee\nin every organization"
    } ]
  }, {
    "tStartMs": 546330,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "can become a builder."
    } ]
  }, {
    "tStartMs": 548050,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "This is an incredible shift."
    } ]
  }, {
    "tStartMs": 550290,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "We are accomplishing\nbigger things faster,"
    } ]
  }, {
    "tStartMs": 553490,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "but this comes with complexity."
    } ]
  }, {
    "tStartMs": 555730,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "The conversation has gone from\ncan we build an agent to how"
    } ]
  }, {
    "tStartMs": 559010,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "do we manage thousands of them?"
    } ]
  }, {
    "tStartMs": 562370,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Today, I'm excited to announce\nour new Gemini Enterprise Agent"
    } ]
  }, {
    "tStartMs": 566810,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Platform."
    } ]
  }, {
    "tStartMs": 568370,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "It provides the secure,\nfull-stack connective tissue"
    } ]
  }, {
    "tStartMs": 572170,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "you need to build, scale,\ngovern, and optimize"
    } ]
  }, {
    "tStartMs": 575890,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "your agents with confidence."
    } ]
  }, {
    "tStartMs": 578970,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Think of it as mission control\nfor the agentic enterprise"
    } ]
  }, {
    "tStartMs": 582330,
    "dDurationMs": 3910,
    "segs": [ {
      "utf8": "to help move your organization\ninto the next phase"
    } ]
  }, {
    "tStartMs": 586240,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "of the agentic era."
    } ]
  }, {
    "tStartMs": 588240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm going to turn it back\nover to Thomas to share more."
    } ]
  }, {
    "tStartMs": 591240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "But first, thanks\nagain for being here."
    } ]
  }, {
    "tStartMs": 594440,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Together, we are building a\nblueprint for true business"
    } ]
  }, {
    "tStartMs": 597120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "transformation, and I'm excited\nto see where it takes us next."
    } ]
  }, {
    "tStartMs": 601840,
    "dDurationMs": 3372,
    "segs": [ {
      "utf8": "Thomas, back to you."
    } ]
  }, {
    "tStartMs": 605212,
    "dDurationMs": 2916,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 620280,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "THOMAS KURIAN:\nThank you, Sundar."
    } ]
  }, {
    "tStartMs": 622000,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Today, we're taking\nthe next step"
    } ]
  }, {
    "tStartMs": 624080,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "in bringing Google AI to every\nemployee and every workflow."
    } ]
  }, {
    "tStartMs": 629040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Gemini Enterprise is now\nthe end-to-end system"
    } ]
  }, {
    "tStartMs": 632000,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "for the agentic era,\nthe connective tissue"
    } ]
  }, {
    "tStartMs": 635120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "between your data, your\npeople, and your goals."
    } ]
  }, {
    "tStartMs": 638640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It transforms\ndisconnected processes"
    } ]
  }, {
    "tStartMs": 640920,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "into a single intelligent flow."
    } ]
  }, {
    "tStartMs": 643550,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "This is our blueprint for\nthe agentic enterprise."
    } ]
  }, {
    "tStartMs": 647590,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It's also the answer to\nthat fundamental question."
    } ]
  }, {
    "tStartMs": 651470,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Intelligence plus automation\nmust deliver value."
    } ]
  }, {
    "tStartMs": 656590,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "To make this work, you\nneed context and action."
    } ]
  }, {
    "tStartMs": 661350,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Intelligence comes\nfrom your data."
    } ]
  }, {
    "tStartMs": 664030,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Automation is driven by agents."
    } ]
  }, {
    "tStartMs": 666870,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "To solve this\nequation at scale, you"
    } ]
  }, {
    "tStartMs": 669670,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "need a complete\nintegrated system."
    } ]
  }, {
    "tStartMs": 673030,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Today, we will show you the\nlayers of that system and all"
    } ]
  }, {
    "tStartMs": 677190,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "the innovations we're\nintroducing at every layer,"
    } ]
  }, {
    "tStartMs": 680630,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "starting with the\nAI Hypercomputer,"
    } ]
  }, {
    "tStartMs": 683710,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "the purpose-built\nfoundation optimized"
    } ]
  }, {
    "tStartMs": 686990,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "for the physics of\nthe agentic era;"
    } ]
  }, {
    "tStartMs": 689790,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "the Agentic Data Cloud, the\nengine that provides agents"
    } ]
  }, {
    "tStartMs": 694270,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "with trusted business context;\nAgentic Defense, the autonomous"
    } ]
  }, {
    "tStartMs": 700340,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "protection that secures\nyour entire AI lifecycle;"
    } ]
  }, {
    "tStartMs": 705060,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "the Agentic Platform, the system\nto build, deploy, and manage"
    } ]
  }, {
    "tStartMs": 709900,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "agents; and finally,\nthe Agentic Task"
    } ]
  }, {
    "tStartMs": 713340,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Force, the pre-built\nspecialized agents that we"
    } ]
  }, {
    "tStartMs": 717580,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "offer that are ready to\ntransform your business."
    } ]
  }, {
    "tStartMs": 722100,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Let's dive in."
    } ]
  }, {
    "tStartMs": 723980,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Now, the Gemini\nEnterprise Agent platform"
    } ]
  }, {
    "tStartMs": 726700,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "is the environment where your\nbusiness logic, your data,"
    } ]
  }, {
    "tStartMs": 730280,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and your models converge\nto drive autonomous action."
    } ]
  }, {
    "tStartMs": 734180,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "It expands on the previous\ncapabilities of Vertex AI"
    } ]
  }, {
    "tStartMs": 737940,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and brings new capabilities\nto enable your teams"
    } ]
  }, {
    "tStartMs": 742180,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "to build, scale, govern,\nand optimize agents"
    } ]
  }, {
    "tStartMs": 746820,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "with the same architectural\nrigor you apply to your most"
    } ]
  }, {
    "tStartMs": 750540,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "mission-critical systems."
    } ]
  }, {
    "tStartMs": 752620,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "At its core, we build on our\nsupport for state-of-the-art"
    } ]
  }, {
    "tStartMs": 756660,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "models."
    } ]
  }, {
    "tStartMs": 757820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Our most advanced reasoning\nmodel, Gemini 3.1 Pro,"
