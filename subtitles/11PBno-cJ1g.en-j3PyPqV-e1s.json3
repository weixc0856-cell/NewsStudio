  }, {
    "tStartMs": 3713730,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "stays exactly where it is while\nwe dynamically build the list."
    } ]
  }, {
    "tStartMs": 3718250,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Before writing a\nsingle line of code,"
    } ]
  }, {
    "tStartMs": 3720230,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Gemini builds a plan\nusing our data engineering"
