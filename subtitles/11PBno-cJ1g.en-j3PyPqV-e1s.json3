  }, {
    "tStartMs": 777720,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "and Replit, have\nchosen Gemini 3.1 Pro."
    } ]
  }, {
    "tStartMs": 781700,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "We're also announcing\nGemini 3.1 Flash Image,"
    } ]
  }, {
    "tStartMs": 786060,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "also known as Nano Banana 2,\nfor high-fidelity visual assets;"
    } ]
  }, {
    "tStartMs": 791380,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Veo 3.1 Lite, our most\ncost-effective video model,"
