  }, {
    "tStartMs": 3707810,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "Not today."
    } ]
  }, {
    "tStartMs": 3708970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "No more slow churn."
    } ]
  }, {
    "tStartMs": 3711370,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "With our cross-cloud\nLakehouse, the data"
