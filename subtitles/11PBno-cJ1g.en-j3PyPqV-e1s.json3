  }, {
    "tStartMs": 5396460,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "a needle in a haystack,\nsolved in seconds."
    } ]
  }, {
    "tStartMs": 5400340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Now I need to turn\nthis scattered data"
