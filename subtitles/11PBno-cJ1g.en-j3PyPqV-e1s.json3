  }, {
    "tStartMs": 3755250,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "zero complexity."
    } ]
  }, {
    "tStartMs": 3756970,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "It's as smooth as a\nbatch of Midnight Swirl."
    } ]
  }, {
    "tStartMs": 3760730,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Finally, ROI-- is this\nworth a global launch?"
