  }, {
    "tStartMs": 5469290,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "It's beautiful."
    } ]
  }, {
    "tStartMs": 5471170,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It matches my brand, and\nit's consistent with how"
