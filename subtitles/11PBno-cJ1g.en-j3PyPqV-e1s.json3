  }, {
    "tStartMs": 3928620,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Center, or SOC."
    } ]
  }, {
    "tStartMs": 3930260,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And the results\nare already here."
    } ]
  }, {
    "tStartMs": 3932900,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Our triage agents are turning\n30-minute investigations"
    } ]
  }, {
    "tStartMs": 3936980,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "into 60-second resolutions."
    } ]
  }, {
    "tStartMs": 3940380,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And our new threat hunting\nand detection agents"
