  }, {
    "tStartMs": 5646630,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "Let's hear their story."
    } ]
  }, {
    "tStartMs": 5650380,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "LEANDRO BARRETO: At Unilever,\nwe serve 3.7 billion people"
