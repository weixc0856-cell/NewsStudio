  }, {
    "tStartMs": 896800,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "Citi's global intelligence\nto clients' fingertips."
    } ]
  }, {
    "tStartMs": 903080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Citi Sky will provide\nan exemplary experience,"
