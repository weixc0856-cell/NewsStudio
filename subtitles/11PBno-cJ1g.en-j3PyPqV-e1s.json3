  }, {
    "tStartMs": 1647090,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "ticket."
    } ]
  }, {
    "tStartMs": 1648330,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I'll get this going with CLI."
    } ]
  }, {
    "tStartMs": 1653010,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Here, I'll ask my\ndev agent to start"
