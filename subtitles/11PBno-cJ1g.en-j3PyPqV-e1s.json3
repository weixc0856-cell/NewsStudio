  }, {
    "tStartMs": 5390140,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Here it is."
    } ]
  }, {
    "tStartMs": 5391420,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "It pointed me directly to\nthe dock with the exact graph"
