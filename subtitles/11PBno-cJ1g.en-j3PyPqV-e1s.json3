  }, {
    "tStartMs": 1898420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 1901180,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Walmart is rolling\nout Gemini Enterprise"
    } ]
  }, {
    "tStartMs": 1903980,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to help their store leaders\nspend more time with customers."
    } ]
  }, {
    "tStartMs": 1907900,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Let's take a look."
    } ]
  }, {
    "tStartMs": 1912043,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "KIERAN SHANAHAN:\nAt Walmart, we're"
    } ]
  }, {
    "tStartMs": 1913460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "known for being people-led\nand tech-powered."
    } ]
  }, {
    "tStartMs": 1916040,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "It's how we deliver\non our promise"
    } ]
  }, {
    "tStartMs": 1917980,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "to help our customers save\nmoney and live better."
    } ]
  }, {
    "tStartMs": 1922460,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "But in a retail landscape\nthat's moving faster than ever,"
    } ]
  }, {
    "tStartMs": 1925990,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "there's one thing that's\ncritical to our success--"
    } ]
  }, {
    "tStartMs": 1929210,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "trust."
    } ]
  }, {
    "tStartMs": 1930090,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "It's the backbone of our\nrelationship with our associates"
    } ]
  }, {
    "tStartMs": 1932970,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "and customers."
    } ]
  }, {
    "tStartMs": 1934070,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "And our field\nleaders build trust"
    } ]
  }, {
    "tStartMs": 1935890,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "by being present\non the sales floor,"
    } ]
  }, {
    "tStartMs": 1938210,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "not in their\noffices at a screen."
    } ]
  }, {
    "tStartMs": 1940890,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So we're giving our\nassociates the latest tech"
    } ]
  }, {
    "tStartMs": 1943330,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and tools at their\nfingertips so that they"
    } ]
  }, {
    "tStartMs": 1945810,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "can spend more time on the\nfloor with their teams,"
    } ]
  }, {
    "tStartMs": 1949010,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "serving our customers."
    } ]
  }, {
    "tStartMs": 1951010,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "By combining our data with\nadvanced AI technology,"
    } ]
  }, {
    "tStartMs": 1955050,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Google Cloud is helping our\nleaders make better decisions"
    } ]
  }, {
    "tStartMs": 1958770,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "with clearer insights."
    } ]
  }, {
    "tStartMs": 1960450,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Gemini Enterprise is helping us\ntake an important step forward,"
    } ]
  }, {
    "tStartMs": 1964510,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "helping our leaders lead\nand solving problems"
    } ]
  }, {
    "tStartMs": 1967090,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "so we can serve our\ncustomers better."
    } ]
  }, {
    "tStartMs": 1969410,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Our store and\nsupply chain leaders"
    } ]
  }, {
    "tStartMs": 1971690,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "now have a Pixel Fold connected\nto Walmart's enterprise data"
    } ]
  }, {
    "tStartMs": 1976170,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and giving them the answers\nthey need in seconds, not hours."
    } ]
  }, {
    "tStartMs": 1979890,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "By putting people first\nand taking their hands,"
    } ]
  }, {
    "tStartMs": 1983230,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "we're building a\nstronger future."
    } ]
  }, {
    "tStartMs": 1985410,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Thanks to our partnership\nwith Google Cloud,"
    } ]
  }, {
    "tStartMs": 1987950,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "we continue to transform\nretail every day."
    } ]
  }, {
    "tStartMs": 1991130,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I'm excited for what's next."
    } ]
  }, {
    "tStartMs": 1995730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2001490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "THOMAS KURIAN:\nThis winter, ahead"
    } ]
  }, {
    "tStartMs": 2003170,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "of one of the biggest\nmoments in global sports,"
    } ]
  }, {
    "tStartMs": 2005970,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "our world-class\nengineers collaborated"
    } ]
  }, {
    "tStartMs": 2008610,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "with world-class athletes."
    } ]
  }, {
    "tStartMs": 2010690,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "We're incredibly proud\nof how Google Cloud is"
    } ]
  }, {
    "tStartMs": 2013850,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "helping athletes push the\nboundaries of their sport"
    } ]
  }, {
    "tStartMs": 2017170,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "with AI."
    } ]
  }, {
    "tStartMs": 2021830,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "SARAH KENNEDY: There\nare sports that"
    } ]
  }, {
    "tStartMs": 2023330,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "have a limited amount\nof data that's captured."
    } ]
  }, {
    "tStartMs": 2025830,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And I think that's a\nbeautifully perfect challenge"
    } ]
  }, {
    "tStartMs": 2028170,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "for a company like Google."
    } ]
  }, {
    "tStartMs": 2029350,
    "dDurationMs": 1488,
    "segs": [ {
      "utf8": "SPEAKER 2: Let's roll it."
    } ]
  }, {
    "tStartMs": 2030838,
    "dDurationMs": 2292,
    "segs": [ {
      "utf8": "SARAH KENNEDY: One of the\nreally cool things that we're"
    } ]
  }, {
    "tStartMs": 2033130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "partnering with\nTeam USA to do is"
    } ]
  }, {
    "tStartMs": 2034730,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to help them understand what's\nthat edge that we can possibly"
    } ]
  }, {
    "tStartMs": 2037850,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "give them?"
    } ]
  }, {
    "tStartMs": 2038550,
    "dDurationMs": 1810,
    "segs": [ {
      "utf8": "MICHAEL SANTORO: They understand\nwhat's happening in the moment"
    } ]
  }, {
    "tStartMs": 2040360,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "better than anybody."
    } ]
  }, {
    "tStartMs": 2041193,
    "dDurationMs": 2334,
    "segs": [ {
      "utf8": "KATHERINE LITINSKY: So to\nhave their input and their say"
    } ]
  }, {
    "tStartMs": 2043527,
    "dDurationMs": 2493,
    "segs": [ {
      "utf8": "can really help us create\nsomething that's of benefit."
    } ]
  }, {
    "tStartMs": 2046020,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "SARAH KENNEDY: The\nside-by-side comparison thing"
    } ]
  }, {
    "tStartMs": 2048020,
    "dDurationMs": 863,
    "segs": [ {
      "utf8": "I'm excited for."
    } ]
  }, {
    "tStartMs": 2048883,
    "dDurationMs": 2417,
    "segs": [ {
      "utf8": "KATHERINE LITINSKY: Everything\nis running on Google Cloud."
    } ]
  }, {
    "tStartMs": 2051300,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The 3D model that we're using\nis a collaboration with Google"
    } ]
  }, {
    "tStartMs": 2054480,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "DeepMind."
    } ]
  }, {
    "tStartMs": 2055060,
    "dDurationMs": 3528,
    "segs": [ {
      "utf8": "We've moved so far past\ntalking to an LLM with text."
    } ]
  }, {
    "tStartMs": 2058588,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "SPEAKER 3: It's so\nclear as day right here."
    } ]
  }, {
    "tStartMs": 2060380,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "It's amazing."
    } ]
  }, {
    "tStartMs": 2060980,
    "dDurationMs": 199,
    "segs": [ {
      "utf8": "SARAH KENNEDY: Whoa."
    } ]
  }, {
    "tStartMs": 2061179,
    "dDurationMs": 861,
    "segs": [ {
      "utf8": "Is that me?"
    } ]
  }, {
    "tStartMs": 2062040,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "That's crazy."
    } ]
  }, {
    "tStartMs": 2063820,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Operating at the\nspeed of sports is"
    } ]
  }, {
    "tStartMs": 2065760,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "one of the greatest challenges\nthat we could be helping solve."
    } ]
  }, {
    "tStartMs": 2068699,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "If we can do that for the\nWinter Olympics in Milan,"
    } ]
  }, {
    "tStartMs": 2071440,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "we can do that for any\nindustry all over the world."
    } ]
  }, {
    "tStartMs": 2076760,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "SPEAKER 1: Please welcome\nthree-time Olympic gold"
    } ]
  }, {
    "tStartMs": 2079120,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "medalist, entrepreneur,\nand snowboarding legend,"
    } ]
  }, {
    "tStartMs": 2082440,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "Shaun White."
    } ]
  }, {
    "tStartMs": 2084199,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "[CHEERING, APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2086079,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "[ROCK MUSIC]"
    } ]
  }, {
    "tStartMs": 2089840,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "SHAUN WHITE: What's\nup, Google Cloud Next?"
    } ]
  }, {
    "tStartMs": 2095320,
    "dDurationMs": 819,
    "segs": [ {
      "utf8": "Oh, wow."
    } ]
  }, {
    "tStartMs": 2099310,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Man, I love seeing it\nsnow in the desert."
    } ]
  }, {
    "tStartMs": 2102330,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "This is wild."
    } ]
  }, {
    "tStartMs": 2103390,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 2104750,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Look, back when I was\ntraining, our tools"
    } ]
  }, {
    "tStartMs": 2107150,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "were camcorders and\nbasically guesswork."
    } ]
  }, {
    "tStartMs": 2110310,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "You'd land a trick\nand watch it back,"
    } ]
  }, {
    "tStartMs": 2112410,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and you'd be looking at\nit thinking, how can I"
    } ]
  }, {
    "tStartMs": 2114590,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "make that trick better?"
    } ]
  }, {
    "tStartMs": 2116310,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Over time, I've seen\nthe tricks get bigger"
    } ]
  }, {
    "tStartMs": 2118590,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and the walls get higher."
    } ]
  }, {
    "tStartMs": 2120130,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "And now, Google Cloud is\nbringing AI to the mountain."
    } ]
  }, {
    "tStartMs": 2123590,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "This winter, I worked with\nsome crazy-smart Google Cloud"
    } ]
  }, {
    "tStartMs": 2126830,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "engineers on some awesome tech."
    } ]
  }, {
    "tStartMs": 2129070,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "And to show you how rad this is,\ngive it up for Jason Davenport."
    } ]
  }, {
    "tStartMs": 2134030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2136430,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "[ROCK MUSIC]"
    } ]
  }, {
    "tStartMs": 2142190,
    "dDurationMs": 1588,
    "segs": [ {
      "utf8": "JASON DAVENPORT:\nWhat's up, Shaun?"
    } ]
  }, {
    "tStartMs": 2143778,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "SHAUN WHITE: What have\nwe got for everyone?"
    } ]
  }, {
    "tStartMs": 2145570,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "JASON DAVENPORT:\nAll right, Shaun."
    } ]
  }, {
    "tStartMs": 2146987,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "This is going to be super fun."
    } ]
  }, {
    "tStartMs": 2148370,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Let's unleash the power\nof Google Cloud AI"
    } ]
  }, {
    "tStartMs": 2150950,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "into the half-pipe."
    } ]
  }, {
    "tStartMs": 2152510,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "And to do that, we're going to\npull up a trick from your 2017"
    } ]
  }, {
    "tStartMs": 2156180,
    "dDurationMs": 945,
    "segs": [ {
      "utf8": "Burton US Open."
    } ]
  }, {
    "tStartMs": 2157125,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "SHAUN WHITE: Oh, wow."
    } ]
  }, {
    "tStartMs": 2158000,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "JASON DAVENPORT: I'm sure\nyou remember this one."
    } ]
  }, {
    "tStartMs": 2159240,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "SHAUN WHITE: It's a throwback."
    } ]
  }, {
    "tStartMs": 2160040,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "It's a throwback."
    } ]
  }, {
    "tStartMs": 2160920,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "JASON DAVENPORT: It is."
    } ]
  }, {
    "tStartMs": 2161878,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "So let's analyze this\nclip for the audience."
    } ]
  }, {
    "tStartMs": 2163960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And so they can see all the\ncool things that AI sees."
    } ]
  }, {
    "tStartMs": 2166200,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "SHAUN WHITE: All right."
    } ]
  }, {
    "tStartMs": 2166860,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "JASON DAVENPORT: All\nright, let's start it off."
    } ]
  }, {
    "tStartMs": 2168818,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "First, this trick is over\nin under three seconds."
    } ]
  }, {
    "tStartMs": 2172180,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You are literally-- it's\na split-second blur."
    } ]
  }, {
    "tStartMs": 2174980,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "And for everyone watching,\nwhat trick is this?"
    } ]
  }, {
    "tStartMs": 2177640,
    "dDurationMs": 2987,
    "segs": [ {
      "utf8": "SHAUN WHITE: This is a\nswitch cab double flip 1440."
    } ]
  }, {
    "tStartMs": 2180627,
    "dDurationMs": 1333,
    "segs": [ {
      "utf8": "JASON DAVENPORT: That is insane."
    } ]
  }, {
    "tStartMs": 2181960,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "But for everyone else, what\ndoes that actually mean?"
    } ]
  }, {
    "tStartMs": 2185620,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "SHAUN WHITE: Basically, it's\nmy unnatural way of riding."
    } ]
  }, {
    "tStartMs": 2188600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "I do four full rotations\nwith two flips in the middle."
    } ]
  }, {
    "tStartMs": 2191540,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "JASON DAVENPORT: I tried\nstopping using the camcorder,"
    } ]
  }, {
    "tStartMs": 2194180,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "and I couldn't do it."
    } ]
  }, {
    "tStartMs": 2195660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So let's slow this down."
    } ]
  }, {
    "tStartMs": 2197520,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "And to do this, we need to\nanalyze this frame by frame"
    } ]
  }, {
    "tStartMs": 2200900,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and see what Google Cloud sees."
    } ]
  }, {
    "tStartMs": 2202820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And we're going to\ndo this essentially"
    } ]
  }, {
    "tStartMs": 2204500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "with every single stop in this."
    } ]
  }, {
    "tStartMs": 2206440,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "So first, let's\nstart with your pose."
    } ]
  }, {
    "tStartMs": 2209620,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "So this is what's super cool."
    } ]
  }, {
    "tStartMs": 2211260,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "We built a model\nin collaboration"
    } ]
  }, {
    "tStartMs": 2213140,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "with Google DeepMind that\ncan track you spatially,"
    } ]
  }, {
    "tStartMs": 2216090,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "and it creates a\nthree-dimensional,"
    } ]
  }, {
    "tStartMs": 2217990,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "essentially pose of you from\na flat, two-dimensional video."
    } ]
  }, {
    "tStartMs": 2221230,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "SHAUN WHITE: So awesome."
    } ]
  }, {
    "tStartMs": 2222230,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "JASON DAVENPORT:\nI mean, I love it."
    } ]
  }, {
    "tStartMs": 2223688,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "I can't even see you here."
    } ]
  }, {
    "tStartMs": 2225150,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "How does it do it?"
    } ]
  }, {
    "tStartMs": 2226310,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "SHAUN WHITE: This was my tight\npant, leather jacket phase."
    } ]
  }, {
    "tStartMs": 2229710,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So you got to really\npunch in on it."
    } ]
  }, {
    "tStartMs": 2231790,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "JASON DAVENPORT: I know."
    } ]
  }, {
    "tStartMs": 2233450,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "I got some out back, too."
    } ]
  }, {
    "tStartMs": 2234750,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "SHAUN WHITE: It was a good look."
    } ]
  }, {
    "tStartMs": 2235550,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "JASON DAVENPORT: I know."
    } ]
  }, {
    "tStartMs": 2236170,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "It's still a good look."
    } ]
  }, {
    "tStartMs": 2237128,
    "dDurationMs": 742,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 2237870,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Let's talk about the next thing."
    } ]
  }, {
    "tStartMs": 2239670,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "These are stats\npowered by Gemini."
    } ]
  }, {
    "tStartMs": 2241890,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Here, we're tracking your flight\ndynamics, rotational velocity,"
    } ]
  }, {
    "tStartMs": 2245510,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "and even your tuck compression."
    } ]
  }, {
    "tStartMs": 2247092,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "SHAUN WHITE: Yeah,\nthis is amazing."
    } ]
  }, {
    "tStartMs": 2248550,
    "dDurationMs": 1125,
    "segs": [ {
      "utf8": "We didn't have this before."
    } ]
  }, {
    "tStartMs": 2249675,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "I can see how much time\nI've spent in the air."
    } ]
  }, {
    "tStartMs": 2251910,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And now take old\nfootage that I've done"
    } ]
  }, {
    "tStartMs": 2254090,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and compare it with new\nfootage of how much time was I"
    } ]
  }, {
    "tStartMs": 2256890,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "in the air when I\nlanded the trick,"
    } ]
  }, {
    "tStartMs": 2258350,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and when I didn't\nland the trick."
    } ]
  }, {
    "tStartMs": 2259550,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "And I can compare the two."
    } ]
  }, {
    "tStartMs": 2260710,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And that data is really\ngoing to help me progress."
    } ]
  }, {
    "tStartMs": 2262950,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "And obviously, the\nnext generation"
    } ]
  }, {
    "tStartMs": 2264730,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "can use these tools too."
    } ]
  }, {
    "tStartMs": 2265990,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "JASON DAVENPORT: It's true."
    } ]
  }, {
    "tStartMs": 2266350,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "And what I love is\nI love seeing how"
    } ]
  }, {
    "tStartMs": 2267930,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "quickly your rotational\nvelocity gets up here."
    } ]
  }, {
    "tStartMs": 2270710,
    "dDurationMs": 1593,
    "segs": [ {
      "utf8": "It's all about how\nyou exit the pipe."
    } ]
  }, {
    "tStartMs": 2272303,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "SHAUN WHITE: Torque--\nexactly, and coming out of it."
    } ]
  }, {
    "tStartMs": 2274470,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "JASON DAVENPORT: All right."
    } ]
  }, {
    "tStartMs": 2274830,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So let's look at one more cool\nthing that we've done here,"
    } ]
  }, {
    "tStartMs": 2276830,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "which is the ribbon overlay."
    } ]
  }, {
    "tStartMs": 2278030,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "SHAUN WHITE: Oh, I love this."
    } ]
  }, {
    "tStartMs": 2278950,
    "dDurationMs": 2083,
    "segs": [ {
      "utf8": "JASON DAVENPORT: So here's\nwhat I love about this."
    } ]
  }, {
    "tStartMs": 2281033,
    "dDurationMs": 1789,
    "segs": [ {
      "utf8": "We're actually\nshowing your cork here"
    } ]
  }, {
    "tStartMs": 2282822,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "with the whole visualization."
    } ]
  }, {
    "tStartMs": 2284030,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "So what happens here?"
    } ]
  }, {
    "tStartMs": 2285610,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "We're moving from blue\nto green on the thing."
    } ]
  }, {
    "tStartMs": 2288030,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "What is that?"
    } ]
  }, {
    "tStartMs": 2288572,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "SHAUN WHITE: When I was\nworking with the engineers,"
    } ]
  }, {
    "tStartMs": 2290697,
    "dDurationMs": 1533,
    "segs": [ {
      "utf8": "I was trying to\ndescribe this trick."
    } ]
  }, {
    "tStartMs": 2292230,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "And there's a turning\npoint where normally I"
    } ]
  }, {
    "tStartMs": 2294770,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "do one front flip and then\ncome in for the second,"
    } ]
  }, {
    "tStartMs": 2297870,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "but then you have to pause\nand then go backflip."
    } ]
  }, {
    "tStartMs": 2300850,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "If you miss that turning\npoint in the trick, well,"
    } ]
  }, {
    "tStartMs": 2303930,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "it's not good."
    } ]
  }, {
    "tStartMs": 2305070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It's not good."
    } ]
  }, {
    "tStartMs": 2306330,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "But this really\npinpoints it exactly."
    } ]
  }, {
    "tStartMs": 2308470,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "JASON DAVENPORT: It is\nso cool to watch this."
    } ]
  }, {
    "tStartMs": 2309710,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And what I love is that\nthis is making sports"
    } ]
  }, {
    "tStartMs": 2311610,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "more accessible for fans."
    } ]
  }, {
    "tStartMs": 2313390,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "We can see all of the\ncraziness that you're"
    } ]
  }, {
    "tStartMs": 2315930,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "putting into this sport."
    } ]
  }, {
    "tStartMs": 2316990,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "SHAUN WHITE: Exactly."
    } ]
  }, {
    "tStartMs": 2317865,
    "dDurationMs": 1125,
    "segs": [ {
      "utf8": "JASON DAVENPORT: All right."
    } ]
  }, {
    "tStartMs": 2318990,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "So let's bring this back and\ntalk a little bit more tech."
    } ]
  }, {
    "tStartMs": 2321410,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Google Cloud is helping\neveryone innovate here"
    } ]
  }, {
    "tStartMs": 2324170,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "by creating new use-case\nspecific models, even"
    } ]
  }, {
    "tStartMs": 2326970,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for things like\nspatial analysis,"
    } ]
  }, {
    "tStartMs": 2329130,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "training these large amounts\nof data and even models"
    } ]
  }, {
    "tStartMs": 2333160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "with Google Cloud TPUs,\nand helping everyone"
    } ]
  }, {
    "tStartMs": 2336200,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "to build a secure data and\nagent foundation with Gemini"
    } ]
  }, {
    "tStartMs": 2339760,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Enterprise Agent Platform."
    } ]
  }, {
    "tStartMs": 2342040,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Compute, models,\nand platform-- this"
    } ]
  }, {
    "tStartMs": 2345360,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "is the power of Google Cloud AI."
    } ]
  }, {
    "tStartMs": 2347695,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "SHAUN WHITE: And look, from\nmy personal experience,"
    } ]
  }, {
    "tStartMs": 2349820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I can tell you, learning a trick\non the mountain is one thing,"
    } ]
  }, {
    "tStartMs": 2352820,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "but actually understanding\nthe physics of a trick"
    } ]
  }, {
    "tStartMs": 2355320,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "is a whole other thing."
    } ]
  }, {
    "tStartMs": 2356880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And this is really\ngoing to help not only"
    } ]
  }, {
    "tStartMs": 2358640,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the next generation of\nathletes learn new skills"
    } ]
  }, {
    "tStartMs": 2361500,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "but also help the fans at home\nunderstand the sport better."
    } ]
  }, {
    "tStartMs": 2364780,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "And not just for snowboarding,\nbut I think sports globally."
    } ]
  }, {
    "tStartMs": 2368520,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Look, I'm so stoked\nto see what's ahead."
    } ]
  }, {
    "tStartMs": 2370772,
    "dDurationMs": 708,
    "segs": [ {
      "utf8": "Thank you, Jason."
    } ]
  }, {
    "tStartMs": 2371480,
    "dDurationMs": 2813,
    "segs": [ {
      "utf8": "And thank you,\nGoogle Cloud Next."
    } ]
  }, {
    "tStartMs": 2374293,
    "dDurationMs": 3451,
    "segs": [ {
      "utf8": "[APPLAUSE, UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 2379720,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "SPEAKER 1: Please welcome\nSVP and chief technologist,"
    } ]
  }, {
    "tStartMs": 2382980,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "AI and infrastructure,\nAmin Vahdat."
    } ]
  }, {
    "tStartMs": 2387485,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 2399740,
    "dDurationMs": 1250,
    "segs": [ {
      "utf8": "AMIN VAHDAT: Thank you, Shaun."
    } ]
  }, {
    "tStartMs": 2400990,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "We're taking the\nexact same technology"
    } ]
  }, {
    "tStartMs": 2403270,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "that empowers athletes and\napplying it to the enterprise."
    } ]
  }, {
    "tStartMs": 2406090,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Because while athletes use\ndata to understand the game,"
    } ]
  }, {
    "tStartMs": 2408730,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "the enterprise needs\nit to change the game."
    } ]
  }, {
    "tStartMs": 2411390,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "That kind of scale is\nthe ultimate stress test"
    } ]
  }, {
    "tStartMs": 2414070,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "for a unified system."
    } ]
  }, {
    "tStartMs": 2415550,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "When you process massive\nvideo feeds, reaching over"
    } ]
  }, {
    "tStartMs": 2418470,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "decades of historical\ndata, and defend"
    } ]
  }, {
    "tStartMs": 2420590,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "every byte in near\nreal time, you"
    } ]
  }, {
    "tStartMs": 2422630,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "have a foundation\nbuilt for anything."
    } ]
  }, {
    "tStartMs": 2426510,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "But to solve this\nat a global scale,"
    } ]
  }, {
    "tStartMs": 2428330,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "we first have to solve\na physics problem."
    } ]
  }, {
    "tStartMs": 2431070,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It is a constant struggle\nagainst the limits"
    } ]
  }, {
    "tStartMs": 2433230,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "of software architecture,\nhardware architecture, power,"
    } ]
  }, {
    "tStartMs": 2437230,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "cooling, and even\nthe speed of light."
    } ]
  }, {
    "tStartMs": 2440470,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This is the foundation\nof our AI Hypercomputer."
    } ]
  }, {
    "tStartMs": 2443950,
    "dDurationMs": 3310,
    "segs": [ {
      "utf8": "We integrate clean energy,\nmassive physical scale,"
    } ]
  }, {
    "tStartMs": 2447260,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "and our purpose-built\ninfrastructure"
    } ]
  }, {
    "tStartMs": 2448980,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "into a single unified engine\nof efficiency and innovation."
    } ]
  }, {
    "tStartMs": 2454020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Because in the\nagentic era, compute"
    } ]
  }, {
    "tStartMs": 2455820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is no longer defined by chip."
    } ]
  }, {
    "tStartMs": 2457820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Compute is the\nentire data center."
    } ]
  }, {
    "tStartMs": 2462140,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "We give you the\nultimate flexibility"
    } ]
  }, {
    "tStartMs": 2464020,
    "dDurationMs": 2985,
    "segs": [ {
      "utf8": "to pick the right architecture\nwithout compromise."
    } ]
  }, {
    "tStartMs": 2467005,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "You can see this\nin how different"
    } ]
  }, {
    "tStartMs": 2468380,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "industry leaders are\ninnovating on Google Cloud."
    } ]
  }, {
    "tStartMs": 2471860,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Axia Energia, Brazil's\nlargest power company,"
    } ]
  }, {
    "tStartMs": 2474960,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "helps prevent power outages\nfor millions of customers"
    } ]
  }, {
    "tStartMs": 2477860,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "by running advanced weather\nmodeling on TPU clusters."
    } ]
  }, {
    "tStartMs": 2481300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "By forecasting severe\nweather conditions up"
    } ]
  }, {
    "tStartMs": 2483340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to 10 days in\nadvance, the company"
    } ]
  }, {
    "tStartMs": 2485380,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "can proactively plan and\nexecute preventative measures"
    } ]
  }, {
    "tStartMs": 2488820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "before storms hit, significantly\nreducing service interruptions"
    } ]
  }, {
    "tStartMs": 2493140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "year over year."
    } ]
  }, {
    "tStartMs": 2495300,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Thinking Machine Labs shows\nour NVIDIA-based infrastructure"
    } ]
  }, {
    "tStartMs": 2498220,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to power Tinker,\nan open platform"
    } ]
  }, {
    "tStartMs": 2501100,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for reinforcement\nlearning and fine-tuning"
    } ]
  }, {
    "tStartMs": 2503380,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "of frontier models for\nspecialized use cases."
    } ]
  }, {
    "tStartMs": 2507250,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Woven by Toyota achieved\n42% faster training"
    } ]
  }, {
    "tStartMs": 2510770,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "for models that predict\ncomplex traffic events."
    } ]
  }, {
    "tStartMs": 2514890,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "The US Department of Energy\nis powering AI coscientists"
    } ]
  }, {
    "tStartMs": 2518410,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "across all 17 national\nlabs to accelerate the pace"
    } ]
  }, {
    "tStartMs": 2522330,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "of scientific discovery."
    } ]
  }, {
    "tStartMs": 2525490,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And Boston Dynamics\nis training and safely"
    } ]
  }, {
    "tStartMs": 2528130,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "deploying flexible\nvision-language models"
    } ]
  }, {
    "tStartMs": 2530730,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "to scale robotics across\ndiverse industrial applications."
    } ]
  }, {
    "tStartMs": 2536450,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "As we enter the\nagentic era, we see"
    } ]
  }, {
    "tStartMs": 2538370,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "that the demands of\ntraining and serving"
    } ]
  }, {
    "tStartMs": 2540250,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "have completely diverged."
    } ]
  }, {
    "tStartMs": 2542930,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "To meet the performance needs\nof these explosive workloads,"
    } ]
  }, {
    "tStartMs": 2546730,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "I am proud to announce our\neighth-generation TPUs."
    } ]
  }, {
    "tStartMs": 2551680,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 2563065,
    "dDurationMs": 3465,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2571490,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "These are things of beauty."
    } ]
  }, {
    "tStartMs": 2573010,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "For the very first\ntime, we are launching"
    } ]
  }, {
    "tStartMs": 2575250,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "two specialized\nplatforms, each built"
    } ]
  }, {
    "tStartMs": 2577490,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "from the ground up for the\ndistinct demands of training"
    } ]
  }, {
    "tStartMs": 2580450,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and serving."
    } ]
  }, {
    "tStartMs": 2582050,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "TPU 8t is a powerhouse\noptimized for training."
    } ]
  }, {
    "tStartMs": 2586090,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "We have redefined\nperformance capability"
    } ]
  }, {
    "tStartMs": 2588650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "by moving block scale\nmultiplication directly"
    } ]
  }, {
    "tStartMs": 2591290,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "inside the MXUs."
    } ]
  }, {
    "tStartMs": 2593370,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "This native MXU quantization\neliminates VPU overhead,"
    } ]
  }, {
    "tStartMs": 2597110,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "delivering nearly three times\nthe compute performance per pod"
    } ]
  }, {
    "tStartMs": 2599810,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "over previous generations."
    } ]
  }, {
    "tStartMs": 2602730,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This allows us to push the\nabsolute limits of model flops"
    } ]
  }, {
    "tStartMs": 2605530,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "utilization at a massive scale\nand reduces the training time"
    } ]
  }, {
    "tStartMs": 2608810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of frontier models."
    } ]
  }, {
    "tStartMs": 2611210,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It leverages our breakthrough\ninter-chip interconnect"
    } ]
  }, {
    "tStartMs": 2613850,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "technology, which now delivers\ntwice the bandwidth compared"
    } ]
  }, {
    "tStartMs": 2616890,
    "dDurationMs": 6070,
    "segs": [ {
      "utf8": "to Ironwood, scaling up to 9,600\nTPUs connected via our 3D torus"
    } ]
  }, {
    "tStartMs": 2622960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "topology."
    } ]
  }, {
    "tStartMs": 2625200,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "This is a 2.8x improvement\nover Ironwood to deliver 1.21"
    } ]
  }, {
    "tStartMs": 2629800,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "exaflops of FP4 compute per pod."
    } ]
  }, {
    "tStartMs": 2635560,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "8t provides two petabytes\nof shared bandwidth memory"
    } ]
  }, {
    "tStartMs": 2638520,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "in a single superpod and\nutilizes the new TPUDirect"
    } ]
  }, {
    "tStartMs": 2641920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "storage to enable high-speed\ndata transfers from managed"
    } ]
  }, {
    "tStartMs": 2645280,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "storage."
    } ]
  }, {
    "tStartMs": 2647120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "To put that scale\nin perspective,"
    } ]
  }, {
    "tStartMs": 2648880,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "two petabytes is enough to hold\nthe entire digital connection"
    } ]
  }, {
    "tStartMs": 2652520,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "of the Library of\nCongress 100 times over."
    } ]
  }, {
    "tStartMs": 2658360,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "TPU 8i is optimized for the\nthinking part of the equation--"
    } ]
  }, {
    "tStartMs": 2661780,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "inference and\nreinforcement learning."
    } ]
  }, {
    "tStartMs": 2663920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "At the chip level, we have\nintegrated a specialized"
    } ]
  }, {
    "tStartMs": 2666320,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "collectives acceleration\nengine, which reduces latency"
    } ]
  }, {
    "tStartMs": 2669160,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "by an additional 5x."
    } ]
  }, {
    "tStartMs": 2671520,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "By hosting the memory\ncache entirely on silicon,"
    } ]
  }, {
    "tStartMs": 2674020,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "we've finally broken the\nmemory wall that slows down"
    } ]
  }, {
    "tStartMs": 2676680,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "long-context decoding."
    } ]
  }, {
    "tStartMs": 2678920,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "We then scaled this\non-chip performance"
    } ]
  }, {
    "tStartMs": 2680790,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "through our new board\nflight topology,"
    } ]
  }, {
    "tStartMs": 2683150,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "which deploys 1152\nTPUs into a single pod"
    } ]
  }, {
    "tStartMs": 2687310,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "to run millions of concurrent\nagents with near-zero latency."
    } ]
  }, {
    "tStartMs": 2692070,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "This delivers 11.6 FP8 exaflops\nfor a substantial 9.8x increase"
    } ]
  }, {
    "tStartMs": 2698390,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "in performance over the\n256-chip Ironwood pod."
    } ]
  }, {
    "tStartMs": 2705990,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "We are extending our\ninfrastructure leadership"
    } ]
  }, {
    "tStartMs": 2708070,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "to general purpose workloads as\nwell with Google Cloud Axion."
    } ]
  }, {
    "tStartMs": 2712590,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Our Google Axion N48\ncompute instances,"
    } ]
  }, {
    "tStartMs": 2715510,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "powered by a\ncustom-designed ARM CPU,"
    } ]
  }, {
    "tStartMs": 2717890,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "deliver up to twice\nbetter price performance"
    } ]
  }, {
    "tStartMs": 2720430,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and 80% better\nperformance per watt"
    } ]
  }, {
    "tStartMs": 2723150,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "than comparable x86 instances."
    } ]
  }, {
    "tStartMs": 2725950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "This provides a sustained,\ncontinuous operation"
    } ]
  }, {
    "tStartMs": 2728470,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "designed to eliminate\ncold starts in logic apps,"
    } ]
  }, {
    "tStartMs": 2731170,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "ensuring your agents are\nalways on and ready to respond."
    } ]
  }, {
    "tStartMs": 2736710,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "We are the preferred\ncloud for NVIDIA GPUs"
    } ]
  }, {
    "tStartMs": 2739500,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "by some of the largest scale\nand most innovative customers"
    } ]
  }, {
    "tStartMs": 2742220,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "in the world."
    } ]
  }, {
    "tStartMs": 2743180,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Today, I am pleased to\nannounce that Google Cloud will"
    } ]
  }, {
    "tStartMs": 2746020,
    "dDurationMs": 5594,
    "segs": [ {
      "utf8": "be among the first to offer\nthe NVIDIA Vera Rubin NVL72."
    } ]
  }, {
    "tStartMs": 2751614,
    "dDurationMs": 2844,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2757780,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Vera Rubin NVL72 on Google\nCloud achieves 10 times"
    } ]
  }, {
    "tStartMs": 2761340,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "performance efficiency,\noptimized for high interactivity"
    } ]
  }, {
    "tStartMs": 2764300,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and long-context workloads."
    } ]
  }, {
    "tStartMs": 2766900,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Of course, silicon is\nonly half the battle."
    } ]
  }, {
    "tStartMs": 2769540,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "To feed these chips, we've\nredesigned our entire storage"
    } ]
  }, {
    "tStartMs": 2772380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and networking pipeline."
    } ]
  }, {
    "tStartMs": 2774180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "I am pleased to announce that\nManaged Lustre now supports"
    } ]
  }, {
    "tStartMs": 2776700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "throughput up to an\nindustry-leading 10"
    } ]
  }, {
    "tStartMs": 2779100,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "terabytes per second."
    } ]
  }, {
    "tStartMs": 2781500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "We tied it all together\nwith our new Virgo Network."
    } ]
  }, {
    "tStartMs": 2784300,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Virgo doubles connectivity\nto scale training"
    } ]
  }, {
    "tStartMs": 2787020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "beyond the superpod."
    } ]
  }, {
    "tStartMs": 2788820,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It links 134,000 chips\nwith up to 47pb per second"
    } ]
  }, {
    "tStartMs": 2793260,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "of non-blocking bandwidth\nto deliver over 1.7 million"
    } ]
  }, {
    "tStartMs": 2797210,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "exaflops of compute."
    } ]
  }, {
    "tStartMs": 2800010,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "We can now turn\nmonths of training"
    } ]
  }, {
    "tStartMs": 2801970,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "into weeks with the power\nof a million-plus TPU"
    } ]
  }, {
    "tStartMs": 2804850,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "chips in a single\ncluster, all orchestrated"
    } ]
  }, {
    "tStartMs": 2808050,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "by Pathways and JAX."
    } ]
  }, {
    "tStartMs": 2812620,
    "dDurationMs": 2892,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2818832,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "With up to four\ntimes the bandwidth"
    } ]
  }, {
    "tStartMs": 2820290,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "per accelerator over\nthe previous generation,"
    } ]
  }, {
    "tStartMs": 2822270,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "this combination delivers\nnear-linear scaling,"
    } ]
  }, {
    "tStartMs": 2824710,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "ensuring you get the full power\nof every chip you pay for."
    } ]
  }, {
    "tStartMs": 2828610,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "We are also making Virgo\navailable on NVIDIA, Vera Rubin,"
    } ]
  }, {
    "tStartMs": 2831850,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "and NVL72, supporting\nup to 960,000 GPUs."
    } ]
  }, {
    "tStartMs": 2838010,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Leading financial\ninstitutions are"
    } ]
  }, {
    "tStartMs": 2839570,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "using this exact combination\nof silicon networking"
    } ]
  }, {
    "tStartMs": 2842570,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "to gain a massive edge."
    } ]
  }, {
    "tStartMs": 2844290,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Let's hear from Citadel\nSecurities on how"
    } ]
  }, {
    "tStartMs": 2846490,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "we are innovating together."
    } ]
  }, {
    "tStartMs": 2849530,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "JOSH WOODS: We trade over half\na trillion dollars per day."
    } ]
  }, {
    "tStartMs": 2852570,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "But it's not just about volumes."
    } ]
  }, {
    "tStartMs": 2854110,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "It's also about speed."
    } ]
  }, {
    "tStartMs": 2855930,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "In financial markets, time\nis measured in nanoseconds."
    } ]
  }, {
    "tStartMs": 2860410,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "We connect markets\nall around the world,"
    } ]
  }, {
    "tStartMs": 2862550,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "whether pension funds or\nsomebody doing their first trade"
    } ]
  }, {
    "tStartMs": 2865970,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "as part of their retirement,\nmeet their investment"
    } ]
  }, {
    "tStartMs": 2868170,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "objectives."
    } ]
  }, {
    "tStartMs": 2869130,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "We've partnered\nwith Google Cloud"
    } ]
  }, {
    "tStartMs": 2870650,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to build what we think is the\npreeminent scalable, cloud-based"
    } ]
  }, {
    "tStartMs": 2874730,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "research environment."
    } ]
  }, {
    "tStartMs": 2876290,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "For instance, we've been\nworking in depth on TPU"
    } ]
  }, {
    "tStartMs": 2879930,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "to ensure that we\nget the efficiency we"
    } ]
  }, {
    "tStartMs": 2882130,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "need to run our business."
    } ]
  }, {
    "tStartMs": 2886170,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Today, we're able to run\nworkloads two to four times"
    } ]
  }, {
    "tStartMs": 2889410,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "as fast with a 30% lower cost."
    } ]
  }, {
    "tStartMs": 2892635,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "HARIS NAIR: With\nTPU Ironwood, we"
    } ]
  }, {
    "tStartMs": 2894010,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "can now run thousands\nof parallel chips"
    } ]
  }, {
    "tStartMs": 2896490,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "for a single workload."
    } ]
  }, {
    "tStartMs": 2897970,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And what that means for\nour business is workloads"
    } ]
  }, {
    "tStartMs": 2900290,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "that used to take\nweeks or days, we"
    } ]
  }, {
    "tStartMs": 2903050,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "can now execute those in\nhours or even minutes."
    } ]
  }, {
    "tStartMs": 2907530,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Imagine you're a\nquantitative researcher."
    } ]
  }, {
    "tStartMs": 2909470,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "You have 100 novel ideas\nthat you want to execute."
    } ]
  }, {
    "tStartMs": 2912070,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "Can we empower our\nresearchers to be"
    } ]
  }, {
    "tStartMs": 2914440,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "able to test all of\ntheir ideas and really"
    } ]
  }, {
    "tStartMs": 2916480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "be limited by not the\nscale of the platform"
    } ]
  }, {
    "tStartMs": 2919280,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "or the economics of the problem,\nbut by their own creativity?"
    } ]
  }, {
    "tStartMs": 2924040,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "JOSH WOODS: As we like to\nsay, steel sharpens steel."
    } ]
  }, {
    "tStartMs": 2926560,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Google Cloud and Citadel\nSecurities' collaboration"
    } ]
  }, {
    "tStartMs": 2929360,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "has been exactly that."
    } ]
  }, {
    "tStartMs": 2934224,
    "dDurationMs": 3872,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 2940355,
    "dDurationMs": 2125,
    "segs": [ {
      "utf8": "AMIN VAHDAT: Citadel\nSecurities is just one example"
    } ]
  }, {
    "tStartMs": 2942480,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "of many innovators who are\ngaining a competitive edge"
    } ]
  }, {
    "tStartMs": 2944920,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "on our foundational\nAI Hypercomputer."
    } ]
  }, {
    "tStartMs": 2947760,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "At this scale, you cannot have\nhumans manually troubleshooting"
    } ]
  }, {
    "tStartMs": 2950720,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "configurations."
    } ]
  }, {
    "tStartMs": 2952000,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "You need a cloud\nthat drives itself."
    } ]
  }, {
    "tStartMs": 2955400,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "We have used the Model Context\nProtocol to turn every Google"
    } ]
  }, {
    "tStartMs": 2958560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Cloud service into a tool that\nagents can orchestrate directly."
    } ]
  }, {
    "tStartMs": 2962880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "By integrating Gemini reasoning\ninto our own telemetry,"
    } ]
  }, {
    "tStartMs": 2966660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "the system now performs\nautonomous root cause analysis,"
    } ]
  }, {
    "tStartMs": 2969720,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "identifying and fixing\nmisconfigurations"
    } ]
  }, {
    "tStartMs": 2972510,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "before you even realize\nthere's a problem."
    } ]
  }, {
    "tStartMs": 2975270,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This is the AI Hypercomputer--\npurpose-built infrastructure"
    } ]
  }, {
    "tStartMs": 2979270,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to accelerate the\nentire AI lifecycle."
    } ]
  }, {
    "tStartMs": 2982230,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "To show you how we feed\nthis engine with your data,"
    } ]
  }, {
    "tStartMs": 2984970,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "please welcome Karthik Narain."
    } ]
  }, {
    "tStartMs": 2987640,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 3001870,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "KARTHIK NARAIN: Thank you, Amin."
    } ]
  }, {
    "tStartMs": 3003310,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Amin just showed you how we\nbuilt the world's most--powerful"
    } ]
  }, {
    "tStartMs": 3006630,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "reasoning engine."
    } ]
  }, {
    "tStartMs": 3008030,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "But here's the reality."
    } ]
  }, {
    "tStartMs": 3009670,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Reasoning without\ncontext is just a guess."
    } ]
  }, {
    "tStartMs": 3013270,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And when you expect your AI to\nmake decisions and your agents"
    } ]
  }, {
    "tStartMs": 3016870,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "to take actions, you\ncannot afford to guess."
    } ]
  }, {
    "tStartMs": 3020790,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Trusted context turns\nan intelligent guess"
    } ]
  }, {
    "tStartMs": 3023870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to a decisive action."
    } ]
  }, {
    "tStartMs": 3026030,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Today, we are completely\nrethinking the data platform."
    } ]
  }, {
    "tStartMs": 3029900,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "We call it the\nAgenetic Data Cloud."
    } ]
  }, {
    "tStartMs": 3034420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "To make this real,\nI'm thrilled to share"
    } ]
  }, {
    "tStartMs": 3037060,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "four foundational innovations."
    } ]
  }, {
    "tStartMs": 3040100,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It all starts with the\nfoundation of truth."
    } ]
  }, {
    "tStartMs": 3043540,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Right now, your data is\ntrapped in PDFs, video calls,"
    } ]
  }, {
    "tStartMs": 3047360,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "multiple data stores,\nand SaaS applications."
    } ]
  }, {
    "tStartMs": 3051020,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "How do we help AI\nmake sense of it all?"
    } ]
  }, {
    "tStartMs": 3054420,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Today, we are introducing\nthe Knowledge Catalog,"
    } ]
  }, {
    "tStartMs": 3057860,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "a universal context engine\nfor your enterprise."
    } ]
  }, {
    "tStartMs": 3061860,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Starting with your\nstructured world,"
    } ]
  }, {
    "tStartMs": 3063840,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the Knowledge Catalog\nnatively integrates"
    } ]
  }, {
    "tStartMs": 3066100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "with BigQuery, mapping\ntables and metadata"
    } ]
  }, {
    "tStartMs": 3069260,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "into unified business logic."
    } ]
  }, {
    "tStartMs": 3072460,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And we are going even further,\nextending the same capability"
    } ]
  }, {
    "tStartMs": 3075860,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "to the unstructured world as\nwell through Smart Storage."
    } ]
  }, {
    "tStartMs": 3080260,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "In the past, a file\nlanding in your storage"
    } ]
  }, {
    "tStartMs": 3082980,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "sat passive, waiting\nfor a pipeline."
    } ]
  }, {
    "tStartMs": 3085740,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "Now, the second that image or\nPDF hits Google Cloud Storage,"
    } ]
  }, {
    "tStartMs": 3090130,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "they are instantly tagged,\nenriched, and made agent-ready--"
    } ]
  }, {
    "tStartMs": 3094170,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "zero manual data engineering."
    } ]
  }, {
    "tStartMs": 3097730,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Powered natively by Gemini,\nthe Knowledge Catalog"
    } ]
  }, {
    "tStartMs": 3100490,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "goes even deeper, reading\nfiles, autonomously extracting"
    } ]
  }, {
    "tStartMs": 3104450,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "entities, mapping\nrelationships, and learning"
    } ]
  }, {
    "tStartMs": 3108170,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "about your unique\nbusiness semantics."
    } ]
  }, {
    "tStartMs": 3111250,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "When an agent hears\nnet revenue or risk,"
    } ]
  }, {
    "tStartMs": 3114330,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "it understands\nthe exact meaning."
    } ]
  }, {
    "tStartMs": 3117410,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Take Virgin Media O2."
    } ]
  }, {
    "tStartMs": 3119410,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "They had over\n20,000 data assets,"
    } ]
  }, {
    "tStartMs": 3121930,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "many of which were untapped."
    } ]
  }, {
    "tStartMs": 3124370,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Knowledge Catalog\nis helping them"
    } ]
  }, {
    "tStartMs": 3126410,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "activate this data to empower\ntheir global product teams."
    } ]
  }, {
    "tStartMs": 3131730,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now, combined with\ndirect zero-copy access"
    } ]
  }, {
    "tStartMs": 3134530,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "to applications, operating\nsystems, and AI platforms"
    } ]
  }, {
    "tStartMs": 3137970,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "like Palantir, Salesforce,\nSAP, ServiceNow, and Workday,"
    } ]
  }, {
    "tStartMs": 3142810,
    "dDurationMs": 6168,
    "segs": [ {
      "utf8": "you now have instant context\nto your entire business."
    } ]
  }, {
    "tStartMs": 3148978,
    "dDurationMs": 1952,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3150930,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "That's right."
    } ]
  }, {
    "tStartMs": 3153530,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "This trusted context enables\nagents to act with certainty."
    } ]
  }, {
    "tStartMs": 3159450,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Now imagine this\npower in the hands"
    } ]
  }, {
    "tStartMs": 3161650,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "of every employee, every day."
    } ]
  }, {
    "tStartMs": 3164770,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We've integrated the Knowledge\nCatalog with Gemini Enterprise's"
    } ]
  }, {
    "tStartMs": 3168450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Deep Research Agent."
    } ]
  }, {
    "tStartMs": 3170850,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You can now enable\nmulti-step reasoning"
    } ]
  }, {
    "tStartMs": 3173250,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "across internal and web data for\nprecise cited business answers."
    } ]
  }, {
    "tStartMs": 3178810,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "What took weeks of manual\neffort now happens seamlessly."
    } ]
  }, {
    "tStartMs": 3185410,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This is the Knowledge Catalog."
    } ]
  }, {
    "tStartMs": 3188850,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Second, we are unveiling a\nGemini-powered data science"
    } ]
  }, {
    "tStartMs": 3192930,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "authoring experience that\nfundamentally transforms"
    } ]
  }, {
    "tStartMs": 3196130,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "how data practitioners work\nwith our new Data Agent Kit."
    } ]
  }, {
    "tStartMs": 3202170,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "We didn't just want to\nbuild another platform"
    } ]
  }, {
    "tStartMs": 3204780,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "you have to learn."
    } ]
  }, {
    "tStartMs": 3205960,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "Instead, the Data Agent Kit\nintegrates comprehensively"
    } ]
  }, {
    "tStartMs": 3211200,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "with libraries of AI\nskills and plugins directly"
    } ]
  }, {
    "tStartMs": 3214760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "into your workflows\nthat you already use."
    } ]
  }, {
    "tStartMs": 3217560,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Your IDE, your\nnotebook, your terminal,"
    } ]
  }, {
    "tStartMs": 3220480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "whether you are in VS Code,\nCloud Code, or Gemini CLI,"
    } ]
  }, {
    "tStartMs": 3224240,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "we instantly turn your\neveryday workspace"
    } ]
  }, {
    "tStartMs": 3227160,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "into a native data environment."
    } ]
  }, {
    "tStartMs": 3229800,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Here's how it works."
    } ]
  }, {
    "tStartMs": 3231760,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "You just state your intent,\npredict customer churn,"
    } ]
  }, {
    "tStartMs": 3236800,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and your environment\nsimply takes over."
    } ]
  }, {
    "tStartMs": 3239400,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It autonomously\nbuilds the pipelines"
    } ]
  }, {
    "tStartMs": 3241480,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and deploys the models right\non Google's Agentic Data Cloud."
    } ]
  }, {
    "tStartMs": 3246360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It handles all the complex\norchestration for you,"
    } ]
  }, {
    "tStartMs": 3249360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "creating a direct path from\nyour business objective"
    } ]
  }, {
    "tStartMs": 3252480,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "straight to the\nbusiness outcome."
    } ]
  }, {
    "tStartMs": 3255360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "For researchers at\nBayer Crop Science,"
    } ]
  }, {
    "tStartMs": 3257940,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "this eliminates manual data\nmanagement and analytics,"
    } ]
  }, {
    "tStartMs": 3261220,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "freeing them to focus on\npioneering agricultural"
    } ]
  }, {
    "tStartMs": 3264070,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "innovations for a sustainable\nand productive future."
    } ]
  }, {
    "tStartMs": 3270550,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Third, the demand on data is\nextreme in this agentic era."
    } ]
  }, {
    "tStartMs": 3275430,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "To address the scale\nchallenge, we're"
    } ]
  }, {
    "tStartMs": 3277510,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "unleashing the Lightning\nEngine for Apache Spark."
    } ]
  }, {
    "tStartMs": 3281830,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It not only delivers\nindustry-leading performance"
    } ]
  }, {
    "tStartMs": 3284590,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "for Spark."
    } ]
  }, {
    "tStartMs": 3285710,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Lightning Engine delivers up to\n2x the price performance over"
    } ]
  }, {
    "tStartMs": 3290030,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "the previous market leader."
    } ]
  }, {
    "tStartMs": 3292190,
    "dDurationMs": 3664,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3297230,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "We fundamentally rebuilt this\nengine for the agentic era,"
    } ]
  }, {
    "tStartMs": 3301830,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "reasoning with trusted context\nenables autonomous agents,"
    } ]
  }, {
    "tStartMs": 3305910,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "and with the Lightning\nEngine, that autonomy"
    } ]
  }, {
    "tStartMs": 3308270,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "operates at massive scale."
    } ]
  }, {
    "tStartMs": 3312070,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Industry-leading\norganizations like Flipkart,"
    } ]
  }, {
    "tStartMs": 3314610,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Lowe's, and Meesho are\naccelerating their Apache Spark"
    } ]
  }, {
    "tStartMs": 3318470,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "workloads with Lightning Engine."
    } ]
  }, {
    "tStartMs": 3323060,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Finally, let's\naddress the biggest"
    } ]
  }, {
    "tStartMs": 3325500,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and the longest-running\ndebate of all."
    } ]
  }, {
    "tStartMs": 3328420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Where should your data reside?"
    } ]
  }, {
    "tStartMs": 3330700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The reality is it\nlives everywhere--"
    } ]
  }, {
    "tStartMs": 3333220,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "at Google, at AWS, Azure, and\nacross your SaaS applications."
    } ]
  }, {
    "tStartMs": 3338620,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Your old lakehouse expected the\nanalytical engine and the data"
    } ]
  }, {
    "tStartMs": 3342980,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "storage to reside\nin the same cloud."
    } ]
  }, {
    "tStartMs": 3345940,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "This approach is broken."
    } ]
  }, {
    "tStartMs": 3348420,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Today, we are introducing\nthe Cross-Cloud Lakehouse,"
    } ]
  }, {
    "tStartMs": 3353540,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "where your analytical engine\nreasons over data in any cloud."
    } ]
  }, {
    "tStartMs": 3359400,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3364580,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Built on the open\nApache Iceberg standard,"
    } ]
  }, {
    "tStartMs": 3367480,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "it is completely borderless."
    } ]
  }, {
    "tStartMs": 3369380,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Instead of forcing you to accept\ncomplex networking hurdles"
    } ]
  }, {
    "tStartMs": 3373060,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "or massive egress fees, we\ndeliver low-latency direct"
    } ]
  }, {
    "tStartMs": 3376900,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "connectivity to AWS and Azure\nas if the data sat natively"
    } ]
  }, {
    "tStartMs": 3381370,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "in Google Cloud--"
    } ]
  }, {
    "tStartMs": 3383370,
    "dDurationMs": 5692,
    "segs": [ {
      "utf8": "no more moving data, no more\nvendor lock in-- just freedom."
    } ]
  }, {
    "tStartMs": 3389062,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3393730,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "No matter where your data\nlives, from traditional systems"
    } ]
  }, {
    "tStartMs": 3396930,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to SaaS applications, we\nprovide the trusted context"
    } ]
  }, {
    "tStartMs": 3400410,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and connectivity your\nbusiness needs to act upon."
    } ]
  }, {
    "tStartMs": 3404810,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "This is why customers are\nchoosing our Agentic Data"
    } ]
  }, {
    "tStartMs": 3408130,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Cloud to drive their\nagentic transformation."
    } ]
  }, {
    "tStartMs": 3413690,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "One example of this\ntransformation is Vodafone."
    } ]
  }, {
    "tStartMs": 3417170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Vodafone unified\ntheir data on BigQuery"
    } ]
  }, {
    "tStartMs": 3420170,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to build a more resilient global\nnetwork for their customers."
    } ]
  }, {
    "tStartMs": 3424490,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And with Gemini Enterprise, they\nare launching hundreds of agents"
    } ]
  }, {
    "tStartMs": 3428330,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "to proactively resolve outages\nand optimize infrastructure,"
    } ]
  }, {
    "tStartMs": 3432970,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "scaling network reliability\nand saving millions every year."
    } ]
  }, {
    "tStartMs": 3438290,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Macquarie Bank's goal\nwas to securely scale"
    } ]
  }, {
    "tStartMs": 3441410,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "AI across their entire\noperation to deliver"
    } ]
  }, {
    "tStartMs": 3444210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "more personalized\ncustomer experiences."
    } ]
  }, {
    "tStartMs": 3447450,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "They deployed Gemini\nEnterprise to all staff"
    } ]
  }, {
    "tStartMs": 3450650,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and supercharged productivity."
    } ]
  }, {
    "tStartMs": 3452530,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And for their two\nmillion customers,"
    } ]
  }, {
    "tStartMs": 3454970,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Macquarie's 24 by 7 AI\nassistant queue autonomously"
    } ]
  }, {
    "tStartMs": 3459610,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "answers banking questions."
    } ]
  }, {
    "tStartMs": 3462410,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "All of this was made possible\nby unifying their data"
    } ]
  }, {
    "tStartMs": 3465690,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "on BigQuery and Spanner."
    } ]
  }, {
    "tStartMs": 3468690,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "With this foundation, Macquarie\nhas already cut client losses"
    } ]
  }, {
    "tStartMs": 3472850,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "from scams by half."
    } ]
  }, {
    "tStartMs": 3475690,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "That's secure, frictionless\nbanking at scale."
    } ]
  }, {
    "tStartMs": 3480570,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "American Express\nis redefining trust"
    } ]
  }, {
    "tStartMs": 3483250,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "by centralizing its core\ndata on Google Cloud"
    } ]
  }, {
    "tStartMs": 3486370,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "to enable faster fraud and\nrisk analysis at global scale."
    } ]
  }, {
    "tStartMs": 3491930,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "Costco leverages BigQuery to\naccelerate member insights,"
    } ]
  }, {
    "tStartMs": 3495900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "empowering associates to\noptimize experience and maximize"
    } ]
  }, {
    "tStartMs": 3499400,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "value for millions of members."
    } ]
  }, {
    "tStartMs": 3502560,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "This is the Agentic Data Cloud."
    } ]
  }, {
    "tStartMs": 3505080,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You and your AI agents\nnow have a platform"
    } ]
  }, {
    "tStartMs": 3507960,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "that operates with\nuniversal context,"
    } ]
  }, {
    "tStartMs": 3510800,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "is defined by your\ndefined intent,"
    } ]
  }, {
    "tStartMs": 3513580,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "and scales autonomously\nacross your borderless data"
    } ]
  }, {
    "tStartMs": 3517040,
    "dDurationMs": 3835,
    "segs": [ {
      "utf8": "and the applications\nyou already use today."
    } ]
  }, {
    "tStartMs": 3520875,
    "dDurationMs": 3805,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3524680,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "To show you how to bring trusted\ncontext to your business,"
    } ]
  }, {
    "tStartMs": 3528500,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "please welcome Yasmeen Ahmad."
    } ]
  }, {
    "tStartMs": 3531606,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 3542800,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "YASMEEN AHMAD: Karthik\ngave us the recipe,"
    } ]
  }, {
    "tStartMs": 3544620,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "so now let's see how\nit all plates up."
    } ]
  }, {
    "tStartMs": 3547320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Most companies take five weeks\nto turn a trend into a decision."
    } ]
  }, {
    "tStartMs": 3551880,
    "dDurationMs": 2510,
    "segs": [ {
      "utf8": "We're going to do\nit in five minutes."
    } ]
  }, {
    "tStartMs": 3554390,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "To get there, we're\nbreaking three barriers--"
    } ]
  }, {
    "tStartMs": 3557150,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "dark data with our\nKnowledge Catalog, data"
    } ]
  }, {
    "tStartMs": 3560070,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "silos with our Cross-Cloud\nLakehouse, and manual code"
    } ]
  }, {
    "tStartMs": 3563590,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "with Google's new\nagentic tools and skills."
    } ]
  }, {
    "tStartMs": 3567190,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So let's get cooking."
    } ]
  }, {
    "tStartMs": 3569390,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Our new agentic\nworkflow triggers"
    } ]
  }, {
    "tStartMs": 3571390,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "have detected a tasty trend--"
    } ]
  }, {
    "tStartMs": 3573910,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Midnight Swirl froyo."
    } ]
  }, {
    "tStartMs": 3576030,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Looks delicious."
    } ]
  }, {
    "tStartMs": 3577430,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "But with any new flavor,\nI need to know is it safe?"
    } ]
  }, {
    "tStartMs": 3581230,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Are there any hidden allergens?"
    } ]
  }, {
    "tStartMs": 3583070,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Is there a market?"
    } ]
  }, {
    "tStartMs": 3584410,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Where are my hungry customers?"
    } ]
  }, {
    "tStartMs": 3586190,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "And is it worth it?"
    } ]
  }, {
    "tStartMs": 3587610,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "What's the real ROI?"
    } ]
  }, {
    "tStartMs": 3589790,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "But first, safety."
    } ]
  }, {
    "tStartMs": 3592470,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "We have thousands\nof PDF recipes."
    } ]
  }, {
    "tStartMs": 3595750,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I'm going to search for soy."
    } ]
  }, {
    "tStartMs": 3597790,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It's a top food allergen,\nand safety is non-negotiable."
    } ]
  }, {
    "tStartMs": 3601150,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Zero results--\nlooks good so far."
    } ]
  }, {
    "tStartMs": 3605350,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "But this recipe does contain\nan ingredient, base 204."
    } ]
  }, {
    "tStartMs": 3610390,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "Let's check the supplier\nmanual for base 204."
    } ]
  }, {
    "tStartMs": 3614620,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And here it is."
    } ]
  }, {
    "tStartMs": 3616800,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Base 204 actually contains soy."
    } ]
  }, {
    "tStartMs": 3619900,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "A simple GenAI search\nwould miss this connection"
    } ]
  }, {
    "tStartMs": 3622700,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "because the\ninformation is trapped"
    } ]
  }, {
    "tStartMs": 3625060,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "across two separate PDFs."
    } ]
  }, {
    "tStartMs": 3627380,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "So how do we digest\nall of this data"
    } ]
  }, {
    "tStartMs": 3630060,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to find those\nhidden connections?"
    } ]
  }, {
    "tStartMs": 3632620,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Well, I need an agent\nthat has the skill"
    } ]
  }, {
    "tStartMs": 3635420,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "to work with my PDF data\ncombined with our Knowledge"
    } ]
  }, {
    "tStartMs": 3638940,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Catalog."
    } ]
  }, {
    "tStartMs": 3640180,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Watch."
    } ]
  }, {
    "tStartMs": 3641220,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Our agent helps us\nfind hidden allergens"
    } ]
  }, {
    "tStartMs": 3643940,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "in a recipe for Midnight Swirl."
    } ]
  }, {
    "tStartMs": 3646900,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "And here it is."
    } ]
  }, {
    "tStartMs": 3648380,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Midnight Swirl contains soy, and\nit's giving me a data citation,"
    } ]
  }, {
    "tStartMs": 3653340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "a schema called product specs."
    } ]
  }, {
    "tStartMs": 3655980,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Now, this schema was generated\nby our Knowledge Catalog,"
    } ]
  }, {
    "tStartMs": 3659200,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "working with Gemini to reason\nover our supplier and recipe"
    } ]
  }, {
    "tStartMs": 3663140,
    "dDurationMs": 6630,
    "segs": [ {
      "utf8": "PDFs and extract entities like\nrecipe, ingredient, and allergen"
    } ]
  }, {
    "tStartMs": 3669770,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and mapping those previously\ninvisible connections"
    } ]
  }, {
    "tStartMs": 3672490,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "between them."
    } ]
  }, {
    "tStartMs": 3673970,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "This is trusted context\nbuilt over dark data."
    } ]
  }, {
    "tStartMs": 3678850,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Next, market size-- to\nlaunch this globally,"
    } ]
  }, {
    "tStartMs": 3682390,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "I need a precision\nlist of customers"
