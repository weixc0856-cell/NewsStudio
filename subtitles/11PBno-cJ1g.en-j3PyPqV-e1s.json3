  }, {
    "tStartMs": 5728050,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "together through one\nsingle user interface."
    } ]
  }, {
    "tStartMs": 5730970,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "This helps my\nprocurement colleagues"
