  }, {
    "tStartMs": 3943060,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "proactively sweep\nyour environments"
    } ]
  }, {
    "tStartMs": 3944860,
    "dDurationMs": 6400,
    "segs": [ {
      "utf8": "for risks at a scale and speed\nthat no human team could match."
    } ]
  }, {
    "tStartMs": 3951260,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "By leveraging Google's\nunparalleled telemetry,"
    } ]
  }, {
    "tStartMs": 3954200,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "including Mandiant,\nVirusTotal, and Chrome,"
    } ]
  }, {
    "tStartMs": 3957820,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "we are delivering\na defense system"
    } ]
  }, {
    "tStartMs": 3959700,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "based on global intelligence."
    } ]
  }, {
    "tStartMs": 3962330,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And now, with our integrated\ndark web intelligence,"
    } ]
  }, {
    "tStartMs": 3966050,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "we can identify external\nthreats with 98% accuracy."
    } ]
  }, {
    "tStartMs": 3971090,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Customers are already\nseeing big benefits"
    } ]
  }, {
    "tStartMs": 3973770,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "from Google Cloud's\nsecurity offerings."
    } ]
  }, {
    "tStartMs": 3976730,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "CME Group depends on a unified\nstack of Mandiant Security"
    } ]
  }, {
    "tStartMs": 3981210,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Command Center and\nGoogle's SecOps"
    } ]
  }, {
    "tStartMs": 3983810,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to protect the world's\nlargest derivatives"
    } ]
  }, {
    "tStartMs": 3986450,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "system against novel threats."
    } ]
  }, {
    "tStartMs": 3990330,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "In an ultra high-stakes\nenvironment,"
    } ]
  }, {
    "tStartMs": 3993130,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Google's security offering\nis matched by speed."
    } ]
  }, {
    "tStartMs": 3997290,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "CME Group achieves\nnanosecond precision"
    } ]
  }, {
    "tStartMs": 4000570,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "with Google's ultra\nlow-latency solution,"
    } ]
  }, {
    "tStartMs": 4003850,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "supporting billions\nof transactions"
    } ]
  }, {
    "tStartMs": 4006050,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "daily and lowering the barrier\nof entry for new traders."
    } ]
  }, {
    "tStartMs": 4010690,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now, the biggest threats\ntoday aren't just hackers."
    } ]
  }, {
    "tStartMs": 4013810,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It's also shadow AI,\nunauthorized models and agents"
    } ]
  }, {
    "tStartMs": 4018050,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "that are operating\nin your enterprise"
    } ]
  }, {
    "tStartMs": 4020570,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "but outside your control."
    } ]
  }, {
    "tStartMs": 4022890,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "And to meet this\nchallenge, we have"
    } ]
  }, {
    "tStartMs": 4024770,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "integrated the industry's\ndeepest security context"
    } ]
  }, {
    "tStartMs": 4028370,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "directly into our AI fabric."
    } ]
  }, {
    "tStartMs": 4031250,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That is why I am thrilled\nto officially welcome"
    } ]
  }, {
    "tStartMs": 4034850,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the Wiz team to Google Cloud."
    } ]
  }, {
    "tStartMs": 4037570,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 4044010,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Together, we are building\na new security posture"
    } ]
  }, {
    "tStartMs": 4047250,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "for the agentic enterprise."
    } ]
  }, {
    "tStartMs": 4049370,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "While the New agent platform\nin Gemini Enterprise"
    } ]
  }, {
    "tStartMs": 4052450,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "secures and governs\nyour agents, with Wiz,"
    } ]
  }, {
    "tStartMs": 4055870,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "we're now extending\nthat protection"
    } ]
  }, {
    "tStartMs": 4057770,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "to every asset on your premises\nand across all major clouds."
    } ]
  }, {
    "tStartMs": 4063770,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "To explain how\nwe're solving this,"
    } ]
  }, {
    "tStartMs": 4065870,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "I'm excited to introduce to\nthe stage Wiz co-founder Yinon"
    } ]
  }, {
    "tStartMs": 4069930,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Costica."
    } ]
  }, {
    "tStartMs": 4071250,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 4087600,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "YINON COSTICA:\nThank you, Francis."
    } ]
  }, {
    "tStartMs": 4089560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "At Wiz, our mission\nfrom day one has"
    } ]
  }, {
    "tStartMs": 4092840,
    "dDurationMs": 4479,
    "segs": [ {
      "utf8": "been to help customers protect\neverything they build and run."
    } ]
  }, {
    "tStartMs": 4097319,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "Wiz began by unifying code\nand cloud and runtime context"
    } ]
  }, {
    "tStartMs": 4101200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to move at developer speed."
    } ]
  }, {
    "tStartMs": 4103680,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "But AI has fundamentally\nchanged the environment."
    } ]
  }, {
    "tStartMs": 4108160,
    "dDurationMs": 3819,
    "segs": [ {
      "utf8": "With autonomous products,\nhyperscale code generation,"
    } ]
  }, {
    "tStartMs": 4111979,
    "dDurationMs": 4941,
    "segs": [ {
      "utf8": "and AI-weaponized threats, the\nstakes have never been higher."
    } ]
  }, {
    "tStartMs": 4116920,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "To protect this new\nfrontier, security"
    } ]
  }, {
    "tStartMs": 4119279,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "must now move at machine speed."
    } ]
  }, {
    "tStartMs": 4122520,
    "dDurationMs": 2639,
    "segs": [ {
      "utf8": "And that is exactly\nwhy we built Wiz"
    } ]
  }, {
    "tStartMs": 4125159,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "as the first AI\nApplication Protection"
    } ]
  }, {
    "tStartMs": 4128160,
    "dDurationMs": 3159,
    "segs": [ {
      "utf8": "Platform, or in short, AI APP."
    } ]
  }, {
    "tStartMs": 4131319,
    "dDurationMs": 4631,
    "segs": [ {
      "utf8": "It solves four key security\nchallenges for the AI era--"
    } ]
  }, {
    "tStartMs": 4135950,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "giving security unparalleled\nvisibility into the AI stack,"
    } ]
  }, {
    "tStartMs": 4140870,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "finding and proactively\nremediating critical risks"
    } ]
  }, {
    "tStartMs": 4145109,
    "dDurationMs": 4281,
    "segs": [ {
      "utf8": "before attackers can use\nthem, enabling our builders"
    } ]
  }, {
    "tStartMs": 4149390,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to start secure by\ndesign in their AI"
    } ]
  }, {
    "tStartMs": 4152510,
    "dDurationMs": 4639,
    "segs": [ {
      "utf8": "enabled IDEs, and lastly, arming\nSecOps teams to stop threats"
    } ]
  }, {
    "tStartMs": 4157149,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "to cloud and AI environments."
    } ]
  }, {
    "tStartMs": 4159670,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "In order to outpace\nattackers, Wiz"
    } ]
  }, {
    "tStartMs": 4162470,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "delivers a set of\nexpert AI agents."
    } ]
  }, {
    "tStartMs": 4166270,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It's a really cool concept."
    } ]
  }, {
    "tStartMs": 4168830,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Our red, blue, and\ngreen agents are"
    } ]
  }, {
    "tStartMs": 4172430,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "named after the teams\nthey help-- red, blue,"
    } ]
  }, {
    "tStartMs": 4175210,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and green teams."
    } ]
  }, {
    "tStartMs": 4176470,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "They form an AI layer to\nautonomously identify,"
    } ]
  }, {
    "tStartMs": 4180350,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "investigate, and then fix\ncritical risks at machine speed,"
    } ]
  }, {
    "tStartMs": 4184970,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "leveraging context from\nour unique security graph."
    } ]
  }, {
    "tStartMs": 4189310,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Security starts with\nvisibility, always."
    } ]
  }, {
    "tStartMs": 4192550,
    "dDurationMs": 950,
    "segs": [ {
      "utf8": "But today."
    } ]
  }, {
    "tStartMs": 4193500,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Your AI footprint is an orbit\nof interconnected tools."
    } ]
  }, {
    "tStartMs": 4197600,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "It spins models like\nGemini, Claude, OpenAI."
    } ]
  }, {
    "tStartMs": 4201540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Your teams are\nusing agent studios"
    } ]
  }, {
    "tStartMs": 4203820,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "such as Gemini Enterprise Agent\nPlatform, Lovable, Copilot"
    } ]
  }, {
    "tStartMs": 4209140,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Studio, Salesforce's Agentforce."
    } ]
  }, {
    "tStartMs": 4212060,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "And to secure all of\nthese environments,"
    } ]
  }, {
    "tStartMs": 4214480,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "we examine every layer--"
    } ]
  }, {
    "tStartMs": 4217100,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "the clouds, the data,\nthe models, the agents."
    } ]
  }, {
    "tStartMs": 4221860,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And we continuously\ncorrelate these risks"
    } ]
  }, {
    "tStartMs": 4224460,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "to find and fix the attack\npath that matter most."
    } ]
  }, {
    "tStartMs": 4228460,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Now let's see it in action."
    } ]
  }, {
    "tStartMs": 4231547,
    "dDurationMs": 3409,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 4240000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So this is Wiz."
    } ]
  }, {
    "tStartMs": 4242180,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Wiz basically starts by\nautomatically building"
    } ]
  }, {
    "tStartMs": 4245460,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "a dynamic inventory from\nyour code and cloud,"
    } ]
  }, {
    "tStartMs": 4248860,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "completely agentlessly."
    } ]
  }, {
    "tStartMs": 4250780,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "This means that you can\nsee every visibility"
    } ]
  }, {
    "tStartMs": 4254170,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "into the environment,\ninto everything"
    } ]
  }, {
    "tStartMs": 4256890,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "that your teams are building\nusing AI, without any friction."
    } ]
  }, {
    "tStartMs": 4262010,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Wiz then builds\nthe security graph."
    } ]
  }, {
    "tStartMs": 4265130,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The security graph-- think\nof it as a living map that"
    } ]
  }, {
    "tStartMs": 4268090,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "explains the architecture and\nthe logic of any AI application"
    } ]
  }, {
    "tStartMs": 4272210,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "it sees."
    } ]
  }, {
    "tStartMs": 4273130,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Here we see an example\nof an agent that"
    } ]
  }, {
    "tStartMs": 4275890,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "is actually running on cloud."
    } ]
  }, {
    "tStartMs": 4278370,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "It has tools to query a\ndatabase and even execute code."
    } ]
  }, {
    "tStartMs": 4282770,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And you can see\nthat Wiz actually"
    } ]
  }, {
    "tStartMs": 4285290,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "flags that this agent\nis internet-exposed."
    } ]
  }, {
    "tStartMs": 4289290,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And also, it has access to\nsensitive customer data."
    } ]
  }, {
    "tStartMs": 4293410,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Now, this is security\nmoving at the speed of AI."
    } ]
  }, {
    "tStartMs": 4298050,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "You don't need any reviews\nwith your development teams."
    } ]
  }, {
    "tStartMs": 4301130,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It just works."
    } ]
  }, {
    "tStartMs": 4303650,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And in the AI era,\nthe best defense"
    } ]
  }, {
    "tStartMs": 4307330,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "is to continuously use\nAI against ourselves"
    } ]
  }, {
    "tStartMs": 4310970,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "in order to give the defenders\nthe first-mover advantage"
    } ]
  }, {
    "tStartMs": 4315050,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "over the attackers."
    } ]
  }, {
    "tStartMs": 4316810,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "And this is exactly what\nthe Wiz Red Agent does."
    } ]
  }, {
    "tStartMs": 4320610,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It validates every single\nexposure that Wiz identified."
    } ]
  }, {
    "tStartMs": 4324850,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And you can think of\nit as a friendly hacker"
    } ]
  }, {
    "tStartMs": 4327370,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "that continuously scans your\noutside like an elite red team."
    } ]
  }, {
    "tStartMs": 4332970,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And look, this is a finding\nthat the Red Agent actually"
    } ]
  }, {
    "tStartMs": 4336890,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "found-- an authentication\nbypass vulnerability."
    } ]
  }, {
    "tStartMs": 4340330,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "This means that it\nenables an attacker"
    } ]
  }, {
    "tStartMs": 4343130,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "to gain access to that agent but\nalso to that sensitive database"
    } ]
  }, {
    "tStartMs": 4348250,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "behind it to exfiltrate\nsensitive information."
    } ]
  }, {
    "tStartMs": 4352210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Now, it's not a\npotential risk anymore."
    } ]
  }, {
    "tStartMs": 4355450,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "This is a validated risk."
    } ]
  }, {
    "tStartMs": 4357850,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "And this gives our\ndevelopers the prioritization"
    } ]
  }, {
    "tStartMs": 4361050,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and the confidence in\nfixing it immediately."
    } ]
  }, {
    "tStartMs": 4364650,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Now, in the past, triage used\nto mean very, very long meetings"
    } ]
  }, {
    "tStartMs": 4369480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and waiting and spreadsheets."
    } ]
  }, {
    "tStartMs": 4371560,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "And you don't need that anymore\nbecause we have the Wiz Green"
    } ]
  }, {
    "tStartMs": 4376520,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "Agent."
    } ]
  }, {
    "tStartMs": 4377300,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "The Wiz Green Agent automates\nthe entire triage process"
    } ]
  }, {
    "tStartMs": 4382040,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "from identifying the\nowner, suggesting the fix,"
    } ]
  }, {
    "tStartMs": 4386640,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "identifying the exact\nline of code that"
    } ]
  }, {
    "tStartMs": 4389320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "caused the risk in\nthe first place--"
    } ]
  }, {
    "tStartMs": 4391360,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "all automated-- no\nphone tag, no friction."
    } ]
  }, {
    "tStartMs": 4394300,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And from here,\nyou have a choice."
    } ]
  }, {
    "tStartMs": 4395980,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "You can send it to the\ndevelopers as a PR,"
    } ]
  }, {
    "tStartMs": 4398640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "or maybe better, send it to a\ncoding agent like CodeMender"
    } ]
  }, {
    "tStartMs": 4403040,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "to execute the final fix at\nthe source automatically."
    } ]
  }, {
    "tStartMs": 4406760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And this is how we can\nmove from a validated risk"
    } ]
  }, {
    "tStartMs": 4410200,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to a verified fix, end-to-end\nvisibility, control,"
    } ]
  }, {
    "tStartMs": 4414520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "and full confidence."
    } ]
  }, {
    "tStartMs": 4416280,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "So to summarize, whenever\nyou have an AI team that"
    } ]
  }, {
    "tStartMs": 4420920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "ships a new product or\neven someone in finance"
    } ]
  }, {
    "tStartMs": 4424040,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "that then codes a new agent,\nnow, within minutes, security"
    } ]
  }, {
    "tStartMs": 4428510,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "is able to, one, identify the\nagent and its architecture, two,"
    } ]
  }, {
    "tStartMs": 4433270,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "automatically conduct a security\nreview to find and validate"
    } ]
  }, {
    "tStartMs": 4437150,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "the risks, and three,\nautomatically suggest the fix,"
    } ]
  }, {
    "tStartMs": 4440610,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "send it to the dev teams\nin their own native tools."
    } ]
  }, {
    "tStartMs": 4443870,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "Ta-da."
    } ]
  }, {
    "tStartMs": 4444590,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "This is how AI agents\nunlock secure innovation"
    } ]
  }, {
    "tStartMs": 4448910,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "with AI at scale."
    } ]
  }, {
    "tStartMs": 4451750,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Thank you, all."
    } ]
  }, {
    "tStartMs": 4452650,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "Back to you, Francis."
    } ]
  }, {
    "tStartMs": 4454841,
    "dDurationMs": 2946,
    "segs": [ {
      "utf8": "[APPLAUSE, UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 4463123,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "FRANCIS DE SOUZA: The\nunique combination"
    } ]
  }, {
    "tStartMs": 4464790,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "of Google's agentic SOC and\nWiz's deep cloud context"
    } ]
  }, {
    "tStartMs": 4469230,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "gives customers the confidence\nto build and deploy generative"
    } ]
  }, {
    "tStartMs": 4472350,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "AI everywhere safely."
    } ]
  }, {
    "tStartMs": 4475670,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "We're helping the Los Angeles\nDepartment of Water and Power"
    } ]
  }, {
    "tStartMs": 4478790,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "secure critical infrastructure\nahead of the LA 28 games,"
    } ]
  }, {
    "tStartMs": 4483270,
    "dDurationMs": 3950,
    "segs": [ {
      "utf8": "while Singapore's CSIT\nenables proactive defense"
    } ]
  }, {
    "tStartMs": 4487220,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "against advanced\ndigital threats."
    } ]
  }, {
    "tStartMs": 4490260,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "DBS strengthens security\nby embedding Google Cloud's"
    } ]
  }, {
    "tStartMs": 4493540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "protection directly\ninto their architecture,"
    } ]
  }, {
    "tStartMs": 4496540,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "enabling real-time threat\ndetection and response,"
    } ]
  }, {
    "tStartMs": 4499700,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "reinforcing customer trust."
    } ]
  }, {
    "tStartMs": 4502780,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Morgan Stanley chose Wiz as\na key component of its cloud"
    } ]
  }, {
    "tStartMs": 4506420,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "security strategy and is\nexpanding visibility and control"
    } ]
  }, {
    "tStartMs": 4510420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "across its cloud environments."
    } ]
  }, {
    "tStartMs": 4512700,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Now, as part of this\nstrategy, the firm"
    } ]
  }, {
    "tStartMs": 4514820,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "is deploying Google Cloud\nSecurity capabilities to support"
    } ]
  }, {
    "tStartMs": 4518260,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "its evolving cloud platforms."
    } ]
  }, {
    "tStartMs": 4521500,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "And trusted global\nicons from Nestlé"
    } ]
  }, {
    "tStartMs": 4524340,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "to LVMH, from BMW to\nShell, rely on Wiz"
    } ]
  }, {
    "tStartMs": 4528020,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and Google Cloud Security to\nensure their AI-driven future"
    } ]
  }, {
    "tStartMs": 4532220,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "is secure by design."
    } ]
  }, {
    "tStartMs": 4534820,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "We have closed the loop between\nthe defender and the builder."
    } ]
  }, {
    "tStartMs": 4538980,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "Google and Wiz provide a\nunified agentic defense"
    } ]
  }, {
    "tStartMs": 4543370,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "that is secure by design\nand autonomous by nature."
    } ]
  }, {
    "tStartMs": 4547690,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Together, we are redefining\ncybersecurity for the AI era"
    } ]
  }, {
    "tStartMs": 4552650,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "so security teams can protect\ntheir organizations at machine"
    } ]
  }, {
    "tStartMs": 4556810,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "speed."
    } ]
  }, {
    "tStartMs": 4558170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "To share more about\nhow our agents are"
    } ]
  }, {
    "tStartMs": 4560090,
    "dDurationMs": 4611,
    "segs": [ {
      "utf8": "helping your customers,\nplease welcome Carrie Tharp."
    } ]
  }, {
    "tStartMs": 4564701,
    "dDurationMs": 4419,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 4580930,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "CARRIE THARP:\nThank you, Francis."
    } ]
  }, {
    "tStartMs": 4582570,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "A secure foundation gives you\nthe confidence to innovate."
    } ]
  }, {
    "tStartMs": 4586690,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "At Google, we are\nusing that foundation"
    } ]
  }, {
    "tStartMs": 4588930,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to solve two of your\nbiggest challenges--"
    } ]
  }, {
    "tStartMs": 4591570,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "serving your customers\nand helping your employees"
    } ]
  }, {
    "tStartMs": 4594570,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "work smarter."
    } ]
  }, {
    "tStartMs": 4595890,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "We do this by deploying a\ncoordinated agentic task"
    } ]
  }, {
    "tStartMs": 4599970,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "force, specialized\nagents that don't just"
    } ]
  }, {
    "tStartMs": 4603240,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "assist your team-- they\noperate alongside them."
    } ]
  }, {
    "tStartMs": 4607440,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "In the agentic era, an agent\nis no longer just a tool."
    } ]
  }, {
    "tStartMs": 4612000,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It's a strategic extension\nof your business, built"
    } ]
  }, {
    "tStartMs": 4615880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "to expand your reach, deepen\nengagement, and personalized"
    } ]
  }, {
    "tStartMs": 4620360,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "service at scale."
    } ]
  }, {
    "tStartMs": 4622560,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Earlier this year, we\nlaunched Gemini Enterprise"
    } ]
  }, {
    "tStartMs": 4625840,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "for Customer Experience,\na suite designed"
    } ]
  }, {
    "tStartMs": 4629240,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "to enhance the entire\ncustomer journey"
    } ]
  }, {
    "tStartMs": 4631840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from the first\nmoment of discovery"
    } ]
  }, {
    "tStartMs": 4634240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to ongoing service interactions."
    } ]
  }, {
    "tStartMs": 4637240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Central to this is\nagentic commerce."
    } ]
  }, {
    "tStartMs": 4640480,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We have introduced\npre-built shopping and food"
    } ]
  }, {
    "tStartMs": 4644160,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "ordering agents that\nhandle everything"
    } ]
  }, {
    "tStartMs": 4647080,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "from discovery to\ncheckout entirely"
    } ]
  }, {
    "tStartMs": 4650320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "through natural language."
    } ]
  }, {
    "tStartMs": 4651760,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "By pairing these agents with\nour customer engagement agents,"
    } ]
  }, {
    "tStartMs": 4656340,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "we've created a seamless\njourney from search"
    } ]
  }, {
    "tStartMs": 4659360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "to service, turning every\ninteraction into revenue"
    } ]
  }, {
    "tStartMs": 4663440,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and retention opportunities."
    } ]
  }, {
    "tStartMs": 4665760,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "For example, with the\nfood ordering agent,"
    } ]
  }, {
    "tStartMs": 4668660,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Papa John's is building a\nhyper-personalized system"
    } ]
  }, {
    "tStartMs": 4673360,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "that remembers customer\npreferences to get"
    } ]
  }, {
    "tStartMs": 4676160,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "the food to your door faster."
    } ]
  }, {
    "tStartMs": 4678720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "During live interactions,\nAgent Assist"
    } ]
  }, {
    "tStartMs": 4681720,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "coaches employees to deliver\nfast and more accurate"
    } ]
  }, {
    "tStartMs": 4685600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "answers to customer questions."
    } ]
  }, {
    "tStartMs": 4688600,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "For example, Best Buy\nis guiding shoppers"
    } ]
  }, {
    "tStartMs": 4691360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "through those\ncomplex tech specs,"
    } ]
  }, {
    "tStartMs": 4693760,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "issue resolution, and\nappointment scheduling,"
    } ]
  }, {
    "tStartMs": 4697080,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "all autonomously."
    } ]
  }, {
    "tStartMs": 4699160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And our new omnichannel\ngateway helps"
    } ]
  }, {
    "tStartMs": 4701880,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "ensure your agents maintain\ncontacts across every surface--"
    } ]
  }, {
    "tStartMs": 4706000,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "web, mobile, voice-- while\npreserving universal consumer"
    } ]
  }, {
    "tStartMs": 4711720,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "context."
    } ]
  }, {
    "tStartMs": 4713440,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "If a customer moves from a\ntext chat to a phone call,"
    } ]
  }, {
    "tStartMs": 4717280,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "the agent seamlessly remembers\nexactly where they left off,"
    } ]
  }, {
    "tStartMs": 4721790,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and this scales\nglobally, conversing"
    } ]
  }, {
    "tStartMs": 4723990,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "with human-like\nvoice capabilities"
    } ]
  }, {
    "tStartMs": 4726230,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "in multiple languages."
    } ]
  }, {
    "tStartMs": 4728830,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Gemini Enterprise for\nCustomer Experience"
    } ]
  }, {
    "tStartMs": 4731270,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "is the technology powering\nthe Home Depot's Magic Apron"
    } ]
  }, {
    "tStartMs": 4734870,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Assistant to reach customers\nacross every channel."
    } ]
  }, {
    "tStartMs": 4738630,
    "dDurationMs": 1812,
    "segs": [ {
      "utf8": "Let's hear from the Home Depot."
    } ]
  }, {
    "tStartMs": 4740442,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "JORDAN BROGGI: There's\na customer journey"
    } ]
  }, {
    "tStartMs": 4742150,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "that often starts with\ninspiration, goes into research,"
    } ]
  }, {
    "tStartMs": 4744930,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and then into shopping and\nbuying and then into doing."
    } ]
  }, {
    "tStartMs": 4747610,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "And Magic Apron is\nreally a digital agent"
    } ]
  }, {
    "tStartMs": 4749870,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "to help through\nthat whole journey,"
    } ]
  }, {
    "tStartMs": 4751650,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "and it is really there to\nprovide that orange apron"
    } ]
  }, {
    "tStartMs": 4755030,
    "dDurationMs": 3290,
    "segs": [ {
      "utf8": "experience for help and\ncustomer service, the same way"
    } ]
  }, {
    "tStartMs": 4758320,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "that as you come into\na store, you're used"
    } ]
  }, {
    "tStartMs": 4760070,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "to that great customer service."
    } ]
  }, {
    "tStartMs": 4763550,
    "dDurationMs": 2992,
    "segs": [ {
      "utf8": "So we've had a partnership with\nGoogle for quite some time,"
    } ]
  }, {
    "tStartMs": 4766542,
    "dDurationMs": 2208,
    "segs": [ {
      "utf8": "and the latest things that\nthey're bringing to market"
    } ]
  }, {
    "tStartMs": 4768750,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "are incredibly exciting to us."
    } ]
  }, {
    "tStartMs": 4771270,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "ANGIE BROWN: We're really\nexcited about Magic Apron"
    } ]
  }, {
    "tStartMs": 4774590,
    "dDurationMs": 1610,
    "segs": [ {
      "utf8": "Shopping Assistant."
    } ]
  }, {
    "tStartMs": 4776200,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Our relationship with Google\nhas really made this possible"
    } ]
  }, {
    "tStartMs": 4778940,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "in a variety of different ways."
    } ]
  }, {
    "tStartMs": 4780480,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "If you just focus for a\nsecond on Gemini Enterprise"
    } ]
  }, {
    "tStartMs": 4783140,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "and you think about how it's\nthe bedrock of what we are doing"
    } ]
  }, {
    "tStartMs": 4786460,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "with Magic Apron, it\ngives us the power"
    } ]
  }, {
    "tStartMs": 4789220,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "and the speed in which\nwe need in order to power"
    } ]
  }, {
    "tStartMs": 4793100,
    "dDurationMs": 1828,
    "segs": [ {
      "utf8": "these great technologies."
    } ]
  }, {
    "tStartMs": 4794928,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "JORDAN BROGGI: Now,\nwith Gemini Enterprise,"
    } ]
  }, {
    "tStartMs": 4796720,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "we think that we can blend\nthose channels because we'll"
    } ]
  }, {
    "tStartMs": 4799740,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "have an agentic back end."
    } ]
  }, {
    "tStartMs": 4801080,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Maybe most importantly, we see a\nhigher conversion rate when they"
    } ]
  }, {
    "tStartMs": 4805140,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "leverage the tool\nversus when they don't."
    } ]
  }, {
    "tStartMs": 4808220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "When customers come into the\nstore and they use Magic Apron,"
    } ]
  }, {
    "tStartMs": 4810920,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "typically it's about wayfinding."
    } ]
  }, {
    "tStartMs": 4812592,
    "dDurationMs": 1208,
    "segs": [ {
      "utf8": "It's about product knowledge."
    } ]
  }, {
    "tStartMs": 4813800,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "It's about compatibility."
    } ]
  }, {
    "tStartMs": 4815340,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "But they also use it\nat home on our website."
    } ]
  }, {
    "tStartMs": 4817760,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Those experiences should\nall get better-- easier"
    } ]
  }, {
    "tStartMs": 4820380,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "to be inspired, easier to\nfind what I need, easier"
    } ]
  }, {
    "tStartMs": 4823500,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "to order it and get it, easier\nto get support after the fact."
    } ]
  }, {
    "tStartMs": 4826122,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "ANGIE BROWN: The\npartnership really"
    } ]
  }, {
    "tStartMs": 4827580,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "keeps us at the\nforefront of building"
    } ]
  }, {
    "tStartMs": 4829500,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "great experiences for our\ncustomers and our associates."
    } ]
  }, {
