    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "on their new shopping assistant."
    } ]
  }, {
    "tStartMs": 936990,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And for a mission that's quite\nliterally out of this world,"
