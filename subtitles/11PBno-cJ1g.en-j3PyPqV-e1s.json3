  }, {
    "tStartMs": 1631290,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "team."
    } ]
  }, {
    "tStartMs": 1633090,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "It connects directly with Jira\nto give a developer full context"
    } ]
  }, {
    "tStartMs": 1637730,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "for a seamless handoff."
    } ]
  }, {
    "tStartMs": 1640050,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "And on the developer's\nend, I'll automatically"
    } ]
  }, {
    "tStartMs": 1643210,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "get a notification right here\nin my Google Chat with that Jira"
