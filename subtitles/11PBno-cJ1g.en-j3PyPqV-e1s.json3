  }, {
    "tStartMs": 5588360,
    "dDurationMs": 3710,
    "segs": [ {
      "utf8": "and interoperability\nenhancements."
    } ]
  }, {
    "tStartMs": 5592070,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Today, you've seen what it looks\nlike to fundamentally change"
