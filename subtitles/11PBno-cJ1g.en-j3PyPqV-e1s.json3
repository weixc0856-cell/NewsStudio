  }, {
    "tStartMs": 958870,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "and ensure astronaut safety\nfor Artemis II, which"
    } ]
  }, {
    "tStartMs": 963510,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "set the human spaceflight\nrecord for traveling"
    } ]
  }, {
    "tStartMs": 966790,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "the furthest\ndistance from Earth."
    } ]
  }, {
    "tStartMs": 969390,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Now, we built the agent platform\nto manage the entire lifecycle"
    } ]
  }, {
    "tStartMs": 973870,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "of an agent."
    } ]
  }, {
    "tStartMs": 975270,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "The low-code Agent Studio\nenables every employee"
    } ]
  }, {
    "tStartMs": 978990,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "to build and deploy agents\nusing natural language."
    } ]
  }, {
    "tStartMs": 982870,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "It grounds LLM reasoning in\nyour specific business rules,"
    } ]
  }, {
    "tStartMs": 987990,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "bringing predictable,\nautonomous action"
    } ]
  }, {
    "tStartMs": 990390,
    "dDurationMs": 2950,
    "segs": [ {
      "utf8": "to every workflow at scale."
    } ]
  }, {
    "tStartMs": 993340,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "To manage these assets,\nthe agent registry"
    } ]
  }, {
    "tStartMs": 997100,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "provides a single\npoint of control,"
    } ]
  }, {
    "tStartMs": 999740,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "indexing every\ninternal agent and tool"
    } ]
  }, {
    "tStartMs": 1002180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "across your organization\nto ensure they're"
    } ]
  }, {
    "tStartMs": 1004940,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "discoverable and governed."
    } ]
  }, {
    "tStartMs": 1007860,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Similarly, our Skills\nand Tools Registry"
    } ]
  }, {
    "tStartMs": 1011580,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "allows you to define\nmodular, reusable packages"
    } ]
  }, {
    "tStartMs": 1015140,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of instructions,\nscripts, and resources"
    } ]
  }, {
    "tStartMs": 1018020,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "to teach agents to perform\nspecialized tasks or repeatable"
    } ]
  }, {
    "tStartMs": 1022740,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "workflows."
    } ]
  }, {
    "tStartMs": 1024380,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "We also expose skills\nfor every GCP service"
