  }, {
    "tStartMs": 4924520,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "subscriptions."
    } ]
  }, {
    "tStartMs": 4925600,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "It's currently\nlive in production,"
