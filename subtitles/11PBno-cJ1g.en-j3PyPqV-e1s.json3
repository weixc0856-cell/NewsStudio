  }, {
    "tStartMs": 4992948,
    "dDurationMs": 512,
    "segs": [ {
      "utf8": "as well."
    } ]
  }, {
    "tStartMs": 4993460,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "I just wanted to see what\nhe thinks about this."
    } ]
  }, {
    "tStartMs": 4995418,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "[SPEAKING SPANISH]"
    } ]
  }, {
    "tStartMs": 4999000,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Actually, could you just quickly\nsummarize this plan for him"
