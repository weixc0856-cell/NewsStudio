  }, {
    "tStartMs": 906240,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "allowing clients and\ncolleagues to ask"
    } ]
  }, {
    "tStartMs": 909840,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "more of Citi Wealth\nwhenever they need it,"
    } ]
  }, {
    "tStartMs": 912880,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and in multiple languages."
    } ]
  }, {
    "tStartMs": 915680,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Honeywell generates billions of\ninsights for managing buildings"
    } ]
  }, {
    "tStartMs": 920200,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "by training digital twins\non over a million product"
