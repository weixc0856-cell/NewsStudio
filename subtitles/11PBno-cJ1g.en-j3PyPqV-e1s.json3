  }, {
    "tStartMs": 4894520,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "experiences."
    } ]
  }, {
    "tStartMs": 4895880,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Let's take a look at how one\nof our first internal customers"
