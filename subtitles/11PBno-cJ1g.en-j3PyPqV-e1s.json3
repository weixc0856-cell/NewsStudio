  }, {
    "tStartMs": 5213120,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "productivity tool."
    } ]
  }, {
    "tStartMs": 5214960,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "But even with the best\ntools at our fingertips,"
    } ]
  }, {
    "tStartMs": 5218600,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "work can still feel\nincredibly fragmented."
    } ]
  }, {
    "tStartMs": 5221760,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "We've all been there."
    } ]
  }, {
    "tStartMs": 5223060,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "You're trying to answer\none simple question,"
    } ]
  }, {
    "tStartMs": 5225940,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "and 10 minutes later,\nyou have 15 tabs open."
    } ]
  }, {
    "tStartMs": 5229280,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "You're jumping\nfrom a stale email"
    } ]
  }, {
    "tStartMs": 5231160,
    "dDurationMs": 2745,
    "segs": [ {
      "utf8": "to a slide deck that's\nbeing edited as you watch"
    } ]
  }, {
    "tStartMs": 5233905,
    "dDurationMs": 1375,
    "segs": [ {
      "utf8": "and digging through\na spreadsheet"
    } ]
  }, {
    "tStartMs": 5235280,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "just to find a quick answer."
    } ]
  }, {
    "tStartMs": 5238320,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "We all spend half our\nday finding information"
    } ]
  }, {
    "tStartMs": 5241860,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "and the other half figuring\nout what to do with it."
    } ]
  }, {
    "tStartMs": 5245480,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "What if you could skip both?"
    } ]
  }, {
    "tStartMs": 5249440,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Today, we're introducing\nWorkspace Intelligence."
    } ]
  }, {
    "tStartMs": 5253840,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 5257760,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "With the advanced reasoning\ncapabilities of Gemini"
    } ]
  }, {
    "tStartMs": 5260560,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and state-of-the-art\nembedding models,"
    } ]
  }, {
    "tStartMs": 5262520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "we're eliminating context\nfragmentation across"
    } ]
  }, {
    "tStartMs": 5265760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the Workspace suite."
    } ]
  }, {
    "tStartMs": 5268000,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Think of it as a\nunified intelligence"
    } ]
  }, {
    "tStartMs": 5270240,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "layer that lives inside\nevery Workspace app."
    } ]
  }, {
    "tStartMs": 5273600,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "It connects the dots and\nlets AI do the heavy lifting."
    } ]
  }, {
    "tStartMs": 5277720,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "Let's see it in action."
    } ]
  }, {
    "tStartMs": 5280130,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 5290440,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "So remember that furniture\nrebrand you saw earlier?"
    } ]
  }, {
    "tStartMs": 5294480,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Let's say I'm the\nregional distributor,"
