    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "in how we work with you."
    } ]
  }, {
    "tStartMs": 5756770,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "We believe the future\nof AI must be open."
