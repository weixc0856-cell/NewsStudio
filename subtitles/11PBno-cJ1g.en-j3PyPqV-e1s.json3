  }, {
    "tStartMs": 5005920,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "football."
    } ]
  }, {
    "tStartMs": 5008104,
    "dDurationMs": 2686,
    "segs": [ {
      "utf8": "SPEAKER 4: [SPEAKING SPANISH]"
    } ]
  }, {
    "tStartMs": 5022702,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "PATRICK MARLOW: Look,\none other question."
    } ]
  }, {
    "tStartMs": 5024410,
    "dDurationMs": 1717,
    "segs": [ {
      "utf8": "I was planning on\nsetting up multiple TVs"
