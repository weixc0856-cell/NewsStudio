  }, {
    "tStartMs": 5035370,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "you can stream on up to three\nscreens at the same time."
    } ]
  }, {
    "tStartMs": 5038730,
    "dDurationMs": 958,
    "segs": [ {
      "utf8": "Is there anything else?"
    } ]
  }, {
    "tStartMs": 5039688,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "PATRICK MARLOW: Awesome."
    } ]
  }, {
    "tStartMs": 5040688,
    "dDurationMs": 1622,
    "segs": [ {
      "utf8": "No, look, I'm\nactually in the middle"
