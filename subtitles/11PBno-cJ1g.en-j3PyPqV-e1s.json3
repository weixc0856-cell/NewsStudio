  }, {
    "tStartMs": 5168210,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "This is the power\nof Gemini Enterprise"
    } ]
  }, {
    "tStartMs": 5170770,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "for Customer Experience."
