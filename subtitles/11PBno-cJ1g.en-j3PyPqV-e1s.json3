  }, {
    "tStartMs": 1029300,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and every service in Workspace\nin our skills registry."
    } ]
  }, {
    "tStartMs": 1034180,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "All of this is also supported\nby our Agent Marketplace,"
    } ]
  }, {
    "tStartMs": 1038460,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "allowing you to\nsearch and deploy"
    } ]
  }, {
    "tStartMs": 1041180,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "specialized agents from our\nglobal partner ecosystem"
    } ]
  }, {
    "tStartMs": 1045540,
    "dDurationMs": 6380,
    "segs": [ {
      "utf8": "directly in Gemini Enterprise,\nincluding Atlassian, Box,"
    } ]
  }, {
    "tStartMs": 1051920,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "Lovable, Oracle, ServiceNow,\nWorkday, and many, many more."
    } ]
  }, {
    "tStartMs": 1058460,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Finally, with our\nnative integration"
    } ]
  }, {
    "tStartMs": 1061580,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "of Model Context\nProtocol, or MCP,"
    } ]
  }, {
    "tStartMs": 1064980,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "you can connect our agent\nplatform to any MCP server."
    } ]
  }, {
    "tStartMs": 1069700,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "We're also exposing\nall of our GCP services"
    } ]
  }, {
    "tStartMs": 1074020,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "as MCP to allow you\nto interact seamlessly"
    } ]
  }, {
    "tStartMs": 1077580,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "with GCP from any agent."
    } ]
  }, {
    "tStartMs": 1081220,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "In addition to developing\nthis agent platform,"
    } ]
  }, {
    "tStartMs": 1084180,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "it also provides the framework\nto orchestrate and scale"
    } ]
  }, {
    "tStartMs": 1088820,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "your entire agentic workforce."
    } ]
  }, {
    "tStartMs": 1091380,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "We enable agent-to-agent\norchestration,"
    } ]
  }, {
    "tStartMs": 1094860,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "allowing agents to seamlessly\ndelegate tasks from one"
    } ]
  }, {
    "tStartMs": 1098660,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "to another, including support\nfor complex generative"
    } ]
  }, {
    "tStartMs": 1104460,
    "dDurationMs": 3350,
    "segs": [ {
      "utf8": "and deterministic\norchestration patterns."
    } ]
  }, {
    "tStartMs": 1107810,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "This helps ensure that for\nyour critical workflows,"
    } ]
  }, {
    "tStartMs": 1111730,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "such as those that\nneed compliance,"
    } ]
  }, {
    "tStartMs": 1114850,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "your agents can follow\nwell-specified paths"
    } ]
  }, {
    "tStartMs": 1118650,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "every single time, guaranteeing\npredictable outcomes."
    } ]
  }, {
    "tStartMs": 1124010,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Orchestration flows and\nagents can respond to events."
    } ]
  }, {
    "tStartMs": 1127610,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "These events can be real-time."
    } ]
  }, {
    "tStartMs": 1129730,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "They can be schedule-based."
    } ]
  }, {
    "tStartMs": 1131890,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "They can be trigger-based, or\nthey can be batch inference job."
    } ]
  }, {
    "tStartMs": 1136690,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "We're bringing\nzero-trust verification"
    } ]
  }, {
    "tStartMs": 1139930,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "to every agent and every\norchestration step."
    } ]
  }, {
    "tStartMs": 1144490,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "And now with Agent\nIdentity, every agent"
    } ]
  }, {
    "tStartMs": 1149650,
    "dDurationMs": 6160,
    "segs": [ {
      "utf8": "has a unique cryptographic ID\nand well-defined authorization"
    } ]
  }, {
    "tStartMs": 1155810,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "policies that are\ntraceable and auditable,"
    } ]
  }, {
    "tStartMs": 1159290,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "ensuring you can track\nevery action in your company"
    } ]
  }, {
    "tStartMs": 1164130,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "and manage all your agents."
    } ]
  }, {
    "tStartMs": 1167680,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "They're also centrally managed\nthrough our Agent Gateway, which"
    } ]
  }, {
    "tStartMs": 1172440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "provides a single command\ncenter for policy enforcement"
    } ]
  }, {
    "tStartMs": 1176440,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "across the organization."
    } ]
  }, {
    "tStartMs": 1178360,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Paired with Model Armor,\nyou protect your models."
    } ]
  }, {
    "tStartMs": 1182240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "You protect your\nproprietary enterprise data"
    } ]
  }, {
    "tStartMs": 1185040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "from threats such as\nsensitive data leakage."
    } ]
  }, {
    "tStartMs": 1189040,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "This integrated approach,\nfrom secure sandboxes"
    } ]
  }, {
    "tStartMs": 1194080,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "to a single management console,\nprovides the visibility"
    } ]
  }, {
    "tStartMs": 1197840,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "and isolation you need to run\nyour most-sensitive workloads"
    } ]
  }, {
    "tStartMs": 1203480,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "with a high degree\nof confidence."
    } ]
  }, {
    "tStartMs": 1206320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Now, optimization\nand observability"
    } ]
  }, {
    "tStartMs": 1208920,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "are also built into the\nfabric of the platform."
    } ]
  }, {
    "tStartMs": 1212400,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Agent observability delivers\ngranular instrumentation,"
    } ]
  }, {
    "tStartMs": 1216840,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "allowing you to visualize\nthe full execution"
    } ]
  }, {
    "tStartMs": 1219760,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "path of any agent using\nOTel-compliant telemetry."
    } ]
  }, {
    "tStartMs": 1225070,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "You can retrieve traces,\nmonitor tool use,"
    } ]
  }, {
    "tStartMs": 1228870,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "quickly diagnose reasoning\nloops with fine-grained logging."
    } ]
  }, {
    "tStartMs": 1233910,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "All of these capabilities\nthat we've just detailed--"
    } ]
  }, {
    "tStartMs": 1237470,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "the orchestration, zero-trust\nsecurity, and developer tools--"
    } ]
  }, {
    "tStartMs": 1242670,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "form the core engine\nof Gemini Enterprise."
    } ]
  }, {
    "tStartMs": 1246430,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "While the agent platform is\nwhere your technical teams build"
    } ]
  }, {
    "tStartMs": 1249510,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and govern agent, the Gemini\nEnterprise application"
    } ]
  }, {
    "tStartMs": 1253510,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "is the primary environment where\nyour business actually operates."
    } ]
  }, {
    "tStartMs": 1258510,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It's that new front door to\nAI for all your employees,"
    } ]
  }, {
    "tStartMs": 1262170,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "turning complex\nagentic capabilities"
    } ]
  }, {
    "tStartMs": 1264830,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "into a simple, new way to\nwork for every employee."
    } ]
  }, {
    "tStartMs": 1270310,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "By unifying data across\nyour entire stack,"
    } ]
  }, {
    "tStartMs": 1273790,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "including Google\nWorkspace, coding tools,"
    } ]
  }, {
    "tStartMs": 1277630,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and enterprise\nsystems, we've created"
    } ]
  }, {
    "tStartMs": 1280230,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "a single intelligent flow\nfor the entire organization."
    } ]
  }, {
    "tStartMs": 1284740,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "To give your teams\na permanent memory,"
    } ]
  }, {
    "tStartMs": 1288220,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "we're introducing Gemini\nEnterprise projects."
    } ]
  }, {
    "tStartMs": 1292220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Projects give your agents\na high-fidelity workspace"
    } ]
  }, {
    "tStartMs": 1296900,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "and the ability\nto use deep think"
    } ]
  }, {
    "tStartMs": 1299260,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to solve your most complex\nbusiness challenges"
    } ]
  }, {
    "tStartMs": 1302260,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "without context pollution."
    } ]
  }, {
    "tStartMs": 1305020,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "We're also adding Microsoft\n365 interoperability,"
    } ]
  }, {
    "tStartMs": 1308700,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "allowing you to export\nthe Docs and Slides you've"
    } ]
  }, {
    "tStartMs": 1311620,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "created within Canvas into\ncommon Microsoft Office formats."
    } ]
  }, {
    "tStartMs": 1316460,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 1322020,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Leading innovators\nalready use this platform"
    } ]
  }, {
    "tStartMs": 1325220,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "to redefine their industries."
    } ]
  }, {
    "tStartMs": 1327460,
    "dDurationMs": 4112,
    "segs": [ {
      "utf8": "Let's hear from one of\nthem, Virgin Voyages."
    } ]
  }, {
    "tStartMs": 1331572,
    "dDurationMs": 2832,
    "segs": [ {
      "utf8": "[STIRRING MUSIC]"
    } ]
  }, {
    "tStartMs": 1335737,
    "dDurationMs": 2083,
    "segs": [ {
      "utf8": "NIRMAL SAVERIMUTTU: Our\npeople are a secret sauce."
    } ]
  }, {
    "tStartMs": 1337820,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "So anytime we can use data to\nmake our people more empowered,"
    } ]
  }, {
    "tStartMs": 1341760,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "we're all in."
    } ]
  }, {
    "tStartMs": 1343420,
    "dDurationMs": 3385,
    "segs": [ {
      "utf8": "Gemini Enterprise is a front\ndoor for AI in our business,"
    } ]
  }, {
    "tStartMs": 1346805,
    "dDurationMs": 2375,
    "segs": [ {
      "utf8": "and we're using it to bring\nnatural language intelligence"
    } ]
  }, {
    "tStartMs": 1349180,
    "dDurationMs": 902,
    "segs": [ {
      "utf8": "to our crew."
    } ]
  }, {
    "tStartMs": 1350082,
    "dDurationMs": 2458,
    "segs": [ {
      "utf8": "BILLY BOHAN CHINIQUE: Gemini\nEnterprise is helping us bring"
    } ]
  }, {
    "tStartMs": 1352540,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Project 3D to life."
    } ]
  }, {
    "tStartMs": 1353760,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "It's going to allow our\ncrew to feel confident"
    } ]
  }, {
    "tStartMs": 1356380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "with any question they're asked."
    } ]
  }, {
    "tStartMs": 1358240,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "So for sailors, Rovey\nis a personal concierge"
    } ]
  }, {
    "tStartMs": 1361100,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "to maximize the value they\nget out of their vacation,"
    } ]
  }, {
    "tStartMs": 1364420,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "inspired at home all the\nway through the last day"
    } ]
  }, {
    "tStartMs": 1366540,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "of their voyage to make\nsure they have the best"
    } ]
  }, {
    "tStartMs": 1368498,
    "dDurationMs": 1882,
    "segs": [ {
      "utf8": "time on vacation with us."
    } ]
  }, {
    "tStartMs": 1370380,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Our crew are already\nworld-renowned and award-winning"
    } ]
  }, {
    "tStartMs": 1373180,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "for the exceptional service\nthey deliver as humans."
    } ]
  }, {
    "tStartMs": 1375860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "We want Project 3D and Gemini\nEnterprise to be able to take"
    } ]
  }, {
    "tStartMs": 1378980,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that even further."
    } ]
  }, {
    "tStartMs": 1380420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So you can imagine\nwhen you're building"
    } ]
  }, {
    "tStartMs": 1382220,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "something for a\ncruise ship, there"
    } ]
  }, {
    "tStartMs": 1383820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "are challenges that pop up."
    } ]
  }, {
    "tStartMs": 1385260,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "There's not exactly a\nfiber cable running out"
    } ]
  }, {
    "tStartMs": 1387420,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "the back of the ship."
    } ]
  }, {
    "tStartMs": 1388500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "With Google\nDistributed Cloud Edge,"
    } ]
  }, {
    "tStartMs": 1390440,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "we had data resiliency at\nthe core of the project."
    } ]
  }, {
    "tStartMs": 1393280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And that means, even\nwhen we're offline,"
    } ]
  }, {
    "tStartMs": 1395560,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "our intelligence\nis still online."
    } ]
  }, {
    "tStartMs": 1397860,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Using our AI stack in\nGoogle Cloud has helped us"
    } ]
  }, {
    "tStartMs": 1401130,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "not only reduce our production\ntimeline by up to 60%,"
    } ]
  }, {
    "tStartMs": 1404790,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "but we have contributed\nto a 28% increase month"
    } ]
  }, {
    "tStartMs": 1407930,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "on month for a\nrecord sales quarter."
    } ]
  }, {
    "tStartMs": 1411930,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "We could truly see a day where\nyou get on a Virgin Atlantic"
    } ]
  }, {
    "tStartMs": 1414810,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "flight, stay at a\nVirgin hotel, and end up"
    } ]
  }, {
    "tStartMs": 1417210,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "on a Virgin Voyage, all\nconnected seamlessly by Project"
    } ]
  }, {
    "tStartMs": 1420450,
    "dDurationMs": 1125,
    "segs": [ {
      "utf8": "Ruby and Gemini Enterprise."
    } ]
  }, {
    "tStartMs": 1421575,
    "dDurationMs": 1458,
    "segs": [ {
      "utf8": "NIRMAL SAVERIMUTTU:\nGoogle has been"
    } ]
  }, {
    "tStartMs": 1423033,
    "dDurationMs": 1417,
    "segs": [ {
      "utf8": "a foundational partner for us."
    } ]
  }, {
    "tStartMs": 1424450,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "The extension of Gemini."
    } ]
  }, {
    "tStartMs": 1425510,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Enterprise was the natural way\nto bring that mission to life."
    } ]
  }, {
    "tStartMs": 1433032,
    "dDurationMs": 2868,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 1438290,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "THOMAS KURIAN: The era\nof the pilot is over."
    } ]
  }, {
    "tStartMs": 1440810,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The era of the agent is here."
    } ]
  }, {
    "tStartMs": 1443170,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "But the true power comes from\nhow it changes your workflow."
    } ]
  }, {
    "tStartMs": 1447610,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Let's see it in action."
    } ]
  }, {
    "tStartMs": 1449410,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Please welcome Erika Chuong."
    } ]
  }, {
    "tStartMs": 1451890,
    "dDurationMs": 4293,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 1461920,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "ERIKA CHUONG: Thanks, Thomas."
    } ]
  }, {
    "tStartMs": 1463480,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Gemini Enterprise is a\nplatform to build, manage,"
    } ]
  }, {
    "tStartMs": 1467140,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and interact with agents."
    } ]
  }, {
    "tStartMs": 1468600,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "I'll demonstrate how it can\norchestrate multiple agents"
    } ]
  }, {
    "tStartMs": 1471160,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "across platforms, share\ncontext for seamless handoffs,"
    } ]
  }, {
    "tStartMs": 1474780,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "and streamline workflows."
    } ]
  }, {
    "tStartMs": 1476560,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Imagine I work for a\nglobal furniture retailer."
    } ]
  }, {
    "tStartMs": 1479720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Here's my personalized\nhomepage where"
    } ]
  }, {
    "tStartMs": 1481920,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "I can interact with\ninternal business"
    } ]
  }, {
    "tStartMs": 1483880,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "context and external sources\nin a single pane of glass."
    } ]
  }, {
    "tStartMs": 1489120,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "The agent gallery hosts my\napproved selection of agents,"
    } ]
  }, {
    "tStartMs": 1492500,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "including built-in ones by\nGoogle and my company's agents,"
    } ]
  }, {
    "tStartMs": 1495740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "like this one for price\nand margin optimization,"
    } ]
  }, {
    "tStartMs": 1498620,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "which autonomously orchestrates\nacross agents, tools,"
    } ]
  }, {
    "tStartMs": 1502380,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and sources."
    } ]
  }, {
    "tStartMs": 1503640,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Now, let's see Gemini\nEnterprise in action."
    } ]
  }, {
    "tStartMs": 1507480,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "To bring some less popular\nproduct lines back to life,"
    } ]
  }, {
    "tStartMs": 1511140,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "we'll ask our agent to analyze\ncurrent interior design trends,"
    } ]
  }, {
    "tStartMs": 1514780,
    "dDurationMs": 2410,
    "segs": [ {
      "utf8": "identify dead stock\nin our warehouse,"
    } ]
  }, {
    "tStartMs": 1517190,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and orchestrate a\nrelaunch campaign."
    } ]
  }, {
    "tStartMs": 1520230,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "With that one prompt,\nmultiple agents"
    } ]
  }, {
    "tStartMs": 1522590,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "complete a series of actions\nin minutes instead of hours."
    } ]
  }, {
    "tStartMs": 1526430,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "My market research agent,\npowered by Deep Research,"
    } ]
  }, {
    "tStartMs": 1529790,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "analyzes the latest\nGoogle Search information"
    } ]
  }, {
    "tStartMs": 1532750,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "alongside my own\nsales and CSAT data."
    } ]
  }, {
    "tStartMs": 1536230,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "My data insights agent is\nconnecting to our global product"
    } ]
  }, {
    "tStartMs": 1539470,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "catalog, regardless\nof location or format."
    } ]
  }, {
    "tStartMs": 1543230,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "It knows that dead stock\nrefers to stale inventory,"
    } ]
  }, {
    "tStartMs": 1546650,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and it uses our\nAgentic Data Cloud"
    } ]
  }, {
    "tStartMs": 1548990,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to identify the right data sets."
    } ]
  }, {
    "tStartMs": 1551710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And my product strategy agent\npulls everything together."
    } ]
  }, {
    "tStartMs": 1555430,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "I'll go ahead and\napprove this plan."
    } ]
  }, {
    "tStartMs": 1557550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "This can take a few minutes,\nso we'll fast-forward."
    } ]
  }, {
    "tStartMs": 1560670,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Here are the highlights."
    } ]
  }, {
    "tStartMs": 1563070,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Organic Modern is a huge\ntrend, and customers"
    } ]
  }, {
    "tStartMs": 1566550,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "are paying top dollar."
    } ]
  }, {
    "tStartMs": 1568710,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Our Tuscany collection\nhas leftover inventory"
    } ]
  }, {
    "tStartMs": 1571750,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "that actually fits right in,\nbut sales haven't been great."
    } ]
  }, {
    "tStartMs": 1577300,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The recommendation--\nrebrand and reprice it"
    } ]
  }, {
    "tStartMs": 1580780,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "above our current discount\nbut below competitor pricing."
    } ]
  }, {
    "tStartMs": 1585060,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "All of that with\none simple prompt."
    } ]
  }, {
    "tStartMs": 1588500,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "I can even see the\nsources that it analyzed"
    } ]
  }, {
    "tStartMs": 1590620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "to make these recommendations."
    } ]
  }, {
    "tStartMs": 1593620,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Gemini Enterprise is also\nsuggesting a new landing"
    } ]
  }, {
    "tStartMs": 1596820,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "page and new media to\nput front and center."
    } ]
  }, {
    "tStartMs": 1600580,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "I'll ask my product strategy\nagent to generate some videos."
    } ]
  }, {
    "tStartMs": 1607900,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This part can also take\na little bit of time,"
