  }, {
    "tStartMs": 5498200,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "It's secure."
    } ]
  }, {
    "tStartMs": 5499340,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "It's integrated."
    } ]
  }, {
    "tStartMs": 5500480,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It just works."
    } ]
  }, {
    "tStartMs": 5503240,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "By moving from simple automation\nto full-scale AI orchestration,"
    } ]
  }, {
    "tStartMs": 5507600,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "industry leaders are using\nWorkspace to fundamentally"
