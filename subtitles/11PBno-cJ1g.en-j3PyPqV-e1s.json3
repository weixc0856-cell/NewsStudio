  }, {
    "tStartMs": 5314190,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "alerted the team that our new\ndisplay kits are arriving early."
    } ]
  }, {
    "tStartMs": 5318470,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "And as you can see, I have\nmultiple chats blowing up."
