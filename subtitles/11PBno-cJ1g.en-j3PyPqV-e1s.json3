  }, {
    "tStartMs": 762980,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It's optimized for complex\nworkflow orchestration."
    } ]
  }, {
    "tStartMs": 766300,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "It bridges the gap between\nstrategy and autonomous"
    } ]
  }, {
    "tStartMs": 768900,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "execution, interacting\nwith your APIs and systems"
    } ]
  }, {
    "tStartMs": 772580,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "with minimal tuning."
    } ]
  }, {
    "tStartMs": 774340,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Industry leaders, including\nDatabricks, JetBrains,"
