  }, {
    "tStartMs": 5296600,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and here I am in Google Chat."
    } ]
  }, {
    "tStartMs": 5299080,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "This is where I collaborate with\nmy colleagues and now my agents,"
    } ]
  }, {
    "tStartMs": 5302450,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "all in one place."
    } ]
  }, {
    "tStartMs": 5304110,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I'm here in the Regional\nManagers chat space."
    } ]
  }, {
    "tStartMs": 5307550,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "And look at this."
    } ]
  }, {
    "tStartMs": 5308990,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The Regional\nOperations Agent, which"
