  }, {
    "tStartMs": 5051070,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "[APPLAUSE]"
    } ]
  }, {
    "tStartMs": 5056070,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 5057230,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Now, that was pretty easy."
    } ]
  }, {
    "tStartMs": 5059070,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The agent was able to\nhandle complex product logic"
    } ]
  }, {
    "tStartMs": 5061630,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and seamlessly\npivoted languages."
    } ]
  }, {
    "tStartMs": 5063830,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "But what happens if the\nteam wants to make a change?"
    } ]
  }, {
    "tStartMs": 5066430,
    "dDurationMs": 2630,
    "segs": [ {
      "utf8": "They don't need a bunch of\nsoftware engineers updating"
