  }, {
    "tStartMs": 5357470,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "we had a great chart that showed\nregional sales last quarter--"
    } ]
  }, {
    "tStartMs": 5362020,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "somewhere."
    } ]
  }, {
    "tStartMs": 5363660,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Normally, this is\nwhere the hunt begins."
    } ]
  }, {
    "tStartMs": 5366560,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "I jump into a folder and\nstare at dozens of files."
    } ]
  }, {
    "tStartMs": 5370620,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Instead, I'll ask Gemini."
