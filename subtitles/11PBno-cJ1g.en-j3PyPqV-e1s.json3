  }, {
    "tStartMs": 4900520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Over to you, Patrick."
    } ]
  }, {
    "tStartMs": 4902360,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 4911337,
    "dDurationMs": 1083,
    "segs": [ {
      "utf8": "PATRICK MARLOW: All right."
    } ]
  }, {
    "tStartMs": 4912420,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "Thanks, Carrie."
    } ]
  }, {
    "tStartMs": 4913480,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "Hey, y'all."
    } ]
  }, {
    "tStartMs": 4914100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "I'm Patrick Marlow, a\nsenior product manager"
    } ]
  }, {
    "tStartMs": 4916000,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "here at Google Cloud."
    } ]
  }, {
    "tStartMs": 4917760,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "YouTube TV customer support\nrecently launched a voice agent"
