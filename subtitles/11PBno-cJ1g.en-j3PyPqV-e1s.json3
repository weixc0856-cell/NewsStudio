  }, {
    "tStartMs": 3723130,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "tools while respecting\nmy built-in security"
    } ]
  }, {
    "tStartMs": 3726130,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "and permissions."
    } ]
  }, {
    "tStartMs": 3727730,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "As the data scientist,\nyou're the chef."
    } ]
  }, {
    "tStartMs": 3731310,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "You can review."
    } ]
  }, {
    "tStartMs": 3733130,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Let's accept and see\nwhat our agents serve up."
    } ]
  }, {
    "tStartMs": 3737810,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "They execute on our\nLightning Engine,"
    } ]
  }, {
    "tStartMs": 3740110,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "which is two times more\nprice-performant than the market"
    } ]
  }, {
    "tStartMs": 3743690,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "proprietary\nalternative, filtering"
    } ]
  }, {
    "tStartMs": 3746970,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "our soy-sensitive\ncustomers in mere seconds."
    } ]
  }, {
    "tStartMs": 3752050,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "AWS and BigQuery\nsources connected--"
