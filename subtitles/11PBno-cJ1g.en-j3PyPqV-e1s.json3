  }, {
    "tStartMs": 1672010,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "This is really easy."
    } ]
  }, {
    "tStartMs": 1673730,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Let's go ahead and get\nthis built and deployed."
