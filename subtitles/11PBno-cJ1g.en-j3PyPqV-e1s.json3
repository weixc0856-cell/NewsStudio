  }, {
    "tStartMs": 5561680,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "can focus on valuable\nclient relationships."
    } ]
  }, {
    "tStartMs": 5565720,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "We know many companies want\nto make the shift to Workspace"
