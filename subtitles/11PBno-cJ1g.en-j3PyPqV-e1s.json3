  }, {
    "tStartMs": 5697580,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "DAPHNE COATES: So my\nrole is to operationalize"
    } ]
  }, {
    "tStartMs": 5699740,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "this really exciting vision,\nco-creating that with Google"
    } ]
  }, {
    "tStartMs": 5702860,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to deliver our\nagentic foundations so"
    } ]
  }, {
    "tStartMs": 5704900,
    "dDurationMs": 3110,
    "segs": [ {
      "utf8": "that our agents can be\narchitected for performance,"
    } ]
  }, {
    "tStartMs": 5708010,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "scale, security, and\nobservability right"
    } ]
  }, {
    "tStartMs": 5710930,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "from the outset."
    } ]
  }, {
    "tStartMs": 5712650,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The competitive buying\nmultiagentic solution,"
