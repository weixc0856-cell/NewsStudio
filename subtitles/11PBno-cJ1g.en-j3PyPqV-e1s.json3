  }, {
    "tStartMs": 3764930,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "An annual forecast would help."
    } ]
  }, {
    "tStartMs": 3768690,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Again, our agents don't guess."
    } ]
  }, {
    "tStartMs": 3770530,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Gemini builds a\nmulti-step execution plan."
    } ]
  }, {
    "tStartMs": 3774250,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Can you make changes?"
    } ]
  }, {
    "tStartMs": 3775930,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Yes, Chef."
    } ]
  }, {
    "tStartMs": 3777850,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "So let's take a look and change\nthe number of simulations from"
    } ]
  }, {
    "tStartMs": 3782050,
    "dDurationMs": 4510,
    "segs": [ {
      "utf8": "1,000 to 2,000."
    } ]
  }, {
    "tStartMs": 3786560,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "And we will accept."
    } ]
  }, {
    "tStartMs": 3790360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Acting as the orchestrator,\nGemini delegates"
    } ]
  }, {
    "tStartMs": 3793360,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "to our specialized\ndata science tools,"
    } ]
  }, {
    "tStartMs": 3795960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "choosing the right\nmodels, and again,"
    } ]
  }, {
    "tStartMs": 3797840,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "executing on our Lightning\nEngine for Spark."
    } ]
  }, {
    "tStartMs": 3801320,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "It's built an entire\nnotebook for me."
    } ]
  }, {
    "tStartMs": 3804000,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Now, training usually\ntakes a bit of time,"
    } ]
  }, {
    "tStartMs": 3806180,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "so here's one I ran earlier."
    } ]
  }, {
    "tStartMs": 3809680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "$15 million."
    } ]
  }, {
    "tStartMs": 3812240,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Even after protecting\nour soy-sensitive market,"
    } ]
  }, {
    "tStartMs": 3815180,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the demand is massive."
    } ]
  }, {
    "tStartMs": 3817440,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Can we bring back the timer?"
    } ]
  }, {
    "tStartMs": 3819920,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Look what we accomplished."
    } ]
  }, {
    "tStartMs": 3821420,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In less than five minutes,\nwe turned a viral trend"
    } ]
  }, {
    "tStartMs": 3824840,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "into a $15 million decision."
    } ]
  }, {
    "tStartMs": 3827640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "First, Knowledge Catalog found\nthe hidden soy connection."
    } ]
  }, {
    "tStartMs": 3831720,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Second, Cross-Cloud Lakehouse,\npowered by the Lightning Engine,"
    } ]
  }, {
    "tStartMs": 3835680,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "connected to AWS\nwith zero complexity."
    } ]
  }, {
    "tStartMs": 3839320,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "And third, our agentic skills\nand tools built the forecast"
    } ]
  }, {
    "tStartMs": 3843280,
    "dDurationMs": 2270,
    "segs": [ {
      "utf8": "with zero manual code."
    } ]
  }, {
    "tStartMs": 3845550,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "This is the Agentic Data Cloud."
    } ]
  }, {
    "tStartMs": 3848950,
    "dDurationMs": 1425,
    "segs": [ {
      "utf8": "[TIMER BEEPING]"
    } ]
  }, {
    "tStartMs": 3850375,
    "dDurationMs": 2375,
    "segs": [ {
      "utf8": "[CHEERING, APPLAUSE]"
    } ]
  }, {
    "tStartMs": 3857510,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "We did it."
    } ]
  }, {
    "tStartMs": 3858790,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And now, here to share\nhow we're securing"
    } ]
  }, {
    "tStartMs": 3861470,
    "dDurationMs": 5075,
    "segs": [ {
      "utf8": "your agentic enterprise,\nplease welcome Francis deSouza"
    } ]
  }, {
    "tStartMs": 3866545,
    "dDurationMs": 3465,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC]"
    } ]
  }, {
    "tStartMs": 3880430,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "FRANCIS DE SOUZA: In\nan agentic enterprise,"
    } ]
  }, {
    "tStartMs": 3882510,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "giving agents the\npower to act means"
    } ]
  }, {
    "tStartMs": 3885070,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "that security must become an\nautonomous force, moving faster"
    } ]
  }, {
    "tStartMs": 3889710,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "than the threats themselves."
    } ]
  }, {
    "tStartMs": 3891670,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Human analysts simply can't\nkeep up with AI-driven attacks."
    } ]
  }, {
    "tStartMs": 3896750,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "The mean time to exploit\nthe vulnerability"
    } ]
  }, {
    "tStartMs": 3899190,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "has dropped to minus\nseven days, meaning"
    } ]
  }, {
    "tStartMs": 3901910,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "that today exploits routinely\noccur before a patch is"
    } ]
  }, {
    "tStartMs": 3906140,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "released, and the handoff\ntime between initial access"
    } ]
  }, {
    "tStartMs": 3910500,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "and handover to a\nsecondary threat group"
    } ]
  }, {
    "tStartMs": 3913220,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "has dropped from eight\nhours to 22 seconds."
    } ]
  }, {
    "tStartMs": 3917540,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Your security must\noperate at machine speed."
    } ]
  }, {
    "tStartMs": 3921860,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now, to do that, we're\nmoving the heavy lifting"
