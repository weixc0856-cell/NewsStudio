  }, {
    "tStartMs": 3698690,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "is in AWS S3 Iceberg."
    } ]
  }, {
    "tStartMs": 3702330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Now, usually you'd\ncall your data engineer"
    } ]
  }, {
    "tStartMs": 3704490,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "and wait three days\nfor a migration."
