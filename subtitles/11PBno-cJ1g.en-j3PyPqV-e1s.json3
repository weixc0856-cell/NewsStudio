  }, {
    "tStartMs": 1696210,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Our store operations team would\nusually handle this piece,"
    } ]
  }, {
    "tStartMs": 1700070,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so I'm in a brand-new session."
    } ]
  }, {
    "tStartMs": 1702410,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "I'll ask for a deck to get\nour regional distributors up"
    } ]
  }, {
    "tStartMs": 1705690,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to speed."
    } ]
  }, {
    "tStartMs": 1707450,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Gemini Enterprise uses\nmy company's context"
    } ]
  }, {
    "tStartMs": 1710450,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "to find exactly what I need\nto know about that launch, how"
    } ]
  }, {
    "tStartMs": 1713330,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I've managed these in the past,\nand my team's sales goals."
