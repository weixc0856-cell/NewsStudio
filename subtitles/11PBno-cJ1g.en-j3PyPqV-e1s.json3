  }, {
    "tStartMs": 5659700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and that's what the\npartnership with Google Cloud"
    } ]
  }, {
    "tStartMs": 5662220,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "allows us to do."
    } ]
  }, {
    "tStartMs": 5663660,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "It's about personalization\nat scale, desire at scale,"
    } ]
  }, {
    "tStartMs": 5668460,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "and that's very unique."
    } ]
  }, {
    "tStartMs": 5669720,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "And it's at the core\nof our strategy."
    } ]
  }, {
    "tStartMs": 5673300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "SAM KINI: We are connecting\nour business end-to-end"
    } ]
  }, {
    "tStartMs": 5675500,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "for faster AI deployment\nacross the enterprise."
    } ]
  }, {
    "tStartMs": 5678980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "This means using AI to\nsupercharge demand generation,"
    } ]
  }, {
    "tStartMs": 5682120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "get early access to advanced\nAI and large language models,"
    } ]
  }, {
    "tStartMs": 5685360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and build even stronger\npartnerships with retailers,"
