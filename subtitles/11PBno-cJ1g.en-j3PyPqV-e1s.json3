  }, {
    "tStartMs": 3684970,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "with zero soy allergies."
    } ]
  }, {
    "tStartMs": 3687170,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "However, I have two data\nsets that have never met."
    } ]
  }, {
    "tStartMs": 3690930,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Our allergen schema\nis here in Google,"
