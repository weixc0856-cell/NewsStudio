  }, {
    "tStartMs": 1687890,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This looks perfect."
    } ]
  }, {
    "tStartMs": 1690650,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Now let's head back over\nto Gemini Enterprise"
