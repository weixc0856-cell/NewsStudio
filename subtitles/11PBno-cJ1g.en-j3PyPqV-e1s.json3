  }, {
    "tStartMs": 871090,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "later this year."
    } ]
  }, {
    "tStartMs": 873930,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Leading organizations\naren't just"
    } ]
  }, {
    "tStartMs": 875680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "using Gemini Enterprise\nto work faster."
    } ]
  }, {
    "tStartMs": 878680,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "They're using it to redefine\nwhat their businesses can do."
    } ]
  }, {
    "tStartMs": 883080,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Citi Wealth, in partnership\nwith Google Cloud and DeepMind,"
    } ]
  }, {
    "tStartMs": 887440,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "today unveiled Citi Sky, an\nalways-on AI-powered member"
    } ]
  }, {
    "tStartMs": 893960,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "of the Citi Wealth\nteam that brings"
