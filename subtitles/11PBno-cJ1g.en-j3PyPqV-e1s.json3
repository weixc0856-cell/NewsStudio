  }, {
    "tStartMs": 5482280,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "a terminal."
    } ]
  }, {
    "tStartMs": 5483520,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "I'm ready to brief my team."
    } ]
  }, {
    "tStartMs": 5486520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Workspace Intelligence is\nthe end of the context tax."
