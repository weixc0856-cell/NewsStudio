  }, {
    "tStartMs": 1775000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "at scale, all while\nmaintaining control"
    } ]
  }, {
    "tStartMs": 1777560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "over their business data."
    } ]
  }, {
    "tStartMs": 1779880,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "That's the magic of the Gemini\nEnterprise Agent platform."
    } ]
  }, {
    "tStartMs": 1784520,
    "dDurationMs": 3936,
    "segs": [ {
      "utf8": "[UPBEAT MUSIC, APPLAUSE]"
