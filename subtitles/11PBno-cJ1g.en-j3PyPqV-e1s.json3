  }, {
    "tStartMs": 5092020,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the most complex requests."
    } ]
  }, {
    "tStartMs": 5094260,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And with our built-in\ntest interface,"
    } ]
  }, {
    "tStartMs": 5096720,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "you can ensure that every answer\nis grounded, factual, and pulled"
    } ]
  }, {
    "tStartMs": 5101220,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "directly from a knowledge base,\nlike the Agents Price Finder"
    } ]
  }, {
    "tStartMs": 5104260,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "tool here."
    } ]
  }, {
    "tStartMs": 5105260,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And the best part?"
    } ]
  }, {
    "tStartMs": 5106940,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "YouTube TV customer\nsupport built"
