  }, {
    "tStartMs": 923960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "specifications."
    } ]
  }, {
    "tStartMs": 925760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Liverpool is bringing\ntheir signature in-store"
    } ]
  }, {
    "tStartMs": 929040,
    "dDurationMs": 5270,
    "segs": [ {
      "utf8": "service online, projecting a\n10 times return on investment"
