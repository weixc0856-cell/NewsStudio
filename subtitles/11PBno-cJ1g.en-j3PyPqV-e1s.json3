  }, {
    "tStartMs": 5510760,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "redefine global productivity."
    } ]
  }, {
    "tStartMs": 5513200,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "For example, customers like\nColgate-Palmolive rolled out"
