  }, {
    "tStartMs": 4927380,
    "dDurationMs": 1958,
    "segs": [ {
      "utf8": "serving 100% of their users."
    } ]
  }, {
    "tStartMs": 4929338,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "We're going to take a look\nat it in action today."
    } ]
  }, {
    "tStartMs": 4931380,
    "dDurationMs": 1708,
    "segs": [ {
      "utf8": "I'm going to call the\nsupport number now."
    } ]
  }, {
    "tStartMs": 4938120,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "SPEAKER 4: Thanks for calling\nthe YouTube TV and NFL Sunday"
    } ]
  }, {
    "tStartMs": 4941200,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "Ticket Support Line."
    } ]
  }, {
    "tStartMs": 4942420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "So tell me, how can\nI help you today?"
    } ]
  }, {
    "tStartMs": 4944460,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "PATRICK MARLOW:\nHey yeah, I've got"
    } ]
  }, {
    "tStartMs": 4945240,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "a bunch of my friends coming\nover tomorrow night for the NFL"
    } ]
  }, {
    "tStartMs": 4947740,
    "dDurationMs": 528,
    "segs": [ {
      "utf8": "draft."
    } ]
  }, {
    "tStartMs": 4948268,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "I don't have cable."
    } ]
  }, {
    "tStartMs": 4949060,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "And to be honest, I\nreally only watch sports."
    } ]
  }, {
    "tStartMs": 4951300,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Does YouTube TV have a\nplan that's just for that?"
    } ]
  }, {
    "tStartMs": 4957120,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "SPEAKER 4: Yes, we do."
    } ]
  }, {
    "tStartMs": 4958240,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The YouTube TV Sports\nPlan has exactly what"
    } ]
  }, {
    "tStartMs": 4961240,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "you're looking for, plus over\n30 other sports channels."
    } ]
  }, {
    "tStartMs": 4965380,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "It's $18 less per month\nthan the base plan."
    } ]
  }, {
    "tStartMs": 4968600,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Would you like me to text\nyou a link to the number"
    } ]
  }, {
    "tStartMs": 4970720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "you're calling from that\nwill take you directly--"
    } ]
  }, {
    "tStartMs": 4972420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "PATRICK MARLOW: Yeah, go\nahead and send me a link."
    } ]
  }, {
    "tStartMs": 4973620,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "I'll take a look at it."
    } ]
  }, {
    "tStartMs": 4980120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "SPEAKER 4: Great, I just sent\nthe link to your mobile phone."
    } ]
  }, {
    "tStartMs": 4982840,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "Is there anything else\nI can help with today?"
    } ]
  }, {
    "tStartMs": 4985282,
    "dDurationMs": 2458,
    "segs": [ {
      "utf8": "PATRICK MARLOW: Yeah, I'm going\nto take a look at this now."
    } ]
  }, {
    "tStartMs": 4987740,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "Actually, my father-in-law is\nhanging out with me here today."
    } ]
  }, {
    "tStartMs": 4990282,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "He's been thinking about getting\nthe sports plan for his account"
