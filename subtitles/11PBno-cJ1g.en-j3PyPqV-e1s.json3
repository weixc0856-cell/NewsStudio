  }, {
    "tStartMs": 5042310,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "of a stadium full\nof people right now,"
    } ]
  }, {
    "tStartMs": 5043970,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and I think there's millions\nwatching me on the live stream."
    } ]
  }, {
    "tStartMs": 5046470,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "So I kind of got to run."
    } ]
  }, {
    "tStartMs": 5047610,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "All right."
    } ]
  }, {
    "tStartMs": 5047930,
    "dDurationMs": 833,
    "segs": [ {
      "utf8": "You've been helpful."
    } ]
  }, {
    "tStartMs": 5048763,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "Later."
