  }, {
    "tStartMs": 5349630,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "The gathering is done."
    } ]
  }, {
    "tStartMs": 5350850,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "And I haven't opened\na single extra tab."
    } ]
  }, {
    "tStartMs": 5354310,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Now, to build this\nplan, I remember"
