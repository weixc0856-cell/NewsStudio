  }, {
    "tStartMs": 796940,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "designed to build high-volume\nvideo applications;"
    } ]
  }, {
    "tStartMs": 800340,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "and Lyria 3 Pro, a\nstate-of-the-art model"
    } ]
  }, {
    "tStartMs": 804700,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "for enterprise and\nprofessional-grade audio"
    } ]
  }, {
    "tStartMs": 808580,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and music."
    } ]
  }, {
    "tStartMs": 810380,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "All of these models are\navailable in preview."
    } ]
  }, {
    "tStartMs": 813740,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "Finally, we support all the\nleading models from Anthropic,"
    } ]
  }, {
    "tStartMs": 817950,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "including Claude Opus,\nSonnet, and Haiku."
    } ]
  }, {
    "tStartMs": 821570,
    "dDurationMs": 6120,
    "segs": [ {
      "utf8": "And today, we're adding support\nfor Anthropic's Claude Opus 4.7."
    } ]
  }, {
    "tStartMs": 827690,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "While all of these models\nrepresent a massive leap"
    } ]
  }, {
    "tStartMs": 831290,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "in intelligence,\ntheir true value"
    } ]
  }, {
    "tStartMs": 833770,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "is realized when they're\noperationalized to solve"
    } ]
  }, {
    "tStartMs": 836930,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "mission-critical problems."
    } ]
  }, {
    "tStartMs": 839090,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Earlier this year, we announced\na monumental partnership"
    } ]
  }, {
    "tStartMs": 843050,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "with one of the world's\nmost iconic brands,"
    } ]
  }, {
    "tStartMs": 847330,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "that will bring the\npower of our technology"
    } ]
  }, {
    "tStartMs": 849450,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "to users everywhere\naround the world."
    } ]
  }, {
    "tStartMs": 852130,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "We're collaborating with\nApple as their preferred cloud"
    } ]
  }, {
    "tStartMs": 855330,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "provider to develop the next\ngeneration of Apple foundation"
    } ]
  }, {
    "tStartMs": 859410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "models based on\nGemini technology."
    } ]
  }, {
    "tStartMs": 862290,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "These models will help power\nfuture Apple Intelligence"
    } ]
  }, {
    "tStartMs": 866690,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "features, including a more\npersonalized Siri coming"
