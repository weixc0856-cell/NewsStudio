  }, {
    "tStartMs": 5109060,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and deployed this entire\nexperience in just six weeks."
    } ]
  }, {
    "tStartMs": 5113500,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Now, let's say that the team\nwants to run a promotion."
    } ]
  }, {
    "tStartMs": 5116420,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "It's really simple for me\nto add a new subagent here."
    } ]
  }, {
    "tStartMs": 5119980,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Click Add a New Subagent."
    } ]
  }, {
    "tStartMs": 5121820,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "And I will make this our\nnew promotions agent."
    } ]
  }, {
    "tStartMs": 5126130,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Say promotions."
