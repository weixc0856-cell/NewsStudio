  "events": [ {
    "tStartMs": 20,
    "dDurationMs": 2686,
    "segs": [ {
      "utf8": "Mark Russinovich: Good\nafternoon, everybody."
    } ]
  }, {
    "tStartMs": 2740,
    "dDurationMs": 974,
    "segs": [ {
      "utf8": "Ion Stoica:\nGood afternoon."
    } ]
  }, {
    "tStartMs": 3748,
    "dDurationMs": 4252,
    "segs": [ {
      "utf8": "[ Applause ]"
    } ]
  }, {
    "tStartMs": 8000,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Mark Russinovich: So it's good\nto see you all here at Build."
    } ]
  }, {
    "tStartMs": 10130,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "I'm Mark Russinovich."
    } ]
  }, {
    "tStartMs": 11540,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Ion Stoica:\nAnd I am Ion Stoica."
    } ]
  }, {
    "tStartMs": 13204,
    "dDurationMs": 1295,
    "segs": [ {
      "utf8": "Mark Russinovich:\nAnd we've got kind"
    } ]
  }, {
    "tStartMs": 14533,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "of a fireside chat today,\nbut it's a fireside chat"
    } ]
  }, {
    "tStartMs": 17760,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "where we don't have a moderator."
    } ]
  }, {
    "tStartMs": 19110,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "We're moderating ourselves."
    } ]
  }, {
    "tStartMs": 20340,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So, we're going to be\ntalking through a bunch"
    } ]
  }, {
    "tStartMs": 22170,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "of questions related to AI,\nAI infrastructure, models,"
    } ]
  }, {
    "tStartMs": 27360,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "architectures for AI,"
    } ]
  }, {
    "tStartMs": 29220,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and it should be a pretty\nengaging conversation."
    } ]
  }, {
    "tStartMs": 32790,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "Ion Stoica: I hope so."
    } ]
  }, {
    "tStartMs": 33270,
    "dDurationMs": 1405,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah. So,"
    } ]
  }, {
    "tStartMs": 34708,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "I think we can start\nby talking a little bit"
    } ]
  }, {
    "tStartMs": 36960,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "of our background and why we're"
    } ]
  }, {
    "tStartMs": 38760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "up here talking about\nthese subjects."
    } ]
  }, {
    "tStartMs": 39960,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "So, Ion, you've got a background"
    } ]
  }, {
    "tStartMs": 42810,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "where you've had some amazing\nimpact on the industry"
    } ]
  }, {
    "tStartMs": 45810,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "in data analytics, in AI, in\nyour role as a professor,"
    } ]
  }, {
    "tStartMs": 49650,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "in your role as a\nstartup founder, Ray,"
    } ]
  }, {
    "tStartMs": 52440,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "vLLM, Databricks, Spark."
    } ]
  }, {
    "tStartMs": 56310,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Why don't you tell us a little\nbit about your background?"
    } ]
  }, {
    "tStartMs": 59880,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah, so actually,"
    } ]
  }, {
    "tStartMs": 62010,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "starting around 15\nyears ago, at Berkeley,"
    } ]
  }, {
    "tStartMs": 65520,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "we started to develop\na little bit more,"
    } ]
  }, {
    "tStartMs": 69960,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "quite a bit of systems, a few\nsystems, initially in the space"
    } ]
  }, {
    "tStartMs": 75540,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "of domain of big data."
    } ]
  }, {
    "tStartMs": 77880,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "And started initially\nwith Mesos and Spark."
    } ]
  }, {
    "tStartMs": 81450,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "Then after that, Ray, and more\nrecently, vLLM and Golang."
    } ]
  }, {
    "tStartMs": 86880,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "And I think, as a high\nlevel, we're always looking"
    } ]
  }, {
    "tStartMs": 91950,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "about, obviously, trying to\nunderstand and to figure"
    } ]
  }, {
    "tStartMs": 95160,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "out what is a problem\nyou try to solve;"
    } ]
  }, {
    "tStartMs": 98820,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "and also, a little bit\ncareful about the trends."
    } ]
  }, {
    "tStartMs": 102600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "What I mean by that, a\nproblem you have today,"
    } ]
  }, {
    "tStartMs": 105600,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "is that problem going to be\nbigger tomorrow than today?"
    } ]
  }, {
    "tStartMs": 110220,
    "dDurationMs": 1255,
    "segs": [ {
      "utf8": "And, you know like,"
    } ]
  }, {
    "tStartMs": 111508,
    "dDurationMs": 6812,
    "segs": [ {
      "utf8": "things like, obviously, Spark\nwas scaling up data analytics"
    } ]
  }, {
    "tStartMs": 118320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "and making more interactive,"
    } ]
  }, {
    "tStartMs": 122220,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "and much better support\niterative kind of patterns"
    } ]
  }, {
    "tStartMs": 127470,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "like machine learning,"
    } ]
  }, {
    "tStartMs": 129120,
    "dDurationMs": 5371,
    "segs": [ {
      "utf8": "then Ray, complex scaling,\ncomplex AI workloads"
    } ]
  }, {
    "tStartMs": 134525,
    "dDurationMs": 1255,
    "segs": [ {
      "utf8": "like reinforcement learning"
    } ]
  }, {
    "tStartMs": 135780,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "on heterogeneous\nhardware back then."
    } ]
  }, {
    "tStartMs": 138750,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And, of course, vLLM is\nto us is clear that trying"
    } ]
  }, {
    "tStartMs": 142530,
    "dDurationMs": 6370,
    "segs": [ {
      "utf8": "to exploit the power limits\ninherent of the GPUs."
    } ]
  }, {
    "tStartMs": 148934,
    "dDurationMs": 3346,
    "segs": [ {
      "utf8": "But then the memory became--\nit was a bottleneck."
    } ]
  }, {
    "tStartMs": 152280,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "So, trying to alleviate that\nbottleneck and things like that."
    } ]
  }, {
    "tStartMs": 155737,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "The one thing I want\nto say, because we are"
    } ]
  }, {
    "tStartMs": 157830,
    "dDurationMs": 3981,
    "segs": [ {
      "utf8": "at the Microsoft conference\nhere, is that I'm very happy"
    } ]
  }, {
    "tStartMs": 161845,
    "dDurationMs": 5765,
    "segs": [ {
      "utf8": "that, actually, some of the\nthings we've done has impact also"
    } ]
  }, {
    "tStartMs": 167644,
    "dDurationMs": 3776,
    "segs": [ {
      "utf8": "with our kind of collaboration\nand partnerships."
    } ]
  }, {
    "tStartMs": 171420,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "As you know, Spark and\nkind of Databricks, great,"
    } ]
  }, {
    "tStartMs": 174450,
    "dDurationMs": 5557,
    "segs": [ {
      "utf8": "fantastic partnerships\nwith Azure Databricks."
    } ]
  }, {
    "tStartMs": 180041,
    "dDurationMs": 3854,
    "segs": [ {
      "utf8": "And actually, today, we also\nannounced a partnership"
    } ]
  }, {
    "tStartMs": 183929,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "between Azure and Anyscale,\nand Anyscale is around Ray."
    } ]
  }, {
    "tStartMs": 188443,
    "dDurationMs": 6053,
    "segs": [ {
      "utf8": "So, yes, very happy about that\nand very much looking forward"
    } ]
  }, {
    "tStartMs": 194530,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "to this partnership to grow."
    } ]
  }, {
    "tStartMs": 196590,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "Mark Russinovich:\nLikewise, yeah."
    } ]
  }, {
    "tStartMs": 197280,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "It's been an awesome\npartnership."
    } ]
  }, {
    "tStartMs": 198544,
    "dDurationMs": 1952,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah.\nSo, you know,"
    } ]
  }, {
    "tStartMs": 200530,
    "dDurationMs": 2276,
    "segs": [ {
      "utf8": "on my side, you know, you"
    } ]
  }, {
    "tStartMs": 202840,
    "dDurationMs": 2449,
    "segs": [ {
      "utf8": "you Mark, you have so much"
    } ]
  }, {
    "tStartMs": 205322,
    "dDurationMs": 4072,
    "segs": [ {
      "utf8": "contributions, you know.\nYou ship CC internals, then--"
    } ]
  }, {
    "tStartMs": 209428,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "Mark Russinovich: Have you\never used these internals, Ion?"
    } ]
  }, {
    "tStartMs": 212610,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "I'm putting him on the spot."
    } ]
  }, {
    "tStartMs": 213933,
    "dDurationMs": 1069,
    "segs": [ {
      "utf8": "How many people have used it?"
    } ]
  }, {
    "tStartMs": 215036,
    "dDurationMs": 3874,
    "segs": [ {
      "utf8": "Ion Stoica: But you\narchitected Azure"
    } ]
  }, {
    "tStartMs": 218910,
    "dDurationMs": 3585,
    "segs": [ {
      "utf8": "infrastructures,\nwhich I did use."
    } ]
  }, {
    "tStartMs": 222529,
    "dDurationMs": 2875,
    "segs": [ {
      "utf8": "And then you are now building"
    } ]
  }, {
    "tStartMs": 225438,
    "dDurationMs": 3958,
    "segs": [ {
      "utf8": "and architecting AI\ninfrastructure for Azure,"
    } ]
  }, {
    "tStartMs": 229430,
    "dDurationMs": 1972,
    "segs": [ {
      "utf8": "and security are leading."
    } ]
  }, {
    "tStartMs": 231436,
    "dDurationMs": 3856,
    "segs": [ {
      "utf8": "So, one question I have, you've\nseen all these kind of phases,"
    } ]
  }, {
    "tStartMs": 235326,
    "dDurationMs": 1670,
    "segs": [ {
      "utf8": "and you've been in\ndistributed systems"
    } ]
  }, {
    "tStartMs": 237030,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "for a long time and security."
    } ]
  }, {
    "tStartMs": 238847,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "So, what is new and what is old?"
    } ]
  }, {
    "tStartMs": 242944,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "What still applies and why\nis no longer applying?"
    } ]
  }, {
    "tStartMs": 247748,
    "dDurationMs": 1874,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah, well,\nthat's a good question."
    } ]
  }, {
    "tStartMs": 249656,
    "dDurationMs": 4144,
    "segs": [ {
      "utf8": "I think one of the things that\nstill holds, and this holds,"
    } ]
  }, {
    "tStartMs": 253834,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "I think, you'll even say for\ninfrastructure and systems,"
    } ]
  }, {
    "tStartMs": 257131,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "is the fundamentals\nare still in place."
    } ]
  }, {
    "tStartMs": 259706,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "I think if you take a look at\nfundamentally what's changed,"
    } ]
  }, {
    "tStartMs": 262110,
    "dDurationMs": 1771,
    "segs": [ {
      "utf8": "it's these non-deterministic\nsystems that are now"
    } ]
  }, {
    "tStartMs": 263914,
    "dDurationMs": 3096,
    "segs": [ {
      "utf8": "carrying out workflows\nthat they create on the fly."
    } ]
  }, {
    "tStartMs": 267044,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "And that introduces a bunch of\nnew risk area. You know, we --"
    } ]
  }, {
    "tStartMs": 271244,
    "dDurationMs": 2556,
    "segs": [ {
      "utf8": "In some sense, humans are\nnon-deterministic agents"
    } ]
  }, {
    "tStartMs": 273834,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "creating workflows on the fly."
    } ]
  }, {
    "tStartMs": 275941,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "But humans you can\nhold accountable."
    } ]
  }, {
    "tStartMs": 278042,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "Also, humans, I think in\ngeneral, are more reliable"
    } ]
  }, {
    "tStartMs": 281243,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "than the AI systems we\nhave today, and certainly,"
    } ]
  }, {
    "tStartMs": 284370,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "when it comes to humans,\nwe designed our systems"
    } ]
  }, {
    "tStartMs": 286830,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "around human speed and scale."
    } ]
  }, {
    "tStartMs": 289380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And when you have agents now"
    } ]
  }, {
    "tStartMs": 291180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "that are intelligent running\naround, they can perform lots"
    } ]
  }, {
    "tStartMs": 294180,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "of damage in a very\nshort period of time."
    } ]
  }, {
    "tStartMs": 296730,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "So I think if we get into\nit a little bit later,"
    } ]
  }, {
    "tStartMs": 300060,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "we'll talk about\nsome of the things"
    } ]
  }, {
    "tStartMs": 301230,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "like prompt injection\nrisks around that,"
    } ]
  }, {
    "tStartMs": 304050,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "risks around jailbreaking,\nrisks around hallucination;"
    } ]
  }, {
    "tStartMs": 306570,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "all of those things can\ncause workflows to go awry"
    } ]
  }, {
    "tStartMs": 309450,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "and for the system to not\nbehave as you intend."
    } ]
  }, {
    "tStartMs": 313260,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah, and\nwhat about this kind of--"
    } ]
  }, {
    "tStartMs": 315510,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "and you mentioned about the\nfundamentals still remain,"
    } ]
  }, {
    "tStartMs": 318060,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "but again, to be more precise\nabout concepts like consensus,"
    } ]
  }, {
    "tStartMs": 323520,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "consistency, this kind of\ndistributed scheduling,"
    } ]
  }, {
    "tStartMs": 328470,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "which of these concepts kind of\nremain more or less the same,"
    } ]
  }, {
    "tStartMs": 332610,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "and which are\nchanging and morphing"
    } ]
  }, {
    "tStartMs": 335400,
    "dDurationMs": 2105,
    "segs": [ {
      "utf8": "in support to support new orbit."
    } ]
  }, {
    "tStartMs": 337539,
    "dDurationMs": 2658,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah. Well, and I think"
    } ]
  }, {
    "tStartMs": 340230,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "you know we talk about AI"
    } ]
  }, {
    "tStartMs": 342180,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "and running these agent\nworkloads, and you talk"
    } ]
  }, {
    "tStartMs": 343680,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "about the LLMs and\nhosting the LLMs."
    } ]
  }, {
    "tStartMs": 346140,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The things like the consensus\naround the infrastructure,"
    } ]
  }, {
    "tStartMs": 350220,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "knowing what is\navailable and online."
    } ]
  }, {
    "tStartMs": 353340,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Things like load\nbalancing still matters."
    } ]
  }, {
    "tStartMs": 355200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Locality matters still."
    } ]
  }, {
    "tStartMs": 356820,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So you want to route requests,\nespecially when you talk"
    } ]
  }, {
    "tStartMs": 358740,
    "dDurationMs": 3074,
    "segs": [ {
      "utf8": "about KV caches,\nwhich is the context."
    } ]
  }, {
    "tStartMs": 361848,
    "dDurationMs": 1632,
    "segs": [ {
      "utf8": "You need to make sure\nthat the requests are going"
    } ]
  }, {
    "tStartMs": 363513,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "back to the same systems."
    } ]
  }, {
    "tStartMs": 364860,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Otherwise, you're going to be\nwasting compute and bandwidth"
    } ]
  }, {
    "tStartMs": 367440,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "as you're moving things around."
    } ]
  }, {
    "tStartMs": 369540,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So all of those\nthings still apply."
    } ]
  }, {
    "tStartMs": 371700,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "I think, and this is an\ninteresting question,"
    } ]
  }, {
    "tStartMs": 375330,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I think, for you."
    } ]
  }, {
    "tStartMs": 377010,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Are these systems stateless?"
    } ]
  }, {
    "tStartMs": 378390,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Do you consider them\nstateless or stateful?"
    } ]
  }, {
    "tStartMs": 383430,
    "dDurationMs": 2687,
    "segs": [ {
      "utf8": "Ion Stoica: I think\nit very much depends."
    } ]
  }, {
    "tStartMs": 386151,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "Certainly, because I will also,"
    } ]
  }, {
    "tStartMs": 389917,
    "dDurationMs": 5753,
    "segs": [ {
      "utf8": "I win as a serverless trend."
    } ]
  }, {
    "tStartMs": 395670,
    "dDurationMs": 6600,
    "segs": [ {
      "utf8": "I think that quite a few\nsystems become more stateful."
    } ]
  }, {
    "tStartMs": 402270,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "That is because just the trend\nof bringing the state in"
    } ]
  }, {
    "tStartMs": 408750,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "and saving the state if needed\nfor the next operation,"
    } ]
  }, {
    "tStartMs": 412980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "in some cases, it's too high."
    } ]
  }, {
    "tStartMs": 415140,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "And it's not only the\nstate, leading the state"
    } ]
  }, {
    "tStartMs": 417990,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and saving the state,\nit's initializing, right?"
    } ]
  }, {
    "tStartMs": 420810,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "If you are talking about\ninitializing the GPUs"
    } ]
  }, {
    "tStartMs": 424380,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "and so forth, it can\ntake a long time."
    } ]
  }, {
    "tStartMs": 427350,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "So this forces you to be\nmarked more stateful."
    } ]
  }, {
    "tStartMs": 432060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The problem with that\nis that it complicates,"
    } ]
  }, {
    "tStartMs": 434730,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "like we all know,\nthe fault tolerance."
    } ]
  }, {
    "tStartMs": 436680,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 439440,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "So when it comes to these\ndistributed infrastructures"
    } ]
  }, {
    "tStartMs": 443850,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "for AI, which include the GPUs,\nhigh bandwidth interconnections,"
    } ]
  }, {
    "tStartMs": 447240,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "the KV cache, when you look\nat distributed systems"
    } ]
  }, {
    "tStartMs": 452490,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "through its evolution,\nwhat assumptions change"
    } ]
  }, {
    "tStartMs": 455760,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "with an architecture to support\nthis kind of computation?"
    } ]
  }, {
    "tStartMs": 459100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Ion Stoica: So, I think\nit very much --great question"
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "-- very much depends on where\nyou are coming from."
    } ]
  }, {
    "tStartMs": 464970,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "So you're coming from\nSpark, it's like big data."
    } ]
  }, {
    "tStartMs": 470550,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It's about, it's like,\nMapReduce plus plus."
    } ]
  }, {
    "tStartMs": 473670,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "It's bulk synchronous\nprocessing, which is a model,"
    } ]
  }, {
    "tStartMs": 478590,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "which is a pretty simple model."
    } ]
  }, {
    "tStartMs": 480750,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "You partition the data."
    } ]
  }, {
    "tStartMs": 482400,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You have stages at every stage."
    } ]
  }, {
    "tStartMs": 483960,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "You have applied the same\ntask on different partitions"
    } ]
  }, {
    "tStartMs": 487230,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "and do a shuffle between them."
    } ]
  }, {
    "tStartMs": 490140,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "What happens with, for instance,\nyou talk about KV cache"
    } ]
  }, {
    "tStartMs": 494130,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "and inference,\nthings are becoming"
    } ]
  }, {
    "tStartMs": 496470,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "so much more coupled,\ntightly coupled."
    } ]
  }, {
    "tStartMs": 500190,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "If you think about\nmixture of experts"
    } ]
  }, {
    "tStartMs": 502380,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and then you have the KV cache\nand you need to distribute it"
    } ]
  }, {
    "tStartMs": 506970,
    "dDurationMs": 6870,
    "segs": [ {
      "utf8": "across different GPUs on the\nsame node and even across nodes,"
    } ]
  }, {
    "tStartMs": 513840,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "then it's things are becoming--"
    } ]
  }, {
    "tStartMs": 517500,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "everything becoming\nmuch more coupled"
    } ]
  }, {
    "tStartMs": 520530,
    "dDurationMs": 3088,
    "segs": [ {
      "utf8": "and more difficult\nbecause of that."
    } ]
  }, {
    "tStartMs": 523652,
    "dDurationMs": 2927,
    "segs": [ {
      "utf8": "Now, if you come from maybe"
    } ]
  }, {
    "tStartMs": 526612,
    "dDurationMs": 2806,
    "segs": [ {
      "utf8": "HPC, maybe you can\nsay, \"I told you so.\""
    } ]
  }, {
    "tStartMs": 529452,
    "dDurationMs": 738,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 530190,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "Ion Stoica: But even there\nI think that with HPC,"
    } ]
  }, {
    "tStartMs": 535046,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "it was much more --"
    } ]
  }, {
    "tStartMs": 536420,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "you don't have such a . . ."
    } ]
  }, {
    "tStartMs": 539295,
    "dDurationMs": 1455,
    "segs": [ {
      "utf8": "tightly coupling"
    } ]
  }, {
    "tStartMs": 540784,
    "dDurationMs": 3112,
    "segs": [ {
      "utf8": "between the data and, kind of. . ."
    } ]
  }, {
    "tStartMs": 544994,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "-- and the compute."
    } ]
  }, {
    "tStartMs": 548760,
    "dDurationMs": 2611,
    "segs": [ {
      "utf8": "Because even\nthere, the data was --"
    } ]
  }, {
    "tStartMs": 551404,
    "dDurationMs": 2096,
    "segs": [ {
      "utf8": "you know, you\ndon't have actually--"
    } ]
  }, {
    "tStartMs": 553500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "in traditional HPC,\nyou don't have a lot"
    } ]
  }, {
    "tStartMs": 555780,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "of data to start with."
    } ]
  }, {
    "tStartMs": 557070,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Because you do\nsimulations, right?"
    } ]
  }, {
    "tStartMs": 559080,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "And things like that, right?"
    } ]
  }, {
    "tStartMs": 560160,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "This was kind of the workload."
    } ]
  }, {
    "tStartMs": 562946,
    "dDurationMs": 1939,
    "segs": [ {
      "utf8": "So I think that's\nkind of what it is."
    } ]
  }, {
    "tStartMs": 564919,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And this creates a\nlot of challenges."
    } ]
  }, {
    "tStartMs": 568353,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And since even you're talking\nabout load balancing,"
    } ]
  }, {
    "tStartMs": 571447,
    "dDurationMs": 3647,
    "segs": [ {
      "utf8": "things are changing\nso much more quickly"
    } ]
  }, {
    "tStartMs": 575127,
    "dDurationMs": 4975,
    "segs": [ {
      "utf8": "if you think about expert\nparallel load balancing."
    } ]
  }, {
    "tStartMs": 580136,
    "dDurationMs": 3652,
    "segs": [ {
      "utf8": "Because you can change from\nlayer to layer when you go"
    } ]
  }, {
    "tStartMs": 583822,
    "dDurationMs": 4479,
    "segs": [ {
      "utf8": "in the forward pass to do\nthe inference to do serving."
    } ]
  }, {
    "tStartMs": 588335,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "And the other thing what\nhappens, I'll probably talk more"
    } ]
  }, {
    "tStartMs": 591636,
    "dDurationMs": 5019,
    "segs": [ {
      "utf8": "about that, is that things are\nevolving so quickly, right?"
    } ]
  }, {
    "tStartMs": 596689,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "By the time you build something,"
    } ]
  }, {
    "tStartMs": 598221,
    "dDurationMs": 1599,
    "segs": [ {
      "utf8": "you have new requirements.\nIt's never ending."
    } ]
  }, {
    "tStartMs": 599820,
    "dDurationMs": 1270,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 602280,
    "dDurationMs": 2090,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah."
    } ]
  }, {
    "tStartMs": 604370,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "So, we have this kind of, I\nremember like it was 15 years,"
    } ]
  }, {
    "tStartMs": 608960,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "10, 15 years ago when people\nstarted the cloud computing"
    } ]
  }, {
    "tStartMs": 613310,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "and so forth, and people are\nsaying the data center is a"
    } ]
  }, {
    "tStartMs": 617660,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "new computer."
    } ]
  }, {
    "tStartMs": 619500,
    "dDurationMs": 6660,
    "segs": [ {
      "utf8": "I'm just curious right now, is\nthat kind of abstraction still"
    } ]
  }, {
    "tStartMs": 626160,
    "dDurationMs": 6780,
    "segs": [ {
      "utf8": "of actuality because now you can\nhave training spanning different"
    } ]
  }, {
    "tStartMs": 632940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "availability zones\nand things like that."
    } ]
  }, {
    "tStartMs": 635790,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I'm curious about that."
    } ]
  }, {
    "tStartMs": 637110,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "Mark Russinovich: I mean,\nI think if you take a look"
    } ]
  }, {
    "tStartMs": 639960,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "when that statement was made,"
    } ]
  }, {
    "tStartMs": 641190,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "it was when a data center\nwould hold all the compute"
    } ]
  }, {
    "tStartMs": 644490,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "that you could imagine in the\ndata centers at that time."
    } ]
  }, {
    "tStartMs": 647220,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Even if you take a look\nat the evolution of Azure"
    } ]
  }, {
    "tStartMs": 649680,
    "dDurationMs": 3890,
    "segs": [ {
      "utf8": "as a hyperscaler, the\navailability zone kind"
    } ]
  }, {
    "tStartMs": 653570,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "of became a unit of compute, but\neven in an availability zone,"
    } ]
  }, {
    "tStartMs": 657320,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "we have multiple data\ncenters typically."
    } ]
  }, {
    "tStartMs": 658790,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "It's not just one data center\nper an availability zone."
    } ]
  }, {
    "tStartMs": 661940,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "Then you have a region, you have\nmultiple availability zones."
    } ]
  }, {
    "tStartMs": 664950,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "So even for traditional\nIT workloads"
    } ]
  }, {
    "tStartMs": 666840,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "or serverless computing, your\napplication can be spread"
    } ]
  }, {
    "tStartMs": 670230,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "across many data centers."
    } ]
  }, {
    "tStartMs": 672210,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "And now, you mentioned\ndistributed training"
    } ]
  }, {
    "tStartMs": 675270,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and AI training, and\nthat's where you run"
    } ]
  }, {
    "tStartMs": 677190,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "into these AI super\nfactories as we call them,"
    } ]
  }, {
    "tStartMs": 680730,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "where you've got massive\ndatacenters just filled"
    } ]
  }, {
    "tStartMs": 683640,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "with GPUs specifically to\nhost that training workload."
    } ]
  }, {
    "tStartMs": 686940,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And for that, we passed\nthe line several years ago"
    } ]
  }, {
    "tStartMs": 690660,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "of a single datacenter being\nenough to hold the scale"
    } ]
  }, {
    "tStartMs": 694830,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "of the AI supercomputers\nthat we're building now"
    } ]
  }, {
    "tStartMs": 696510,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to train these frontier models."
    } ]
  }, {
    "tStartMs": 698220,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And then over the last couple\nof years, we've crossed a line"
    } ]
  }, {
    "tStartMs": 701400,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "of even one region of\ndatacenters is not big enough"
    } ]
  }, {
    "tStartMs": 706650,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to train these models."
    } ]
  }, {
    "tStartMs": 707850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And now we have these\nFairwater systems"
    } ]
  }, {
    "tStartMs": 710790,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "that we've launched\nthese AI super factories"
    } ]
  }, {
    "tStartMs": 712740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "where there are multiple\nFairwaters in Wisconsin,"
    } ]
  }, {
    "tStartMs": 714720,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "multiple in Atlanta,\nand they're connected"
    } ]
  }, {
    "tStartMs": 716617,
    "dDurationMs": 2290,
    "segs": [ {
      "utf8": "with a dedicated network\nso that you can have a"
    } ]
  }, {
    "tStartMs": 718940,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "job that spans the GPUs across"
    } ]
  }, {
    "tStartMs": 721916,
    "dDurationMs": 3574,
    "segs": [ {
      "utf8": "both regions with\na very direct cable"
    } ]
  }, {
    "tStartMs": 725490,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "between them doing RDMA\nacross the two regions."
    } ]
  }, {
    "tStartMs": 730230,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah,\nit's fascinating."
    } ]
  }, {
    "tStartMs": 731580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Now, going back again, like\nwe discussed a little bit"
    } ]
  }, {
    "tStartMs": 734280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "about serverless, right?\nThe serverless--"
    } ]
  }, {
    "tStartMs": 737100,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "Mark Russinovich: My\nfavorite services."
    } ]
  }, {
    "tStartMs": 738210,
    "dDurationMs": 4369,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah. So,\nwhat what does it mean in. . ."
    } ]
  }, {
    "tStartMs": 742612,
    "dDurationMs": 2468,
    "segs": [ {
      "utf8": "this kind of--"
    } ]
  }, {
    "tStartMs": 745080,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "when you have today's\nlong-lived agents,"
    } ]
  }, {
    "tStartMs": 749850,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "which can go hours,\nsometimes days?"
    } ]
  }, {
    "tStartMs": 752790,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Mark Russinovich: Well, if\nyou talk about serverless,"
    } ]
  }, {
    "tStartMs": 756090,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "it's kind of people speak about\nit synonymously with containers."
    } ]
  }, {
    "tStartMs": 760800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Serverless equals containers."
    } ]
  }, {
    "tStartMs": 762960,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And when people\nthink containers,"
    } ]
  }, {
    "tStartMs": 765210,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "they think the original\nserverless containers,"
    } ]
  }, {
    "tStartMs": 767970,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "which were like Lambda\nor Azure Functions,"
    } ]
  }, {
    "tStartMs": 771840,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "which are short-lived, and so\npeople conflate serverless"
    } ]
  }, {
    "tStartMs": 776490,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "with short-lived applications\nor pieces of code,"
    } ]
  }, {
    "tStartMs": 780330,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "when in fact serverless\ndoesn't have an opinion"
    } ]
  }, {
    "tStartMs": 783750,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "about what code runs\nin these containers,"
    } ]
  }, {
    "tStartMs": 785580,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and so you could put SQL\nServer inside of a container,"
    } ]
  }, {
    "tStartMs": 788310,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and it can run for years."
    } ]
  }, {
    "tStartMs": 791850,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "And it also can be monstrous."
    } ]
  }, {
    "tStartMs": 793230,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "It can have terabytes of memory."
    } ]
  }, {
    "tStartMs": 795090,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So I think for me,\nI separate the two."
    } ]
  }, {
    "tStartMs": 798660,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "And I say serverless\nis you don't worry"
    } ]
  }, {
    "tStartMs": 800250,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "about the infrastructure, it is\ncontainerized for the most part,"
    } ]
  }, {
    "tStartMs": 803250,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "although we talk about\nlightweight containers now"
    } ]
  }, {
    "tStartMs": 805200,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "and Wasm sandboxes which are\nalso a form of serverless."
    } ]
  }, {
    "tStartMs": 810270,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But that's where I\nthink the whole trend--"
    } ]
  }, {
    "tStartMs": 813690,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "if you take a look at Azure's\narchitectural evolution,"
    } ]
  }, {
    "tStartMs": 817140,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "we're moving everything\nto serverless."
    } ]
  }, {
    "tStartMs": 818700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "We're moving the whole\ninfrastructure to containers"
    } ]
  }, {
    "tStartMs": 821220,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "that are on a serverless\ninfrastructure"
    } ]
  }, {
    "tStartMs": 822750,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "that is doing the scheduling\nand placement and for the job,"
    } ]
  }, {
    "tStartMs": 827850,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "which is expressing constraints."
    } ]
  }, {
    "tStartMs": 832950,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "Ion Stoica: So now\ncontinuing on that note."
    } ]
  }, {
    "tStartMs": 836100,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "We have our infra, we build\nthese infrastructures mostly"
    } ]
  }, {
    "tStartMs": 840330,
    "dDurationMs": 4230,
    "segs": [ {
      "utf8": "to serve requests initiated\nby people directly"
    } ]
  }, {
    "tStartMs": 844560,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "or via BI tools and\nthings like that."
    } ]
  }, {
    "tStartMs": 847920,
    "dDurationMs": 5430,
    "segs": [ {
      "utf8": "But now we are moving\nrapidly to an age of agents,"
    } ]
  }, {
    "tStartMs": 853350,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "to having agent loops instead of\njust requests as a unit of work."
    } ]
  }, {
    "tStartMs": 859920,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "How does this impact, do you\nthink, about architecture stack?"
    } ]
  }, {
    "tStartMs": 865860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Mark Russinovich: Well,\nI think we're still"
    } ]
  }, {
    "tStartMs": 867060,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "at the early days of this,\nactually, because just"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "in the last few years,\nwe went from chat"
    } ]
  }, {
    "tStartMs": 873480,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "to now agentic systems,\nwhich are this loop"
    } ]
  }, {
    "tStartMs": 877770,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "where the agents are\ntalking to other systems"
    } ]
  }, {
    "tStartMs": 880200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "as part of their computation."
    } ]
  }, {
    "tStartMs": 882060,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And they might even be\ntalking to other agents."
    } ]
  }, {
    "tStartMs": 883830,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "And so when it comes to how you\ndefine an agentic application"
    } ]
  }, {
    "tStartMs": 889110,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "that consists of these\nthings, I think we're still"
    } ]
  }, {
    "tStartMs": 890610,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "in the early days of specifying\nthe application model for these."
    } ]
  }, {
    "tStartMs": 896610,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "And a lot of it is, I\nthink, still ad hoc."
    } ]
  }, {
    "tStartMs": 898380,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "But we're getting towards what\nis an agentic application?"
    } ]
  }, {
    "tStartMs": 901980,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "What are the components? How do\nyou place them for efficiency?"
    } ]
  }, {
    "tStartMs": 905940,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "How do you automatically deploy\nthem instead of taking piecemeal"
    } ]
  }, {
    "tStartMs": 909360,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and deploying and connecting\nthem together after the fact?"
    } ]
  }, {
    "tStartMs": 911550,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "So in my opinion, I think\nthat we're still early."
    } ]
  }, {
    "tStartMs": 913860,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "But I'd be curious to hear\nabout what you think?"
    } ]
  }, {
    "tStartMs": 919200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Ion Stoica: So, yeah,\nI think we are early."
    } ]
  }, {
    "tStartMs": 921960,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "The one thing I see is that\nconstant increase in complexity."
    } ]
  }, {
    "tStartMs": 926850,
    "dDurationMs": 690,
    "segs": [ {
      "utf8": "Mark Russinovich:\nThat's for sure."
    } ]
  }, {
    "tStartMs": 927540,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Ion Stoica: Even the definition"
    } ]
  }, {
    "tStartMs": 929790,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "of agents, what is an agent?"
    } ]
  }, {
    "tStartMs": 932850,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Well, was an agent an\nLLM invoking a tool?"
    } ]
  }, {
    "tStartMs": 936570,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "But now it's much\nmore than that."
    } ]
  }, {
    "tStartMs": 939000,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "You have a tool, you have an\nentire harnessing, right?"
    } ]
  }, {
    "tStartMs": 942570,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Which can be very\ncomplex, right?"
    } ]
  }, {
    "tStartMs": 944820,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "So now, and then you are\ntalking about some kind"
    } ]
  }, {
    "tStartMs": 949860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "of continual learning."
    } ]
  }, {
    "tStartMs": 952140,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "People talk more and more\nwhether this happens in context,"
    } ]
  }, {
    "tStartMs": 955470,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "continuously\nevolving the prompt."
    } ]
  }, {
    "tStartMs": 958890,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And in some cases even\nupdating the weights, right?"
    } ]
  }, {
    "tStartMs": 962490,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So kind of like RL."
    } ]
  }, {
    "tStartMs": 965490,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "So, and then you have this\nkind of, you need something"
    } ]
  }, {
    "tStartMs": 969660,
    "dDurationMs": 6519,
    "segs": [ {
      "utf8": "to support very diverse\nand complex. . ."
    } ]
  }, {
    "tStartMs": 976212,
    "dDurationMs": 2898,
    "segs": [ {
      "utf8": "you know, application."
    } ]
  }, {
    "tStartMs": 979110,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "You need to do, for sure,\nkind of the inference,"
    } ]
  }, {
    "tStartMs": 982620,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "then basically\narbitrary application--"
    } ]
  }, {
    "tStartMs": 988170,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "running arbitrary application\nbecause that's part"
    } ]
  }, {
    "tStartMs": 990090,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "of the harnessing, right?"
    } ]
  }, {
    "tStartMs": 991620,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "And then maybe you are going\nalso to do some kind of training"
    } ]
  }, {
    "tStartMs": 995730,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "if you want to\nupdate the policy."
    } ]
  }, {
    "tStartMs": 998730,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "And so that's kind of things."
    } ]
  }, {
    "tStartMs": 1000410,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And when you have the models, of\ncourse, you can have the models"
    } ]
  }, {
    "tStartMs": 1003830,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "which is going to be co-located."
    } ]
  }, {
    "tStartMs": 1005660,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "It has to be co-located because\nif you want to update it,"
    } ]
  }, {
    "tStartMs": 1010490,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "or it just can be\nsomething running outside,"
    } ]
  }, {
    "tStartMs": 1015050,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "it can be like OpenAI or like\na new model that's released"
    } ]
  }, {
    "tStartMs": 1018680,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "by Microsoft."
    } ]
  }, {
    "tStartMs": 1019790,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "So that's kind of,\nit's so complex."
    } ]
  }, {
    "tStartMs": 1022820,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "So you need to think-- to have\nsomething which is very flexible"
    } ]
  }, {
    "tStartMs": 1027460,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to support these workloads."
    } ]
  }, {
    "tStartMs": 1028720,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And yeah, I think\nthat we'll see."
    } ]
  }, {
    "tStartMs": 1031360,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "I assume that in time, things\nwill stabilize one way"
    } ]
  }, {
    "tStartMs": 1034510,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "or another, but we\nare very early."
    } ]
  }, {
    "tStartMs": 1036460,
    "dDurationMs": 3018,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah. So one of the things"
    } ]
  }, {
    "tStartMs": 1039511,
    "dDurationMs": 1729,
    "segs": [ {
      "utf8": "that I'd be really curious"
    } ]
  }, {
    "tStartMs": 1041240,
    "dDurationMs": 1339,
    "segs": [ {
      "utf8": "to hear your thoughts on,"
    } ]
  }, {
    "tStartMs": 1042612,
    "dDurationMs": 1298,
    "segs": [ {
      "utf8": "in the systems\nthat we've designed,"
    } ]
  }, {
    "tStartMs": 1043910,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "they've largely\nbeen deterministic."
    } ]
  }, {
    "tStartMs": 1045920,
    "dDurationMs": 1370,
    "segs": [ {
      "utf8": "You design the\nsystem, you've got a"
    } ]
  }, {
    "tStartMs": 1047323,
    "dDurationMs": 1837,
    "segs": [ {
      "utf8": "workload, you optimize for it."
    } ]
  }, {
    "tStartMs": 1049160,
    "dDurationMs": 1407,
    "segs": [ {
      "utf8": "These systems are inherently"
    } ]
  }, {
    "tStartMs": 1050600,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "non-deterministic,\nas we talked about."
    } ]
  }, {
    "tStartMs": 1051920,
    "dDurationMs": 510,
    "segs": [ {
      "utf8": "Ion Stoica: Yep."
    } ]
  }, {
    "tStartMs": 1052430,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "Mark Russinovich:\nAnd so how does"
    } ]
  }, {
    "tStartMs": 1053450,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "that change the way\nyou design a system?"
    } ]
  }, {
    "tStartMs": 1058250,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Ion Stoica: That's\na great question."
    } ]
  }, {
    "tStartMs": 1061370,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And just to be clear, it's one"
    } ]
  }, {
    "tStartMs": 1062990,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "of the reasons they\nare non-deterministic"
    } ]
  }, {
    "tStartMs": 1064700,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "because, obviously, the LLMs"
    } ]
  }, {
    "tStartMs": 1066716,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "themselves are\nnon-deterministic."
    } ]
  }, {
    "tStartMs": 1068120,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "If you send the same prompt\nover and over again,"
    } ]
  }, {
    "tStartMs": 1071060,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "you shouldn't expect,\nor you are not going"
    } ]
  }, {
    "tStartMs": 1072620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to expect the same results."
    } ]
  }, {
    "tStartMs": 1073880,
    "dDurationMs": 4470,
    "segs": [ {
      "utf8": "Actually, in some cases, you\nrely on that to get diversity"
    } ]
  }, {
    "tStartMs": 1078350,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "in order to get\nbetter solutions."
    } ]
  }, {
    "tStartMs": 1082220,
    "dDurationMs": 5970,
    "segs": [ {
      "utf8": "So I think it's like there\nare a few things to consider."
    } ]
  }, {
    "tStartMs": 1088190,
    "dDurationMs": 5550,
    "segs": [ {
      "utf8": "One, first of all, what\neventually, what is your output?"
    } ]
  }, {
    "tStartMs": 1093740,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And in some cases, like\nwith coding and so forth,"
    } ]
  }, {
    "tStartMs": 1097580,
    "dDurationMs": 4310,
    "segs": [ {
      "utf8": "the artifact can be still\ndeterministic, right?"
    } ]
  }, {
    "tStartMs": 1101890,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "You use this to create,\nto optimize the system,"
    } ]
  }, {
    "tStartMs": 1105280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to synthesize even a system,"
    } ]
  }, {
    "tStartMs": 1107020,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and that one kind of\nis deterministic."
    } ]
  }, {
    "tStartMs": 1109420,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "You can have harnessing\ntests and so forth to check,"
    } ]
  }, {
    "tStartMs": 1113660,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "and then you can have\nmetrics to high hill-climb."
    } ]
  }, {
    "tStartMs": 1116870,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "If you want to optimize,"
    } ]
  }, {
    "tStartMs": 1117890,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "optimize for throughput,\nfor latency."
    } ]
  }, {
    "tStartMs": 1119810,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "So the output is still\nkind of deterministic."
    } ]
  }, {
    "tStartMs": 1123080,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I think now this doesn't\nanswer the question"
    } ]
  }, {
    "tStartMs": 1125450,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "about how you debug your kind"
    } ]
  }, {
    "tStartMs": 1127570,
    "dDurationMs": 3330,
    "segs": [ {
      "utf8": "of evolution systems\nor agentic system."
    } ]
  }, {
    "tStartMs": 1130900,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "And unfortunately, there, it's\nlike, you have to presumably,"
    } ]
  }, {
    "tStartMs": 1135430,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "and what you do is, record\nthe inputs and outputs"
    } ]
  }, {
    "tStartMs": 1139000,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and the traces and then try\nto replace the traces, right,"
    } ]
  }, {
    "tStartMs": 1142450,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "to find what the problem\nis if there is a problem."
    } ]
  }, {
    "tStartMs": 1144640,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 1147200,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "So when you talk about an AI\nstack, you talk about GPUs,"
    } ]
  }, {
    "tStartMs": 1153020,
    "dDurationMs": 6810,
    "segs": [ {
      "utf8": "network, you talk about\ndifferent types of accelerators."
    } ]
  }, {
    "tStartMs": 1159830,
    "dDurationMs": 4110,
    "segs": [ {
      "utf8": "Where do you see the\noptimizations happening,"
    } ]
  }, {
    "tStartMs": 1163940,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "the most important ones?"
    } ]
  }, {
    "tStartMs": 1165800,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Or have we reached\nsome limit someplace"
    } ]
  }, {
    "tStartMs": 1168530,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "where there's the bottleneck\nthat we need to focus on?"
    } ]
  }, {
    "tStartMs": 1171620,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Ion Stoica: I think\nclearly it will happen."
    } ]
  }, {
    "tStartMs": 1174860,
    "dDurationMs": 5330,
    "segs": [ {
      "utf8": "I think there are three. . ."
    } ]
  }, {
    "tStartMs": 1180223,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "levels of optimizations\nwill happen."
    } ]
  }, {
    "tStartMs": 1183560,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "At the top level, there\nwill be many algorithmic"
    } ]
  }, {
    "tStartMs": 1185870,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "optimizations still."
    } ]
  }, {
    "tStartMs": 1186890,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "So I assume that a few orders\nof magnitude improvement"
    } ]
  }, {
    "tStartMs": 1192020,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "over the next few years will\ncome from the algorithms."
    } ]
  }, {
    "tStartMs": 1195290,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "What I mean by algorithms, if\nyou look like, for instance,"
    } ]
  }, {
    "tStartMs": 1198890,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "just inference or\ntraining, right now,"
    } ]
  }, {
    "tStartMs": 1201350,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "of course, the workload\nchanges, you have agents."
    } ]
  }, {
    "tStartMs": 1203960,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "You have much larger prompts\nor, of course, outputs."
    } ]
  }, {
    "tStartMs": 1208550,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "The context, again,\nis much larger."
    } ]
  }, {
    "tStartMs": 1211280,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "You see a lot of optimizations."
    } ]
  }, {
    "tStartMs": 1213800,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "And architectural optimizations,\nsoftware architecture, like,"
    } ]
  }, {
    "tStartMs": 1217730,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "for instance, sparse attention,\ndifferent kinds of attention."
    } ]
  }, {
    "tStartMs": 1221330,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "You see different layers,\ndifferent attentions."
    } ]
  }, {
    "tStartMs": 1224000,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And now you see even within the\nsame layer different attentions."
    } ]
  }, {
    "tStartMs": 1227090,
    "dDurationMs": 1974,
    "segs": [ {
      "utf8": "Even maybe you'll have per-token"
    } ]
  }, {
    "tStartMs": 1229098,
    "dDurationMs": 2012,
    "segs": [ {
      "utf8": "learned attentions\nand things like that."
    } ]
  }, {
    "tStartMs": 1231110,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "So that's kind of what can\ngive you a big improvement."
    } ]
  }, {
    "tStartMs": 1234890,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Of course, this comes\nwith a lot of complexity."
    } ]
  }, {
    "tStartMs": 1238760,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "Then, obviously, you are going\nto have GPUs, the accelerators,"
    } ]
  }, {
    "tStartMs": 1243710,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which are going to\nstill make progress,"
    } ]
  }, {
    "tStartMs": 1246290,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "1.5 or 1.6 every\nyear improvements."
    } ]
  }, {
    "tStartMs": 1251590,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "And that's coming, again, with\ncomplexity because it's not"
    } ]
  }, {
    "tStartMs": 1255340,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "like Moore's law\nused to be, right?"
    } ]
  }, {
    "tStartMs": 1257950,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "The instructions"
    } ]
  }, {
    "tStartMs": 1259840,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that architecture is\nmore or less the same."
    } ]
  }, {
    "tStartMs": 1262420,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "How you get these\nimprovements, a lot of them is"
    } ]
  }, {
    "tStartMs": 1265780,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "by adding new instructions"
    } ]
  }, {
    "tStartMs": 1267670,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "which are targeting particularly\nnew segments of the workload"
    } ]
  }, {
    "tStartMs": 1272690,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "like I expect you are going to\nhave more and more instructions"
    } ]
  }, {
    "tStartMs": 1276500,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "in the GPUs to target this kind\nof sophisticated attentions."
    } ]
  }, {
    "tStartMs": 1280580,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "And then, from the inherent,"
    } ]
  }, {
    "tStartMs": 1283160,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "this will go a\nlittle bit slower."
    } ]
  }, {
    "tStartMs": 1286100,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "You are still going to\nhave smaller transistors;"
    } ]
  }, {
    "tStartMs": 1288290,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "you are going to still\nbe more power-efficient"
    } ]
  }, {
    "tStartMs": 1291230,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "for the power per flops will\nimprove and things like that."
    } ]
  }, {
    "tStartMs": 1295330,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "But these are\nmultiplicative, right?"
    } ]
  }, {
    "tStartMs": 1297550,
    "dDurationMs": 4290,
    "segs": [ {
      "utf8": "So when you multiply them,\nyou can get massive gains"
    } ]
  }, {
    "tStartMs": 1301840,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "in the next few years."
    } ]
  }, {
    "tStartMs": 1305210,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Mark Russinovich: Okay, I have\nanother question for you."
    } ]
  }, {
    "tStartMs": 1307370,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "Because you've been involved\nso much with open source"
    } ]
  }, {
    "tStartMs": 1309320,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "in AI infrastructure\nand analytics,"
    } ]
  }, {
    "tStartMs": 1313100,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "do you see a canonical\nopen source-based stack?"
    } ]
  }, {
    "tStartMs": 1316850,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "And do you think\nit will converge"
    } ]
  }, {
    "tStartMs": 1319336,
    "dDurationMs": 1870,
    "segs": [ {
      "utf8": "or there will be diversity?"
    } ]
  }, {
    "tStartMs": 1323099,
    "dDurationMs": 5391,
    "segs": [ {
      "utf8": "Ion Stoica: I think that\nthere is some stack"
    } ]
  }, {
    "tStartMs": 1328490,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "which is used by companies."
    } ]
  }, {
    "tStartMs": 1331580,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "There is like-- and, you see--"
    } ]
  }, {
    "tStartMs": 1337100,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "you have at the lower\nlevel Kubernetes or Slurm."
    } ]
  }, {
    "tStartMs": 1340970,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Under the hood, if you want to\nmove, because everyone now has"
    } ]
  }, {
    "tStartMs": 1344750,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "to want to have the freedom\nto make a move across regions"
    } ]
  }, {
    "tStartMs": 1348020,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "or from region to region,"
    } ]
  }, {
    "tStartMs": 1349520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "maybe you have something\nlike SkyPilot."
    } ]
  }, {
    "tStartMs": 1351500,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "On top of that, you have to\nhave some framework like Ray"
    } ]
  }, {
    "tStartMs": 1356840,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or Pathways or something\nlike that, which helps you"
    } ]
  }, {
    "tStartMs": 1359840,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "to distribute this\nkind of AI workloads;"
    } ]
  }, {
    "tStartMs": 1362420,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "then obviously you have\nPyTorch and so forth."
    } ]
  }, {
    "tStartMs": 1365150,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So I think you can put\ntogether this kind of stack,"
    } ]
  }, {
    "tStartMs": 1367670,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "and then you have vLLM, or\nGolang, whatever, TensorRT-LLM"
    } ]
  }, {
    "tStartMs": 1372080,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "as an inference layer."
    } ]
  }, {
    "tStartMs": 1373460,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "And then post-training, you\nhave kind of WELL or SkyRL,"
    } ]
  }, {
    "tStartMs": 1377090,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "and things like that, right?"
    } ]
  }, {
    "tStartMs": 1378260,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So you can create a stack,\nand you have a stack."
    } ]
  }, {
    "tStartMs": 1380540,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "I think a pretty good stack."
    } ]
  }, {
    "tStartMs": 1382070,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "The question is about what\nwill happen and how this kind"
    } ]
  }, {
    "tStartMs": 1386810,
    "dDurationMs": 7470,
    "segs": [ {
      "utf8": "of stack will evolve because\nit's like the one thing"
    } ]
  }, {
    "tStartMs": 1394280,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "which I see in terms of\ncomplexity increasing is"
    } ]
  }, {
    "tStartMs": 1397430,
    "dDurationMs": 7320,
    "segs": [ {
      "utf8": "that we used to build-- one of\nthe things you teach students,"
    } ]
  }, {
    "tStartMs": 1404750,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "right, and we learn ourselves"
    } ]
  }, {
    "tStartMs": 1407420,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that how do you build\na complex system?"
    } ]
  }, {
    "tStartMs": 1409880,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "You build this kind of\nin a modular way, right?"
    } ]
  }, {
    "tStartMs": 1412730,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "So you have these components\nwith nice abstractions,"
    } ]
  }, {
    "tStartMs": 1415790,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "clean abstractions"
    } ]
  }, {
    "tStartMs": 1417110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "which abstract away the\nimplementation, right?"
    } ]
  }, {
    "tStartMs": 1420050,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "So then you can evolve each\nof them independently."
    } ]
  }, {
    "tStartMs": 1425180,
    "dDurationMs": 1792,
    "segs": [ {
      "utf8": "Now, the problem with that--"
    } ]
  }, {
    "tStartMs": 1427005,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "and this is when we\nare talking about these"
    } ]
  }, {
    "tStartMs": 1428415,
    "dDurationMs": 1264,
    "segs": [ {
      "utf8": "layers and all these components,"
    } ]
  }, {
    "tStartMs": 1429712,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "the problem with that is that,"
    } ]
  }, {
    "tStartMs": 1431336,
    "dDurationMs": 3474,
    "segs": [ {
      "utf8": "as we know, it also\ncomes with some overhead."
    } ]
  }, {
    "tStartMs": 1434810,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "And it used to be perfectly\nfine to say okay, we are going"
    } ]
  }, {
    "tStartMs": 1437900,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "to spend a few percent, 10%\noverhead had to have this kind"
    } ]
  }, {
    "tStartMs": 1441290,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of nice available system,\nbecause at the end of the day,"
    } ]
  }, {
    "tStartMs": 1443930,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "we can be even faster\nbecause we are going"
    } ]
  }, {
    "tStartMs": 1445820,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "to evolve these systems,\nand the system is going"
    } ]
  }, {
    "tStartMs": 1448190,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "to evolve quickly and quicker."
    } ]
  }, {
    "tStartMs": 1451550,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "But now it's like it's so\nmuch breaking the layering,"
    } ]
  }, {
    "tStartMs": 1455750,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and it's called cross-layer\noptimizations, right?"
    } ]
  }, {
    "tStartMs": 1458210,
    "dDurationMs": 4350,
    "segs": [ {
      "utf8": "It's like, this is what I\nsee, everything, right?"
    } ]
  }, {
    "tStartMs": 1462560,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "I don't know, it's\nlike, in some sense,"
    } ]
  }, {
    "tStartMs": 1464990,
    "dDurationMs": 4168,
    "segs": [ {
      "utf8": "it's like all these\nlayers are going to"
    } ]
  }, {
    "tStartMs": 1469192,
    "dDurationMs": 5518,
    "segs": [ {
      "utf8": "get crossed and broken."
    } ]
  }, {
    "tStartMs": 1474710,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And I see, you can do maybe in\nan orderly way, but I don't know"
    } ]
  }, {
    "tStartMs": 1478310,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "where you are stopping."
    } ]
  }, {
    "tStartMs": 1479330,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "Is this collaboration\nbetween Ray"
    } ]
  }, {
    "tStartMs": 1480860,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and Kubernetes, with you guys?"
    } ]
  }, {
    "tStartMs": 1483530,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "But what is the thing\nhere is that something"
    } ]
  }, {
    "tStartMs": 1486680,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "like Kubernetes wants to\nknow more information"
    } ]
  }, {
    "tStartMs": 1488750,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "about the applications from Ray"
    } ]
  }, {
    "tStartMs": 1490550,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to make more\nintelligent decisions,"
    } ]
  }, {
    "tStartMs": 1492710,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "something like Ray,\nwhich is up there."
    } ]
  }, {
    "tStartMs": 1494720,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "They want now to\nhave more control"
    } ]
  }, {
    "tStartMs": 1496490,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "to tell Kubernetes\nwhat to do. Right?"
    } ]
  }, {
    "tStartMs": 1498620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So you can allow that."
    } ]
  }, {
    "tStartMs": 1500600,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "But I don't know when you\nstop because, of course,"
    } ]
  }, {
    "tStartMs": 1502520,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "you are no longer going\nto have these kind"
    } ]
  }, {
    "tStartMs": 1503990,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "of clean, narrow abstractions."
    } ]
  }, {
    "tStartMs": 1507500,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "I think that's very interesting."
    } ]
  }, {
    "tStartMs": 1511070,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "Mark Russinovich:\nSo, we've got about five"
    } ]
  }, {
    "tStartMs": 1512230,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "minutes left, I think."
    } ]
  }, {
    "tStartMs": 1514670,
    "dDurationMs": 3864,
    "segs": [ {
      "utf8": "Ion Stoica:\nYeah, so. . ."
    } ]
  }, {
    "tStartMs": 1518576,
    "dDurationMs": 5298,
    "segs": [ {
      "utf8": "So, one question\nI do have for you,"
    } ]
  }, {
    "tStartMs": 1524992,
    "dDurationMs": 4858,
    "segs": [ {
      "utf8": "It's how do you think about--"
    } ]
  }, {
    "tStartMs": 1529850,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "we are talking about the\nworkflows, agents, and so forth."
    } ]
  }, {
    "tStartMs": 1533780,
    "dDurationMs": 3810,
    "segs": [ {
      "utf8": "Is that, you think about like\na boundary, two different kind"
    } ]
  }, {
    "tStartMs": 1537590,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "of patterns of workloads,\nor you think are--"
    } ]
  }, {
    "tStartMs": 1541250,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Mark Russinovich:\nFor agents and--"
    } ]
  }, {
    "tStartMs": 1542210,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Ion Stoica: And workflows."
    } ]
  }, {
    "tStartMs": 1543080,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "Mark Russinovich: And workflows."
    } ]
  }, {
    "tStartMs": 1543530,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "Ion Stoica: Traditionally,\nwhat we call them."
    } ]
  }, {
    "tStartMs": 1544941,
    "dDurationMs": 3419,
    "segs": [ {
      "utf8": "Mark Russinovich: You\nknow, the beauty of agents is"
    } ]
  }, {
    "tStartMs": 1548360,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "that they can make\nworkflows dynamically."
    } ]
  }, {
    "tStartMs": 1550370,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And I think that this is,\ninstead of you having to go"
    } ]
  }, {
    "tStartMs": 1552890,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "and prescribe a workflow\nand write it out,"
    } ]
  }, {
    "tStartMs": 1556340,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "you can give AI a problem,\nand it'll go figure out how"
    } ]
  }, {
    "tStartMs": 1560540,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "to execute that task and come\nup with a workflow dynamically."
    } ]
  }, {
    "tStartMs": 1565310,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "When I look at those systems,\nif you've got anything"
    } ]
  }, {
    "tStartMs": 1568580,
    "dDurationMs": 4950,
    "segs": [ {
      "utf8": "where the workflow is going\nto be repeated many times,"
    } ]
  }, {
    "tStartMs": 1573530,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "you want to make that\ndeterministic and not rely"
    } ]
  }, {
    "tStartMs": 1576260,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "on an AI to make it up every\ntime you've got the problem."
    } ]
  }, {
    "tStartMs": 1580580,
    "dDurationMs": 5250,
    "segs": [ {
      "utf8": "So I think where things\nare not well-defined,"
    } ]
  }, {
    "tStartMs": 1585830,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "where they're very ad hoc,\nthen AI and agents are great"
    } ]
  }, {
    "tStartMs": 1590510,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "for making up the workflows\nand solving the problem."
    } ]
  }, {
    "tStartMs": 1592880,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "But for anything where you've\ngot a repetitive process,"
    } ]
  }, {
    "tStartMs": 1597710,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "you should go try to\nmake it deterministic,"
    } ]
  }, {
    "tStartMs": 1599240,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "because it's going to\nbe much more efficient,"
    } ]
  }, {
    "tStartMs": 1601610,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "much more reliable,\nand much cheaper."
    } ]
  }, {
    "tStartMs": 1604820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "So all of those things\nare going to be true."
    } ]
  }, {
    "tStartMs": 1606500,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And I think that this is where I\nsee people over-rotate on, oh,"
    } ]
  }, {
    "tStartMs": 1609380,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "I can have an agent\ngo do this thing."
    } ]
  }, {
    "tStartMs": 1610760,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "When I'm like, I\nlook at it and go,"
    } ]
  }, {
    "tStartMs": 1612260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "actually you could just\nwrite a simple workflow."
    } ]
  }, {
    "tStartMs": 1614300,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Ion Stoica: You can have the\nagent synthesize that workflow."
    } ]
  }, {
    "tStartMs": 1616640,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "Mark Russinovich: That's right."
    } ]
  }, {
    "tStartMs": 1617300,
    "dDurationMs": 630,
    "segs": [ {
      "utf8": "That's right, yeah."
    } ]
  }, {
    "tStartMs": 1617930,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "That's the other way to do it\nis have the agents make the"
    } ]
  }, {
    "tStartMs": 1620060,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "workflow, and then the\nworkflow is deterministic."
    } ]
  }, {
    "tStartMs": 1622310,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "Ion Stoica: Yep, that's\nwhat I mentioned about."
    } ]
  }, {
    "tStartMs": 1624440,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Yeah. So the other thing\nis that we used to have--"
    } ]
  }, {
    "tStartMs": 1628310,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "you have training, and you have\nserving separate deployments"
    } ]
  }, {
    "tStartMs": 1632570,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and things like that."
    } ]
  }, {
    "tStartMs": 1634010,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "But now with this kind\nof post-training,"
    } ]
  }, {
    "tStartMs": 1639890,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "starting even earlier on\nfrom reinforcement learning"
    } ]
  }, {
    "tStartMs": 1642830,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "with human feedback."
    } ]
  }, {
    "tStartMs": 1644360,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "And now it's continual\nlearning and things like that."
    } ]
  }, {
    "tStartMs": 1649070,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It seems that kind of\nit's a blur out there."
    } ]
  }, {
    "tStartMs": 1651710,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "So what should the\nplatform look like --"
    } ]
  }, {
    "tStartMs": 1657170,
    "dDurationMs": 1937,
    "segs": [ {
      "utf8": "Mark Russinovich:\nThis is the --"
    } ]
  }, {
    "tStartMs": 1659141,
    "dDurationMs": 2049,
    "segs": [ {
      "utf8": "multi-hundred billion\ndollar question, isn't it?"
    } ]
  }, {
    "tStartMs": 1661190,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "I think because we\nrun into two things."
    } ]
  }, {
    "tStartMs": 1665210,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "I mean, you heard about Maia."
    } ]
  }, {
    "tStartMs": 1666500,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Ion Stoica: Yes, of course."
    } ]
  }, {
    "tStartMs": 1667400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Mark Russinovich: And Maia\nis optimized for inference."
    } ]
  }, {
    "tStartMs": 1669980,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Then you hear about NVIDIA's\nchips, which are optimized,"
    } ]
  }, {
    "tStartMs": 1672650,
    "dDurationMs": 2610,
    "segs": [ {
      "utf8": "for the most part, their\nmain line for training."
    } ]
  }, {
    "tStartMs": 1675260,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And then you mentioned\nlike GRP or DRPO or any"
    } ]
  }, {
    "tStartMs": 1678260,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "of these post-training things\nthat are happening in the loop"
    } ]
  }, {
    "tStartMs": 1681800,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "with it, where you're\ndoing inference"
    } ]
  }, {
    "tStartMs": 1683870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "at the same time you're\ndoing the training."
    } ]
  }, {
    "tStartMs": 1686510,
    "dDurationMs": 6570,
    "segs": [ {
      "utf8": "And so whenever you've got a\nsituation where you can optimize"
    } ]
  }, {
    "tStartMs": 1693080,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "for efficiency, obviously,\nthat's going to be what you want"
    } ]
  }, {
    "tStartMs": 1697130,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "to do, especially at\nthe scales you're at,"
    } ]
  }, {
    "tStartMs": 1698750,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "where you can save\nliterally tens of millions,"
    } ]
  }, {
    "tStartMs": 1701000,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "hundreds of millions of\ndollars by optimizing"
    } ]
  }, {
    "tStartMs": 1703490,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "for some specific path."
    } ]
  }, {
    "tStartMs": 1705350,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "But when you optimize\nfor that specific path"
    } ]
  }, {
    "tStartMs": 1707240,
    "dDurationMs": 3510,
    "segs": [ {
      "utf8": "and then things change, and\nthey're not a good fit,"
    } ]
  }, {
    "tStartMs": 1710750,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that can be a big problem."
    } ]
  }, {
    "tStartMs": 1712430,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And so it's this tension now\nbecause we haven't even--"
    } ]
  }, {
    "tStartMs": 1715610,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "like you said, the evolution"
    } ]
  }, {
    "tStartMs": 1717260,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "of these architectures\nhasn't finished."
    } ]
  }, {
    "tStartMs": 1718850,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "And so if you over-optimize\nfor one workload,"
    } ]
  }, {
    "tStartMs": 1722120,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you could run into trouble."
    } ]
  }, {
    "tStartMs": 1723560,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "So the question is, how general\nshould we be and leave money"
    } ]
  }, {
    "tStartMs": 1731000,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "on the table in the short term?"
    } ]
  }, {
    "tStartMs": 1732410,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "Because in the long term,\nwe're going to be protected"
    } ]
  }, {
    "tStartMs": 1734720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "against changes in\nthe architecture"
    } ]
  }, {
    "tStartMs": 1737300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "or in the application\nrequirements"
    } ]
  }, {
    "tStartMs": 1739610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "versus taking advantage\nof optimization now"
    } ]
  }, {
    "tStartMs": 1742250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and potentially being\nbitten by it later."
    } ]
  }, {
    "tStartMs": 1744170,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "I think that that's the\ntension that you see."
    } ]
  }, {
    "tStartMs": 1746540,
    "dDurationMs": 662,
    "segs": [ {
      "utf8": "Ion Stoica: Absolutely."
    } ]
  }, {
    "tStartMs": 1747245,
    "dDurationMs": 453,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 1748568,
    "dDurationMs": 426,
    "segs": [ {
      "utf8": "Ion Stoica:\nYeah."
    } ]
  }, {
    "tStartMs": 1750200,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "Mark Russinovich:\nAll right. So, we're down to"
    } ]
  }, {
    "tStartMs": 1751900,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "a couple of minutes left,"
    } ]
  }, {
    "tStartMs": 1752810,
    "dDurationMs": 3291,
    "segs": [ {
      "utf8": "according to the clock up here."
    } ]
  }, {
    "tStartMs": 1756135,
    "dDurationMs": 1295,
    "segs": [ {
      "utf8": "So I want to thank\nyou for coming"
    } ]
  }, {
    "tStartMs": 1757430,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "and spending time\nwith us at Build."
    } ]
  }, {
    "tStartMs": 1759200,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Your impact on the industry is\nmonumental, and it's gracious"
    } ]
  }, {
    "tStartMs": 1762680,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "of you to come and take\ntime out of your day"
    } ]
  }, {
    "tStartMs": 1764150,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "to share your thoughts on the\nevolution of AI infrastructure."
    } ]
  }, {
    "tStartMs": 1768410,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah, thank you."
    } ]
  }, {
    "tStartMs": 1769310,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "And we haven't touched on--"
    } ]
  }, {
    "tStartMs": 1771320,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "Mark Russinovich:\nOn Confidential computing."
    } ]
  }, {
    "tStartMs": 1772190,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "Ion Stoica: On\nconfidential computing."
    } ]
  }, {
    "tStartMs": 1773600,
    "dDurationMs": 1830,
    "segs": [ {
      "utf8": "So before going, I know I know"
    } ]
  }, {
    "tStartMs": 1775430,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "that this is a topic dear\nto your heart, Mark."
    } ]
  }, {
    "tStartMs": 1778220,
    "dDurationMs": 1350,
    "segs": [ {
      "utf8": "So can you say something"
    } ]
  }, {
    "tStartMs": 1779570,
    "dDurationMs": 2537,
    "segs": [ {
      "utf8": "about like security\ngovernance and so forth?"
    } ]
  }, {
    "tStartMs": 1782140,
    "dDurationMs": 1159,
    "segs": [ {
      "utf8": "Mark Russinovich:\nWell, absolutely. I mean,"
    } ]
  }, {
    "tStartMs": 1783332,
    "dDurationMs": 2028,
    "segs": [ {
      "utf8": "they're all -- from\nsecurity governance,"
    } ]
  }, {
    "tStartMs": 1785360,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "we didn't really get time\nto deep dive on this."
    } ]
  }, {
    "tStartMs": 1787340,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "But when it comes to jailbreaks\nand prompt injections,"
    } ]
  }, {
    "tStartMs": 1790370,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "I've been doing a lot\nof research on this."
    } ]
  }, {
    "tStartMs": 1791690,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "This is, like I\nmentioned earlier,"
    } ]
  }, {
    "tStartMs": 1793220,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "a big topic of evolution where\nwe haven't bottomed out yet."
    } ]
  }, {
    "tStartMs": 1796970,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "I think I view it as\nkind of the early days"
    } ]
  }, {
    "tStartMs": 1798740,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "when people were downloading\nstuff from the internet"
    } ]
  }, {
    "tStartMs": 1800900,
    "dDurationMs": 2130,
    "segs": [ {
      "utf8": "and just your fingers\nwere crossed."
    } ]
  }, {
    "tStartMs": 1803030,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "This is what happens now\nwhen you give agents access"
    } ]
  }, {
    "tStartMs": 1805340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "to your company's private\ndata or your private data"
    } ]
  }, {
    "tStartMs": 1808520,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "or your access tokens is you're\nkind of crossing your fingers"
    } ]
  }, {
    "tStartMs": 1811940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and hoping that things\ndon't go off the rails"
    } ]
  }, {
    "tStartMs": 1814790,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "and you end up with a problem."
    } ]
  }, {
    "tStartMs": 1815900,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And we've seen some\nhigh-profile examples just"
    } ]
  }, {
    "tStartMs": 1818360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "in the last few months\nof people getting burned"
    } ]
  }, {
    "tStartMs": 1820100,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "by prompt injections."
    } ]
  }, {
    "tStartMs": 1821420,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "So I don't think we've come\nto the reckoning yet on that"
    } ]
  }, {
    "tStartMs": 1823610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and people\nunderstanding the risk."
    } ]
  }, {
    "tStartMs": 1826250,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And then with\nconfidential computing,"
    } ]
  }, {
    "tStartMs": 1827450,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "that is another layer of--"
    } ]
  }, {
    "tStartMs": 1829430,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "the clock just reset\nto five minutes."
    } ]
  }, {
    "tStartMs": 1831800,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "So we've got another\nfive minutes."
    } ]
  }, {
    "tStartMs": 1833020,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "[ Laughter ]"
    } ]
  }, {
    "tStartMs": 1834710,
    "dDurationMs": 1630,
    "segs": [ {
      "utf8": "Ion Stoica: So now\nyou can, please."
    } ]
  }, {
    "tStartMs": 1837406,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Mark Russinovich: I think\nbackstage they liked the answer"
    } ]
  }, {
    "tStartMs": 1839330,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "so much they wanted\nme to continue."
    } ]
  }, {
    "tStartMs": 1843500,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So I can talk a little bit about\nconfidential computing now,"
    } ]
  }, {
    "tStartMs": 1845780,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "which is it's independent\nof AI, of course,"
    } ]
  }, {
    "tStartMs": 1849080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "but related in some ways."
    } ]
  }, {
    "tStartMs": 1851060,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "Because if you think about\nthe sensitivity of the data"
    } ]
  }, {
    "tStartMs": 1854510,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "that people are processing\nwith agentic systems,"
    } ]
  }, {
    "tStartMs": 1856760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "if it's in a personal\ncontext, you're saying, \"Hey,"
    } ]
  }, {
    "tStartMs": 1860060,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "I really want you to help\nme with my medical advice."
    } ]
  }, {
    "tStartMs": 1862730,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I want you to help me\nwith my financials.\""
    } ]
  }, {
    "tStartMs": 1865550,
    "dDurationMs": 4410,
    "segs": [ {
      "utf8": "You're giving these agents\nso much very personal"
    } ]
  }, {
    "tStartMs": 1869960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and very sensitive\ndata about yourself."
    } ]
  }, {
    "tStartMs": 1872000,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "And if you're in an\nenterprise context,"
    } ]
  }, {
    "tStartMs": 1874250,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "the way you get the value"
    } ]
  }, {
    "tStartMs": 1875690,
    "dDurationMs": 1410,
    "segs": [ {
      "utf8": "out of these models\nis giving them access"
    } ]
  }, {
    "tStartMs": 1877100,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "to the sensitive data\nof your enterprise."
    } ]
  }, {
    "tStartMs": 1881780,
    "dDurationMs": 3990,
    "segs": [ {
      "utf8": "And especially when you're\nhosting this in a cloud platform"
    } ]
  }, {
    "tStartMs": 1885770,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "or some hoster that's\nout of your control,"
    } ]
  }, {
    "tStartMs": 1888410,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "or even in your own environment,"
    } ]
  }, {
    "tStartMs": 1889580,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "you want to minimize the\ntrusted computing base,"
    } ]
  }, {
    "tStartMs": 1892820,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the code that has\naccess to that data,"
    } ]
  }, {
    "tStartMs": 1894530,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "to the smallest amount possible"
    } ]
  }, {
    "tStartMs": 1895970,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "where you can have the highest\nassurance that it's going"
    } ]
  }, {
    "tStartMs": 1897980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "to behave properly and where\nbad actors can't get to it."
    } ]
  }, {
    "tStartMs": 1901434,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And confidential computing\nis -- now we've got another. . ."
    } ]
  }, {
    "tStartMs": 1906170,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "It reset again."
    } ]
  }, {
    "tStartMs": 1906830,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "I was wondering."
    } ]
  }, {
    "tStartMs": 1907280,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "I was like, wow, we burned\nthrough that time really fast."
    } ]
  }, {
    "tStartMs": 1909320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So now we have 13 minutes left."
    } ]
  }, {
    "tStartMs": 1911520,
    "dDurationMs": 1395,
    "segs": [ {
      "utf8": "[ Laughter ]"
    } ]
  }, {
    "tStartMs": 1914610,
    "dDurationMs": 990,
    "segs": [ {
      "utf8": "So let me just wrap this up."
    } ]
  }, {
    "tStartMs": 1915600,
    "dDurationMs": 3210,
    "segs": [ {
      "utf8": "And I think there were some more\ntopics that we can discuss."
    } ]
  }, {
    "tStartMs": 1918810,
    "dDurationMs": 2370,
    "segs": [ {
      "utf8": "And maybe we can take some\nquestions from the audience."
    } ]
  }, {
    "tStartMs": 1921180,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "But confidential computing,\nfor those of you"
    } ]
  }, {
    "tStartMs": 1925140,
    "dDurationMs": 3530,
    "segs": [ {
      "utf8": "that aren't familiar with it,\nit's hardware-based protection"
    } ]
  }, {
    "tStartMs": 1928670,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "of data while it's in use."
    } ]
  }, {
    "tStartMs": 1929690,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So the hardware itself\nis encrypting memory"
    } ]
  }, {
    "tStartMs": 1933350,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "and creating a privileged\nboundary around the data"
    } ]
  }, {
    "tStartMs": 1936080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "such that nothing else on\nthe system can get access"
    } ]
  }, {
    "tStartMs": 1939080,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "to what's inside of that\nenclave, they're called."
    } ]
  }, {
    "tStartMs": 1942650,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "And it comes with a cool\nproperty the hardware provides,"
    } ]
  }, {
    "tStartMs": 1945290,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "which is an attestation,"
    } ]
  }, {
    "tStartMs": 1946370,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "where it can measure\nwhat's inside the enclave"
    } ]
  }, {
    "tStartMs": 1948650,
    "dDurationMs": 4050,
    "segs": [ {
      "utf8": "and then the application\nin that enclave can offer"
    } ]
  }, {
    "tStartMs": 1952700,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "that attestation to another\nsystem that then can look at it"
    } ]
  }, {
    "tStartMs": 1955670,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "and say, oh, your compute\ninside of an enclave,"
    } ]
  }, {
    "tStartMs": 1959420,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "I trust that enclave, I\ntrust your configuration,"
    } ]
  }, {
    "tStartMs": 1961970,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "I'm going to give you a\nsecret, typically a key,"
    } ]
  }, {
    "tStartMs": 1964760,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "which allows you to go and\nprocess that data in the clear."
    } ]
  }, {
    "tStartMs": 1968030,
    "dDurationMs": 2725,
    "segs": [ {
      "utf8": "And it's protected against\nso many of the threats"
    } ]
  }, {
    "tStartMs": 1970789,
    "dDurationMs": 2575,
    "segs": [ {
      "utf8": "that not having this\nenclave protecting"
    } ]
  }, {
    "tStartMs": 1973398,
    "dDurationMs": 2374,
    "segs": [ {
      "utf8": "that boundary against.\nAnd when it comes to agents,"
    } ]
  }, {
    "tStartMs": 1975806,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "having an attestation\nof what is the agent?"
    } ]
  }, {
    "tStartMs": 1979094,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "What is its provenance.?"
    } ]
  }, {
    "tStartMs": 1981009,
    "dDurationMs": 1576,
    "segs": [ {
      "utf8": "Do I know that the\ndata that I'm giving to"
    } ]
  }, {
    "tStartMs": 1982618,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "the agent is protected"
    } ]
  }, {
    "tStartMs": 1983870,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "with the highest assurance as\npossible inside that enclave?"
    } ]
  }, {
    "tStartMs": 1986780,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "You're going to see a trend with\nAI and confidential computing"
    } ]
  }, {
    "tStartMs": 1990410,
    "dDurationMs": 1590,
    "segs": [ {
      "utf8": "that I think is going\nto really drive forward"
    } ]
  }, {
    "tStartMs": 1992000,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "confidential computing."
    } ]
  }, {
    "tStartMs": 1993050,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Confidential GPUs from NVIDIA,\nfor example, confidential GPUs"
    } ]
  }, {
    "tStartMs": 1996020,
    "dDurationMs": 6510,
    "segs": [ {
      "utf8": "from AMD, and even\nMicrosoft's Maia processor."
    } ]
  }, {
    "tStartMs": 2002530,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah,\nthat's fascinating."
    } ]
  }, {
    "tStartMs": 2005920,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "Mark Russinovich: Since we have\nmore time on the clock now,"
    } ]
  }, {
    "tStartMs": 2008470,
    "dDurationMs": 2710,
    "segs": [ {
      "utf8": "which is kind of nice."
    } ]
  }, {
    "tStartMs": 2016090,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "Let me go back to some questions\nthat we skipped earlier for you."
    } ]
  }, {
    "tStartMs": 2024730,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "And I guess this is something\nwe really haven't talked"
    } ]
  }, {
    "tStartMs": 2027280,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "about is developer experience."
    } ]
  }, {
    "tStartMs": 2028450,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "We've been talking a lot\nabout infrastructure,"
    } ]
  }, {
    "tStartMs": 2030340,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "but you've got all\nthis complexity."
    } ]
  }, {
    "tStartMs": 2033430,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "When it comes to\ndeveloper experience,"
    } ]
  }, {
    "tStartMs": 2035950,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "there's so many\noptions out there."
    } ]
  }, {
    "tStartMs": 2037330,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "There's GitHub Copilot CLI\nthere's the SDK,"
    } ]
  }, {
    "tStartMs": 2040005,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "there's OpenClaw, like what --"
    } ]
  }, {
    "tStartMs": 2042940,
    "dDurationMs": 5310,
    "segs": [ {
      "utf8": "and there's doing your own loop,\ncalling an LLM directly."
    } ]
  }, {
    "tStartMs": 2048250,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "We saw Simon Willison doing\nthis with his own application."
    } ]
  }, {
    "tStartMs": 2051520,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "He didn't use any harness."
    } ]
  }, {
    "tStartMs": 2054100,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "What's the best approach?"
    } ]
  }, {
    "tStartMs": 2056050,
    "dDurationMs": 2070,
    "segs": [ {
      "utf8": "When do you decide, when\ndo you use one harness"
    } ]
  }, {
    "tStartMs": 2058120,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "versus a custom orchestrator?"
    } ]
  }, {
    "tStartMs": 2061000,
    "dDurationMs": 1782,
    "segs": [ {
      "utf8": "How do you code this,"
    } ]
  }, {
    "tStartMs": 2062815,
    "dDurationMs": 2205,
    "segs": [ {
      "utf8": "and how do you measure\nwhat's the best answer?"
    } ]
  }, {
    "tStartMs": 2065020,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And in fact, I wrestle with this\ntoo when I'm approaching code."
    } ]
  }, {
    "tStartMs": 2068620,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "Ion Stoica: And me as well."
    } ]
  }, {
    "tStartMs": 2069460,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "But let me just give. . ."
    } ]
  }, {
    "tStartMs": 2074513,
    "dDurationMs": 4778,
    "segs": [ {
      "utf8": "So, I think that. . ."
    } ]
  }, {
    "tStartMs": 2079325,
    "dDurationMs": 6545,
    "segs": [ {
      "utf8": "Look, my TLDR is that now\nwe have, again,"
    } ]
  }, {
    "tStartMs": 2085870,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "very powerful coding\nagents and so forth."
    } ]
  }, {
    "tStartMs": 2088570,
    "dDurationMs": 4938,
    "segs": [ {
      "utf8": "And many of you, I'm sure -- how\nmany of you use coding agents?"
    } ]
  }, {
    "tStartMs": 2093542,
    "dDurationMs": 2298,
    "segs": [ {
      "utf8": "Everyone, right?"
    } ]
  }, {
    "tStartMs": 2097554,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "I do think that --"
    } ]
  }, {
    "tStartMs": 2099017,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "actually, the biggest\nchallenge is that --"
    } ]
  }, {
    "tStartMs": 2102141,
    "dDurationMs": 1578,
    "segs": [ {
      "utf8": "and this is --"
    } ]
  }, {
    "tStartMs": 2103752,
    "dDurationMs": 4405,
    "segs": [ {
      "utf8": "it's about how do\nyou know that. . ."
    } ]
  }, {
    "tStartMs": 2108190,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "the code which is generated"
    } ]
  }, {
    "tStartMs": 2110308,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "is going to work\ncorrectly for some kind"
    } ]
  }, {
    "tStartMs": 2113710,
    "dDurationMs": 2477,
    "segs": [ {
      "utf8": "of definition of\ncorrectness, right?"
    } ]
  }, {
    "tStartMs": 2116221,
    "dDurationMs": 4419,
    "segs": [ {
      "utf8": "Is doing what you hope\nyou want to do, right?"
    } ]
  }, {
    "tStartMs": 2120640,
    "dDurationMs": 2457,
    "segs": [ {
      "utf8": "I think that's the key, right?"
    } ]
  }, {
    "tStartMs": 2123131,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "And the more code it generates,"
    } ]
  }, {
    "tStartMs": 2126826,
    "dDurationMs": 3431,
    "segs": [ {
      "utf8": "the harder it is to do\nthat, right? Because --"
    } ]
  }, {
    "tStartMs": 2130310,
    "dDurationMs": 4993,
    "segs": [ {
      "utf8": "-- and I think this\nwas, you know,"
    } ]
  }, {
    "tStartMs": 2135337,
    "dDurationMs": 3373,
    "segs": [ {
      "utf8": "this is also, was true\nbefore, right?"
    } ]
  }, {
    "tStartMs": 2138744,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "Everyone here probably\ndeveloped a production --"
    } ]
  }, {
    "tStartMs": 2142323,
    "dDurationMs": 1267,
    "segs": [ {
      "utf8": "-- system, right?"
    } ]
  }, {
    "tStartMs": 2143590,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "Or, has been involved in\ndeveloping a production system."
    } ]
  }, {
    "tStartMs": 2146320,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Where do you spend\nmost of the time?"
    } ]
  }, {
    "tStartMs": 2148540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "You don't spending the\ntime or most of the time"
    } ]
  }, {
    "tStartMs": 2150520,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "in prototyping or\nwriting the code;"
    } ]
  }, {
    "tStartMs": 2152470,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "you do spend\nthe time in, kind of,"
    } ]
  }, {
    "tStartMs": 2154636,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "even, you know, in debugging,"
    } ]
  }, {
    "tStartMs": 2157540,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "then maintaining the code."
    } ]
  }, {
    "tStartMs": 2159220,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It's easily 10 to 1 effort."
    } ]
  }, {
    "tStartMs": 2161800,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "So, in some sense, what these\ncoding agents are doing"
    } ]
  }, {
    "tStartMs": 2166234,
    "dDurationMs": 3156,
    "segs": [ {
      "utf8": "are going to commoditize that\nkind of writing the code."
    } ]
  }, {
    "tStartMs": 2169390,
    "dDurationMs": 1089,
    "segs": [ {
      "utf8": "But the bottleneck will be"
    } ]
  }, {
    "tStartMs": 2170512,
    "dDurationMs": 1488,
    "segs": [ {
      "utf8": "more and more\nin, kind of, verifying."
    } ]
  }, {
    "tStartMs": 2172000,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "And, yes, you can\nuse these agents"
    } ]
  }, {
    "tStartMs": 2174970,
    "dDurationMs": 2389,
    "segs": [ {
      "utf8": "to say, \"Hey you-- \","
    } ]
  }, {
    "tStartMs": 2177392,
    "dDurationMs": 3008,
    "segs": [ {
      "utf8": "you know,\"check\nthat, is that correct?\""
    } ]
  }, {
    "tStartMs": 2180400,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "But it's very hard, you know?"
    } ]
  }, {
    "tStartMs": 2181660,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "Some agents are lazy."
    } ]
  }, {
    "tStartMs": 2182918,
    "dDurationMs": 2432,
    "segs": [ {
      "utf8": "So, without you\nunderstanding the code,"
    } ]
  }, {
    "tStartMs": 2185350,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "at least at this point\ntoday, I don't think --"
    } ]
  }, {
    "tStartMs": 2189040,
    "dDurationMs": 1839,
    "segs": [ {
      "utf8": "and having continuously"
    } ]
  }, {
    "tStartMs": 2190912,
    "dDurationMs": 2958,
    "segs": [ {
      "utf8": "having testing it and\nenhancing the test,"
    } ]
  }, {
    "tStartMs": 2193870,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I don't think you\ncan trust that code"
    } ]
  }, {
    "tStartMs": 2196630,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "that is doing what\nit's supposed to do."
    } ]
  }, {
    "tStartMs": 2198790,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Because that kind of reward\nhacking is very different"
    } ]
  }, {
    "tStartMs": 2202930,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "from what you can think about."
    } ]
  }, {
    "tStartMs": 2204910,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Let me give you\njust one example."
    } ]
  }, {
    "tStartMs": 2206350,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "I have so many\nexamples about that,"
    } ]
  }, {
    "tStartMs": 2207970,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "but I'm giving you\nthe simplest one."
    } ]
  }, {
    "tStartMs": 2209650,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "You mentioned earlier\nabout load balancing."
    } ]
  }, {
    "tStartMs": 2211810,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So, say you are\ngoing to say, okay,"
    } ]
  }, {
    "tStartMs": 2213520,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "I want to develop a load\nbalancer algorithms"
    } ]
  }, {
    "tStartMs": 2216610,
    "dDurationMs": 1677,
    "segs": [ {
      "utf8": "and, you know,"
    } ]
  }, {
    "tStartMs": 2218320,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "for and -- you know,\nusing the agents."
    } ]
  }, {
    "tStartMs": 2221380,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And we did that, we have that\na few months ago using EPLB,"
    } ]
  }, {
    "tStartMs": 2225070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "right, Expert Parallelism\nLoad Balancer, of course."
    } ]
  }, {
    "tStartMs": 2227590,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And then what you want to do\nis the metrics, you want this,"
    } ]
  }, {
    "tStartMs": 2230530,
    "dDurationMs": 4863,
    "segs": [ {
      "utf8": "the load you are\ngoing to handle."
    } ]
  }, {
    "tStartMs": 2235427,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "You know, you want\nto maximize that load."
    } ]
  }, {
    "tStartMs": 2237520,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "Now, one solution is simply,"
    } ]
  }, {
    "tStartMs": 2241423,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "which we've seen, that\nbecause that's a metric --"
    } ]
  }, {
    "tStartMs": 2244322,
    "dDurationMs": 2678,
    "segs": [ {
      "utf8": "the \"hill climbs\", the load,"
    } ]
  }, {
    "tStartMs": 2247000,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "is just dropping requests."
    } ]
  }, {
    "tStartMs": 2249310,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Right? Now, you wouldn't think\nthat when you tell someone,"
    } ]
  }, {
    "tStartMs": 2253930,
    "dDurationMs": 3230,
    "segs": [ {
      "utf8": "even when you write the\nPRD about the load balancers,"
    } ]
  }, {
    "tStartMs": 2257194,
    "dDurationMs": 1746,
    "segs": [ {
      "utf8": "\"Hey, you shouldn't\ndrop the request.\""
    } ]
  }, {
    "tStartMs": 2258940,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "It's that's kind of\nunderstandable, right?"
    } ]
  }, {
    "tStartMs": 2261130,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "But these models,\nthey are going to do"
    } ]
  }, {
    "tStartMs": 2264580,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "that because they are going"
    } ]
  }, {
    "tStartMs": 2265750,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to maximize the things you\ntold them to maximize, right?"
    } ]
  }, {
    "tStartMs": 2268270,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "In the simplest and\nthe easiest way."
    } ]
  }, {
    "tStartMs": 2270910,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So that's kind of why\nI'm saying it, right?"
    } ]
  }, {
    "tStartMs": 2272830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "And there are many things"
    } ]
  }, {
    "tStartMs": 2274090,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which you can pass all the\nunit tests and so forth."
    } ]
  }, {
    "tStartMs": 2276970,
    "dDurationMs": 4190,
    "segs": [ {
      "utf8": "And then when you look deeper,\nthere are things which are,"
    } ]
  }, {
    "tStartMs": 2281160,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "in a way, overfit to your test\nyou couldn't imagine, right?"
    } ]
  }, {
    "tStartMs": 2286840,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "It's like that's kind of the\nthings you still need to,"
    } ]
  }, {
    "tStartMs": 2289660,
    "dDurationMs": 1110,
    "segs": [ {
      "utf8": "I think, at this stage."
    } ]
  }, {
    "tStartMs": 2290770,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "I don't know what will happen\nin a few months, in one year,"
    } ]
  }, {
    "tStartMs": 2293590,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "but right now, you have\nto be able to specify."
    } ]
  }, {
    "tStartMs": 2297130,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "If you didn't specify something,\nyou can almost guarantee"
    } ]
  }, {
    "tStartMs": 2301210,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "that the systems will\nfind something around it."
    } ]
  }, {
    "tStartMs": 2304390,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And there are three places\na specification comes from."
    } ]
  }, {
    "tStartMs": 2307510,
    "dDurationMs": 3365,
    "segs": [ {
      "utf8": "So one is, basically --"
    } ]
  }, {
    "tStartMs": 2310908,
    "dDurationMs": 1282,
    "segs": [ {
      "utf8": "Actually, there are only two."
    } ]
  }, {
    "tStartMs": 2312190,
    "dDurationMs": 1105,
    "segs": [ {
      "utf8": "And you know, like. . ."
    } ]
  }, {
    "tStartMs": 2313328,
    "dDurationMs": 2552,
    "segs": [ {
      "utf8": "One is that the\ntraining data set."
    } ]
  }, {
    "tStartMs": 2315880,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "The training data set,\nyou kind of train,"
    } ]
  }, {
    "tStartMs": 2317890,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and some specifications\ncome from here."
    } ]
  }, {
    "tStartMs": 2319990,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "Like, for instance, one year\nago, when you generated code,"
    } ]
  }, {
    "tStartMs": 2323080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "you have a lot of\nvulnerabilities."
    } ]
  }, {
    "tStartMs": 2324940,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "Now, you have fewer\nvulnerabilities"
    } ]
  }, {
    "tStartMs": 2326710,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "when you generate\ncode with agentic."
    } ]
  }, {
    "tStartMs": 2329020,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Right? And the other\none is from the prompt."
    } ]
  }, {
    "tStartMs": 2331540,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "You have to specify what\nit should do or not."
    } ]
  }, {
    "tStartMs": 2334330,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "If it's not in the\nprompt or it's not"
    } ]
  }, {
    "tStartMs": 2337300,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "in the training data set, it's\ngoing to find a way around."
    } ]
  }, {
    "tStartMs": 2342040,
    "dDurationMs": 930,
    "segs": [ {
      "utf8": "Mark Russinovich: It'll\nfill in the blanks."
    } ]
  }, {
    "tStartMs": 2342970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Ion Stoica: Yeah, so that's\nkind of, I think, that's,"
    } ]
  }, {
    "tStartMs": 2344770,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "I think, the main bottleneck."
    } ]
  }, {
    "tStartMs": 2347076,
    "dDurationMs": 1016,
    "segs": [ {
      "utf8": "Mark Russinovich: All right.\nSo, now we really have six"
    } ]
  }, {
    "tStartMs": 2348126,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "minutes, and I'll give\nyou a question that I --"
    } ]
  }, {
    "tStartMs": 2350002,
    "dDurationMs": 4265,
    "segs": [ {
      "utf8": "that I think is the -- the\nquestion that I get a lot,"
    } ]
  }, {
    "tStartMs": 2354301,
    "dDurationMs": 1329,
    "segs": [ {
      "utf8": "and I've got my own\nopinion about this,"
    } ]
  }, {
    "tStartMs": 2355630,
    "dDurationMs": 870,
    "segs": [ {
      "utf8": "but I'm curious about yours."
    } ]
  }, {
    "tStartMs": 2356500,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Ion Stoica: So you'll answer\nit after I answer it."
    } ]
  }, {
    "tStartMs": 2357640,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah, I'll answer it."
    } ]
  }, {
    "tStartMs": 2359760,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "And this is, I talk to people,\nand I explain I've got"
    } ]
  }, {
    "tStartMs": 2364570,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "so many war stories of\nAI going off the rails."
    } ]
  }, {
    "tStartMs": 2367000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I mean, me and Scott, we\nhave got this podcast."
    } ]
  }, {
    "tStartMs": 2370480,
    "dDurationMs": 3390,
    "segs": [ {
      "utf8": "I talk about how I basically\nsculpt, which I always have."
    } ]
  }, {
    "tStartMs": 2373870,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "But even with AI, I'm\nwatching what it's doing."
    } ]
  }, {
    "tStartMs": 2376060,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "I'm control seeing it."
    } ]
  }, {
    "tStartMs": 2378820,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "I'm telling it, \"That's not\nwhat I want you to do.\""
    } ]
  }, {
    "tStartMs": 2381460,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And I see it creating this test\nor going off in some direction,"
    } ]
  }, {
    "tStartMs": 2385240,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "filling in the blanks\nwith something"
    } ]
  }, {
    "tStartMs": 2386530,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "that is ridiculous or\nthat I don't want."
    } ]
  }, {
    "tStartMs": 2390030,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And I tell people\nthis and I say,"
    } ]
  }, {
    "tStartMs": 2392130,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "you just can't give it a\nprompt or a PRD and expect"
    } ]
  }, {
    "tStartMs": 2395670,
    "dDurationMs": 3450,
    "segs": [ {
      "utf8": "that you're going to get a\nsystem that works reliably"
    } ]
  }, {
    "tStartMs": 2399120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and efficiently and\ndoes all the things"
    } ]
  }, {
    "tStartMs": 2401040,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "that you imagine you\nwould want it to do."
    } ]
  }, {
    "tStartMs": 2403620,
    "dDurationMs": 4030,
    "segs": [ {
      "utf8": "And even if you go and\ntry to specify it,"
    } ]
  }, {
    "tStartMs": 2407650,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "you cannot specify it\ndeeply enough to guarantee"
    } ]
  }, {
    "tStartMs": 2410650,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "that it's not going to do\nthings that you don't want."
    } ]
  }, {
    "tStartMs": 2412840,
    "dDurationMs": 7410,
    "segs": [ {
      "utf8": "A lot of what we do is based off\nof kind of environmental context"
    } ]
  }, {
    "tStartMs": 2420250,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "and just kind of the taste\nthat we've developed."
    } ]
  }, {
    "tStartMs": 2424850,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "And so I'm like-- I just don't\nsee a path to this world where"
    } ]
  }, {
    "tStartMs": 2429130,
    "dDurationMs": 2430,
    "segs": [ {
      "utf8": "You don't need engineers that\nunderstand what's going on"
    } ]
  }, {
    "tStartMs": 2431560,
    "dDurationMs": 1036,
    "segs": [ {
      "utf8": "and don't know how to guide"
    } ]
  }, {
    "tStartMs": 2432630,
    "dDurationMs": 1150,
    "segs": [ {
      "utf8": "the system when\nit goes off the rails."
    } ]
  }, {
    "tStartMs": 2433780,
    "dDurationMs": 3826,
    "segs": [ {
      "utf8": "And then, I get this pushback\nof, \"No, Mark, you're just--\""
    } ]
  }, {
    "tStartMs": 2437640,
    "dDurationMs": 1147,
    "segs": [ {
      "utf8": "You know? That's a bet that"
    } ]
  }, {
    "tStartMs": 2438820,
    "dDurationMs": 1950,
    "segs": [ {
      "utf8": "I would take with you every day"
    } ]
  }, {
    "tStartMs": 2440770,
    "dDurationMs": 2910,
    "segs": [ {
      "utf8": "because it's going to be solved."
    } ]
  }, {
    "tStartMs": 2443680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Maybe two years from now,\nmaybe five years from now,"
    } ]
  }, {
    "tStartMs": 2446020,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "maybe 10 years from now,\nthe AI will be so good"
    } ]
  }, {
    "tStartMs": 2449800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "that you won't need that."
    } ]
  }, {
    "tStartMs": 2451420,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Your example where you\nsaid the load balancer was"
    } ]
  }, {
    "tStartMs": 2453520,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "dropping requests."
    } ]
  }, {
    "tStartMs": 2454810,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "What if you have an adversarial\ncode reviewer go look"
    } ]
  }, {
    "tStartMs": 2457630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "at the system and\nsay, \"You know what,"
    } ]
  }, {
    "tStartMs": 2459670,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you shouldn't be\ndropping a request.\""
    } ]
  }, {
    "tStartMs": 2460870,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "And it's, is this system\nwell-behaved? It'll say,"
    } ]
  }, {
    "tStartMs": 2463545,
    "dDurationMs": 2425,
    "segs": [ {
      "utf8": "\"No, it's not.\" And so you\njust address that."
    } ]
  }, {
    "tStartMs": 2465970,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So where do you lie on this?"
    } ]
  }, {
    "tStartMs": 2467770,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "Do you think that--\nwould you be bold enough"
    } ]
  }, {
    "tStartMs": 2469660,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "to say it's never going to be\nsolved or do you think we'll get"
    } ]
  }, {
    "tStartMs": 2472360,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "to the point where\nwe'll have the ability"
    } ]
  }, {
    "tStartMs": 2474850,
    "dDurationMs": 5610,
    "segs": [ {
      "utf8": "to give a specification,\nit'll come out great,"
    } ]
  }, {
    "tStartMs": 2480460,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "and you won't need a human?"
    } ]
  }, {
    "tStartMs": 2481270,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "Ion Stoica: I think\nthat in theoretical--"
    } ]
  }, {
    "tStartMs": 2487450,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "from the theoretical\nperspective, it's very hard"
    } ]
  }, {
    "tStartMs": 2490450,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "for me to see how it's\ngoing to be ever solved."
    } ]
  }, {
    "tStartMs": 2494380,
    "dDurationMs": 6030,
    "segs": [ {
      "utf8": "And fundamentally, because\nwe know from Gödel"
    } ]
  }, {
    "tStartMs": 2500410,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "that no axiomatic\nsystem can be complete."
    } ]
  }, {
    "tStartMs": 2504010,
    "dDurationMs": 570,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah."
    } ]
  }, {
    "tStartMs": 2504580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Ion Stoica: So in some sense,"
    } ]
  }, {
    "tStartMs": 2506260,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that kind of tells\nyou something."
    } ]
  }, {
    "tStartMs": 2509560,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "I think that when we look at\nother techniques to do it,"
    } ]
  }, {
    "tStartMs": 2514090,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "like for instance, assume that\nyou have a formal specification."
    } ]
  }, {
    "tStartMs": 2518490,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "You can write in Lean,\non Coal, and so forth."
    } ]
  }, {
    "tStartMs": 2522450,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "So from that one, if I have\nthe formal specification,"
    } ]
  }, {
    "tStartMs": 2526050,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "then you can generate the code,"
    } ]
  }, {
    "tStartMs": 2528210,
    "dDurationMs": 2190,
    "segs": [ {
      "utf8": "and then you can\ngenerate the proof"
    } ]
  }, {
    "tStartMs": 2530400,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "that the code satisfies\nthe specification."
    } ]
  }, {
    "tStartMs": 2533650,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "So that kind of is good,\nand you can see that."
    } ]
  }, {
    "tStartMs": 2538360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The problem is that obviously\nthen you need to write"
    } ]
  }, {
    "tStartMs": 2541840,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "that specification, which\nis kind of not easy."
    } ]
  }, {
    "tStartMs": 2545590,
    "dDurationMs": 3195,
    "segs": [ {
      "utf8": "And even that when\nyou write the specification,"
    } ]
  }, {
    "tStartMs": 2548818,
    "dDurationMs": 3346,
    "segs": [ {
      "utf8": "it cannot -- you\nknow, it's like,"
    } ]
  }, {
    "tStartMs": 2552197,
    "dDurationMs": 2033,
    "segs": [ {
      "utf8": "if it's incomplete, right?"
    } ]
  }, {
    "tStartMs": 2554230,
    "dDurationMs": 1347,
    "segs": [ {
      "utf8": "You don't specify a property"
    } ]
  }, {
    "tStartMs": 2555610,
    "dDurationMs": 1470,
    "segs": [ {
      "utf8": "because, you know,\nlike, in this case,"
    } ]
  }, {
    "tStartMs": 2557080,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I write a specification for load\nbalancers, but I don't write,"
    } ]
  }, {
    "tStartMs": 2560500,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "\"Oh, you shouldn't drop\nthe packets,\" right?"
    } ]
  }, {
    "tStartMs": 2563740,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "So maybe if there is a\nconservation law there,"
    } ]
  }, {
    "tStartMs": 2566500,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "you can argue that\nyou should put it in."
    } ]
  }, {
    "tStartMs": 2570070,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "But there can be\nassumptions, right?"
    } ]
  }, {
    "tStartMs": 2571930,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Because any\nspecification, anything,"
    } ]
  }, {
    "tStartMs": 2573640,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "you have to have\nsome assumptions,"
    } ]
  }, {
    "tStartMs": 2575020,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "right, to make the proof."
    } ]
  }, {
    "tStartMs": 2576820,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But you are not going to imagine\nall of the assumptions, right?"
    } ]
  }, {
    "tStartMs": 2580600,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Mark Russinovich: I got\nto -- you know what I think?"
    } ]
  }, {
    "tStartMs": 2582610,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You know what is a\nfull specification?"
    } ]
  }, {
    "tStartMs": 2585250,
    "dDurationMs": 2355,
    "segs": [ {
      "utf8": "Actually, programming languages."
    } ]
  }, {
    "tStartMs": 2587639,
    "dDurationMs": 2531,
    "segs": [ {
      "utf8": "Ion Stoica: Almost, almost.\nEven that is not."
    } ]
  }, {
    "tStartMs": 2590170,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "Let me give you an example --\neven that is not."
    } ]
  }, {
    "tStartMs": 2592420,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah, that's true. But that's --"
    } ]
  }, {
    "tStartMs": 2594035,
    "dDurationMs": 1038,
    "segs": [ {
      "utf8": "Ion Stoica: Like, I\nremember, you know,"
    } ]
  }, {
    "tStartMs": 2595106,
    "dDurationMs": 1372,
    "segs": [ {
      "utf8": "we have this kind\nof, I'm not sure really,"
    } ]
  }, {
    "tStartMs": 2596511,
    "dDurationMs": 2509,
    "segs": [ {
      "utf8": "like, this peer-to-peer\ncourt system and so forth."
    } ]
  }, {
    "tStartMs": 2599020,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "I was young faculty there,"
    } ]
  }, {
    "tStartMs": 2601240,
    "dDurationMs": 1530,
    "segs": [ {
      "utf8": "still implementing\nall of these things."
    } ]
  }, {
    "tStartMs": 2602770,
    "dDurationMs": 3150,
    "segs": [ {
      "utf8": "And really, really, I\nthought it's bulletproof."
    } ]
  }, {
    "tStartMs": 2605920,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "And we are testing it on this --"
    } ]
  }, {
    "tStartMs": 2609930,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "I don't remember, how many\nremember about Planet Labs."
    } ]
  }, {
    "tStartMs": 2612330,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Twenty years ago, this\nPlanet Lab, which is kind"
    } ]
  }, {
    "tStartMs": 2614730,
    "dDurationMs": 2790,
    "segs": [ {
      "utf8": "of an infrastructure,\ninternet infrastructure,"
    } ]
  }, {
    "tStartMs": 2617520,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "or each organization have these\nservers, and then you deploy"
    } ]
  }, {
    "tStartMs": 2622330,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "at the servers applications,\nand then you communicate."
    } ]
  }, {
    "tStartMs": 2625390,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "And it breaks."
    } ]
  }, {
    "tStartMs": 2626620,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "And I don't know how it breaks."
    } ]
  }, {
    "tStartMs": 2627640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It has to work."
    } ]
  }, {
    "tStartMs": 2628960,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "And when we look about, it\nwas an assumption we missed,"
    } ]
  }, {
    "tStartMs": 2632650,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and the assumption we've\nmade, implicitly, is a kind"
    } ]
  }, {
    "tStartMs": 2636070,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "of transient connectivity."
    } ]
  }, {
    "tStartMs": 2637330,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If A communicates with B\nand B communicates with C,"
    } ]
  }, {
    "tStartMs": 2639970,
    "dDurationMs": 3090,
    "segs": [ {
      "utf8": "then A should communicate\nwith C. And in the Internet"
    } ]
  }, {
    "tStartMs": 2643060,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "as a whole, right, because\nit's not behind NATs"
    } ]
  }, {
    "tStartMs": 2645790,
    "dDurationMs": 2250,
    "segs": [ {
      "utf8": "and so forth, this has to hold."
    } ]
  }, {
    "tStartMs": 2648040,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And it should have hold,\nexcept that is one university"
    } ]
  }, {
    "tStartMs": 2652120,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "which misconfigured\ntheir servers."
    } ]
  }, {
    "tStartMs": 2654610,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "So that blocks some\ncommunication, some traffic."
    } ]
  }, {
    "tStartMs": 2658180,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "So that's kind of, I\nalways think about that."
    } ]
  }, {
    "tStartMs": 2660160,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "Mark Russinovich:\nYeah, good example."
    } ]
  }, {
    "tStartMs": 2660580,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "Ion Stoica: I couldn't,\nyou know, it's like,"
    } ]
  }, {
    "tStartMs": 2663314,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "I was actually, we were\ncorrect about the assumptions."
    } ]
  }, {
    "tStartMs": 2667480,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "It should have held, but it\ndidn't because of a mistake"
    } ]
  }, {
    "tStartMs": 2671860,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "in the configuration\nin the platform."
    } ]
  }, {
    "tStartMs": 2673480,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "So that's kind of what\nI'm trying to say."
    } ]
  }, {
    "tStartMs": 2675190,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "It's extremely hard."
    } ]
  }, {
    "tStartMs": 2676240,
    "dDurationMs": 3630,
    "segs": [ {
      "utf8": "Mark Russinovich: Yeah. So, Now\nwe are really, I think, at time."
    } ]
  }, {
    "tStartMs": 2679870,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I haven't seen the\nclock jump up again."
    } ]
  }, {
    "tStartMs": 2682930,
    "dDurationMs": 1875,
    "segs": [ {
      "utf8": "But it's been a\nfun conversation,"
    } ]
  }, {
    "tStartMs": 2684839,
    "dDurationMs": 941,
    "segs": [ {
      "utf8": "a really fun conversation."
    } ]
  }, {
    "tStartMs": 2685780,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And if you like this,\nthis is the experiment."
    } ]
  }, {
    "tStartMs": 2688540,
    "dDurationMs": 1290,
    "segs": [ {
      "utf8": "It's the first time we've\ndone something like this."
    } ]
  }, {
    "tStartMs": 2689830,
    "dDurationMs": 1890,
    "segs": [ {
      "utf8": "If you like this, let us know."
    } ]
  }, {
    "tStartMs": 2691720,
    "dDurationMs": 1650,
    "segs": [ {
      "utf8": "So we'll try to do it again."
    } ]
  }, {
    "tStartMs": 2693370,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If you find it boring,\nalso let us know."
    } ]
  }, {
    "tStartMs": 2696730,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "And I think the people\nthat thought it was boring"
    } ]
  }, {
    "tStartMs": 2698513,
    "dDurationMs": 1507,
    "segs": [ {
      "utf8": "probably already\nleft, so I think--"
    } ]
  }, {
    "tStartMs": 2700020,
    "dDurationMs": 1090,
    "segs": [ {
      "utf8": "[ Laughter ]"
    } ]
  }, {
    "tStartMs": 2701110,
    "dDurationMs": 2010,
    "segs": [ {
      "utf8": "Ion Stoica: We have a\nbiased audience here."
    } ]
  }, {
    "tStartMs": 2703120,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Mark Russinovich: But thanks\nvery much for coming to Build,"
    } ]
  }, {
    "tStartMs": 2705220,
    "dDurationMs": 1230,
    "segs": [ {
      "utf8": "and I hope to see\nyou tomorrow morning"
    } ]
  }, {
    "tStartMs": 2706450,
    "dDurationMs": 2550,
    "segs": [ {
      "utf8": "in my Azure Innovation Talk,\nwhere I'll talk a little bit"
    } ]
  }, {
    "tStartMs": 2709000,
    "dDurationMs": 1106,
    "segs": [ {
      "utf8": "about some of these things."
    } ]
  }, {
    "tStartMs": 2710140,
    "dDurationMs": 612,
    "segs": [ {
      "utf8": "[ Applause ]"
    } ]
  }, {
    "tStartMs": 2710786,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "Ion Stoica: Thank you very much."
    } ]
  }, {
    "tStartMs": 2711460,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "[ Applause ]"
    } ]
  } ]
