  "events": [ {
    "tStartMs": 1440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "All right. We're about to \nenter the High NA lab."
    } ]
  }, {
    "tStartMs": 5960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Behind this highly secured \ndoor in an ASML cleanroom."
    } ]
  }, {
    "tStartMs": 9160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "There's a giant $400 million \nmachine."
    } ]
  }, {
    "tStartMs": 12200,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "It's bigger than a \ndouble-decker bus."
    } ]
  }, {
    "tStartMs": 14440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Made with such closely \nprotected technical"
    } ]
  }, {
    "tStartMs": 16560,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "specificity."
    } ]
  }, {
    "tStartMs": 17560,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Very complex. The most \nadvanced machine tool in"
    } ]
  }, {
    "tStartMs": 22040,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "history."
    } ]
  }, {
    "tStartMs": 22880,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That no filming's ever been \nallowed,"
    } ]
  }, {
    "tStartMs": 24640,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "even by ASML's own team."
    } ]
  }, {
    "tStartMs": 26480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Until we flew across the \nworld to see it."
    } ]
  }, {
    "tStartMs": 28880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We're here at ASML's \nheadquarters in the"
    } ]
  }, {
    "tStartMs": 30920,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Netherlands, where 100% of \nthe world's extreme"
    } ]
  }, {
    "tStartMs": 33840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "ultraviolet lithography \nmachines are made,"
    } ]
  }, {
    "tStartMs": 36320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "and now the next generation \nmachines called High NA."
    } ]
  }, {
    "tStartMs": 39480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "We had to wear these bunny \nsuits to protect these"
    } ]
  }, {
    "tStartMs": 41840,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "extremely precise machines \nfrom getting contaminated by"
    } ]
  }, {
    "tStartMs": 45040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "our own hair and skin cells."
    } ]
  }, {
    "tStartMs": 47400,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "This is high numerical \naperture."
    } ]
  }, {
    "tStartMs": 49160,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "High NA, the new generation \nof EUV machines,"
    } ]
  }, {
    "tStartMs": 52280,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the only machines in the \nworld capable of printing"
    } ]
  }, {
    "tStartMs": 55000,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "nanoscopic blueprints onto \nthe most advanced chips."
    } ]
  }, {
    "tStartMs": 58120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Nvidia, Apple, \nTaiwan Semiconductor,"
    } ]
  }, {
    "tStartMs": 60360,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Samsung, Intel."
    } ]
  }, {
    "tStartMs": 61640,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "None of their advanced chips \ncan be made without EUV."
    } ]
  }, {
    "tStartMs": 64450,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And this company has that \nmarket completely cornered."
    } ]
  }, {
    "tStartMs": 68490,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The first High NA machine \nwas installed in the U.S."
    } ]
  }, {
    "tStartMs": 71210,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "at Intel's Oregon chip \nfabrication plant,"
    } ]
  }, {
    "tStartMs": 73330,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "or Fab, last year."
    } ]
  }, {
    "tStartMs": 74810,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Only five have ever been \nshipped."
    } ]
  }, {
    "tStartMs": 76850,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Indeed, the machine is so \nbig you can't ship them in"
    } ]
  }, {
    "tStartMs": 79010,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "ones, so we break them into \nparts."
    } ]
  }, {
    "tStartMs": 81530,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Now they're being ramped up \nto make millions of chips on"
    } ]
  }, {
    "tStartMs": 84210,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "the factory floors of the \nfew companies that can"
    } ]
  }, {
    "tStartMs": 86410,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "afford them Intel, \nTSMC and Samsung."
    } ]
  }, {
    "tStartMs": 89250,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "ASML says eventually China \nwill be used by all its EUV"
    } ]
  }, {
    "tStartMs": 92450,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "customers. Other advanced \nchipmakers like Micron,"
    } ]
  }, {
    "tStartMs": 94930,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "SK Hynix and Rapidus."
    } ]
  }, {
    "tStartMs": 96930,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Without EUV, without very \nadvanced logic"
    } ]
  }, {
    "tStartMs": 99370,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "manufacturing."
    } ]
  }, {
    "tStartMs": 100450,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Most of the AI cannot \nhappen."
    } ]
  }, {
    "tStartMs": 102530,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "CNB went from ASML's labs in \nCalifornia all the way to"
    } ]
  }, {
    "tStartMs": 105690,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "its Veldhoven, \nNetherlands, headquarters to"
    } ]
  }, {
    "tStartMs": 107730,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "bring you this \nnever-before-seen look at"
    } ]
  }, {
    "tStartMs": 109370,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "the world's most advanced \nchipmaking machine and to"
    } ]
  }, {
    "tStartMs": 112130,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "ask its makers exactly how \nit works and what could go"
    } ]
  }, {
    "tStartMs": 115050,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "wrong, amidst Trump's \ntariffs,"
    } ]
  }, {
    "tStartMs": 116810,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "export controls and a new \ntraining facility coming to"
    } ]
  }, {
    "tStartMs": 119650,
    "dDurationMs": 120,
    "segs": [ {
      "utf8": "the"
    } ]
  }, {
    "tStartMs": 119810,
    "dDurationMs": 14810,
    "segs": [ {
      "utf8": "U.S."
    } ]
  }, {
    "tStartMs": 119810,
    "dDurationMs": 14810,
    "segs": [ {
      "utf8": "Suited"
    } ]
  }, {
    "tStartMs": 134620,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "up and throuhj an air \nshower."
    } ]
  }, {
    "tStartMs": 136100,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It's basically to blow off \nall the contamination from"
    } ]
  }, {
    "tStartMs": 139580,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "your suit and your clothes."
    } ]
  }, {
    "tStartMs": 142940,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Down several long hallways \nwhere humongous parts are"
    } ]
  }, {
    "tStartMs": 145380,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "being meticulously moved."
    } ]
  }, {
    "tStartMs": 147180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "How many people would you \nsay are working here? 24 /7"
    } ]
  }, {
    "tStartMs": 149340,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "."
    } ]
  }, {
    "tStartMs": 150180,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Inside the EUV factory \nalone,"
    } ]
  }, {
    "tStartMs": 152180,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "it's like 2,000 people."
    } ]
  }, {
    "tStartMs": 153820,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It's a 24 /7 operation."
    } ]
  }, {
    "tStartMs": 156340,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Ayssia Haddou took us to the \nrestricted lab space where"
    } ]
  }, {
    "tStartMs": 159060,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "40 years of ASML's \ntechnology research all"
    } ]
  }, {
    "tStartMs": 161660,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "comes together."
    } ]
  }, {
    "tStartMs": 162820,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It takes approximately a \nyear and a half to create"
    } ]
  }, {
    "tStartMs": 166300,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "this system."
    } ]
  }, {
    "tStartMs": 167500,
    "dDurationMs": 2707,
    "segs": [ {
      "utf8": "Haddou leads the team that \ntests and qualifies the High"
    } ]
  }, {
    "tStartMs": 170207,
    "dDurationMs": 933,
    "segs": [ {
      "utf8": "NA machines here."
    } ]
  }, {
    "tStartMs": 171180,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "It still does blow my mind."
    } ]
  }, {
    "tStartMs": 172620,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I think even if you learn \nmore about it,"
    } ]
  }, {
    "tStartMs": 174740,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "it blows your mind even \nmore."
    } ]
  }, {
    "tStartMs": 176580,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The big machine at the end \nof the day is used to"
    } ]
  }, {
    "tStartMs": 178980,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "transfer a pattern, \nwhich we store on a mask"
    } ]
  }, {
    "tStartMs": 182540,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "onto a wafer, \nand then the end of the day,"
    } ]
  }, {
    "tStartMs": 184780,
    "dDurationMs": 2490,
    "segs": [ {
      "utf8": "you cut them in pieces, \nyou package them,"
    } ]
  }, {
    "tStartMs": 188270,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and then you end up in your \nphone."
    } ]
  }, {
    "tStartMs": 191270,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Jos Benschop joined Dutch \nelectronics giant Philips in"
    } ]
  }, {
    "tStartMs": 194190,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "1984. Two weeks later, \nASML was founded as a"
    } ]
  }, {
    "tStartMs": 197470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "subsidiary, conducting \nresearch out of a leaky shed"
    } ]
  }, {
    "tStartMs": 199990,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "nearby in Eindhoven."
    } ]
  }, {
    "tStartMs": 201550,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "It broke off from Philips \nwith an IPO in 1995,"
    } ]
  }, {
    "tStartMs": 204710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "and two years later, \nBenschop helped spearhead"
    } ]
  }, {
    "tStartMs": 207270,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ASML's first foray into EUV."
    } ]
  }, {
    "tStartMs": 209760,
    "dDurationMs": 2390,
    "segs": [ {
      "utf8": "Three or four years later, \nwe had enough confidence to"
    } ]
  }, {
    "tStartMs": 212190,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "put all our eggs in one \nbasket called EUV."
    } ]
  }, {
    "tStartMs": 214590,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "With hindsight, \nwe can say we placed the"
    } ]
  }, {
    "tStartMs": 216550,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "right bet."
    } ]
  }, {
    "tStartMs": 217710,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "On a yearly basis, \nI think we file several"
    } ]
  }, {
    "tStartMs": 220270,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "hundreds of patents on EUV."
    } ]
  }, {
    "tStartMs": 222950,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Christophe Fouquet began as \nCEO just over a year ago,"
    } ]
  }, {
    "tStartMs": 225870,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "but he's been with ASML more \nthan 17 years."
    } ]
  }, {
    "tStartMs": 228590,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "We barely made it."
    } ]
  }, {
    "tStartMs": 229710,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I think sometimes people \nforget that."
    } ]
  }, {
    "tStartMs": 231950,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "But EUV took us practically \nmore than 20 years."
    } ]
  }, {
    "tStartMs": 236030,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I would say it's been a very \nrisky investment because"
    } ]
  }, {
    "tStartMs": 239070,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "when we started, \nwell, there was no guarantee"
    } ]
  }, {
    "tStartMs": 242670,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "the technology would work."
    } ]
  }, {
    "tStartMs": 244790,
    "dDurationMs": 3650,
    "segs": [ {
      "utf8": "By 2018, ASML had shown that \nEUV was possible,"
    } ]
  }, {
    "tStartMs": 248440,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and it's the same process \nused in High NA."
    } ]
  }, {
    "tStartMs": 250800,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Here's how it works."
    } ]
  }, {
    "tStartMs": 252080,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Chips are built in a grid \nformation on thinly sliced"
    } ]
  }, {
    "tStartMs": 254560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "wafers of silicon, \neach with up to 100 thin"
    } ]
  }, {
    "tStartMs": 256880,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "layers that make up billions \nof transistors that"
    } ]
  }, {
    "tStartMs": 259160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "determine what the chips can \ndo."
    } ]
  }, {
    "tStartMs": 261120,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "These layers are printed \nusing lithography,"
    } ]
  }, {
    "tStartMs": 263240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "extremely precise rays of \nlight projected through a"
    } ]
  }, {
    "tStartMs": 265640,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "mask of the chip design \nuntil they hit the surface"
    } ]
  }, {
    "tStartMs": 267800,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "of the wafer that's been \ncoated with photoresist"
    } ]
  }, {
    "tStartMs": 270000,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "chemicals. ASML's older \ngeneration DUV machines,"
    } ]
  }, {
    "tStartMs": 273560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "which it still makes, \nuse rays of deep ultraviolet"
    } ]
  }, {
    "tStartMs": 276200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "light with a wavelength of \n193 nanometers."
    } ]
  }, {
    "tStartMs": 279280,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Nikon and Canon in Japan are \nstill competitors in DUV,"
    } ]
  }, {
    "tStartMs": 282960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "but ASML's real breakthrough \ncame with that bold bet on a"
    } ]
  }, {
    "tStartMs": 285840,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "technology many thought was \nimpossible using even"
    } ]
  }, {
    "tStartMs": 288800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "shorter wavelength extreme \nultraviolet light,"
    } ]
  }, {
    "tStartMs": 291160,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "EUV, something that to this \nday no other company does."
    } ]
  }, {
    "tStartMs": 294760,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "A few more people tried for \nmany years,"
    } ]
  }, {
    "tStartMs": 297960,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "but the size of the \ninvestment,"
    } ]
  }, {
    "tStartMs": 300440,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the commitment you have to \nhave,"
    } ]
  }, {
    "tStartMs": 302360,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "I think, discouraged quite a \nfew people."
    } ]
  }, {
    "tStartMs": 304760,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Transistors have gotten so \nsmall,"
    } ]
  }, {
    "tStartMs": 306360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "down to 10,000 times thinner \nthan a human hair,"
    } ]
  }, {
    "tStartMs": 308940,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "that ASML decided to create \nits own source of smaller,"
    } ]
  }, {
    "tStartMs": 311980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "more precise EUV light."
    } ]
  }, {
    "tStartMs": 313660,
    "dDurationMs": 2296,
    "segs": [ {
      "utf8": "At a wavelength of 13.5 \nnanometers,"
    } ]
  }, {
    "tStartMs": 315956,
    "dDurationMs": 2824,
    "segs": [ {
      "utf8": "it's the width of just five \nDNA strands laid side by"
    } ]
  }, {
    "tStartMs": 318780,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "side."
    } ]
  }, {
    "tStartMs": 319580,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So small that it gets \nabsorbed by almost"
    } ]
  }, {
    "tStartMs": 322020,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "everything. And that's why \nthis whole system needs to"
    } ]
  }, {
    "tStartMs": 324940,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "be in a vacuum."
    } ]
  }, {
    "tStartMs": 326420,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "This tiny thread may look \nlike the strand of a spider"
    } ]
  }, {
    "tStartMs": 328660,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "web, but it's actually \nmolten tin being shot out at"
    } ]
  }, {
    "tStartMs": 331460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "50,000 droplets a second."
    } ]
  }, {
    "tStartMs": 333660,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The tin droplets are \nvaporized with a laser,"
    } ]
  }, {
    "tStartMs": 335700,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and those tiny explosions \nare what emit photons of EUV"
    } ]
  }, {
    "tStartMs": 338620,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "light."
    } ]
  }, {
    "tStartMs": 341380,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "This is called a CO2 laser."
    } ]
  }, {
    "tStartMs": 343060,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It's been used in the car \nindustry for many years."
    } ]
  }, {
    "tStartMs": 345140,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "They would cut through steel \nwith one of these."
    } ]
  }, {
    "tStartMs": 347540,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "We use four of them to shoot \nat one of these tiny tin"
    } ]
  }, {
    "tStartMs": 350460,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "droplets to generate a \nplasma,"
    } ]
  }, {
    "tStartMs": 352460,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "which is hotter than the \nsun."
    } ]
  }, {
    "tStartMs": 354460,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "That plasma generates EUV, \nand that EUV is captured by"
    } ]
  }, {
    "tStartMs": 357780,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "this collector mirror that \ncomes from Carl Zeiss and"
    } ]
  }, {
    "tStartMs": 360820,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "brings the light into our \nscanner."
    } ]
  }, {
    "tStartMs": 363180,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The light bounces off of \nmirrors that aim it through"
    } ]
  }, {
    "tStartMs": 365300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "the lens, much like how a \ncamera works."
    } ]
  }, {
    "tStartMs": 367340,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "But because EUV gets \nabsorbed by typical mirrors."
    } ]
  }, {
    "tStartMs": 370110,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "German optics company Zeiss \nmade specific mirrors just"
    } ]
  }, {
    "tStartMs": 373190,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "for ASML that are the \nflattest man made surfaces"
    } ]
  }, {
    "tStartMs": 375590,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "in the world."
    } ]
  }, {
    "tStartMs": 376630,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "And then the light is \nemitted through the"
    } ]
  }, {
    "tStartMs": 378670,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "projection optics onto the \nwafer,"
    } ]
  }, {
    "tStartMs": 381630,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "which is about here."
    } ]
  }, {
    "tStartMs": 383350,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "So this is the wafer table."
    } ]
  }, {
    "tStartMs": 386190,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "When the EUV finally hits \nphotoresist chemicals on the"
    } ]
  }, {
    "tStartMs": 389150,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "surface of the silicon \nwafer,"
    } ]
  }, {
    "tStartMs": 390710,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "it prints the minuscule \nblueprint that makes up the"
    } ]
  }, {
    "tStartMs": 393150,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "chip. The aim needs to be so \nprecise,"
    } ]
  }, {
    "tStartMs": 395510,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "TSMC says it's equivalent to \nshining a laser from the"
    } ]
  }, {
    "tStartMs": 398390,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "moon to hit a coin on the \nEarth."
    } ]
  }, {
    "tStartMs": 400630,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "EUV made up less than 8% of \nASML's total number of"
    } ]
  }, {
    "tStartMs": 403750,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "machines sold in 2024: \n44 EUV machines versus 374"
    } ]
  }, {
    "tStartMs": 408710,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "cheaper DUV machines, \nbut with a price tag of $220"
    } ]
  }, {
    "tStartMs": 412270,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "million. EUV made up 38% of \nASML's system sales revenue."
    } ]
  }, {
    "tStartMs": 417230,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "But a cost of the chips the \ntool is going to create is"
    } ]
  }, {
    "tStartMs": 421110,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "going down."
    } ]
  }, {
    "tStartMs": 422070,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Because yo u're t he o nly c \nompany in the world that"
    } ]
  }, {
    "tStartMs": 424310,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "makes these m achines, \nw hat's stopping you from"
    } ]
  }, {
    "tStartMs": 426390,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "setting the price even \nhigher?"
    } ]
  }, {
    "tStartMs": 428110,
    "dDurationMs": 3690,
    "segs": [ {
      "utf8": "Well, what stops us is \nMoore's Law says that we"
    } ]
  }, {
    "tStartMs": 431800,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "need to continue to drive \ncosts down."
    } ]
  }, {
    "tStartMs": 434280,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This allows you to go to the \nnext node and then the next"
    } ]
  }, {
    "tStartMs": 437880,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "node, and then again the \nnext node."
    } ]
  }, {
    "tStartMs": 440040,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "If this was to stop, \nthen everyone gets stuck."
    } ]
  }, {
    "tStartMs": 448640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "ASML began developing its \nlatest $400 million High NA"
    } ]
  }, {
    "tStartMs": 452280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "machines around 2016."
    } ]
  }, {
    "tStartMs": 454320,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Inside, all the same \nprocesses still happen with"
    } ]
  }, {
    "tStartMs": 457240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the same EUV light source."
    } ]
  }, {
    "tStartMs": 458920,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "But there's one key \ndifference."
    } ]
  }, {
    "tStartMs": 460840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "We increase the aperture of \nthe opening angle of the"
    } ]
  }, {
    "tStartMs": 463400,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "lens."
    } ]
  }, {
    "tStartMs": 464440,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "High NA stands for high \nnumerical aperture,"
    } ]
  }, {
    "tStartMs": 466680,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "meaning it has a larger lens \nopening,"
    } ]
  }, {
    "tStartMs": 468480,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "increasing the angle at \nwhich the light is captured"
    } ]
  }, {
    "tStartMs": 470600,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "by the mirrors. More light \ncoming in from steeper"
    } ]
  }, {
    "tStartMs": 473280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "angles allows High NA \nmachines to capture"
    } ]
  }, {
    "tStartMs": 475560,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "increasingly small designs \non chip masks,"
    } ]
  }, {
    "tStartMs": 478120,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "so they can be projected in \none exposure step,"
    } ]
  }, {
    "tStartMs": 480760,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "whereas original lower NA \nmachines reach higher"
    } ]
  }, {
    "tStartMs": 483000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "resolution to project these \ntiny designs using multiple"
    } ]
  }, {
    "tStartMs": 486200,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "exposures through multiple \nmasks."
    } ]
  }, {
    "tStartMs": 488280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "One become two, \nthen two become three,"
    } ]
  }, {
    "tStartMs": 491120,
    "dDurationMs": 1050,
    "segs": [ {
      "utf8": "three become four."
    } ]
  }, {
    "tStartMs": 492850,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "And when the number \nincreases,"
    } ]
  }, {
    "tStartMs": 494730,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "it gets very complex process \nwise."
    } ]
  }, {
    "tStartMs": 497370,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And the yield goes down."
    } ]
  }, {
    "tStartMs": 498970,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "But with a higher NA, \nresolution improves and the"
    } ]
  }, {
    "tStartMs": 501570,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "small designs can be printed \nwith fewer masks,"
    } ]
  }, {
    "tStartMs": 503930,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "saving time and money."
    } ]
  }, {
    "tStartMs": 505690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The larger the number, \nthe smaller the thing you"
    } ]
  }, {
    "tStartMs": 508330,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "can print."
    } ]
  }, {
    "tStartMs": 509170,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But this higher NA also \ncomes with a much higher"
    } ]
  }, {
    "tStartMs": 511690,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "price tag for one main \nreason."
    } ]
  }, {
    "tStartMs": 513690,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The higher the NA of an \noptic,"
    } ]
  }, {
    "tStartMs": 516370,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "the bigger the mirror you \nhave to use,"
    } ]
  }, {
    "tStartMs": 518570,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "and therefore the bigger the \nsystem."
    } ]
  }, {
    "tStartMs": 520290,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "These machines also take up \na huge amount of power."
    } ]
  }, {
    "tStartMs": 523450,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "How much power do these \nmachines take?"
    } ]
  }, {
    "tStartMs": 526370,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "I think they take too much."
    } ]
  }, {
    "tStartMs": 527650,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "If we don't improve the \npower efficiency of our AI"
    } ]
  }, {
    "tStartMs": 532570,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "chips over time, \nthe training of the models"
    } ]
  }, {
    "tStartMs": 536850,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "could consume the entire \nworldwide energy,"
    } ]
  }, {
    "tStartMs": 540330,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and that could happen around \n2035."
    } ]
  }, {
    "tStartMs": 542970,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Since the moment we started \nEUV,"
    } ]
  }, {
    "tStartMs": 544890,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "2018, we have reduced the \npower the energy needed per"
    } ]
  }, {
    "tStartMs": 549370,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "wafer exposure by more than \n60%."
    } ]
  }, {
    "tStartMs": 552420,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "ASML says its machines print \nabout 200 wafers per hour,"
    } ]
  }, {
    "tStartMs": 555860,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "24/7, 365. The goal is \nseveral hundred per hour."
    } ]
  }, {
    "tStartMs": 559900,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "You can print at the end of \nthe day,"
    } ]
  }, {
    "tStartMs": 561420,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "millions of these wafers per \nyear."
    } ]
  }, {
    "tStartMs": 563580,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "At a conference in February,"
    } ]
  }, {
    "tStartMs": 564820,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Intel said it started making \nchips with High NA using it"
    } ]
  }, {
    "tStartMs": 567700,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "for some 30,000 wafers so \nfar,"
    } ]
  }, {
    "tStartMs": 569860,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and that it's about twice as \nreliable as previous models."
    } ]
  }, {
    "tStartMs": 573020,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "And Samsung said High NA \ncould reduce its cycle time"
    } ]
  }, {
    "tStartMs": 575580,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "by 60%."
    } ]
  }, {
    "tStartMs": 577420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "High NA means two things."
    } ]
  }, {
    "tStartMs": 578980,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "First and foremost, \nshrink."
    } ]
  }, {
    "tStartMs": 580340,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So there's more devices on a \nsingle wafer."
    } ]
  }, {
    "tStartMs": 583180,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And secondly, \nby avoiding multiple"
    } ]
  }, {
    "tStartMs": 585340,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "patterning, you can make \nthem faster and you can make"
    } ]
  }, {
    "tStartMs": 587660,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "them with higher yield."
    } ]
  }, {
    "tStartMs": 591700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "In reality, every chip is \nmade using multiple"
    } ]
  }, {
    "tStartMs": 594100,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "different lithography \ntechniques at different"
    } ]
  }, {
    "tStartMs": 595860,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "resolutions."
    } ]
  }, {
    "tStartMs": 596860,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Every chip consists out of \nlike 100 different layers."
    } ]
  }, {
    "tStartMs": 601220,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Most of the layers are \nactually made with deep UV,"
    } ]
  }, {
    "tStartMs": 605420,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which is a much smaller \nsystem."
    } ]
  }, {
    "tStartMs": 607980,
    "dDurationMs": 3730,
    "segs": [ {
      "utf8": "Legacy DUV machines sell for \nless 5$ million to $90"
    } ]
  }, {
    "tStartMs": 611710,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "million, but still make up \nover half of ASML's sales."
    } ]
  }, {
    "tStartMs": 614790,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The older machines are in \nhigh demand."
    } ]
  }, {
    "tStartMs": 617030,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Many of the chips we use in \nour daily life do not"
    } ]
  }, {
    "tStartMs": 619630,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "require DEUV. If you press \nthe button to open the"
    } ]
  }, {
    "tStartMs": 622790,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "window in your car, \nunlikely an EUV-based chip"
    } ]
  }, {
    "tStartMs": 625990,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "is needed."
    } ]
  }, {
    "tStartMs": 626950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Turns out ASML sells a lot \nof its legacy machines to"
    } ]
  }, {
    "tStartMs": 629510,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "China, although U.S."
    } ]
  }, {
    "tStartMs": 630710,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "export controls prevent it \nfrom selling EUV there."
    } ]
  }, {
    "tStartMs": 633470,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It's a ban that started \nunder the first Trump"
    } ]
  }, {
    "tStartMs": 635310,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "administration."
    } ]
  }, {
    "tStartMs": 636510,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The Trump administration is \nvery focused on ensuring"
    } ]
  }, {
    "tStartMs": 639830,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "that China does not get \naccess to the most advanced"
    } ]
  }, {
    "tStartMs": 642790,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "tools and chips that are \nrequired to power AI."
    } ]
  }, {
    "tStartMs": 646990,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So without access to ASML's \nEUV machines,"
    } ]
  }, {
    "tStartMs": 649430,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "could China develop its own?"
    } ]
  }, {
    "tStartMs": 651110,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "I feel like it's a real long \nshot that China could enter"
    } ]
  }, {
    "tStartMs": 654590,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "this space. But right now, \nChina's really figuring out"
    } ]
  }, {
    "tStartMs": 657230,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "ways to take things like \nseven nanometer,"
    } ]
  }, {
    "tStartMs": 659950,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the most advanced nodes that \ncan be done without EUV,"
    } ]
  }, {
    "tStartMs": 662470,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "and figuring out ways to \nscale them."
    } ]
  }, {
    "tStartMs": 664110,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And they've been able to do \nthat successfully in some"
    } ]
  }, {
    "tStartMs": 666070,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "areas, like in smartphones \nand personal devices."
    } ]
  }, {
    "tStartMs": 669590,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Still, export controls \nhaven't stopped China from"
    } ]
  }, {
    "tStartMs": 671830,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "stockpiling ASML's less \nadvanced machines."
    } ]
  }, {
    "tStartMs": 673670,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "At one point recently, \nu p to 49% of your business"
    } ]
  }, {
    "tStartMs": 677240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "was in China. What happened \nthere and what is that"
    } ]
  }, {
    "tStartMs": 680280,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "number at now?"
    } ]
  }, {
    "tStartMs": 681160,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "We had a huge backlog in \nChina because we got orders"
    } ]
  }, {
    "tStartMs": 685240,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "in 2022 at the peak of the \nmarket."
    } ]
  }, {
    "tStartMs": 688760,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And in 2023, 24, \nthe rest of the world kind"
    } ]
  }, {
    "tStartMs": 691520,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "of went down. So basically \nwe could use our capacity to"
    } ]
  }, {
    "tStartMs": 695760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "fulfill this backlog."
    } ]
  }, {
    "tStartMs": 697240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "End of 24, last quarter, \nthe part of China in our"
    } ]
  }, {
    "tStartMs": 700280,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "business went down to 30%."
    } ]
  }, {
    "tStartMs": 703400,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "U.S. concern over advanced \ntech making its way to China"
    } ]
  }, {
    "tStartMs": 706120,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "has accelerated amidst the \ngenerative AI race."
    } ]
  }, {
    "tStartMs": 708680,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "But that boom has also sent \ndemand for chips and the"
    } ]
  }, {
    "tStartMs": 711240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "machines that make them \nsoaring."
    } ]
  }, {
    "tStartMs": 712920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "And with it, chip stocks \nincluding ASML's,"
    } ]
  }, {
    "tStartMs": 715440,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "which hit an all time high \nin July."
    } ]
  }, {
    "tStartMs": 717880,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Still, it's declined some \nsince as the chip industry"
    } ]
  }, {
    "tStartMs": 720440,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "faces uncertainties, \nchief among them Trump's"
    } ]
  }, {
    "tStartMs": 723080,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "tariffs."
    } ]
  }, {
    "tStartMs": 724040,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Any idea how tariffs are \ngoing to impact ASML?"
    } ]
  }, {
    "tStartMs": 727680,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Well the short answer is I \ndon't know."
    } ]
  }, {
    "tStartMs": 729440,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "We we don't know."
    } ]
  }, {
    "tStartMs": 730560,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And if anybody would know it \ncould make a lot of money."
    } ]
  }, {
    "tStartMs": 733600,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "But we don't."
    } ]
  }, {
    "tStartMs": 735320,
    "dDurationMs": 1850,
    "segs": [ {
      "utf8": "In its first quarter \nearnings reported last"
    } ]
  }, {
    "tStartMs": 737170,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "month. ASML missed on order \nexpectations amid tariff"
    } ]
  }, {
    "tStartMs": 740210,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "uncertainty."
    } ]
  }, {
    "tStartMs": 741130,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "I suspect ASML will come in \nand advocate for a very low"
    } ]
  }, {
    "tStartMs": 746010,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "to minimal to no tariff on \ntheir machines."
    } ]
  }, {
    "tStartMs": 748930,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The impact of tariffs is \ncomplicated by ASML's"
    } ]
  }, {
    "tStartMs": 751490,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "complex web of 800 global \nsuppliers and the winding"
    } ]
  }, {
    "tStartMs": 755290,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "worldwide path. ASML's \nmachines take before"
    } ]
  }, {
    "tStartMs": 757810,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "arriving in a fab."
    } ]
  }, {
    "tStartMs": 759330,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Each High NA machine is made \nup of four subsystems"
    } ]
  }, {
    "tStartMs": 762250,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "manufactured in Connecticut,"
    } ]
  }, {
    "tStartMs": 763610,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Germany, the Netherlands and \nCalifornia."
    } ]
  }, {
    "tStartMs": 766330,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Each module is shipped \nseparately to ASML's"
    } ]
  }, {
    "tStartMs": 768490,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "headquarters in Veldhoven, \nwhere they are put together,"
    } ]
  }, {
    "tStartMs": 771010,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "tested, then disassembled \nagain,"
    } ]
  }, {
    "tStartMs": 772970,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "bound for fabs in places \nlike the U.S."
    } ]
  }, {
    "tStartMs": 774970,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "or more frequently, \nAsia."
    } ]
  }, {
    "tStartMs": 777370,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "How do you ship something \nthis massive?"
    } ]
  }, {
    "tStartMs": 779450,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Yeah, it takes about seven \nBoeing 747s to ship this"
    } ]
  }, {
    "tStartMs": 783770,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "whole thing, and it's about \n25 to 30 trucks."
    } ]
  }, {
    "tStartMs": 797990,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "For years, Asia has made up \nmore than 80% of ASML's"
    } ]
  }, {
    "tStartMs": 801630,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "business, but the U.S."
    } ]
  }, {
    "tStartMs": 803190,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "share, around 17% in 2024, \nis growing fast,"
    } ]
  }, {
    "tStartMs": 806910,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "especially as Intel builds \nnew chip fabs in Ohio and"
    } ]
  }, {
    "tStartMs": 809830,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Arizona. And TSMC is now in \nvolume production in"
    } ]
  }, {
    "tStartMs": 813030,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Arizona, too."
    } ]
  }, {
    "tStartMs": 814110,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "So there's a lot of chip \ncustomers in the U.S."
    } ]
  }, {
    "tStartMs": 816510,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "So there is a, \nI would say,"
    } ]
  }, {
    "tStartMs": 817790,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "a good reason to have cheap \nmanufacturing."
    } ]
  }, {
    "tStartMs": 820430,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "When we first got a look at \nEUV in 2022,"
    } ]
  }, {
    "tStartMs": 823190,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "ASML had about 32,000 \nemployees."
    } ]
  }, {
    "tStartMs": 826030,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Today, that number has grown \nto 44,000,"
    } ]
  }, {
    "tStartMs": 828430,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "and 8,500 of them are in the \nUS."
    } ]
  }, {
    "tStartMs": 830790,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Like Eric Ma, \nwho's been with ASML in San"
    } ]
  }, {
    "tStartMs": 833070,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Jose, California, \nfor 18 plus years."
    } ]
  }, {
    "tStartMs": 835630,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Have you gotten to see the \nHigh NA machines?"
    } ]
  }, {
    "tStartMs": 837910,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Yes. What is it like?"
    } ]
  }, {
    "tStartMs": 839550,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "Oh, it's huge."
    } ]
  }, {
    "tStartMs": 841110,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Of ASML's 60 global offices,"
    } ]
  }, {
    "tStartMs": 843150,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "18 of them are in the U.S., \nincluding a manufacturing"
    } ]
  }, {
    "tStartMs": 846150,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "site in Connecticut and R\u0026D \nsites in San Diego and here"
    } ]
  }, {
    "tStartMs": 849430,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "in San Jose."
    } ]
  }, {
    "tStartMs": 850710,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "We're here at ASML, \nSilicon Valley,"
    } ]
  }, {
    "tStartMs": 852350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "California location."
    } ]
  }, {
    "tStartMs": 853750,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And behind me is a metrology \nmachine."
    } ]
  }, {
    "tStartMs": 855950,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "This one has 25 beams of \nelectrons that are used to"
    } ]
  }, {
    "tStartMs": 859560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "test the different \nmicrochips,"
    } ]
  }, {
    "tStartMs": 861160,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "to make sure that the yield \nis going to be good."
    } ]
  }, {
    "tStartMs": 865040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "For High NA in the U.S., \nit's likely that Arizona"
    } ]
  }, {
    "tStartMs": 867480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "could be a major hub. Many \nof ASML's first High NA"
    } ]
  }, {
    "tStartMs": 870320,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "shipments went to Intel last \nyear,"
    } ]
  }, {
    "tStartMs": 872160,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the struggling \nU.S.-based chipmaker is"
    } ]
  }, {
    "tStartMs": 874080,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "building a giant new chip \nfab in Chandler,"
    } ]
  }, {
    "tStartMs": 876280,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Arizona."
    } ]
  }, {
    "tStartMs": 877160,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Intel has been for many \nyears a formidable partner"
    } ]
  }, {
    "tStartMs": 880880,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "for ASML, they were the \nfirst company to believe in"
    } ]
  }, {
    "tStartMs": 884400,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "EUV and the first company to \nwork with us to develop EUV."
    } ]
  }, {
    "tStartMs": 888440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "They have done the same on \nHigh NA,"
    } ]
  }, {
    "tStartMs": 890320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "and I think that moving \nforward,"
    } ]
  }, {
    "tStartMs": 891760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the role of Intel for the \nU.S."
    } ]
  }, {
    "tStartMs": 894680,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "autonomy, independence on \nsemiconductor is still very"
    } ]
  }, {
    "tStartMs": 897760,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "critical."
    } ]
  }, {
    "tStartMs": 898920,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "But TSMC is far ahead of \nIntel in advancing chip"
    } ]
  }, {
    "tStartMs": 902080,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "nodes. We recently visited \nTSMC's new fab north of"
    } ]
  }, {
    "tStartMs": 905240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Phoenix, the most advanced \nchip fab on U.S."
    } ]
  }, {
    "tStartMs": 907920,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "soil. The need for High NA \nthere will likely come soon,"
    } ]
  }, {
    "tStartMs": 911240,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "with ASML's original EUV \nmachines in use now."
    } ]
  }, {
    "tStartMs": 914520,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "In order to hook one up \nrequires something over"
    } ]
  }, {
    "tStartMs": 919720,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "2,000 electrical \nconnections,"
    } ]
  }, {
    "tStartMs": 923340,
    "dDurationMs": 3750,
    "segs": [ {
      "utf8": "over two kilometers of \ncabling,"
    } ]
  }, {
    "tStartMs": 927450,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "100,000 parts, \n40,000 bolts."
    } ]
  }, {
    "tStartMs": 931490,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "We're talking about massive."
    } ]
  }, {
    "tStartMs": 933930,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "With so many EUV machines in \nArizona,"
    } ]
  }, {
    "tStartMs": 936010,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "ASML is for the first time \nbringing a training facility"
    } ]
  }, {
    "tStartMs": 938970,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "to the US. Its only other \ntraining centers are in the"
    } ]
  }, {
    "tStartMs": 941690,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Netherlands, Taiwan and \nKorea."
    } ]
  }, {
    "tStartMs": 943730,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "We're planning to open that \nin the next few months in"
    } ]
  }, {
    "tStartMs": 946730,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Arizona, with the idea that \nwe could train 1,200 people"
    } ]
  }, {
    "tStartMs": 951290,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "every year on EUV dpof."
    } ]
  }, {
    "tStartMs": 955250,
    "dDurationMs": 2547,
    "segs": [ {
      "utf8": "As chipmaking shows no signs \nof slowing in the U.S."
    } ]
  }, {
    "tStartMs": 957797,
    "dDurationMs": 2133,
    "segs": [ {
      "utf8": "or elsewhere, \nASML is already hard at work"
    } ]
  }, {
    "tStartMs": 959930,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "on its next generation \nmachine,"
    } ]
  }, {
    "tStartMs": 961410,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Hyper NA."
    } ]
  }, {
    "tStartMs": 962330,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "With an even larger NA that \ncan print even smaller"
    } ]
  }, {
    "tStartMs": 965290,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "features."
    } ]
  }, {
    "tStartMs": 966410,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "I heard it could be up to \n$700 million."
    } ]
  }, {
    "tStartMs": 968690,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Do you have any price tag?"
    } ]
  }, {
    "tStartMs": 970250,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Oh, it's way too early to \nmention the number,"
    } ]
  }, {
    "tStartMs": 972170,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "but typically price goes up."
    } ]
  }, {
    "tStartMs": 974290,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "So no, I don't think it's \ngoing to be that high."
    } ]
  }, {
    "tStartMs": 976890,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Despite market headwinds, \nFouquet told CNBC that"
    } ]
  }, {
    "tStartMs": 979450,
    "dDurationMs": 2890,
    "segs": [ {
      "utf8": "customers will need Hyper NA \nwithin ten years."
    } ]
  }, {
    "tStartMs": 982780,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Anything you can tell us \nabout Hyper NA?"
    } ]
  }, {
    "tStartMs": 984620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "How far away are we from \nseeing that?"
    } ]
  }, {
    "tStartMs": 986700,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "For us, it's not necessarily \na difficult product."
    } ]
  }, {
    "tStartMs": 991420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "We need our customers to \nneed it as well."
    } ]
  }, {
    "tStartMs": 993860,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And if you look at the \nroadmap of our customer,"
    } ]
  }, {
    "tStartMs": 995860,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "I think the need for Hyper \nNA will be somewhere between"
    } ]
  }, {
    "tStartMs": 999540,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "2032 and 2035."
    } ]
  }, {
    "tStartMs": 1002340,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "But for now, ASML is focused \non meeting demand for High"
    } ]
  }, {
    "tStartMs": 1005129,
    "dDurationMs": 2851,
    "segs": [ {
      "utf8": "NA. It plans to ship at \nleast five more systems this"
    } ]
  }, {
    "tStartMs": 1007980,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "year, ramping to a \nproduction capacity of 20"
    } ]
  }, {
    "tStartMs": 1010420,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "machines in a few years."
    } ]
  }, {
    "tStartMs": 1012340,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "While this is a monopoly \nright here and today,"
    } ]
  }, {
    "tStartMs": 1015180,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "in the era of AI, \nthere will be new vehicles"
    } ]
  }, {
    "tStartMs": 1018220,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "for building semiconductors."
    } ]
  }, {
    "tStartMs": 1020220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And if I'm ASML, \nif I'm from any other"
    } ]
  }, {
    "tStartMs": 1022380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "company in this space, \nI'm being careful to make"
    } ]
  }, {
    "tStartMs": 1024540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "sure that I'm protecting my \nposition, not just in the"
    } ]
  }, {
    "tStartMs": 1026820,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "near term, but in the long \nterm as well."
    } ]
  } ]
}
