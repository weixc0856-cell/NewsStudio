{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 786390,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "OK good afternoon, everybody."
    } ]
  }, {
    "tStartMs": 789330,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Thanks for coming."
    } ]
  }, {
    "tStartMs": 792750,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "This is the first of the first\ncolloquium of the colloquium"
    } ]
  }, {
    "tStartMs": 797870,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of the semester."
    } ]
  }, {
    "tStartMs": 800510,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "And so welcome everybody."
    } ]
  }, {
    "tStartMs": 801970,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "We are here every\nWednesday at this time,"
    } ]
  }, {
    "tStartMs": 805710,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "and we get quite a variety\nof topics and speakers."
    } ]
  }, {
    "tStartMs": 811270,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Generally we get very, very\nprominent high quality speakers."
    } ]
  }, {
    "tStartMs": 815630,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "And today we start out with."
    } ]
  }, {
    "tStartMs": 821230,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "A very, very good first case."
    } ]
  }, {
    "tStartMs": 826120,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "We actually have two speakers."
    } ]
  }, {
    "tStartMs": 828860,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "We have Tony yen."
    } ]
  }, {
    "tStartMs": 831180,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "He's the vice president head of\ntechnology development at ASML."
    } ]
  }, {
    "tStartMs": 835080,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "I assume all of you who\nare here have heard of ASML"
    } ]
  }, {
    "tStartMs": 837500,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "and know the key role they play\nin the semiconductor industry."
    } ]
  }, {
    "tStartMs": 843820,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And Tony is currently in\naddition to his continuing"
    } ]
  }, {
    "tStartMs": 848020,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "in his role as VP and Head of\ntechnology development at ASML,"
    } ]
  }, {
    "tStartMs": 851680,
    "dDurationMs": 6820,
    "segs": [ {
      "utf8": "he is also serving as a visiting\nprofessor in our department."
    } ]
  }, {
    "tStartMs": 858500,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "He will be teaching\na course in the."
    } ]
  }, {
    "tStartMs": 863660,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "In the fall."
    } ]
  }, {
    "tStartMs": 865540,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Sorry spring semester on\nthe topic of today's talk."
    } ]
  }, {
    "tStartMs": 869280,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "So if you're interested\nin this material,"
    } ]
  }, {
    "tStartMs": 872780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "sign up for Tony's class."
    } ]
  }, {
    "tStartMs": 874640,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Tony was he got his\nbachelor's degree from Purdue,"
    } ]
  }, {
    "tStartMs": 879420,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "his PhD and MBA from MIT."
    } ]
  }, {
    "tStartMs": 882500,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "He was."
    } ]
  }, {
    "tStartMs": 883460,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "He worked at TI and at\nTSMC for quite a while"
    } ]
  }, {
    "tStartMs": 888400,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "before joining ASML."
    } ]
  }, {
    "tStartMs": 890400,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "He's a fellow of IEEE and won\na number of important awards."
    } ]
  }, {
    "tStartMs": 895960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Tony's going to start\nout today, but he"
    } ]
  }, {
    "tStartMs": 898480,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "has a colleague\nhere, Ron Gosens,"
    } ]
  }, {
    "tStartMs": 901100,
    "dDurationMs": 8980,
    "segs": [ {
      "utf8": "also Gosens, also from ASML,\nwho is a senior strategy"
    } ]
  }, {
    "tStartMs": 910080,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "manager at ASML."
    } ]
  }, {
    "tStartMs": 912420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "He's working part time."
    } ]
  }, {
    "tStartMs": 913820,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "He's partly retired."
    } ]
  }, {
    "tStartMs": 916920,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "He is also an adjunct professor\nat Purdue, where he teaches,"
    } ]
  }, {
    "tStartMs": 922080,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "and he got educated in the\nNetherlands, at Utrecht"
    } ]
  }, {
    "tStartMs": 926440,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "and has been at Philips\nresearch, Stanford national, NXP"
    } ]
  }, {
    "tStartMs": 931520,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "before joining ASML, where he\nleads computational lithography"
    } ]
  }, {
    "tStartMs": 935440,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "efforts."
    } ]
  }, {
    "tStartMs": 936480,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "So they're going\nto do a tag team"
    } ]
  }, {
    "tStartMs": 938320,
    "dDurationMs": 4670,
    "segs": [ {
      "utf8": "and tell us about EUV\nlithography, which"
    } ]
  }, {
    "tStartMs": 942990,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "is the hot thing now\nin microelectronics."
    } ]
  }, {
    "tStartMs": 946690,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And it'll give us the\nhistory and where we are"
    } ]
  }, {
    "tStartMs": 948870,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "and where we're going."
    } ]
  }, {
    "tStartMs": 949890,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So I'll start with Tony."
    } ]
  }, {
    "tStartMs": 955910,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Thank you."
    } ]
  }, {
    "tStartMs": 958110,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Thank you, Jeff, for this\nvery nice introduction."
    } ]
  }, {
    "tStartMs": 960490,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Is the microphone on."
    } ]
  }, {
    "tStartMs": 961870,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Yes thank you."
    } ]
  }, {
    "tStartMs": 963110,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "And Ronald and I were very\nhappy to be here at Berkeley"
    } ]
  }, {
    "tStartMs": 968110,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "to give this colloquium."
    } ]
  }, {
    "tStartMs": 970010,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "And we without further\nado, let me get started."
    } ]
  }, {
    "tStartMs": 975270,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Perhaps I'll get\na little excited."
    } ]
  }, {
    "tStartMs": 977250,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "So let me remove my jacket\nfirst, just in case."
    } ]
  }, {
    "tStartMs": 980243,
    "dDurationMs": 2667,
    "segs": [ {
      "utf8": "Don't think you want to stand in\nthe middle because you'll walk."
    } ]
  }, {
    "tStartMs": 982910,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "No, no, I will be standing here."
    } ]
  }, {
    "tStartMs": 985630,
    "dDurationMs": 7440,
    "segs": [ {
      "utf8": "So we want to tell you\nabout EUV lithography."
    } ]
  }, {
    "tStartMs": 993070,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "But I want to start\nwith some history."
    } ]
  }, {
    "tStartMs": 997070,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "But I'd like to start with the\nhistory of photolithography"
    } ]
  }, {
    "tStartMs": 999810,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "itself."
    } ]
  }, {
    "tStartMs": 1000430,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Just give me five minutes."
    } ]
  }, {
    "tStartMs": 1002110,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Because this may be interesting\nto know if some of you"
    } ]
  }, {
    "tStartMs": 1007410,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "do not know\nphotolithography or are not"
    } ]
  }, {
    "tStartMs": 1010490,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "familiar with this\ntechnology yet, but."
    } ]
  }, {
    "tStartMs": 1013230,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "So let me get started, it's\nthe first part of the talk is"
    } ]
  }, {
    "tStartMs": 1017530,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "the photolithography until early\n1980s and then EUV as a next"
    } ]
  }, {
    "tStartMs": 1021970,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "generation technology,\nlithography technology,"
    } ]
  }, {
    "tStartMs": 1024770,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "and then developing EUV\nlithography for high volume"
    } ]
  }, {
    "tStartMs": 1028490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "production."
    } ]
  }, {
    "tStartMs": 1030170,
    "dDurationMs": 6520,
    "segs": [ {
      "utf8": "So photolithography itself was\ninvented in the mid 1950s by two"
    } ]
  }, {
    "tStartMs": 1036690,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "groups."
    } ]
  }, {
    "tStartMs": 1037650,
    "dDurationMs": 4199,
    "segs": [ {
      "utf8": "First was called Bell\nLabs where you folks were."
    } ]
  }, {
    "tStartMs": 1041849,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "And the second group was\na US Army's laboratory."
    } ]
  }, {
    "tStartMs": 1045290,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So let me focus on\nthe second group"
    } ]
  }, {
    "tStartMs": 1047250,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "because the story\nwas more dramatic."
    } ]
  }, {
    "tStartMs": 1051250,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "In the second group, the goal\nwas to fit a proximity fuse"
    } ]
  }, {
    "tStartMs": 1056210,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "diffuse into a mortar shell."
    } ]
  }, {
    "tStartMs": 1058970,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Mortar shells are not very big."
    } ]
  }, {
    "tStartMs": 1060590,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "A proximity fuse is basically\na cheap radar system."
    } ]
  }, {
    "tStartMs": 1064270,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "OK, the goal is to\nhave the bomb explode"
    } ]
  }, {
    "tStartMs": 1068470,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "in the proximity of the target\nbefore hitting the target."
    } ]
  }, {
    "tStartMs": 1072790,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "To increase the\nprobability of impact."
    } ]
  }, {
    "tStartMs": 1076110,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Because if it explodes right on\ntarget, you may miss the target."
    } ]
  }, {
    "tStartMs": 1080010,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "But if you explore the\nvicinity and your chances"
    } ]
  }, {
    "tStartMs": 1082510,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "are a lot higher\nhitting the target."
    } ]
  }, {
    "tStartMs": 1084370,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "So this was the goal to put the\nproximity fuse inside a mortar"
    } ]
  }, {
    "tStartMs": 1088550,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "shell."
    } ]
  }, {
    "tStartMs": 1089050,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "OK mortar shell is very small."
    } ]
  }, {
    "tStartMs": 1090990,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "So in those days the transistors\nwere mesa transistors."
    } ]
  }, {
    "tStartMs": 1096530,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Germanium OK."
    } ]
  }, {
    "tStartMs": 1098090,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "How do you fit a mesa\ngermanium transistor"
    } ]
  }, {
    "tStartMs": 1102070,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "circuit inside a mortar shell."
    } ]
  }, {
    "tStartMs": 1103730,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Well, these two guys."
    } ]
  }, {
    "tStartMs": 1107910,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Jay Lathrop and James\nKnoll from the laboratory,"
    } ]
  }, {
    "tStartMs": 1112570,
    "dDurationMs": 4490,
    "segs": [ {
      "utf8": "they thought of using,\nof course, they found out"
    } ]
  }, {
    "tStartMs": 1117060,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "that Kodak had a\nphotoresist and they"
    } ]
  }, {
    "tStartMs": 1119540,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "thought of using a microscope,\nbut operating in reverse."
    } ]
  }, {
    "tStartMs": 1123940,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "So this is a microscope."
    } ]
  }, {
    "tStartMs": 1126120,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And this is where the transistor\nor a piece of germanium is."
    } ]
  }, {
    "tStartMs": 1129820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And they put the\nphotomask here where you"
    } ]
  }, {
    "tStartMs": 1132300,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "would have the Polaroid camera."
    } ]
  }, {
    "tStartMs": 1134080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "And you shine white\nlight from the top."
    } ]
  }, {
    "tStartMs": 1137260,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Now what is this filter."
    } ]
  }, {
    "tStartMs": 1138800,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Well, before the\nexposure, when you're"
    } ]
  }, {
    "tStartMs": 1141020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "aligning to the\nprevious layer, you"
    } ]
  }, {
    "tStartMs": 1142940,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "slide the red filter in there\nso that the photoresist is not"
    } ]
  }, {
    "tStartMs": 1146340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "exposed."
    } ]
  }, {
    "tStartMs": 1147540,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Once you do the alignment,\nyou take out the red filter"
    } ]
  }, {
    "tStartMs": 1150500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and then the exposure happens."
    } ]
  }, {
    "tStartMs": 1152500,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "You expose this and then\nyou get the transistor."
    } ]
  }, {
    "tStartMs": 1156540,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And the transistor\nlooked like this."
    } ]
  }, {
    "tStartMs": 1158640,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "The die is about 1 millimeter\nto 1 millimeter by 1 millimeter."
    } ]
  }, {
    "tStartMs": 1163360,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "And this is a mesa."
    } ]
  }, {
    "tStartMs": 1164360,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The base size was not stated."
    } ]
  }, {
    "tStartMs": 1165960,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "The base contact."
    } ]
  }, {
    "tStartMs": 1167260,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This little guy,\none of these guys"
    } ]
  }, {
    "tStartMs": 1169340,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "is a base contact\nis 0.1 by 0.25."
    } ]
  }, {
    "tStartMs": 1174820,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Nowadays it's gigantic."
    } ]
  }, {
    "tStartMs": 1176500,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "But back in those days,\nit was hard to make."
    } ]
  }, {
    "tStartMs": 1178560,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And then they also had to make\nthe emitter contact, which is"
    } ]
  }, {
    "tStartMs": 1181520,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "the other rectangle right here."
    } ]
  }, {
    "tStartMs": 1183660,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Same Same dimension."
    } ]
  }, {
    "tStartMs": 1186080,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "It was a success."
    } ]
  }, {
    "tStartMs": 1187720,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "And then what happened was that\nJay Lathrop joined ti in 1958."
    } ]
  }, {
    "tStartMs": 1193680,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And what happened in TI at 19."
    } ]
  }, {
    "tStartMs": 1196020,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "In 1958, Jack Kilby invented\nthe integrated circuit."
    } ]
  }, {
    "tStartMs": 1200780,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "So Jay Lathrop worked at TI\nwith Jack Kilby for the next 10"
    } ]
  }, {
    "tStartMs": 1205760,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "years."
    } ]
  }, {
    "tStartMs": 1206920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And where did the other guy go."
    } ]
  }, {
    "tStartMs": 1210040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Of course, he went to Fairchild."
    } ]
  }, {
    "tStartMs": 1212600,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "1959 right where Robert\nNoyce and others had invented"
    } ]
  }, {
    "tStartMs": 1218000,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "the integrated circuit there."
    } ]
  }, {
    "tStartMs": 1221000,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So great story, and\nit's a bit romantic."
    } ]
  }, {
    "tStartMs": 1225240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "So this was in the\nmid to late 1950s."
    } ]
  }, {
    "tStartMs": 1229080,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And what happened next."
    } ]
  }, {
    "tStartMs": 1231040,
    "dDurationMs": 5290,
    "segs": [ {
      "utf8": "What happened next is\nless romantic lithography."
    } ]
  }, {
    "tStartMs": 1236330,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "In the 60s and the 70, early\n70s were mainly contact"
    } ]
  }, {
    "tStartMs": 1240070,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "and proximity printing."
    } ]
  }, {
    "tStartMs": 1244830,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "Because those days, resolution\nwasn't really the top issue."
    } ]
  }, {
    "tStartMs": 1250250,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The top issue was how to\nget these layers to align."
    } ]
  }, {
    "tStartMs": 1253250,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So those machines were\ncalled aligners back then."
    } ]
  }, {
    "tStartMs": 1257350,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "And this is an aligner\nfrom Casper instruments"
    } ]
  }, {
    "tStartMs": 1261710,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "here in the US."
    } ]
  }, {
    "tStartMs": 1263910,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "These guys were the\nKing back in the 60s OK."
    } ]
  }, {
    "tStartMs": 1268590,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "They were very good at\ndoing contact printing."
    } ]
  }, {
    "tStartMs": 1271470,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "We put the mask right\non top of the wafer."
    } ]
  }, {
    "tStartMs": 1273690,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "You're aligned."
    } ]
  }, {
    "tStartMs": 1274570,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "And then you shine the light."
    } ]
  }, {
    "tStartMs": 1276350,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The problem with\ncontact printing"
    } ]
  }, {
    "tStartMs": 1277750,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "is that it generates\nparticles in the space or."
    } ]
  }, {
    "tStartMs": 1283070,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Well, you're rubbing the\nwafer against the mask."
    } ]
  }, {
    "tStartMs": 1286510,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So what happened was that later."
    } ]
  }, {
    "tStartMs": 1289150,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Well, maybe we\nshould create a gap"
    } ]
  }, {
    "tStartMs": 1292330,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "between the mask and the wafer."
    } ]
  }, {
    "tStartMs": 1294150,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And then they went from contact\nprinting to proximity printing."
    } ]
  }, {
    "tStartMs": 1298290,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "Once proximity printing happens,\ncanon took over as the new King."
    } ]
  }, {
    "tStartMs": 1304010,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This guy faded away."
    } ]
  }, {
    "tStartMs": 1306350,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And then canon made\na much better machine"
    } ]
  }, {
    "tStartMs": 1310490,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "for proximity printing."
    } ]
  }, {
    "tStartMs": 1312290,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "So this is canon machine until."
    } ]
  }, {
    "tStartMs": 1317370,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Well, until proximity\nprinting was superseded"
    } ]
  }, {
    "tStartMs": 1320930,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "by projection imaging."
    } ]
  }, {
    "tStartMs": 1323130,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And this happened\nin the early 70s."
    } ]
  }, {
    "tStartMs": 1326610,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So let me first give an example."
    } ]
  }, {
    "tStartMs": 1329490,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Why did we go for\nprojection imaging."
    } ]
  }, {
    "tStartMs": 1332450,
    "dDurationMs": 7680,
    "segs": [ {
      "utf8": "So the example is let's shine a\nlambda equal to 400 nanometer UV"
    } ]
  }, {
    "tStartMs": 1340130,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "light through a mask."
    } ]
  }, {
    "tStartMs": 1343730,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Imaging a slit slit is 4\nmicron wide slit right."
    } ]
  }, {
    "tStartMs": 1348510,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "And the gap is 1 micron\n5 micron and 10 microns."
    } ]
  }, {
    "tStartMs": 1353750,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "And this is the kind of\naerial image that you get."
    } ]
  }, {
    "tStartMs": 1357010,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "As you can see\nthat this is almost"
    } ]
  }, {
    "tStartMs": 1360150,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "at the limit of resolution\nOf proximity printing."
    } ]
  }, {
    "tStartMs": 1365470,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "Because why."
    } ]
  }, {
    "tStartMs": 1366330,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Because you really cannot\ncontrol the gap very well."
    } ]
  }, {
    "tStartMs": 1368690,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "If you control the gap\nperfectly then it's fine."
    } ]
  }, {
    "tStartMs": 1371910,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "But you can't because first\nthe control itself mechanism"
    } ]
  }, {
    "tStartMs": 1375830,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "itself wasn't very good."
    } ]
  }, {
    "tStartMs": 1377090,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "But also the wafer\nhas is not flat."
    } ]
  }, {
    "tStartMs": 1381990,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It's warped."
    } ]
  }, {
    "tStartMs": 1383070,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "So it's much better if\nyou do it through a lens."
    } ]
  }, {
    "tStartMs": 1388030,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And this is projection printing\nsame wavelengths of light"
    } ]
  }, {
    "tStartMs": 1392710,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "with a lens that is\nnot very sophisticated."
    } ]
  }, {
    "tStartMs": 1395890,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "0.2 a very low\nnumerical aperture lens."
    } ]
  }, {
    "tStartMs": 1399390,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And this is what you\nget if you're unfocused."
    } ]
  }, {
    "tStartMs": 1401890,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "You're looking at the red curve."
    } ]
  }, {
    "tStartMs": 1403410,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "And if you're off by plus\n5 plus minus 5 microns"
    } ]
  }, {
    "tStartMs": 1406750,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "you're looking at\nthe blue curve."
    } ]
  }, {
    "tStartMs": 1409780,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "So in one case you're\nfighting diffraction."
    } ]
  }, {
    "tStartMs": 1414980,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The other case, you're taking\nadvantage of diffraction."
    } ]
  }, {
    "tStartMs": 1418420,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Of course, with the\naddition of a lens."
    } ]
  }, {
    "tStartMs": 1421300,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "So this is what's going\non in terms of physics."
    } ]
  }, {
    "tStartMs": 1425820,
    "dDurationMs": 8920,
    "segs": [ {
      "utf8": "And then of course, early 1970s,\nthere was this company called"
    } ]
  }, {
    "tStartMs": 1434740,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "perkin-elmer."
    } ]
  }, {
    "tStartMs": 1435900,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "They made the first commercially\nsuccessful projection aligner,"
    } ]
  }, {
    "tStartMs": 1441820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to be precise, in 1973."
    } ]
  }, {
    "tStartMs": 1444300,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "This, this was the\nperkin-elmer microline 1X,"
    } ]
  }, {
    "tStartMs": 1448940,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "meaning no magnification\nor magnification."
    } ]
  }, {
    "tStartMs": 1452080,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Reflective imaging system\nwith an annular slit."
    } ]
  }, {
    "tStartMs": 1455640,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It's actually quite clever."
    } ]
  }, {
    "tStartMs": 1457120,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "The designer of this\noptics was called"
    } ]
  }, {
    "tStartMs": 1459140,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "Abe offner, a gigantic\nfigure in lens design."
    } ]
  }, {
    "tStartMs": 1464820,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Sorry he passed away."
    } ]
  }, {
    "tStartMs": 1466920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "But this system has\nonly two mirrors."
    } ]
  }, {
    "tStartMs": 1470700,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Concentric concentric,\ntwo mirrors, one concave,"
    } ]
  }, {
    "tStartMs": 1473940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "one convex."
    } ]
  }, {
    "tStartMs": 1475580,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And the imaging is done\nthrough a slit y slit."
    } ]
  }, {
    "tStartMs": 1480700,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Because Abe figured out\nthat the optimal distance"
    } ]
  }, {
    "tStartMs": 1484160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "from the optical\naxis is this thing"
    } ]
  }, {
    "tStartMs": 1486160,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "called H0 at H0 from\nthe optical axis."
    } ]
  }, {
    "tStartMs": 1492120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "The aberration was\nminimized through a slit"
    } ]
  }, {
    "tStartMs": 1496840,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "is fine because you can\nscan the whole thing,"
    } ]
  }, {
    "tStartMs": 1498980,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "because the mask and\nthe wafer are actually"
    } ]
  }, {
    "tStartMs": 1502240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "ganged together through a shaft,\nwhich is not shown down here."
    } ]
  }, {
    "tStartMs": 1506500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So the exposure happens\nafter alignment."
    } ]
  }, {
    "tStartMs": 1509620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "You basically do this right."
    } ]
  }, {
    "tStartMs": 1511620,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "You can never go wrong because\nthey're together in one axis OK."
    } ]
  }, {
    "tStartMs": 1516040,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "And this was the\nfirst of course."
    } ]
  }, {
    "tStartMs": 1519620,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Then it became a hit."
    } ]
  }, {
    "tStartMs": 1521880,
    "dDurationMs": 4390,
    "segs": [ {
      "utf8": "Thousands of these machines\nwere sold and the first one went"
    } ]
  }, {
    "tStartMs": 1526270,
    "dDurationMs": 8720,
    "segs": [ {
      "utf8": "to Texas Instruments for\na price of 90,000 $95,000."
    } ]
  }, {
    "tStartMs": 1534990,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "It cannot even get a mask\nwith this kind of money."
    } ]
  }, {
    "tStartMs": 1538630,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Euv mask, of course."
    } ]
  }, {
    "tStartMs": 1540110,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So this was sold to TI."
    } ]
  }, {
    "tStartMs": 1542510,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And then what happened."
    } ]
  }, {
    "tStartMs": 1544230,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Intel 8088."
    } ]
  }, {
    "tStartMs": 1546310,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "OK, this was not ti."
    } ]
  }, {
    "tStartMs": 1547530,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This was Intel."
    } ]
  }, {
    "tStartMs": 1549030,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "A device size was 0.2 by point\nis about 5 millimeters by 5"
    } ]
  }, {
    "tStartMs": 1554850,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "millimeter device size."
    } ]
  }, {
    "tStartMs": 1556370,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "With contact printing."
    } ]
  }, {
    "tStartMs": 1557530,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "The yield of these\nmicroprocessors"
    } ]
  }, {
    "tStartMs": 1559230,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "were only 20% with\nmicro microline"
    } ]
  }, {
    "tStartMs": 1562870,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "60% This is basically it."
    } ]
  }, {
    "tStartMs": 1567910,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "I mean, Moore's law\nalive back then."
    } ]
  }, {
    "tStartMs": 1571790,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "And now, of course, this\nwasn't the end of the story."
    } ]
  }, {
    "tStartMs": 1576650,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "They were the King\nfor a few years"
    } ]
  }, {
    "tStartMs": 1579270,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "until the King is dead\nand long live the King."
    } ]
  }, {
    "tStartMs": 1584410,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The new King, of course."
    } ]
  }, {
    "tStartMs": 1586650,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Who's the new King."
    } ]
  }, {
    "tStartMs": 1588650,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Well, the problem\nwith the one x design"
    } ]
  }, {
    "tStartMs": 1592610,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "was that it was a\nsimple optical system."
    } ]
  }, {
    "tStartMs": 1596290,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Two mirrors, all spherical."
    } ]
  }, {
    "tStartMs": 1598470,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Both spherical."
    } ]
  }, {
    "tStartMs": 1600290,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "So the could not\nbe made very high."
    } ]
  }, {
    "tStartMs": 1603650,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "The numerical aperture of\nthe microline was 0.167."
    } ]
  }, {
    "tStartMs": 1608430,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Very low."
    } ]
  }, {
    "tStartMs": 1609370,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "In order to get\nbetter resolution,"
    } ]
  }, {
    "tStartMs": 1612350,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "you need to increase\nthe numerical aperture."
    } ]
  }, {
    "tStartMs": 1614650,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "However, in order to do\nso on the offner system,"
    } ]
  }, {
    "tStartMs": 1617910,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "the aberration would\nbecome very high."
    } ]
  }, {
    "tStartMs": 1620850,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "So we had to get away from\nthis kind of a offner design"
    } ]
  }, {
    "tStartMs": 1626170,
    "dDurationMs": 6360,
    "segs": [ {
      "utf8": "and to come back to the\nmore traditional D magnified"
    } ]
  }, {
    "tStartMs": 1632530,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "lens design."
    } ]
  }, {
    "tStartMs": 1633550,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "And this is what happened\nin the late 70s, early 80s."
    } ]
  }, {
    "tStartMs": 1638450,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The first champion was GCA."
    } ]
  }, {
    "tStartMs": 1640770,
    "dDurationMs": 5950,
    "segs": [ {
      "utf8": "OK GCA made a G Line\nsystem called a 4,800 man."
    } ]
  }, {
    "tStartMs": 1646720,
    "dDurationMs": 6440,
    "segs": [ {
      "utf8": "And now I have to say a little\nbit about the resolution"
    } ]
  }, {
    "tStartMs": 1653160,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "in projection lithography."
    } ]
  }, {
    "tStartMs": 1655380,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Only projection lithography."
    } ]
  }, {
    "tStartMs": 1657380,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Approximately lithography."
    } ]
  }, {
    "tStartMs": 1658500,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "The resolution\nformula is different."
    } ]
  }, {
    "tStartMs": 1660280,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "This is K1 lambda over and\nthis is minimum half pitch."
    } ]
  }, {
    "tStartMs": 1665760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "We're just talking\nabout this with Eli."
    } ]
  }, {
    "tStartMs": 1669280,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "Minimum half pitch right\nis a more accurate metric"
    } ]
  }, {
    "tStartMs": 1675480,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "in our sense."
    } ]
  }, {
    "tStartMs": 1676300,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Because if you want to\ncompare all the systems,"
    } ]
  }, {
    "tStartMs": 1679480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "you don't want to compare\nwith, oh, how thin a line"
    } ]
  }, {
    "tStartMs": 1681800,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "you can print."
    } ]
  }, {
    "tStartMs": 1682620,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "It's always minimum half pitch."
    } ]
  }, {
    "tStartMs": 1684300,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Because in minimum\nwith minimum half pitch"
    } ]
  }, {
    "tStartMs": 1686560,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "this K1 has a lower limit, which\nRonald will talk about 0.25."
    } ]
  }, {
    "tStartMs": 1692120,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "And then the minimum pitch is\nlambda over can decrease lambda"
    } ]
  }, {
    "tStartMs": 1696080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "or you can increase\nthe numerical aperture."
    } ]
  }, {
    "tStartMs": 1698060,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Numerical aperture is the\nsign of this half angle"
    } ]
  }, {
    "tStartMs": 1702540,
    "dDurationMs": 6540,
    "segs": [ {
      "utf8": "at times n n n index of the\nmedium surrounding this lens."
    } ]
  }, {
    "tStartMs": 1709080,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Of course, this\nend is always one"
    } ]
  }, {
    "tStartMs": 1711340,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "until you got to immersion\nlithography right at 193,"
    } ]
  }, {
    "tStartMs": 1715480,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "then n became 1.44."
    } ]
  }, {
    "tStartMs": 1717860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "OK, so this is what happened."
    } ]
  }, {
    "tStartMs": 1719960,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "And then of course later k RF\nlithography with excimer laser"
    } ]
  }, {
    "tStartMs": 1725100,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "reliable excimer laser\nbecame available."
    } ]
  }, {
    "tStartMs": 1729420,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And then, of course, after that\nwas the ARF excimer laser at 193"
    } ]
  }, {
    "tStartMs": 1734540,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "and immersion 193\nwith water 193."
    } ]
  }, {
    "tStartMs": 1739800,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So the effective\nwavelength became 144 OK."
    } ]
  }, {
    "tStartMs": 1743460,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And then of course, we\nhave EUV lithography."
    } ]
  }, {
    "tStartMs": 1747620,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Euv lithography took a\nlong time to develop."
    } ]
  }, {
    "tStartMs": 1752500,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Why Because in the early days,\nwe did not think we could"
    } ]
  }, {
    "tStartMs": 1757940,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "optical lithography\ncould go beyond this."
    } ]
  }, {
    "tStartMs": 1760720,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Why exactly this thing."
    } ]
  }, {
    "tStartMs": 1763420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is called a\npoint spread function"
    } ]
  }, {
    "tStartMs": 1765400,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "because is cut off here."
    } ]
  }, {
    "tStartMs": 1768740,
    "dDurationMs": 7760,
    "segs": [ {
      "utf8": "So if you have a point source on\na mask, point object on a mask,"
    } ]
  }, {
    "tStartMs": 1776500,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "you never get a point here."
    } ]
  }, {
    "tStartMs": 1777820,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "You get a diffraction\nlimited point spread"
    } ]
  }, {
    "tStartMs": 1781480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "function, which is this spot\nwhich is 1.2 to lambda over."
    } ]
  }, {
    "tStartMs": 1786480,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "Now, you can say that, OK, I can\nincrease the numerical aperture"
    } ]
  }, {
    "tStartMs": 1791800,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "and I get a smaller spot."
    } ]
  }, {
    "tStartMs": 1793980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "But no, not if you have\nlots of aberrations."
    } ]
  }, {
    "tStartMs": 1796860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "If you increase the\nnumerical aperture then"
    } ]
  }, {
    "tStartMs": 1798960,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "the spot won't get any smaller."
    } ]
  }, {
    "tStartMs": 1801060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "This is the early\ndays, exactly what"
    } ]
  }, {
    "tStartMs": 1802640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "we were facing,\nbecause we did not"
    } ]
  }, {
    "tStartMs": 1805160,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "know how to make high Na\noptics without inducing"
    } ]
  }, {
    "tStartMs": 1810000,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "a lot of aberration."
    } ]
  }, {
    "tStartMs": 1812040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "OK, when we were here."
    } ]
  }, {
    "tStartMs": 1814600,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "And this is when people started\nto work on NGL, next generation"
    } ]
  }, {
    "tStartMs": 1820070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "lithography technologies,\nand EUV was one of them."
    } ]
  }, {
    "tStartMs": 1823190,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "OK, so EUV development\nhappened in the mid 1980s,"
    } ]
  }, {
    "tStartMs": 1828350,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "and it went into high\nvolume production in 2019."
    } ]
  }, {
    "tStartMs": 1832210,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "35 years of development."
    } ]
  }, {
    "tStartMs": 1835150,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "OK, so let me now get\ninto EUV lithography."
    } ]
  }, {
    "tStartMs": 1838910,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The first paper on EUV\nlithography in the US"
    } ]
  }, {
    "tStartMs": 1842510,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "happened in 1988."
    } ]
  }, {
    "tStartMs": 1845070,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "In 1987, a guy called\nAndy Herrlich, working"
    } ]
  }, {
    "tStartMs": 1848950,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "at Lawrence Livermore\nlaboratory back"
    } ]
  }, {
    "tStartMs": 1851350,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "then was a laboratory\nthat belonged"
    } ]
  }, {
    "tStartMs": 1853310,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "to the University\nof California here."
    } ]
  }, {
    "tStartMs": 1855190,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "And he thought that\nthey had perfected"
    } ]
  }, {
    "tStartMs": 1860390,
    "dDurationMs": 5900,
    "segs": [ {
      "utf8": "by then the multilayer mirrors\nto reflect soft X-ray light."
    } ]
  }, {
    "tStartMs": 1866290,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Back then, EUV wasn't the name."
    } ]
  }, {
    "tStartMs": 1867970,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "Soft X-ray was the name for\nabout the kind of wavelength"
