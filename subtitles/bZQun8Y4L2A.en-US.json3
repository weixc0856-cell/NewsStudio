  }, {
    "tStartMs": 856151,
    "dDurationMs": 1559,
    "segs": [ {
      "utf8": "It's all the same prompt, but"
    } ]
  }, {
    "tStartMs": 857711,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "the completion of this varies."
    } ]
  }, {
    "tStartMs": 859211,
    "dDurationMs": 2654,
    "segs": [ {
      "utf8": "The yellow tokens are\ncoming from the SFT model."
    } ]
  }, {
    "tStartMs": 861866,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "Then what we do is we append"
    } ]
  }, {
    "tStartMs": 863366,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "another special reward\nreadout token at"
    } ]
  }, {
    "tStartMs": 866471,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "the end and we basically only"
    } ]
  }, {
    "tStartMs": 868571,
    "dDurationMs": 3149,
    "segs": [ {
      "utf8": "supervise the transformer\nat this single green token."
    } ]
  }, {
    "tStartMs": 871721,
    "dDurationMs": 2549,
    "segs": [ {
      "utf8": "The transformer will\npredict some reward"
    } ]
  }, {
    "tStartMs": 874271,
    "dDurationMs": 2654,
    "segs": [ {
      "utf8": "for how good that completion is"
    } ]
  }, {
    "tStartMs": 876926,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "for that prompt and\nbasically it makes"
    } ]
  }, {
    "tStartMs": 879386,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "a guess about the quality\nof each completion."
    } ]
  }, {
    "tStartMs": 882146,
    "dDurationMs": 2594,
    "segs": [ {
      "utf8": "Then once it makes a guess\nfor every one of them,"
    } ]
  }, {
    "tStartMs": 884741,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "we also have the ground truth"
