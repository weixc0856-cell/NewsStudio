  }, {
    "tStartMs": 736691,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "we get an SFT model."
    } ]
  }, {
    "tStartMs": 738191,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "You can actually deploy\nthese models and"
    } ]
  }, {
    "tStartMs": 740381,
    "dDurationMs": 2429,
    "segs": [ {
      "utf8": "they are actual assistants\nand they work to some extent."
    } ]
  }, {
    "tStartMs": 742811,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "Let me show you what an"
