  "events": [ {
    "tStartMs": 235,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "[MUSIC]"
    } ]
  }, {
    "tStartMs": 7159,
    "dDurationMs": 1736,
    "segs": [ {
      "utf8": "ANNOUNCER:\nPlease welcome"
    } ]
  }, {
    "tStartMs": 8896,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "AI researcher and"
    } ]
  }, {
    "tStartMs": 10231,
    "dDurationMs": 4119,
    "segs": [ {
      "utf8": "founding member of\nOpenAI, Andrej Karpathy."
    } ]
  }, {
    "tStartMs": 21169,
    "dDurationMs": 3091,
    "segs": [ {
      "utf8": "ANDREJ KARPATHY:\nHi, everyone. I'm happy"
    } ]
  }, {
    "tStartMs": 24261,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "to be here to tell you\nabout the state of"
    } ]
  }, {
    "tStartMs": 26031,
    "dDurationMs": 2429,
    "segs": [ {
      "utf8": "GPT and more generally about"
    } ]
  }, {
    "tStartMs": 28461,
    "dDurationMs": 3439,
    "segs": [ {
      "utf8": "the rapidly growing ecosystem\nof large language models."
    } ]
  }, {
    "tStartMs": 31901,
    "dDurationMs": 3114,
    "segs": [ {
      "utf8": "I would like to partition\nthe talk into two parts."
    } ]
  }, {
    "tStartMs": 35016,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "In the first part, I would\nlike to tell you about"
    } ]
  }, {
    "tStartMs": 36951,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "how we train GPT Assistance,"
    } ]
  }, {
    "tStartMs": 39111,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "and then in the second part,"
    } ]
  }, {
    "tStartMs": 40611,
    "dDurationMs": 2309,
    "segs": [ {
      "utf8": "we're going to take a\nlook at how we can use"
    } ]
  }, {
    "tStartMs": 42921,
    "dDurationMs": 3469,
    "segs": [ {
      "utf8": "these assistants effectively\nfor your applications."
    } ]
  }, {
    "tStartMs": 46391,
    "dDurationMs": 1914,
    "segs": [ {
      "utf8": "First, let's take a\nlook at the emerging"
    } ]
  }, {
    "tStartMs": 48306,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "recipe for how to train"
    } ]
  }, {
    "tStartMs": 49791,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "these assistants and keep\nin mind that this is all"
    } ]
  }, {
    "tStartMs": 51381,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "very new and still\nrapidly evolving,"
    } ]
  }, {
    "tStartMs": 53031,
    "dDurationMs": 2504,
    "segs": [ {
      "utf8": "but so far, the recipe\nlooks something like this."
    } ]
  }, {
    "tStartMs": 55536,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "Now, this is a\ncomplicated slide,"
    } ]
  }, {
    "tStartMs": 57546,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "I'm going to go\nthrough it piece by"
    } ]
  }, {
    "tStartMs": 59031,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "piece, but roughly speaking,"
    } ]
  }, {
    "tStartMs": 61251,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "we have four major\nstages, pretraining,"
    } ]
  }, {
    "tStartMs": 64041,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "supervised finetuning,\nreward modeling,"
    } ]
  }, {
    "tStartMs": 66231,
    "dDurationMs": 1259,
    "segs": [ {
      "utf8": "reinforcement learning,"
    } ]
  }, {
    "tStartMs": 67491,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "and they follow each\nother serially."
    } ]
  }, {
    "tStartMs": 69636,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "Now, in each stage,"
    } ]
  }, {
    "tStartMs": 71091,
    "dDurationMs": 3439,
    "segs": [ {
      "utf8": "we have a dataset that\npowers that stage."
    } ]
  }, {
    "tStartMs": 74531,
    "dDurationMs": 2589,
    "segs": [ {
      "utf8": "We have an algorithm that\nfor our purposes will be"
    } ]
  }, {
    "tStartMs": 77121,
    "dDurationMs": 4949,
    "segs": [ {
      "utf8": "a objective and over for\ntraining the neural network,"
    } ]
  }, {
    "tStartMs": 82071,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "and then we have a\nresulting model,"
    } ]
  }, {
    "tStartMs": 83781,
    "dDurationMs": 1894,
    "segs": [ {
      "utf8": "and then there are some\nnotes on the bottom."
    } ]
  }, {
    "tStartMs": 85676,
    "dDurationMs": 1404,
    "segs": [ {
      "utf8": "The first stage\nwe're going to start"
    } ]
  }, {
    "tStartMs": 87081,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "with as the pretraining stage."
    } ]
  }, {
    "tStartMs": 88581,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "Now, this stage is\nspecial in this diagram,"
    } ]
  }, {
    "tStartMs": 91521,
    "dDurationMs": 2189,
    "segs": [ {
      "utf8": "and this diagram is\nnot to scale because"
    } ]
  }, {
    "tStartMs": 93711,
    "dDurationMs": 1049,
    "segs": [ {
      "utf8": "this stage is where all of"
    } ]
  }, {
    "tStartMs": 94761,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "the computational work\nbasically happens."
    } ]
  }, {
    "tStartMs": 96366,
    "dDurationMs": 2114,
    "segs": [ {
      "utf8": "This is 99 percent\nof the training"
    } ]
  }, {
    "tStartMs": 98481,
    "dDurationMs": 3489,
    "segs": [ {
      "utf8": "compute time and also flops."
    } ]
  }, {
    "tStartMs": 101971,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "This is where we\nare dealing with"
    } ]
  }, {
    "tStartMs": 104211,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "Internet scale datasets\nwith thousands"
    } ]
  }, {
    "tStartMs": 106611,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "of GPUs in the supercomputer and"
    } ]
  }, {
    "tStartMs": 108696,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "also months of\ntraining potentially."
    } ]
  }, {
    "tStartMs": 111096,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "The other three\nstages are finetuning"
    } ]
  }, {
    "tStartMs": 113031,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "stages that are much more along"
    } ]
  }, {
    "tStartMs": 114741,
    "dDurationMs": 4304,
    "segs": [ {
      "utf8": "the lines of small few number\nof GPUs and hours or days."
    } ]
  }, {
    "tStartMs": 119046,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "Let's take a look at\nthe pretraining stage"
    } ]
  }, {
    "tStartMs": 120876,
    "dDurationMs": 2174,
    "segs": [ {
      "utf8": "to achieve a base model."
    } ]
  }, {
    "tStartMs": 123051,
    "dDurationMs": 4439,
    "segs": [ {
      "utf8": "First, we are going to gather\na large amount of data."
    } ]
  }, {
    "tStartMs": 127491,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "Here's an example\nof what we call a"
    } ]
  }, {
    "tStartMs": 128901,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "data mixture that comes from"
    } ]
  }, {
    "tStartMs": 130611,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "this paper that was released by"
    } ]
  }, {
    "tStartMs": 133281,
    "dDurationMs": 3319,
    "segs": [ {
      "utf8": "Meta where they released\nthis LLaMA based model."
    } ]
  }, {
    "tStartMs": 136601,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "Now, you can see roughly\nthe datasets that"
    } ]
  }, {
    "tStartMs": 138571,
    "dDurationMs": 1874,
    "segs": [ {
      "utf8": "enter into these collections."
    } ]
  }, {
    "tStartMs": 140446,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "We have CommonCrawl, which\nis a web scrape, C4,"
    } ]
  }, {
    "tStartMs": 143406,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "which is also CommonCrawl,"
    } ]
  }, {
    "tStartMs": 145041,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "and then some high\nquality datasets as well."
    } ]
  }, {
    "tStartMs": 147261,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "For example, GitHub, Wikipedia,"
    } ]
  }, {
    "tStartMs": 149106,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "Books, Archives, Stock\nExchange and so on."
    } ]
  }, {
    "tStartMs": 151326,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "These are all mixed up together,"
    } ]
  }, {
    "tStartMs": 152931,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "and then they are sampled"
    } ]
  }, {
    "tStartMs": 154446,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "according to some\ngiven proportions,"
    } ]
  }, {
    "tStartMs": 156381,
    "dDurationMs": 4044,
    "segs": [ {
      "utf8": "and that forms the\ntraining set for the GPT."
    } ]
  }, {
    "tStartMs": 160426,
    "dDurationMs": 2764,
    "segs": [ {
      "utf8": "Now before we can actually\ntrain on this data,"
    } ]
  }, {
    "tStartMs": 163191,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "we need to go through one\nmore preprocessing step,"
    } ]
  }, {
    "tStartMs": 165351,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "and that is tokenization."
    } ]
  }, {
    "tStartMs": 166671,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "This is basically\na translation of"
    } ]
  }, {
    "tStartMs": 168501,
    "dDurationMs": 2999,
    "segs": [ {
      "utf8": "the raw text that we scrape\nfrom the Internet into"
    } ]
  }, {
    "tStartMs": 171501,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "sequences of integers because"
    } ]
  }, {
    "tStartMs": 173861,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "that's the native representation"
    } ]
  }, {
    "tStartMs": 175281,
    "dDurationMs": 1799,
    "segs": [ {
      "utf8": "over which GPTs function."
    } ]
  }, {
    "tStartMs": 177081,
    "dDurationMs": 3089,
    "segs": [ {
      "utf8": "Now, this is a\nlossless translation"
    } ]
  }, {
    "tStartMs": 180171,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "between pieces of texts\nand tokens and integers,"
    } ]
  }, {
    "tStartMs": 183476,
    "dDurationMs": 2274,
    "segs": [ {
      "utf8": "and there are a number of\nalgorithms for the stage."
    } ]
  }, {
    "tStartMs": 185751,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "Typically, for\nexample, you could"
    } ]
  }, {
    "tStartMs": 187101,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "use something like\nbyte pair encoding,"
    } ]
  }, {
    "tStartMs": 188706,
    "dDurationMs": 2489,
    "segs": [ {
      "utf8": "which iteratively\nmerges text chunks"
    } ]
  }, {
    "tStartMs": 191196,
    "dDurationMs": 2554,
    "segs": [ {
      "utf8": "and groups them into tokens."
    } ]
  }, {
    "tStartMs": 193751,
    "dDurationMs": 3009,
    "segs": [ {
      "utf8": "Here, I'm showing some example\nchunks of these tokens,"
    } ]
  }, {
    "tStartMs": 196761,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "and then this is the\nraw integer sequence"
    } ]
  }, {
    "tStartMs": 198861,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "that will actually feed\ninto a transformer."
    } ]
  }, {
    "tStartMs": 201296,
    "dDurationMs": 1819,
    "segs": [ {
      "utf8": "Now, here I'm showing"
    } ]
  }, {
    "tStartMs": 203116,
    "dDurationMs": 3664,
    "segs": [ {
      "utf8": "two examples for\nhybrid parameters"
    } ]
  }, {
    "tStartMs": 206781,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "that govern this stage."
    } ]
  }, {
    "tStartMs": 208161,
    "dDurationMs": 2129,
    "segs": [ {
      "utf8": "GPT-4, we did not release"
    } ]
  }, {
    "tStartMs": 210291,
    "dDurationMs": 1934,
    "segs": [ {
      "utf8": "too much information about\nhow it was trained and so on,"
    } ]
  }, {
    "tStartMs": 212226,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "I'm using GPT-3s numbers,"
    } ]
  }, {
    "tStartMs": 213846,
    "dDurationMs": 1724,
    "segs": [ {
      "utf8": "but GPT-3 is of course\na little bit old"
    } ]
  }, {
    "tStartMs": 215571,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "by now, about three years ago."
    } ]
  }, {
    "tStartMs": 217596,
    "dDurationMs": 2934,
    "segs": [ {
      "utf8": "But LLaMA is a fairly\nrecent model from Meta."
    } ]
  }, {
    "tStartMs": 220531,
    "dDurationMs": 1879,
    "segs": [ {
      "utf8": "These are roughly the orders of"
    } ]
  }, {
    "tStartMs": 222411,
    "dDurationMs": 869,
    "segs": [ {
      "utf8": "magnitude that we're dealing"
    } ]
  }, {
    "tStartMs": 223281,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "with when we're\ndoing pretraining."
    } ]
  }, {
    "tStartMs": 224781,
    "dDurationMs": 3359,
    "segs": [ {
      "utf8": "The vocabulary size is usually\na couple 10,000 tokens."
    } ]
  }, {
    "tStartMs": 228141,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "The context length is usually\nsomething like 2,000,"
    } ]
  }, {
    "tStartMs": 230541,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "4,000, or nowadays even 100,000,"
    } ]
  }, {
    "tStartMs": 233241,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "and this governs the maximum\nnumber of integers that"
    } ]
  }, {
    "tStartMs": 236676,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "the GPT will look at\nwhen it's trying to"
    } ]
  }, {
    "tStartMs": 238431,
    "dDurationMs": 2849,
    "segs": [ {
      "utf8": "predict the next\ninteger in a sequence."
    } ]
  }, {
    "tStartMs": 241281,
    "dDurationMs": 3209,
    "segs": [ {
      "utf8": "You can see that roughly the\nnumber of parameters say,"
    } ]
  }, {
    "tStartMs": 244491,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "65 billion for LLaMA."
    } ]
  }, {
    "tStartMs": 246141,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "Now, even though LLaMA\nhas only 65B parameters"
    } ]
  }, {
    "tStartMs": 248601,
    "dDurationMs": 2719,
    "segs": [ {
      "utf8": "compared to GPP-3s 175\nbillion parameters,"
    } ]
  }, {
    "tStartMs": 251321,
    "dDurationMs": 2574,
    "segs": [ {
      "utf8": "LLaMA is a significantly\nmore powerful model,"
    } ]
  }, {
    "tStartMs": 253896,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "and intuitively, that's because"
    } ]
  }, {
    "tStartMs": 255861,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "the model is trained for\nsignificantly longer."
    } ]
  }, {
    "tStartMs": 257871,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "In this case, 1.4\ntrillion tokens,"
    } ]
  }, {
    "tStartMs": 259861,
    "dDurationMs": 1809,
    "segs": [ {
      "utf8": "instead of 300 billion tokens."
    } ]
  }, {
    "tStartMs": 261671,
    "dDurationMs": 1989,
    "segs": [ {
      "utf8": "You shouldn't judge the\npower of a model by"
    } ]
  }, {
    "tStartMs": 263661,
    "dDurationMs": 2614,
    "segs": [ {
      "utf8": "the number of parameters\nthat it contains."
    } ]
  }, {
    "tStartMs": 266276,
    "dDurationMs": 2034,
    "segs": [ {
      "utf8": "Below, I'm showing\nsome tables of"
    } ]
  }, {
    "tStartMs": 268311,
    "dDurationMs": 2909,
    "segs": [ {
      "utf8": "rough hyperparameters\nthat typically"
    } ]
  }, {
    "tStartMs": 271221,
    "dDurationMs": 3089,
    "segs": [ {
      "utf8": "go into specifying the\ntransformer neural network,"
    } ]
  }, {
    "tStartMs": 274311,
    "dDurationMs": 629,
    "segs": [ {
      "utf8": "the number of heads,"
    } ]
  }, {
    "tStartMs": 274941,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "the dimension size,\nnumber of layers,"
    } ]
  }, {
    "tStartMs": 276591,
    "dDurationMs": 1994,
    "segs": [ {
      "utf8": "and so on, and on the bottom"
    } ]
  }, {
    "tStartMs": 278586,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "I'm showing some training\nhyperparameters."
    } ]
  }, {
    "tStartMs": 281156,
    "dDurationMs": 3094,
    "segs": [ {
      "utf8": "For example, to\ntrain the 65B model,"
    } ]
  }, {
    "tStartMs": 284251,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "Meta used 2,000 GPUs,"
    } ]
  }, {
    "tStartMs": 286621,
    "dDurationMs": 2309,
    "segs": [ {
      "utf8": "roughly 21 days of training and"
    } ]
  }, {
    "tStartMs": 288931,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "a roughly several\nmillion dollars."
    } ]
  }, {
    "tStartMs": 292561,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "That's the rough orders of\nmagnitude that you should have"
    } ]
  }, {
    "tStartMs": 294831,
    "dDurationMs": 3099,
    "segs": [ {
      "utf8": "in mind for the\npre-training stage."
    } ]
  }, {
    "tStartMs": 297980,
    "dDurationMs": 2925,
    "segs": [ {
      "utf8": "Now, when we're actually\npre-training, what happens?"
    } ]
  }, {
    "tStartMs": 300906,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Roughly speaking, we are\ngoing to take our tokens,"
    } ]
  }, {
    "tStartMs": 303666,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "and we're going to lay them\nout into data batches."
    } ]
  }, {
    "tStartMs": 306126,
    "dDurationMs": 1574,
    "segs": [ {
      "utf8": "We have these arrays"
    } ]
  }, {
    "tStartMs": 307701,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "that will feed into\nthe transformer,"
    } ]
  }, {
    "tStartMs": 309231,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "and these arrays are B,"
    } ]
  }, {
    "tStartMs": 310821,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "the batch size and these are\nall independent examples"
    } ]
  }, {
    "tStartMs": 313281,
    "dDurationMs": 2859,
    "segs": [ {
      "utf8": "stocked up in rows and B by T,"
    } ]
  }, {
    "tStartMs": 316141,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "T being the maximum\ncontext length."
    } ]
  }, {
    "tStartMs": 317971,
    "dDurationMs": 3019,
    "segs": [ {
      "utf8": "In my picture I only have\n10 the context lengths,"
    } ]
  }, {
    "tStartMs": 320991,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "so this could be\n2,000, 4,000, etc."
    } ]
  }, {
    "tStartMs": 323031,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "These are extremely long rows."
    } ]
  }, {
    "tStartMs": 324861,
    "dDurationMs": 1664,
    "segs": [ {
      "utf8": "What we do is we take\nthese documents,"
    } ]
  }, {
    "tStartMs": 326526,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "and we pack them into rows,"
    } ]
  }, {
    "tStartMs": 328041,
    "dDurationMs": 1199,
    "segs": [ {
      "utf8": "and we delimit them with"
    } ]
  }, {
    "tStartMs": 329241,
    "dDurationMs": 2444,
    "segs": [ {
      "utf8": "these special end\nof texts tokens,"
    } ]
  }, {
    "tStartMs": 331686,
    "dDurationMs": 1214,
    "segs": [ {
      "utf8": "basically telling\nthe transformer"
    } ]
  }, {
    "tStartMs": 332901,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "where a new document begins."
    } ]
  }, {
    "tStartMs": 335006,
    "dDurationMs": 3354,
    "segs": [ {
      "utf8": "Here, I have a few examples\nof documents and then"
