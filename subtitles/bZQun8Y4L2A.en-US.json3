  }, {
    "tStartMs": 823931,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "and then we ask people to\nrank these completions."
    } ]
  }, {
    "tStartMs": 827036,
    "dDurationMs": 2564,
    "segs": [ {
      "utf8": "If you stare at this for\na while, and by the way,"
