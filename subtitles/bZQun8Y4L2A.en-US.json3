  }, {
    "tStartMs": 1333541,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "and then maybe I'm happy\nwith what comes out."
    } ]
  }, {
    "tStartMs": 1335626,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "Basically long story short,"
    } ]
  }, {
    "tStartMs": 1337216,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "a ton happens under\nthe hood in terms of"
    } ]
  }, {
    "tStartMs": 1339301,
    "dDurationMs": 1109,
    "segs": [ {
      "utf8": "your internal monologue when you"
    } ]
  }, {
    "tStartMs": 1340411,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "create sentences like this."
    } ]
  }, {
    "tStartMs": 1341851,
    "dDurationMs": 2174,
    "segs": [ {
      "utf8": "But what does a sentence\nlike this look like"
    } ]
  }, {
    "tStartMs": 1344026,
    "dDurationMs": 2739,
    "segs": [ {
      "utf8": "when we are training\na GPT on it?"
    } ]
  }, {
    "tStartMs": 1346766,
    "dDurationMs": 1974,
    "segs": [ {
      "utf8": "From GPT's perspective, this"
    } ]
  }, {
    "tStartMs": 1348741,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "is just a sequence of tokens."
    } ]
  }, {
    "tStartMs": 1350586,
    "dDurationMs": 3539,
    "segs": [ {
      "utf8": "GPT, when it's reading or\ngenerating these tokens,"
    } ]
  }, {
    "tStartMs": 1354126,
    "dDurationMs": 1304,
    "segs": [ {
      "utf8": "it just goes chunk,\nchunk, chunk,"
    } ]
  }, {
    "tStartMs": 1355431,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "chunk and each chunk is roughly"
    } ]
  }, {
    "tStartMs": 1357591,
    "dDurationMs": 2704,
    "segs": [ {
      "utf8": "the same amount of computational\nwork for each token."
