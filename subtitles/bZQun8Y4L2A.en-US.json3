  }, {
    "tStartMs": 768071,
    "dDurationMs": 2609,
    "segs": [ {
      "utf8": "you probably can't\nread it, neither can I,"
    } ]
  }, {
    "tStartMs": 770681,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "but they're long\nand this is people"
