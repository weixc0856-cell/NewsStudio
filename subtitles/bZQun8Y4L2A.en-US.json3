  }, {
    "tStartMs": 829601,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "these are very\ndifficult things to do to"
    } ]
  }, {
    "tStartMs": 831101,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "compare some of\nthese predictions."
    } ]
  }, {
    "tStartMs": 832856,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "This can take people\neven hours for"
    } ]
  }, {
    "tStartMs": 834821,
    "dDurationMs": 3059,
    "segs": [ {
      "utf8": "a single prompt\ncompletion pairs,"
    } ]
  }, {
    "tStartMs": 837881,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "but let's say we decided\nthat one of these is"
    } ]
  }, {
    "tStartMs": 840401,
    "dDurationMs": 2654,
    "segs": [ {
      "utf8": "much better than the others\nand so on. We rank them."
    } ]
  }, {
    "tStartMs": 843056,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "Then we can follow that with"
    } ]
  }, {
    "tStartMs": 844511,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "something that looks\nvery much like"
    } ]
  }, {
    "tStartMs": 846041,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "a binary classification on"
    } ]
  }, {
    "tStartMs": 847496,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "all the possible pairs\nbetween these completions."
    } ]
  }, {
    "tStartMs": 850241,
    "dDurationMs": 3119,
    "segs": [ {
      "utf8": "What we do now is, we lay\nout our prompt in rows,"
