  }, {
    "tStartMs": 338361,
    "dDurationMs": 3184,
    "segs": [ {
      "utf8": "I stretch them out\ninto this input."
    } ]
  }, {
    "tStartMs": 341546,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "Now, we're going to feed all of"
    } ]
  }, {
    "tStartMs": 343791,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "these numbers into transformer."
    } ]
  }, {
    "tStartMs": 346116,
    "dDurationMs": 3449,
    "segs": [ {
      "utf8": "Let me just focus on a\nsingle particular cell,"
    } ]
  }, {
    "tStartMs": 349566,
    "dDurationMs": 1184,
    "segs": [ {
      "utf8": "but the same thing\nwill happen at"
