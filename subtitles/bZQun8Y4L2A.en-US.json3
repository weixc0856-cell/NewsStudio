  }, {
    "tStartMs": 408921,
    "dDurationMs": 1004,
    "segs": [ {
      "utf8": "a source of supervision to"
    } ]
  }, {
    "tStartMs": 409926,
    "dDurationMs": 1699,
    "segs": [ {
      "utf8": "update our transformers weights."
    } ]
  }, {
    "tStartMs": 411626,
    "dDurationMs": 1644,
    "segs": [ {
      "utf8": "We're applying this basically"
    } ]
  }, {
    "tStartMs": 413271,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "on every single cell\nin the parallel,"
    } ]
  }, {
    "tStartMs": 414561,
    "dDurationMs": 2054,
    "segs": [ {
      "utf8": "and we keep swapping batches,"
    } ]
  }, {
    "tStartMs": 416616,
    "dDurationMs": 1904,
    "segs": [ {
      "utf8": "and we're trying to get\nthe transformer to make"
    } ]
  }, {
    "tStartMs": 418521,
    "dDurationMs": 1394,
    "segs": [ {
      "utf8": "the correct\npredictions over what"
    } ]
  }, {
    "tStartMs": 419916,
    "dDurationMs": 2149,
    "segs": [ {
      "utf8": "token comes next in a sequence."
    } ]
  }, {
    "tStartMs": 422066,
    "dDurationMs": 1734,
    "segs": [ {
      "utf8": "Let me show you more\nconcretely what this looks"
    } ]
  }, {
    "tStartMs": 423801,
    "dDurationMs": 1664,
    "segs": [ {
      "utf8": "like when you train\none of these models."
    } ]
  }, {
    "tStartMs": 425466,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "This is actually coming\nfrom the New York Times,"
    } ]
  }, {
    "tStartMs": 427836,
    "dDurationMs": 3224,
    "segs": [ {
      "utf8": "and they trained a small\nGPT on Shakespeare."
    } ]
  }, {
    "tStartMs": 431061,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "Here's a small snippet\nof Shakespeare,"
    } ]
  }, {
    "tStartMs": 432891,
    "dDurationMs": 1519,
    "segs": [ {
      "utf8": "and they train their GPT on it."
    } ]
  }, {
    "tStartMs": 434411,
    "dDurationMs": 1389,
    "segs": [ {
      "utf8": "Now, in the beginning,"
    } ]
  }, {
    "tStartMs": 435801,
    "dDurationMs": 1214,
    "segs": [ {
      "utf8": "at initialization,"
    } ]
  }, {
    "tStartMs": 437016,
    "dDurationMs": 2174,
    "segs": [ {
      "utf8": "the GPT starts with\ncompletely random weights."
    } ]
  }, {
    "tStartMs": 439191,
    "dDurationMs": 2774,
    "segs": [ {
      "utf8": "You're getting completely\nrandom outputs as well."
    } ]
  }, {
    "tStartMs": 441966,
    "dDurationMs": 4049,
    "segs": [ {
      "utf8": "But over time, as you train\nthe GPT longer and longer,"
    } ]
  }, {
    "tStartMs": 446016,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "you are getting more\nand more coherent and"
    } ]
  }, {
    "tStartMs": 448101,
    "dDurationMs": 3339,
    "segs": [ {
      "utf8": "consistent samples\nfrom the model,"
    } ]
  }, {
    "tStartMs": 451441,
    "dDurationMs": 1429,
    "segs": [ {
      "utf8": "and the way you sample\nfrom it, of course,"
    } ]
  }, {
    "tStartMs": 452871,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "is you predict what comes next,"
