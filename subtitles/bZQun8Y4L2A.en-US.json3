  }, {
    "tStartMs": 772721,
    "dDurationMs": 1109,
    "segs": [ {
      "utf8": "following instructions\nand trying"
    } ]
  }, {
    "tStartMs": 773831,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "to complete these prompts."
    } ]
  }, {
    "tStartMs": 775646,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "That's what the\ndataset looks like."
    } ]
  }, {
    "tStartMs": 777431,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "You can train these models.\nThis works to some extent."
    } ]
  }, {
    "tStartMs": 779951,
    "dDurationMs": 2609,
    "segs": [ {
      "utf8": "Now, you can actually\ncontinue the pipeline from"
    } ]
  }, {
    "tStartMs": 782561,
    "dDurationMs": 2609,
    "segs": [ {
      "utf8": "here on, and go into RLHF,"
    } ]
  }, {
    "tStartMs": 785171,
    "dDurationMs": 2219,
    "segs": [ {
      "utf8": "reinforcement learning\nfrom human feedback that"
    } ]
  }, {
    "tStartMs": 787391,
    "dDurationMs": 1649,
    "segs": [ {
      "utf8": "consists of both reward modeling"
    } ]
  }, {
    "tStartMs": 789041,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "and reinforcement learning."
    } ]
  }, {
    "tStartMs": 790376,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "Let me cover that and then I'll"
    } ]
  }, {
    "tStartMs": 791891,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "come back to why you\nmay want to go through"
    } ]
  }, {
    "tStartMs": 793331,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "the extra steps and how that\ncompares to SFT models."
    } ]
  }, {
    "tStartMs": 796461,
    "dDurationMs": 1554,
    "segs": [ {
      "utf8": "In the reward modeling step,"
    } ]
  }, {
    "tStartMs": 798016,
    "dDurationMs": 2114,
    "segs": [ {
      "utf8": "what we're going to do is\nwe're now going to shift"
    } ]
  }, {
    "tStartMs": 800131,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "our data collection to be\nof the form of comparisons."
    } ]
  }, {
    "tStartMs": 803011,
    "dDurationMs": 2344,
    "segs": [ {
      "utf8": "Here's an example of what\nour dataset will look like."
    } ]
  }, {
    "tStartMs": 805356,
    "dDurationMs": 2959,
    "segs": [ {
      "utf8": "I have the same identical\nprompt on the top,"
    } ]
  }, {
    "tStartMs": 808316,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "which is asking the\nassistant to write"
    } ]
  }, {
    "tStartMs": 811196,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "a program or a function that"
    } ]
  }, {
    "tStartMs": 812981,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "checks if a given\nstring is a palindrome."
    } ]
  }, {
    "tStartMs": 815381,
    "dDurationMs": 3029,
    "segs": [ {
      "utf8": "Then what we do is we\ntake the SFT model which"
    } ]
  }, {
    "tStartMs": 818411,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "we've already trained and we\ncreate multiple completions."
    } ]
  }, {
    "tStartMs": 821171,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "In this case, we have\nthree completions"
