  }, {
    "tStartMs": 886091,
    "dDurationMs": 1874,
    "segs": [ {
      "utf8": "which is telling us\nthe ranking of them."
    } ]
  }, {
    "tStartMs": 887966,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "We can actually\nenforce that some of"
    } ]
  }, {
    "tStartMs": 890111,
    "dDurationMs": 1049,
    "segs": [ {
      "utf8": "these numbers should\nbe much higher"
    } ]
  }, {
    "tStartMs": 891161,
    "dDurationMs": 1109,
    "segs": [ {
      "utf8": "than others, and so on."
    } ]
  }, {
    "tStartMs": 892271,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "We formulate this into\na loss function and we"
    } ]
  }, {
    "tStartMs": 894191,
    "dDurationMs": 2279,
    "segs": [ {
      "utf8": "train our model to make\nreward predictions"
    } ]
  }, {
    "tStartMs": 896471,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "that are consistent with\nthe ground truth coming"
    } ]
  }, {
    "tStartMs": 898481,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "from the comparisons from\nall these contractors."
    } ]
  }, {
    "tStartMs": 901106,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "That's how we train\nour reward model."
    } ]
  }, {
    "tStartMs": 902786,
    "dDurationMs": 1454,
    "segs": [ {
      "utf8": "That allows us to score how good"
    } ]
  }, {
    "tStartMs": 904241,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "a completion is for a prompt."
    } ]
  }, {
    "tStartMs": 906611,
    "dDurationMs": 2414,
    "segs": [ {
      "utf8": "Once we have a reward model,"
    } ]
  }, {
    "tStartMs": 909026,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "we can't deploy this\nbecause this is"
    } ]
  }, {
    "tStartMs": 911171,
    "dDurationMs": 2174,
    "segs": [ {
      "utf8": "not very useful as an\nassistant by itself,"
    } ]
  }, {
    "tStartMs": 913346,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "but it's very useful\nfor the reinforcement"
    } ]
  }, {
    "tStartMs": 915371,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "learning stage that follows now."
    } ]
  }, {
    "tStartMs": 916916,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "Because we have a reward model,"
    } ]
  }, {
    "tStartMs": 918446,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "we can score the quality of"
    } ]
  }, {
    "tStartMs": 919766,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "any arbitrary completion\nfor any given prompt."
    } ]
  }, {
    "tStartMs": 922901,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "What we do during\nreinforcement learning"
    } ]
  }, {
    "tStartMs": 924716,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "is we basically get, again,"
    } ]
  }, {
    "tStartMs": 926066,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "a large collection of\nprompts and now we do"
    } ]
  }, {
    "tStartMs": 928526,
    "dDurationMs": 1364,
    "segs": [ {
      "utf8": "reinforcement learning\nwith respect to"
    } ]
  }, {
    "tStartMs": 929891,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "the reward model. Here's\nwhat that looks like."
    } ]
  }, {
    "tStartMs": 932276,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "We take a single prompt,"
    } ]
  }, {
    "tStartMs": 934316,
    "dDurationMs": 1679,
    "segs": [ {
      "utf8": "we lay it out in rows,"
    } ]
  }, {
    "tStartMs": 935996,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "and now we use basically"
    } ]
  }, {
    "tStartMs": 938381,
    "dDurationMs": 1259,
    "segs": [ {
      "utf8": "the model we'd like\nto train which"
    } ]
  }, {
    "tStartMs": 939641,
    "dDurationMs": 1949,
    "segs": [ {
      "utf8": "was initialized at SFT model"
    } ]
  }, {
    "tStartMs": 941591,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "to create some\ncompletions in yellow,"
    } ]
  }, {
    "tStartMs": 943436,
    "dDurationMs": 2534,
    "segs": [ {
      "utf8": "and then we append the\nreward token again"
    } ]
  }, {
    "tStartMs": 945971,
    "dDurationMs": 1859,
    "segs": [ {
      "utf8": "and we read off the reward"
    } ]
  }, {
    "tStartMs": 947831,
    "dDurationMs": 1274,
    "segs": [ {
      "utf8": "according to the reward model,"
    } ]
  }, {
    "tStartMs": 949106,
    "dDurationMs": 1364,
    "segs": [ {
      "utf8": "which is now kept fixed."
    } ]
  }, {
    "tStartMs": 950471,
    "dDurationMs": 3029,
    "segs": [ {
      "utf8": "It doesn't change any\nmore. Now the reward model"
    } ]
  }, {
    "tStartMs": 953501,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "tells us the quality of\nevery single completion"
    } ]
  }, {
    "tStartMs": 955526,
    "dDurationMs": 2924,
    "segs": [ {
      "utf8": "for all these prompts and so\nwhat we can do is we can now"
    } ]
  }, {
    "tStartMs": 958451,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "just basically apply the same"
    } ]
  }, {
    "tStartMs": 959891,
    "dDurationMs": 1904,
    "segs": [ {
      "utf8": "language modeling loss function,"
    } ]
  }, {
    "tStartMs": 961796,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "but we're currently training\non the yellow tokens,"
    } ]
  }, {
    "tStartMs": 964616,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "and we are weighing"
    } ]
  }, {
    "tStartMs": 966941,
    "dDurationMs": 1874,
    "segs": [ {
      "utf8": "the language modeling objective"
    } ]
  }, {
    "tStartMs": 968816,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "by the rewards indicated\nby the reward model."
    } ]
  }, {
    "tStartMs": 971276,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "As an example, in the first row,"
    } ]
  }, {
    "tStartMs": 973166,
    "dDurationMs": 2339,
    "segs": [ {
      "utf8": "the reward model\nsaid that this is"
    } ]
  }, {
    "tStartMs": 975506,
    "dDurationMs": 1694,
    "segs": [ {
      "utf8": "a fairly high-scoring completion"
    } ]
  }, {
    "tStartMs": 977201,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "and so all the tokens that we"
    } ]
  }, {
    "tStartMs": 978611,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "happen to sample on the\nfirst row are going to get"
    } ]
  }, {
    "tStartMs": 981431,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "reinforced and\nthey're going to get"
    } ]
  }, {
    "tStartMs": 982931,
    "dDurationMs": 2144,
    "segs": [ {
      "utf8": "higher probabilities\nfor the future."
    } ]
  }, {
    "tStartMs": 985076,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "Conversely, on the second row,"
    } ]
  }, {
    "tStartMs": 986831,
    "dDurationMs": 1349,
    "segs": [ {
      "utf8": "the reward model\nreally did not like"
    } ]
  }, {
    "tStartMs": 988181,
    "dDurationMs": 1754,
    "segs": [ {
      "utf8": "this completion, -1.2."
    } ]
  }, {
    "tStartMs": 989936,
    "dDurationMs": 2864,
    "segs": [ {
      "utf8": "Therefore, every single\ntoken that we sampled in"
    } ]
  }, {
    "tStartMs": 992801,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "that second row is going to get"
    } ]
  }, {
    "tStartMs": 994091,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "a slightly higher\nprobability for the future."
    } ]
  }, {
    "tStartMs": 996116,
    "dDurationMs": 1574,
    "segs": [ {
      "utf8": "We do this over and over on"
    } ]
  }, {
    "tStartMs": 997691,
    "dDurationMs": 2099,
    "segs": [ {
      "utf8": "many prompts on many\nbatches and basically,"
    } ]
  }, {
    "tStartMs": 999791,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "we get a policy that\ncreates yellow tokens here."
    } ]
  }, {
    "tStartMs": 1003091,
    "dDurationMs": 3209,
    "segs": [ {
      "utf8": "It's basically all the\ncompletions here will"
    } ]
  }, {
    "tStartMs": 1006301,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "score high according to"
    } ]
  }, {
    "tStartMs": 1007681,
    "dDurationMs": 2889,
    "segs": [ {
      "utf8": "the reward model that we\ntrained in the previous stage."
    } ]
  }, {
    "tStartMs": 1011930,
    "dDurationMs": 3610,
    "segs": [ {
      "utf8": "That's what the\nRLHF pipeline is."
    } ]
  }, {
    "tStartMs": 1015541,
    "dDurationMs": 3389,
    "segs": [ {
      "utf8": "Then at the end, you get a\nmodel that you could deploy."
    } ]
  }, {
    "tStartMs": 1018931,
    "dDurationMs": 3554,
    "segs": [ {
      "utf8": "As an example, ChatGPT\nis an RLHF model,"
    } ]
  }, {
    "tStartMs": 1022486,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "but some other models\nthat you might"
    } ]
  }, {
    "tStartMs": 1023896,
    "dDurationMs": 1274,
    "segs": [ {
      "utf8": "come across for example,"
    } ]
  }, {
    "tStartMs": 1025171,
    "dDurationMs": 1469,
    "segs": [ {
      "utf8": "Vicuna-13B, and so on,"
    } ]
  }, {
    "tStartMs": 1026641,
    "dDurationMs": 1589,
    "segs": [ {
      "utf8": "these are SFT models."
    } ]
  }, {
    "tStartMs": 1028231,
    "dDurationMs": 3899,
    "segs": [ {
      "utf8": "We have base models, SFT\nmodels, and RLHF models."
    } ]
  }, {
    "tStartMs": 1032131,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "That's the state\nof things there."
    } ]
  }, {
    "tStartMs": 1034501,
    "dDurationMs": 2414,
    "segs": [ {
      "utf8": "Now why would you\nwant to do RLHF?"
    } ]
  }, {
    "tStartMs": 1036916,
    "dDurationMs": 2264,
    "segs": [ {
      "utf8": "One answer that's not"
    } ]
  }, {
    "tStartMs": 1039181,
    "dDurationMs": 1769,
    "segs": [ {
      "utf8": "that exciting is that\nit works better."
    } ]
  }, {
    "tStartMs": 1040951,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "This comes from the\ninstruct GPT paper."
    } ]
  }, {
    "tStartMs": 1042841,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "According to these\nexperiments a while ago now,"
    } ]
  }, {
    "tStartMs": 1045586,
    "dDurationMs": 2459,
    "segs": [ {
      "utf8": "these PPO models are RLHF."
    } ]
  }, {
    "tStartMs": 1048046,
    "dDurationMs": 2684,
    "segs": [ {
      "utf8": "We see that they are\nbasically preferred in a lot"
    } ]
  }, {
    "tStartMs": 1050731,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "of comparisons when we\ngive them to humans."
    } ]
  }, {
    "tStartMs": 1053776,
    "dDurationMs": 2804,
    "segs": [ {
      "utf8": "Humans prefer basically tokens"
    } ]
  }, {
    "tStartMs": 1056581,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "that come from RLHF models\ncompared to SFT models,"
    } ]
  }, {
    "tStartMs": 1059341,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "compared to base model\nthat is prompted to be"
    } ]
  }, {
    "tStartMs": 1061351,
    "dDurationMs": 2399,
    "segs": [ {
      "utf8": "an assistant. It\njust works better."
    } ]
  }, {
    "tStartMs": 1063751,
    "dDurationMs": 3584,
    "segs": [ {
      "utf8": "But you might ask why\ndoes it work better?"
    } ]
  }, {
    "tStartMs": 1067336,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "I don't think that there's\na single amazing answer"
    } ]
  }, {
    "tStartMs": 1069721,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "that the community\nhas really agreed on,"
    } ]
  }, {
    "tStartMs": 1071731,
    "dDurationMs": 3764,
    "segs": [ {
      "utf8": "but I will offer one\nreason potentially."
    } ]
  }, {
    "tStartMs": 1075496,
    "dDurationMs": 2834,
    "segs": [ {
      "utf8": "It has to do with the\nasymmetry between how easy"
    } ]
  }, {
    "tStartMs": 1078331,
    "dDurationMs": 3914,
    "segs": [ {
      "utf8": "computationally it is to\ncompare versus generate."
    } ]
  }, {
    "tStartMs": 1082246,
    "dDurationMs": 2609,
    "segs": [ {
      "utf8": "Let's take an example\nof generating a haiku."
    } ]
  }, {
    "tStartMs": 1084856,
    "dDurationMs": 3134,
    "segs": [ {
      "utf8": "Suppose I ask a model to write\na haiku about paper clips."
    } ]
  }, {
    "tStartMs": 1087991,
    "dDurationMs": 2729,
    "segs": [ {
      "utf8": "If you're a contractor\ntrying to train data,"
    } ]
  }, {
    "tStartMs": 1090721,
    "dDurationMs": 1439,
    "segs": [ {
      "utf8": "then imagine being a contractor"
    } ]
  }, {
    "tStartMs": 1092161,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "collecting basically\ndata for the SFT stage,"
    } ]
  }, {
    "tStartMs": 1094246,
    "dDurationMs": 1109,
    "segs": [ {
      "utf8": "how are you supposed to create"
    } ]
  }, {
    "tStartMs": 1095356,
    "dDurationMs": 1484,
    "segs": [ {
      "utf8": "a nice haiku for a paper clip?"
    } ]
  }, {
    "tStartMs": 1096841,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "You might not be\nvery good at that,"
    } ]
  }, {
    "tStartMs": 1098671,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "but if I give you\na few examples of"
    } ]
  }, {
    "tStartMs": 1100081,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "haikus you might be able to"
    } ]
  }, {
    "tStartMs": 1101371,
    "dDurationMs": 2879,
    "segs": [ {
      "utf8": "appreciate some of these\nhaikus a lot more than others."
    } ]
  }, {
    "tStartMs": 1104251,
    "dDurationMs": 3149,
    "segs": [ {
      "utf8": "Judging which one of these is\ngood is a much easier task."
    } ]
  }, {
    "tStartMs": 1107401,
    "dDurationMs": 1889,
    "segs": [ {
      "utf8": "Basically, this asymmetry"
    } ]
  }, {
    "tStartMs": 1109291,
    "dDurationMs": 2039,
    "segs": [ {
      "utf8": "makes it so that comparisons are"
    } ]
  }, {
    "tStartMs": 1111331,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "a better way to\npotentially leverage"
    } ]
  }, {
    "tStartMs": 1113851,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "yourself as a human and"
    } ]
  }, {
    "tStartMs": 1114931,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "your judgment to create\na slightly better model."
    } ]
  }, {
    "tStartMs": 1117601,
    "dDurationMs": 3014,
    "segs": [ {
      "utf8": "Now, RLHF models are not"
    } ]
  }, {
    "tStartMs": 1120616,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "strictly an improvement on the\nbase models in some cases."
    } ]
  }, {
    "tStartMs": 1123586,
    "dDurationMs": 1604,
    "segs": [ {
      "utf8": "In particular, we'd\nnotice for example"
    } ]
  }, {
    "tStartMs": 1125191,
    "dDurationMs": 1709,
    "segs": [ {
      "utf8": "that they lose some entropy."
    } ]
  }, {
    "tStartMs": 1126901,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "That means that they\ngive more peaky results."
    } ]
  }, {
    "tStartMs": 1129661,
    "dDurationMs": 4469,
    "segs": [ {
      "utf8": "They can output samples"
    } ]
  }, {
    "tStartMs": 1134131,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "with lower variation\nthan the base model."
    } ]
  }, {
    "tStartMs": 1135946,
    "dDurationMs": 1514,
    "segs": [ {
      "utf8": "The base model has\nlots of entropy and"
    } ]
  }, {
    "tStartMs": 1137461,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "will give lots of\ndiverse outputs."
    } ]
  }, {
    "tStartMs": 1140161,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "For example, one\nplace where I still"
    } ]
  }, {
    "tStartMs": 1143461,
    "dDurationMs": 2729,
    "segs": [ {
      "utf8": "prefer to use a base\nmodel is in the setup"
    } ]
  }, {
    "tStartMs": 1146191,
    "dDurationMs": 3614,
    "segs": [ {
      "utf8": "where you basically have"
    } ]
  }, {
    "tStartMs": 1149806,
    "dDurationMs": 3929,
    "segs": [ {
      "utf8": "n things and you want to\ngenerate more things like it."
    } ]
  }, {
    "tStartMs": 1153736,
    "dDurationMs": 2699,
    "segs": [ {
      "utf8": "Here is an example\nthat I just cooked up."
    } ]
  }, {
    "tStartMs": 1156436,
    "dDurationMs": 2354,
    "segs": [ {
      "utf8": "I want to generate\ncool Pokemon names."
    } ]
  }, {
    "tStartMs": 1158791,
    "dDurationMs": 2789,
    "segs": [ {
      "utf8": "I gave it seven Pokemon names\nand I asked the base model"
    } ]
  }, {
    "tStartMs": 1161581,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "to complete the document and it"
    } ]
  }, {
    "tStartMs": 1162961,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "gave me a lot more\nPokemon names."
    } ]
  }, {
    "tStartMs": 1164581,
    "dDurationMs": 2429,
    "segs": [ {
      "utf8": "These are fictitious. I\ntried to look them up."
    } ]
  }, {
    "tStartMs": 1167011,
    "dDurationMs": 2129,
    "segs": [ {
      "utf8": "I don't believe they're\nactual Pokemons."
    } ]
  }, {
    "tStartMs": 1169141,
    "dDurationMs": 2309,
    "segs": [ {
      "utf8": "This is the task that I think\nthe base model would be"
    } ]
  }, {
    "tStartMs": 1171451,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "good at because it still\nhas lots of entropy."
    } ]
  }, {
    "tStartMs": 1173371,
    "dDurationMs": 2249,
    "segs": [ {
      "utf8": "It'll give you lots\nof diverse cool"
    } ]
  }, {
    "tStartMs": 1175621,
    "dDurationMs": 3639,
    "segs": [ {
      "utf8": "more things that look like\nwhatever you give it before."
    } ]
  }, {
    "tStartMs": 1181820,
    "dDurationMs": 2170,
    "segs": [ {
      "utf8": "Having said all that, these are"
    } ]
  }, {
    "tStartMs": 1183991,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "the assistant models\nthat are probably"
    } ]
  }, {
    "tStartMs": 1185491,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "available to you at this point."
    } ]
  }, {
    "tStartMs": 1187111,
    "dDurationMs": 3079,
    "segs": [ {
      "utf8": "There was a team at Berkeley\nthat ranked a lot of"
    } ]
  }, {
    "tStartMs": 1190191,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "the available assistant models"
    } ]
  }, {
    "tStartMs": 1191601,
    "dDurationMs": 1814,
    "segs": [ {
      "utf8": "and give them\nbasically Elo ratings."
    } ]
  }, {
    "tStartMs": 1193416,
    "dDurationMs": 1184,
    "segs": [ {
      "utf8": "Currently, some of\nthe best models,"
    } ]
  }, {
    "tStartMs": 1194601,
    "dDurationMs": 1154,
    "segs": [ {
      "utf8": "of course, are GPT-4,"
    } ]
  }, {
    "tStartMs": 1195756,
    "dDurationMs": 1289,
    "segs": [ {
      "utf8": "by far, I would say,"
    } ]
  }, {
    "tStartMs": 1197046,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "followed by Claude,"
    } ]
  }, {
    "tStartMs": 1198366,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "GPT-3.5, and then a\nnumber of models,"
    } ]
  }, {
    "tStartMs": 1200691,
    "dDurationMs": 1619,
    "segs": [ {
      "utf8": "some of these might be\navailable as weights,"
    } ]
  }, {
    "tStartMs": 1202311,
    "dDurationMs": 2434,
    "segs": [ {
      "utf8": "like Vicuna, Koala, etc."
    } ]
  }, {
    "tStartMs": 1204746,
    "dDurationMs": 2284,
    "segs": [ {
      "utf8": "The first three rows here are"
    } ]
  }, {
    "tStartMs": 1207031,
    "dDurationMs": 2819,
    "segs": [ {
      "utf8": "all RLHF models and"
    } ]
  }, {
    "tStartMs": 1209851,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "all of the other models\nto my knowledge,"
    } ]
  }, {
    "tStartMs": 1211396,
    "dDurationMs": 2814,
    "segs": [ {
      "utf8": "are SFT models, I believe."
    } ]
  }, {
    "tStartMs": 1215809,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "That's how we train"
