  }, {
    "tStartMs": 1362056,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "very shallow networks they have"
    } ]
  }, {
    "tStartMs": 1363601,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "about 80 layers of reasoning,"
    } ]
  }, {
    "tStartMs": 1365341,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "but 80 is still\nnot like too much."
    } ]
  }, {
    "tStartMs": 1367966,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "This transformer is going\nto do its best to imitate,"
    } ]
  }, {
    "tStartMs": 1371401,
    "dDurationMs": 1949,
    "segs": [ {
      "utf8": "but of course, the process here"
