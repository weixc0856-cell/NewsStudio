  }, {
    "tStartMs": 358671,
    "dDurationMs": 1564,
    "segs": [ {
      "utf8": "so all of the tokens in yellow,"
    } ]
  }, {
    "tStartMs": 360236,
    "dDurationMs": 2859,
    "segs": [ {
      "utf8": "and we're going to feed\nthat entire context"
    } ]
  }, {
    "tStartMs": 363096,
    "dDurationMs": 2009,
    "segs": [ {
      "utf8": "into the transforming\nneural network,"
    } ]
  }, {
    "tStartMs": 365106,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and the transformer\nis going to try to"
    } ]
  }, {
    "tStartMs": 367401,
    "dDurationMs": 1049,
    "segs": [ {
      "utf8": "predict the next token in"
    } ]
  }, {
    "tStartMs": 368451,
    "dDurationMs": 1724,
    "segs": [ {
      "utf8": "a sequence, in this case in red."
    } ]
  }, {
    "tStartMs": 370176,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "Now the transformer,\nI don't have"
    } ]
  }, {
    "tStartMs": 371721,
    "dDurationMs": 1319,
    "segs": [ {
      "utf8": "too much time to, unfortunately,"
    } ]
  }, {
    "tStartMs": 373041,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "go into the full details of this"
    } ]
  }, {
    "tStartMs": 374121,
    "dDurationMs": 1529,
    "segs": [ {
      "utf8": "neural network architecture is"
    } ]
  }, {
    "tStartMs": 375651,
    "dDurationMs": 3299,
    "segs": [ {
      "utf8": "just a large blob of neural\nnet stuff for our purposes,"
    } ]
  }, {
    "tStartMs": 378951,
    "dDurationMs": 1139,
    "segs": [ {
      "utf8": "and it's got several,"
    } ]
  }, {
    "tStartMs": 380091,
    "dDurationMs": 2359,
    "segs": [ {
      "utf8": "10 billion parameters typically\nor something like that."
    } ]
  }, {
    "tStartMs": 382451,
    "dDurationMs": 1499,
    "segs": [ {
      "utf8": "Of course, as I tune\nthese parameters,"
    } ]
  }, {
    "tStartMs": 383951,
    "dDurationMs": 1015,
    "segs": [ {
      "utf8": "you're getting slightly"
    } ]
  }, {
    "tStartMs": 384978,
    "dDurationMs": 1562,
    "segs": [ {
      "utf8": "different predicted\ndistributions"
    } ]
  }, {
    "tStartMs": 386541,
    "dDurationMs": 2389,
    "segs": [ {
      "utf8": "for every single\none of these cells."
    } ]
  }, {
    "tStartMs": 388931,
    "dDurationMs": 5439,
    "segs": [ {
      "utf8": "For example, if our vocabulary\nsize is 50,257 tokens,"
    } ]
  }, {
    "tStartMs": 394371,
    "dDurationMs": 1139,
    "segs": [ {
      "utf8": "then we're going\nto have that many"
    } ]
  }, {
    "tStartMs": 395511,
    "dDurationMs": 1409,
    "segs": [ {
      "utf8": "numbers because we need to"
    } ]
  }, {
    "tStartMs": 396921,
    "dDurationMs": 1225,
    "segs": [ {
      "utf8": "specify a probability"
    } ]
  }, {
    "tStartMs": 398158,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "distribution for\nwhat comes next."
    } ]
  }, {
    "tStartMs": 400221,
    "dDurationMs": 1379,
    "segs": [ {
      "utf8": "Basically, we have\na probability for"
    } ]
  }, {
    "tStartMs": 401601,
    "dDurationMs": 1174,
    "segs": [ {
      "utf8": "whatever may follow."
    } ]
  }, {
    "tStartMs": 402776,
    "dDurationMs": 1494,
    "segs": [ {
      "utf8": "Now, in this specific example,"
    } ]
  }, {
    "tStartMs": 404271,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "for this specific cell,"
    } ]
  }, {
    "tStartMs": 405351,
    "dDurationMs": 1829,
    "segs": [ {
      "utf8": "513 will come next,"
    } ]
  }, {
    "tStartMs": 407181,
    "dDurationMs": 1739,
    "segs": [ {
      "utf8": "and so we can use this as"
