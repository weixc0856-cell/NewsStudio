  }, {
    "tStartMs": 970600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "So MI455 is the engine."
    } ]
  }, {
    "tStartMs": 973060,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "It's the highest performance GPU in the\nindustry."
    } ]
  }, {
    "tStartMs": 976480,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Venice, which drives it, is the world's\nfastest CPU cores."
    } ]
  }, {
    "tStartMs": 981040,
    "dDurationMs": 7920,
    "segs": [ {
      "utf8": "And Pensando DPUs and NICs actually connect\nthem with leadership programmability and"
    } ]
  }, {
    "tStartMs": 988960,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "scale-out bandwidth."
    } ]
  }, {
    "tStartMs": 990620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So I have a few more props to show you."
