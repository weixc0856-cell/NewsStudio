  }, {
    "tStartMs": 746620,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "And you're going to see that AI has been a\ntremendous multiplier in this great"
    } ]
  }, {
    "tStartMs": 751800,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "pace of progress that we're making in\nROCm and in software."
