  }, {
    "tStartMs": 906220,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And that is exactly what we built with\nHelios."
    } ]
  }, {
    "tStartMs": 910760,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "So today, I'm super excited to launch\nHelios, the industry's highest performance"
    } ]
  }, {
    "tStartMs": 916340,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "AI rack."
    } ]
  }, {
    "tStartMs": 922920,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Now, Helios is built to train and run the\nmost demanding Frontier models in the"
    } ]
  }, {
    "tStartMs": 927660,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "world at massive scale."
    } ]
  }, {
    "tStartMs": 929480,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "And I have a lot of show and tell for you."
    } ]
  }, {
    "tStartMs": 932320,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "So for those of you who know me,\nyou know that I love holding up chips."
    } ]
  }, {
    "tStartMs": 938220,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I call myself sometimes the Vanna White of\nchips."
    } ]
  }, {
    "tStartMs": 942320,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "But it turns out with Helios, there are\nlots and lots of components."
