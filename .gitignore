.tmpvid.*
*.tmpvid.*

# Auto-clip renders: keep JSON/SRT/ASS/logs, ignore video files only
clips/**/*.mp4
clips/**/*.mkv
clips/**/*.webm
clips/**/*.tmp.mp4

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
