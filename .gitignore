__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Downloaded media: never commit (large files)
downloads/
*.mkv
*.mp4
*.webm
*.mov
*.avi
*.flv
*.part
*.ytdl
*.tmp

